; Outputs the texture color at the interpolated texture coordinate, lit by the face's light

; $MODE = "UniformRegister"
; $NUM_SPI_PS_INPUT_CNTL = 1
; R0, the texture coordinate
; $SPI_PS_INPUT_CNTL[0].SEMANTIC = 0
; $SPI_PS_INPUT_CNTL[0].DEFAULT_VAL = 1

; C0, the light of the face
; $UNIFORM_VARS[0].name = "uLight"
; $UNIFORM_VARS[0].type = "vec4"
; $UNIFORM_VARS[0].count = 1
; $UNIFORM_VARS[0].block = -1
; $UNIFORM_VARS[0].offset = 0

; $SAMPLER_VARS[0].name = "uTexture"
; $SAMPLER_VARS[0].type = "sampler2D"
; $SAMPLER_VARS[0].location = 0

00 TEX: ADDR(48) CNT(1) VALID_PIX
    0  SAMPLE R0, R0.xy00, t0, s0
01 ALU: ADDR(32) CNT(4)
    1  x: MUL    R0.x, R0.x, C0.x
       y: MUL    R0.y, R0.y, C0.y
       z: MUL    R0.z, R0.z, C0.z
       w: MUL    R0.w, R0.w, C0.w
02 EXP_DONE: PIX0, R0
END_OF_PROGRAM
