+// snd_nds.c -- Nintendo DS sound output
+//
+// Quake II keeps its channels, which sound plays where at what volume, but
+// instead of mixing them in software the loudest 16 play on the hardware
+// channels, which do the resampling, volume and stereo panning. The samples
+// play straight from the loaded sounds, 8-bit signed, at 11025 Hz on a DS
+// and 22050 Hz on a DSi, which has the RAM for them. The sound hardware
+// can't read the Memory Expansion Pak, they are in main RAM. The play
+// position Quake II's timing needs follows from the tick timer.
+
+#include "../client/client.h"
+#include "../client/snd_loc.h"
+
+#include <nds.h>
+
+#define	MIN(a,b)		((a) < (b) ? (a) : (b))
+#define	CLAMP(lo,x,hi)	((x) < (lo) ? (lo) : (x) > (hi) ? (hi) : (x))
+
+#define	SND_FRAMES		4096		// of the time base, a power of two
+#define	HW_CHANNELS		16
+
+// What the loaded sounds may take
+#define	SND_CACHE_DS	(768 * 1024)
+#define	SND_CACHE_DSI	(3 * 1024 * 1024)
+
+typedef struct
+{
+	channel_t	*ch;		// the Quake II channel playing, NULL for none
+	sfx_t		*sfx;		// a looping sound of entities keeps its channel by this
+	sfxcache_t	*sc;
+	qboolean	autosound;
+	unsigned	vol, pan;
+} hwchannel_t;
+
+extern int			soundtime;
+
+static hwchannel_t	hw[HW_CHANNELS];
+static unsigned	snd_timer;
+static u64		snd_start;
+
+static void HW_Stop (int slot)
+{
+	if (hw[slot].sc)
+		soundStop (BIT(slot));
+	memset (&hw[slot], 0, sizeof(hw[slot]));
+}
+
+qboolean SNDDMA_IsPlaying (sfxcache_t *sc)
+{
+	int	slot;
+
+	for (slot = 0; slot < HW_CHANNELS; slot++)
+		if (hw[slot].sc == sc)
+			return true;
+	return false;
+}
+
+// A sound that is freed stops, the channel would play what comes there next
+void SNDDMA_SoundFreed (sfxcache_t *sc)
+{
+	int	slot;
+
+	for (slot = 0; slot < HW_CHANNELS; slot++)
+		if (hw[slot].sc == sc)
+			HW_Stop (slot);
+}
+
+qboolean SNDDMA_Init (void)
+{
+	dma.channels = 2;
+	dma.samplebits = 16;
+	dma.speed = isDSiMode () ? 22050 : 11025;
+	dma.samples = SND_FRAMES * 2;
+	dma.samplepos = 0;
+	dma.submission_chunk = 1;
+	dma.buffer = NULL;		// nothing is mixed, the samples play as they are
+	Cvar_Set ("s_loadas8bit", "1");
+	snd_cachemax = isDSiMode () ? SND_CACHE_DSI : SND_CACHE_DS;
+
+	soundInit ();
+	soundPowerOn ();
+	soundSetMixerVolume (127);
+	memset (hw, 0, sizeof(hw));
+	snd_timer = soundTimerFromHz (dma.speed);
+	snd_start = tickGetCount ();
+	return true;
+}
+
+int SNDDMA_GetDMAPos (void)
+{
+	// Ticks run at SYSTEM_CLOCK / 64, a sample lasts snd_timer SYSTEM_CLOCK / 2 cycles
+	u64	frames = (tickGetCount () - snd_start) * 32 / snd_timer;
+
+	dma.samplepos = (frames & (SND_FRAMES - 1)) * 2;
+	return dma.samplepos;
+}
+
+void SNDDMA_Shutdown (void)
+{
+	int	i;
+
+	for (i = 0; i < HW_CHANNELS; i++)
+		HW_Stop (i);
+}
+
+void SNDDMA_BeginPainting (void)
+{
+}
+
+void SNDDMA_Submit (void)
+{
+}
+
+void S_InitScaletable (void)
+{
+}
+
+// The volume cvar as 0..256, worked out once for each S_PaintChannels
+static unsigned	master_volume;
+
+// The volume (0..2047) and pan (0..127) of a channel, with the volume cvar
+static void HW_Volume (const channel_t *ch, unsigned *vol, unsigned *pan)
+{
+	int	left = MIN (ch->leftvol, 255), right = MIN (ch->rightvol, 255);
+
+	*vol = MIN ((left + right) * 4 * master_volume >> 8, 2047);
+	*pan = left + right ? right * 127 / (left + right) : 64;
+}
+
+// Starts the sound of a channel on a hardware channel
+static void HW_Start (int slot, channel_t *ch, sfxcache_t *sc)
+{
+	hwchannel_t	*h = &hw[slot];
+	uintptr_t	start = (uintptr_t) sc->data & ~3;	// whole words from an aligned address
+	unsigned	bytes = sc->length * sc->width, loop;
+	qboolean	loops = ch->autosound || sc->loopstart >= 0;
+	// a loop ends at the last whole word, the bytes after the data aren't
+	// part of the sound
+	unsigned	words = loops ? bytes / 4 : (bytes + 3) / 4;
+
+	h->ch = ch;
+	h->sfx = ch->sfx;
+	h->sc = sc;
+	h->autosound = ch->autosound;
+	HW_Volume (ch, &h->vol, &h->pan);
+	// the ARM7 plays from main RAM, past the data cache
+	DC_FlushRange ((void *) start, words * 4);
+	if (loops)
+	{
+		loop = ch->autosound ? 0 : sc->loopstart * sc->width / 4;
+		soundPreparePcm (slot | SOUND_START, h->vol, h->pan, soundTimerFromHz (sc->speed), SoundMode_Repeat,
+			sc->width == 2 ? SoundFmt_Pcm16 : SoundFmt_Pcm8, (const void *) start, loop, words - loop);
+	}
+	else
+		soundPreparePcm (slot | SOUND_START, h->vol, h->pan, soundTimerFromHz (sc->speed), SoundMode_OneShot,
+			sc->width == 2 ? SoundFmt_Pcm16 : SoundFmt_Pcm8, (const void *) start, 0, words);
+	// started, a new sound on the channel sets it back to 0
+	ch->pos = 1;
+}
+
+// Whether a hardware channel plays what a Quake II channel plays
+static qboolean HW_Plays (hwchannel_t *h, channel_t *ch)
+{
+	if (!h->sc || !ch->sfx || h->autosound != ch->autosound)
+		return false;
+	// the looping sounds of entities are made again every frame
+	if (ch->autosound)
+		return h->sfx == ch->sfx;
+	return h->ch == ch && h->sfx == ch->sfx && ch->pos;
+}
+
+/*
+================
+S_PaintChannels
+
+Instead of mixing up to endtime, keeps the hardware channels playing what
+the loudest Quake II channels play
+================
+*/
+void S_PaintChannels (int endtime)
+{
+	channel_t	*ch, *loudest[HW_CHANNELS];
+	playsound_t	*ps;
+	sfxcache_t	*sc;
+	unsigned	vol, pan, loudvol[HW_CHANNELS];
+	int			i, j, k, slot;
+
+	master_volume = CLAMP (0, s_volume->value, 1) * 256;
+
+	// start the playsounds that are due
+	while ((ps = s_pendingplays.next) != &s_pendingplays && ps->begin <= soundtime)
+		S_IssuePlaysound (ps);
+
+	// sounds that ended stop, looping ones go on, those whose samples were
+	// freed for others are over
+	for (i = 0, ch = channels; i < MAX_CHANNELS; i++, ch++)
+	{
+		if (!ch->sfx || ch->autosound)
+			continue;
+		if (!(sc = ch->sfx->cache))
+		{
+			ch->sfx = NULL;
+			continue;
+		}
+		while (ch->end <= soundtime)
+		{
+			if (sc->loopstart < 0)
+			{
+				ch->sfx = NULL;
+				break;
+			}
+			ch->end += sc->length - sc->loopstart;
+		}
+	}
+
+	// the loudest ones, which stay loaded
+	memset (loudest, 0, sizeof(loudest));
+	memset (loudvol, 0, sizeof(loudvol));
+	for (i = 0, ch = channels; i < MAX_CHANNELS; i++, ch++)
+	{
+		if (!ch->sfx || !ch->sfx->cache)
+			continue;
+		HW_Volume (ch, &vol, &pan);
+		if (!vol)
+			continue;
+		for (j = 0; j < HW_CHANNELS && vol <= loudvol[j]; j++)
+			;
+		if (j == HW_CHANNELS)
+			continue;
+		for (k = HW_CHANNELS - 1; k > j; k--)
+		{
+			loudest[k] = loudest[k - 1];
+			loudvol[k] = loudvol[k - 1];
+		}
+		loudest[j] = ch;
+		loudvol[j] = vol;
+	}
+	for (i = 0; i < HW_CHANNELS; i++)
+		if (loudest[i])
+			loudest[i]->sfx->lastused = paintedtime;
+
+	// those still playing keep their hardware channel, the sounds that ended
+	// or are too quiet now stop
+	for (slot = 0; slot < HW_CHANNELS; slot++)
+	{
+		for (i = 0; i < HW_CHANNELS && !(loudest[i] && HW_Plays (&hw[slot], loudest[i])); i++)
+			;
+		if (i == HW_CHANNELS)
+		{
+			if (hw[slot].sc)
+				HW_Stop (slot);
+			continue;
+		}
+		hw[slot].ch = loudest[i];
+		HW_Volume (loudest[i], &vol, &pan);
+		if (vol != hw[slot].vol)
+			soundChSetVolume (slot, hw[slot].vol = vol);
+		if (pan != hw[slot].pan)
+			soundChSetPan (slot, hw[slot].pan = pan);
+		loudest[i] = NULL;
+	}
+
+	// and the new ones start
+	for (i = 0, slot = 0; i < HW_CHANNELS; i++)
+	{
+		if (!loudest[i])
+			continue;
+		while (hw[slot].sc)
+			slot++;
+		HW_Start (slot, loudest[i], loudest[i]->sfx->cache);
+	}
+
+	paintedtime = endtime;
+}
