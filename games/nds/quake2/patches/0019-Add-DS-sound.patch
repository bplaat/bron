 			if (sc->width == 2)
@@ -90,6 +91,38 @@ void ResampleSfx (sfx_t *sfx, int inrate, int inwidth, byte *data)
 
 //=============================================================================
 
+int		snd_cachemax = 0x7fffffff;
+static int	snd_cachebytes;
+
+void S_FreeSound (sfx_t *s)
+{
+	if (!s->cache)
+		return;
+	SNDDMA_SoundFreed (s->cache);
+	snd_cachebytes -= s->cache->size;
+	free (s->cache);
+	s->cache = NULL;
+}
+
+// Frees the least recently played sound that doesn't play, false when there
+// is none
+static qboolean S_FreeOldest (sfx_t *loading)
+{
+	extern sfx_t	known_sfx[];
+	extern int		num_sfx;
+	sfx_t			*sfx, *oldest = NULL;
+	int				i;
+
+	for (i = 0, sfx = known_sfx; i < num_sfx; i++, sfx++)
+		if (sfx->cache && sfx != loading && !SNDDMA_IsPlaying (sfx->cache)
+			&& (!oldest || sfx->lastused < oldest->lastused))
+			oldest = sfx;
+	if (!oldest)
+		return false;
+	S_FreeSound (oldest);
+	return true;
+}
+
 /*
