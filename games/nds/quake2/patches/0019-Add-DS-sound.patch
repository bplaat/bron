 client/snd_loc.h |  11 +-
 client/snd_mem.c |  71 ++++++++++--
 nds/snd_nds.c    | 293 +++++++++++++++++++++++++++++++++++++++++++++++
 4 files changed, 379 insertions(+), 29 deletions(-)
 create mode 100644 nds/snd_nds.c

