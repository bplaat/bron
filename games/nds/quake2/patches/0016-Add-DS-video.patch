+// vid_nds.c -- Nintendo DS video driver
+//
+// The refresh (ref_nds) has a single video mode, the brightness is in the
+// options menu.
+
+#include "../client/client.h"
+
+refexport_t	re;
+
+// The refresh is linked in, not loaded from a library
+refexport_t GetRefAPI (refimport_t rimp);
+
+viddef_t	viddef;
+
+void VID_Printf (int print_level, char *fmt, ...)
+{
+	va_list	argptr;
+	char	msg[1024];
+
+	va_start (argptr, fmt);
+	vsnprintf (msg, sizeof(msg), fmt, argptr);
+	va_end (argptr);
+
+	if (print_level == PRINT_DEVELOPER)
+		Com_DPrintf ("%s", msg);
+	else
+		Com_Printf ("%s", msg);
+}
+
+void VID_Error (int err_level, char *fmt, ...)
+{
+	va_list	argptr;
+	char	msg[1024];
+
+	va_start (argptr, fmt);
+	vsnprintf (msg, sizeof(msg), fmt, argptr);
+	va_end (argptr);
+
+	Com_Error (err_level, "%s", msg);
+}
+
+qboolean VID_GetModeInfo (int *width, int *height, int mode)
+{
+	return false;
+}
+
+void VID_NewWindow (int width, int height)
+{
+	viddef.width = width;
+	viddef.height = height;
+}
+
+void VID_Init (void)
+{
+	refimport_t	ri;
+
+	ri.Cmd_AddCommand = Cmd_AddCommand;
+	ri.Cmd_RemoveCommand = Cmd_RemoveCommand;
+	ri.Cmd_Argc = Cmd_Argc;
+	ri.Cmd_Argv = Cmd_Argv;
+	ri.Cmd_ExecuteText = Cbuf_ExecuteText;
+	ri.Con_Printf = VID_Printf;
+	ri.Sys_Error = VID_Error;
+	ri.FS_LoadFile = FS_LoadFile;
+	ri.FS_FreeFile = FS_FreeFile;
+	ri.FS_Gamedir = FS_Gamedir;
+	ri.Cvar_Get = Cvar_Get;
+	ri.Cvar_Set = Cvar_Set;
+	ri.Cvar_SetValue = Cvar_SetValue;
+	ri.Vid_GetModeInfo = VID_GetModeInfo;
+	ri.Vid_MenuInit = VID_MenuInit;
+	ri.Vid_NewWindow = VID_NewWindow;
+
+	// The particles and shells are drawn like GL does
+	vidref_val = VIDREF_GL;
+	re = GetRefAPI (ri);
+	if (!re.Init (NULL, NULL))
+		Com_Error (ERR_FATAL, "Couldn't start the refresh");
+}
+
+void VID_Shutdown (void)
+{
+	if (re.Shutdown)
+		re.Shutdown ();
+}
+
+void VID_CheckChanges (void)
+{
+}
+
+// The brightness is in the options menu, the video menu is that one
+void VID_MenuInit (void)
+{
+}
+
+void VID_MenuDraw (void)
+{
+}
+
+const char *VID_MenuKey (int key)
+{
+	return NULL;
+}
