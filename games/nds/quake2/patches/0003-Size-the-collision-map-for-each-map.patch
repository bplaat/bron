-byte	*cmod_base;
+// The map is read a lump at a time into temporary memory, not all at once
+static FILE	*cmod_file;
+static int	cmod_fileofs;
+
+static void *CMod_ReadLump (lump_t *l, int size, int extra, int *count, int tag)
+{
+	void	*in;
+
+	if (l->filelen % size)
+		Com_Error (ERR_DROP, "MOD_LoadBmodel: funny lump size");
+	*count = l->filelen / size;
+	// the lumps are only read while they are converted, the visibility and
+	// entities are seldom read, they go to the far heap
+	in = Z_TagMallocFar (l->filelen + extra, tag);
+	fseek (cmod_file, cmod_fileofs + l->fileofs, SEEK_SET);
+	FS_Read (in, l->filelen, cmod_file);
+	return in;
+}
+
+// Memory for count entries and the extra ones of the box hull, freed all at
+// once when the next map loads
+#define	TAG_CMODEL	767
+
+static void *CMod_Alloc (int count, int extra, int size)
+{
+	return Z_TagMalloc ((count + extra) * size, TAG_CMODEL);
+}
 
