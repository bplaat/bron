+// The messages on the text layer of the top screen: the lines printed last,
+// wrapped at words to its 32 columns like the console
+#define	MSG_COLS	32
+#define	MSG_LINES	4
+
+static char		msg_lines[MSG_LINES][MSG_COLS + 1];
+static int		msg_times[MSG_LINES];
+static int		msg_current = -1, msg_x;
+static qboolean	msg_cr;
+
 void Con_ClearNotify (void)
 {
 	int		i;
 	
 	for (i=0 ; i<NUM_CON_TIMES ; i++)
 		con.times[i] = 0;
+	for (i = 0; i < MSG_LINES; i++)
+		msg_times[i] = 0;
+}
+
+static void Con_PrintMessage (char *txt, int mask)
+{
+	char	*line;
+	int		c, l;
+
+	while ((c = *txt))
+	{
+		for (l = 0; l < MSG_COLS; l++)
+			if (txt[l] <= ' ')
+				break;
+		if (l != MSG_COLS && msg_x + l > MSG_COLS)
+			msg_x = 0;
+		txt++;
+		if (msg_cr)
+		{
+			msg_current--;
+			msg_cr = false;
+		}
+		if (!msg_x)
+		{
+			msg_current++;
+			line = msg_lines[msg_current % MSG_LINES];
+			memset (line, ' ', MSG_COLS);
+			line[MSG_COLS] = 0;
+			msg_times[msg_current % MSG_LINES] = cls.realtime;
+		}
+		switch (c)
+		{
+		case '\n':
+			msg_x = 0;
+			break;
+		case '\r':
+			msg_x = 0;
+			msg_cr = true;
+			break;
+		default:
+			msg_lines[msg_current % MSG_LINES][msg_x] = c | mask;
+			if (++msg_x >= MSG_COLS)
+				msg_x = 0;
+			break;
+		}
+	}
+}
+
+/*
+================
+Con_DrawMessages
+
+The messages of the last con_notifytime seconds at the top of the text
+layer of the top screen
+================
+*/
+void Con_DrawMessages (void)
+{
+	int	i, row = 0;
+
+	for (i = msg_current - MSG_LINES + 1; i <= msg_current; i++)
+	{
+		if (i < 0 || !msg_times[i % MSG_LINES] || cls.realtime - msg_times[i % MSG_LINES] > con_notifytime->value * 1000)
+			continue;
+		VID_TextString (0, row++, msg_lines[i % MSG_LINES], 0);
+	}
 }
 
 						
@@ -365,6 +441,7 @@ void Con_Print (char *txt)
 	}
 	else
 		mask = 0;
+	Con_PrintMessage (txt, mask);
 
 
 	while ( (c = *txt) )
