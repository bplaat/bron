+// r_alias.c -- alias models
+//
+// The vertices of the two frames are interpolated in fixed point into eye
+// space positions, so the position relative to the eye isn't the difference
+// of two rounded positions, then sent through the strips and triangle lists
+// of the model's GL commands. They are lit like GL Quake II, shaded by their
+// normals.
+
+#include "r_local.h"
+
+#define	SHADEDOT_QUANT	16
+#define	NUMVERTEXNORMALS	162
+
+// The view weapon's positions are in 1/16 of the units of the world's, its
+// matrix and projection in finer units: the gun wobbled while turning
+#define	VIEWMODEL_UNITS	16
+
+int			c_alias_polys;
+
+static const float	r_avertexnormal_dots[SHADEDOT_QUANT][256] =
+#include "../ref_gl/anormtab.h"
+;
+static u16		shadedots_i[SHADEDOT_QUANT][NUMVERTEXNORMALS];	// 8.8
+
+static unsigned	alias_xy[MAX_VERTS];
+static u16		alias_z[MAX_VERTS];
+static u16		alias_color[MAX_VERTS];
+
+void R_InitAlias (void)
+{
+	int	i, j;
+
+	for (i = 0; i < SHADEDOT_QUANT; i++)
+		for (j = 0; j < NUMVERTEXNORMALS; j++)
+			shadedots_i[i][j] = r_avertexnormal_dots[i][j] * 256;
+}
+
+// The light of a model like GL Quake II, 1.0 is the normal light
+static void R_AliasLight (entity_t *e, vec3_t shadelight)
+{
+	int		i;
+	float	scale, min;
+
+	if (e->flags & (RF_SHELL_HALF_DAM | RF_SHELL_GREEN | RF_SHELL_RED | RF_SHELL_BLUE | RF_SHELL_DOUBLE))
+	{
+		VectorClear (shadelight);
+		if (e->flags & RF_SHELL_HALF_DAM)
+		{
+			shadelight[0] = 0.56f;
+			shadelight[1] = 0.59f;
+			shadelight[2] = 0.45f;
+		}
+		if (e->flags & RF_SHELL_DOUBLE)
+		{
+			shadelight[0] = 0.9f;
+			shadelight[1] = 0.7f;
+		}
+		if (e->flags & RF_SHELL_RED)
+			shadelight[0] = 1.0f;
+		if (e->flags & RF_SHELL_GREEN)
+			shadelight[1] = 1.0f;
+		if (e->flags & RF_SHELL_BLUE)
+			shadelight[2] = 1.0f;
+		return;
+	}
+	if (e->flags & RF_FULLBRIGHT)
+	{
+		shadelight[0] = shadelight[1] = shadelight[2] = 1.0f;
+		return;
+	}
+
+	R_LightPoint (e->origin, shadelight);
+	if (e->flags & RF_MINLIGHT)
+	{
+		for (i = 0; i < 3; i++)
+			if (shadelight[i] > 0.1f)
+				break;
+		if (i == 3)
+			shadelight[0] = shadelight[1] = shadelight[2] = 0.1f;
+	}
+	if (e->flags & RF_GLOW)
+	{
+		// bonus items will pulse with time
+		scale = 0.1f * sinf (r_newrefdef.time * 7);
+		for (i = 0; i < 3; i++)
+		{
+			min = shadelight[i] * 0.8f;
+			shadelight[i] += scale;
+			if (shadelight[i] < min)
+				shadelight[i] = min;
+		}
+	}
+}
+
+static image_t *R_AliasSkin (entity_t *e, gxalias_t *gx)
+{
+	if (e->skin)
+		return e->skin;		// custom player skin
+	if (e->skinnum >= 0 && e->skinnum < gx->numskins && gx->skins[e->skinnum])
+		return gx->skins[e->skinnum];
+	return gx->skins[0];
+}
+
+/*
+=================
+R_LerpVertices
+
+The positions of the vertices between the two frames in 1/8 units times
+scale of the model's coordinates, and their colors
+=================
+*/
+HOT_CODE static void R_LerpVertices (gxalias_t *gx, daliasframe_t *frame, daliasframe_t *oldframe,
+	int frontlerp, int scale, const int *shade, const u16 *dots)
+{
+	dtrivertx_t	*v = frame->verts, *ov = oldframe->verts;
+	int			i, k, front[3], back[3], move[3], p[3], l;
+
+	// 16.16 fixed point multipliers of the bytes of each frame
+	for (k = 0; k < 3; k++)
+	{
+		front[k] = (int) (frame->scale[k] * scale * 256) * frontlerp;
+		back[k] = (int) (oldframe->scale[k] * scale * 256) * (256 - frontlerp);
+		move[k] = (int) ((frame->translate[k] * frontlerp + oldframe->translate[k] * (256 - frontlerp))
+			* scale * 256);
+	}
+	for (i = 0; i < gx->numverts; i++, v++, ov++)
+	{
+		for (k = 0; k < 3; k++)
+			p[k] = (v->v[k] * front[k] + ov->v[k] * back[k] + move[k]) >> 16;
+		alias_xy[i] = VERTEX_PACK (p[0], p[1]);
+		alias_z[i] = p[2];
+		l = dots[v->lightnormalindex];
+		alias_color[i] = RGB15 (MIN ((l * shade[0]) >> 16, 31), MIN ((l * shade[1]) >> 16, 31),
+			MIN ((l * shade[2]) >> 16, 31));
+	}
+}
+
+HOT_CODE static void R_EmitAliasCommands (gxalias_t *gx)
+{
+	const u16		*cmd = gx->cmds;
+	const unsigned	*st = gx->st;
+	int				count, n;
+
+	while ((count = *cmd++))
+	{
+		GFX_BEGIN = *cmd++;
+		for (; count; count--)
+		{
+			n = *cmd++;
+			GFX_COLOR = alias_color[n];
+			GFX_TEX_COORD = *st++;
+			GFX_VERTEX16 = alias_xy[n];
+			GFX_VERTEX16 = alias_z[n];
+		}
+	}
+}
+
+void R_DrawAliasModel (entity_t *e)
+{
+	gxalias_t		*gx = e->model->alias;
+	daliasframe_t	*frame, *oldframe;
+	vec3_t			mins, maxs, forward, right, up, dist, shadelight;
+	float			m[4][3], units;
+	int				i, scale, frontlerp, shade[3], alpha;
+
+	if (!(e->flags & RF_WEAPONMODEL))
+	{
+		for (i = 0; i < 3; i++)
+		{
+			mins[i] = e->origin[i] - gx->radius;
+			maxs[i] = e->origin[i] + gx->radius;
+		}
+		if (R_CullBox (mins, maxs))
+			return;
+	}
+	else if (r_lefthand->value == 2)
+		return;
+
+	if (e->frame >= gx->numframes || e->frame < 0)
+		e->frame = 0;
+	if (e->oldframe >= gx->numframes || e->oldframe < 0)
+		e->oldframe = 0;
+	frame = (daliasframe_t *)(gx->frames + e->frame * gx->framesize);
+	oldframe = (daliasframe_t *)(gx->frames + e->oldframe * gx->framesize);
+
+	// the normal light shaded by the 8.8 normal dots to the 15 of the colors
+	R_AliasLight (e, shadelight);
+	for (i = 0; i < 3; i++)
+		shade[i] = MIN (shadelight[i], 2.0f) * (GX_NORMAL_LIGHT * 256);
+
+	// straight to eye space, x right, y up, looking down -z
+	AngleVectors (e->angles, forward, right, up);
+	scale = e->flags & RF_WEAPONMODEL ? VERTEX_SCALE * VIEWMODEL_UNITS : VERTEX_SCALE;
+	units = (e->flags & RF_WEAPONMODEL ? VIEWMODEL_UNITS : 1) * MATRIX_SCALE_W;
+	for (i = 0; i < 3; i++)
+	{
+		m[0][i] = forward[i];
+		m[1][i] = -right[i];
+		m[2][i] = up[i];
+	}
+	VectorSubtract (e->origin, r_origin, m[3]);
+	VectorScale (m[3], units, m[3]);
+	for (i = 0; i < 4; i++)
+	{
+		VectorCopy (m[i], dist);
+		m[i][0] = DotProduct (dist, vright);
+		m[i][1] = DotProduct (dist, vup);
+		m[i][2] = -DotProduct (dist, vpn);
+	}
+
+	frontlerp = (1 - e->backlerp) * 256;
+	R_LerpVertices (gx, frame, oldframe, frontlerp, scale, shade,
+		shadedots_i[((int)(e->angles[1] * (SHADEDOT_QUANT / 360.0f))) & (SHADEDOT_QUANT - 1)]);
+
+	if (e->flags & RF_WEAPONMODEL)
+		R_SetViewModelProjection (true);
+	MATRIX_PUSH = 0;
+	R_LoadMatrix (m, false);
+	R_BindImage (R_AliasSkin (e, gx));
+	alpha = e->flags & RF_TRANSLUCENT ? CLAMP (1, (int) (e->alpha * 31), 31) : 31;
+	GFX_POLY_FORMAT = POLY_ALPHA (alpha) | POLY_CULL_FRONT | POLY_ID (alpha < 31 ? 4 : 0);
+	R_EmitAliasCommands (gx);
+	c_alias_polys += gx->numverts;
+	GFX_POLY_FORMAT = POLY_ALPHA (31) | POLY_CULL_NONE;
+	MATRIX_POP = 1;
+	if (e->flags & RF_WEAPONMODEL)
+		R_SetViewModelProjection (false);
+}
