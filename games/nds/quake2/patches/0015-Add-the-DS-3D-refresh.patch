+// r_surf.c -- the world and brush models
+//
+// The visible surfaces of the world are chained by texture and drawn as quad
+// strips with vertex colors. Most surfaces only have light styles at their
+// normal light and no dynamic light, they take the colors worked out when
+// the map loaded.
+
+#include "r_local.h"
+
+// Surfaces are left out when the eye is this far behind them: the integer
+// plane tests are up to a unit off for slanted planes far from the origin,
+// the eye of the matrices 1/8, so a surface seen edge on could face the one
+// and not the other, a crack. The back of one is hidden behind its solid.
+#define	BACKFACE_DIST		1.5f
+#define	BACKFACE_DIST_I		((int) (BACKFACE_DIST * VERTEX_SCALE * 16384))	// for the planes' inormal and idist
+
+#define	DLIGHT_CUTOFF		64
+
+// Polygon IDs of the translucent surfaces, those of a different ID blend
+#define	POLYID_ALPHA		8
+
+int			r_visframecount;
+int			r_viewcluster, r_viewcluster2, r_oldviewcluster, r_oldviewcluster2;
+int			c_brush_polys;
+
+static msurface_t	*r_alpha_surfaces;
+static qboolean		r_sky_visible;
+static int			r_dlightframecount;
+
+// The light styles of this frame in 8.8 per channel, and whether one is at
+// its normal light
+static int			style_i[MAX_LIGHTSTYLES][3];
+static byte			style_normal[MAX_LIGHTSTYLES];
+static int			dlight_i[MAX_DLIGHTS][7];	// origin, intensity and color 8.8
+
+/*
+===============================================================================
+
+LIGHT
+
+===============================================================================
+*/
+
+// The light styles and dynamic lights of this frame in integers
+static void R_SetupLight (void)
+{
+	int		i, j;
+	dlight_t	*dl;
+
+	for (i = 0; i < MAX_LIGHTSTYLES; i++)
+	{
+		for (j = 0; j < 3; j++)
+			style_i[i][j] = r_newrefdef.lightstyles[i].rgb[j] * 256;
+		style_normal[i] = style_i[i][0] == 256 && style_i[i][1] == 256 && style_i[i][2] == 256;
+	}
+	for (i = 0, dl = r_newrefdef.dlights; i < r_newrefdef.num_dlights; i++, dl++)
+	{
+		for (j = 0; j < 3; j++)
+		{
+			dlight_i[i][j] = dl->origin[j];
+			dlight_i[i][4 + j] = dl->color[j] * 256;
+		}
+		dlight_i[i][3] = dl->intensity;
+	}
+}
+
+static void R_MarkLights (dlight_t *light, int bit, mnode_t *node)
+{
+	mplane_t	*splitplane;
+	float		dist;
+	msurface_t	*surf;
+	int			i;
+
+	if (node->contents != -1)
+		return;
+
+	splitplane = node->plane;
+	dist = DotProduct (light->origin, splitplane->normal) - splitplane->dist;
+	if (dist > light->intensity - DLIGHT_CUTOFF)
+	{
+		R_MarkLights (light, bit, node->children[0]);
+		return;
+	}
+	if (dist < -light->intensity + DLIGHT_CUTOFF)
+	{
+		R_MarkLights (light, bit, node->children[1]);
+		return;
+	}
+
+	// mark the polygons
+	surf = r_worldmodel->surfaces + node->firstsurface;
+	for (i = 0; i < node->numsurfaces; i++, surf++)
+	{
+		if (surf->dlightframe != r_dlightframecount)
+		{
+			surf->dlightbits = 0;
+			surf->dlightframe = r_dlightframecount;
+		}
+		surf->dlightbits |= bit;
+	}
+	R_MarkLights (light, bit, node->children[0]);
+	R_MarkLights (light, bit, node->children[1]);
+}
+
+void R_PushDlights (void)
+{
+	int			i;
+	dlight_t	*l;
+
+	R_SetupLight ();
+	r_dlightframecount = r_framecount;
+	for (i = 0, l = r_newrefdef.dlights; i < r_newrefdef.num_dlights; i++, l++)
+		R_MarkLights (l, 1 << i, r_worldmodel->nodes);
+}
+
+HOT_CODE static int R_Sqrt (int n)
+{
+	int	root = 0, bit = 1 << 30;
+
+	while (bit > n)
+		bit >>= 2;
+	for (; bit; bit >>= 2)
+	{
+		if (n >= root + bit)
+		{
+			n -= root + bit;
+			root = (root >> 1) + bit;
+		}
+		else
+			root >>= 1;
+	}
+	return root;
+}
+
+// The vertex light of a surface with its light styles and dynamic lights,
+// RGB in 0..255 for the normal light of 128
+HOT_CODE static void R_SurfaceLight (model_t *mod, msurface_t *surf, int (*vlight)[3], qboolean dlit)
+{
+	gxsurf_t		*gx = surf->gx;
+	unsigned short	*verts = GX_VERTS (gx);
+	byte			*light = GX_LIGHT (gx);
+	unsigned		*pos;
+	int				n = gx->numverts, i, k, c, x, y, z, d, l, *s, *dl;
+
+	for (i = 0; i < n; i++)
+		vlight[i][0] = vlight[i][1] = vlight[i][2] = 0;
+	for (k = 0; k < gx->numstyles; k++)
+	{
+		s = style_i[surf->styles[k]];
+		for (i = 0; i < n; i++, light += 3)
+			for (c = 0; c < 3; c++)
+				vlight[i][c] += (light[c] * s[c]) >> 8;
+	}
+	if (!gx->numstyles)
+		for (i = 0; i < n; i++)
+			vlight[i][0] = vlight[i][1] = vlight[i][2] = 128;
+	if (!dlit)
+		return;
+	for (k = 0; k < r_newrefdef.num_dlights; k++)
+	{
+		if (!(surf->dlightbits & (1 << k)))
+			continue;
+		dl = dlight_i[k];
+		for (i = 0; i < n; i++)
+		{
+			pos = mod->gxvertexes + verts[i] * 2;
+			x = ((short) (pos[0] & 0xffff) >> 3) - dl[0];
+			y = ((short) (pos[0] >> 16) >> 3) - dl[1];
+			z = ((short) (pos[1] & 0xffff) >> 3) - dl[2];
+			d = x * x + y * y + z * z;
+			if (d >= dl[3] * dl[3])
+				continue;
+			// half, the light maps' 128 is the normal light, GL Quake II's 255
+			l = dl[3] - R_Sqrt (d);
+			for (c = 0; c < 3; c++)
+				vlight[i][c] += (l * dl[4 + c]) >> 9;
+		}
+	}
+}
+
+// The vertex colors of a surface, from the map unless a light style isn't
+// normal or a dynamic light touches it
+HOT_CODE static u16 *R_SurfaceColors (model_t *mod, msurface_t *surf, u16 *color)
+{
+	gxsurf_t	*gx = surf->gx;
+	int			n = gx->numverts, i, k, vlight[MAX_SURFVERTS][3];
+	qboolean	dlit = surf->dlightframe == r_framecount && mod == r_worldmodel;
+
+	for (k = 0; k < gx->numstyles && style_normal[surf->styles[k]]; k++)
+		;
+	if (k == gx->numstyles && !dlit)
+		return surf->colors;
+	R_SurfaceLight (mod, surf, vlight, dlit);
+	for (i = 0; i < n; i++)
+		color[i] = RGB15 (MIN (vlight[i][0] * GX_NORMAL_LIGHT >> 7, 31),
+			MIN (vlight[i][1] * GX_NORMAL_LIGHT >> 7, 31), MIN (vlight[i][2] * GX_NORMAL_LIGHT >> 7, 31));
+	return color;
+}
+
+/*
+===============
+R_LightPoint
+
+The light at a point, from the vertex light of the nearest vertex of the
+surface below it, 1.0 is the normal light
+===============
+*/
+static qboolean R_RecursiveLightPoint (mnode_t *node, vec3_t start, vec3_t end, vec3_t color)
+{
+	float		front, back, frac, s, t, d, best;
+	int			side, i, k, ds, dt, nearest, vlight[MAX_SURFVERTS][3];
+	mplane_t	*plane;
+	vec3_t		mid, v;
+	msurface_t	*surf;
+	mtexinfo_t	*tex;
+	unsigned	*pos;
+
+	if (node->contents != -1)
+		return false;		// didn't hit anything
+
+	// calculate mid point
+	plane = node->plane;
+	front = DotProduct (start, plane->normal) - plane->dist;
+	back = DotProduct (end, plane->normal) - plane->dist;
+	side = front < 0;
+	if ((back < 0) == side)
+		return R_RecursiveLightPoint (node->children[side], start, end, color);
+
+	frac = front / (front - back);
+	mid[0] = start[0] + (end[0] - start[0]) * frac;
+	mid[1] = start[1] + (end[1] - start[1]) * frac;
+	mid[2] = start[2] + (end[2] - start[2]) * frac;
+
+	// go down front side
+	if (R_RecursiveLightPoint (node->children[side], start, mid, color))
+		return true;
+	if ((back < 0) == side)
+		return false;		// didn't hit anuthing
+
+	// check for impact on this node
+	surf = r_worldmodel->surfaces + node->firstsurface;
+	for (i = 0; i < node->numsurfaces; i++, surf++)
+	{
+		tex = surf->texinfo;
+		if (tex->flags & (SURF_WARP | SURF_SKY) || !surf->gx)
+			continue;	// no lightmaps
+		ds = DotProduct (mid, tex->vecs[0]) + tex->vecs[0][3];
+		dt = DotProduct (mid, tex->vecs[1]) + tex->vecs[1][3];
+		if (ds < surf->texturemins[0] || dt < surf->texturemins[1])
+			continue;
+		if (ds - surf->texturemins[0] > surf->extents[0] || dt - surf->texturemins[1] > surf->extents[1])
+			continue;
+
+		// the vertex nearest to the point
+		best = 1e30f;
+		nearest = 0;
+		for (k = 0; k < surf->gx->numverts; k++)
+		{
+			pos = r_worldmodel->gxvertexes + GX_VERTS (surf->gx)[k] * 2;
+			v[0] = (short) (pos[0] & 0xffff) * (1.0f / VERTEX_SCALE);
+			v[1] = (short) (pos[0] >> 16) * (1.0f / VERTEX_SCALE);
+			v[2] = (short) (pos[1] & 0xffff) * (1.0f / VERTEX_SCALE);
+			s = DotProduct (v, tex->vecs[0]) + tex->vecs[0][3] - ds;
+			t = DotProduct (v, tex->vecs[1]) + tex->vecs[1][3] - dt;
+			d = s * s + t * t;
+			if (d < best)
+			{
+				best = d;
+				nearest = k;
+			}
+		}
+		R_SurfaceLight (r_worldmodel, surf, vlight, false);
+		for (k = 0; k < 3; k++)
+			color[k] = vlight[nearest][k] * (1.0f / 128);
+		return true;
+	}
+
+	// go down back side
+	return R_RecursiveLightPoint (node->children[!side], mid, end, color);
+}
+
+void R_LightPoint (vec3_t p, vec3_t color)
+{
+	vec3_t		end, dist;
+	dlight_t	*dl;
+	float		add;
+	int			lnum;
+
+	if (!r_worldmodel || !r_worldmodel->nodes || r_fullbright->value)
+	{
+		color[0] = color[1] = color[2] = 1.0f;
+		return;
+	}
+
+	end[0] = p[0];
+	end[1] = p[1];
+	end[2] = p[2] - 2048;
+	if (!R_RecursiveLightPoint (r_worldmodel->nodes, p, end, color))
+		VectorClear (color);
+
+	// add dynamic lights
+	for (lnum = 0, dl = r_newrefdef.dlights; lnum < r_newrefdef.num_dlights; lnum++, dl++)
+	{
+		VectorSubtract (p, dl->origin, dist);
+		add = (dl->intensity - VectorLength (dist)) * (1.0f / 256);
+		if (add > 0)
+			VectorMA (color, add, dl->color, color);
+	}
+}
+
+/*
+===============================================================================
+
+SURFACES
+
+===============================================================================
+*/
+
+/*
+===============
+R_TextureAnimation
+
+Returns the proper texture for a given time and base texture
+===============
+*/
+static image_t *R_TextureAnimation (mtexinfo_t *tex)
+{
+	int	c;
+
+	if (!tex->next)
+		return tex->image;
+	c = currententity->frame % tex->numframes;
+	while (c)
+	{
+		tex = tex->next;
+		c--;
+	}
+	return tex->image;
+}
+
+// The polygon of a surface as a quad strip zig-zagging across it: 1 0, 2 n-1,
+// 3 n-2, ... with an odd number of vertices the last quad is a triangle
+HOT_CODE static void R_EmitSurface (model_t *mod, gxsurf_t *gx, u16 *color, unsigned *st)
+{
+	int				i, j, n = gx->numverts;
+	unsigned short	*verts = GX_VERTS (gx);
+
+#define EMIT(v) \
+	GFX_COLOR = color[v]; \
+	GFX_TEX_COORD = st[v]; \
+	GFX_VERTEX16 = mod->gxvertexes[verts[v] * 2]; \
+	GFX_VERTEX16 = mod->gxvertexes[verts[v] * 2 + 1];
+
+	GFX_BEGIN = GL_QUAD_STRIP;
+	for (i = 1, j = 0; ; )
+	{
+		EMIT (i);
+		EMIT (j);
+		i++;
+		j = j ? j - 1 : n - 1;
+		if (i > j)
+			break;
+		if (i == j)
+		{
+			EMIT (i);
+			EMIT (i);
+			break;
+		}
+	}
+#undef EMIT
+
+	c_brush_polys += (n - 1) / 2;
+}
+
+static void R_DrawSurface (model_t *mod, msurface_t *surf)
+{
+	u16	color[MAX_SURFVERTS];
+
+	R_EmitSurface (mod, surf->gx, R_SurfaceColors (mod, surf, color), surf->gx->st);
+}
+
+// Binds the texture of a surface, liquids and flowing surfaces move theirs
+static void R_BindSurfaceTexture (image_t *image, msurface_t *surf)
+{
+	float	flow;
+
+	R_BindImage (image);
+	if (!(surf->texinfo->flags & (SURF_FLOWING | SURF_WARP)))
+		return;
+	// the time wraps at whole repeats of the texture before the fixed
+	// point overflows, in the surfaces' 1/8 texels
+	MATRIX_CONTROL = GL_TEXTURE;
+	if (surf->texinfo->flags & SURF_FLOWING)
+	{
+		flow = fmodf (r_newrefdef.time * 0.5f, 1) * 64;
+		MATRIX_TRANSLATE = F32 (-flow * 8);
+		MATRIX_TRANSLATE = 0;
+	}
+	else
+	{
+		flow = fmodf (r_newrefdef.time, 64);
+		MATRIX_TRANSLATE = F32 (flow * 8);
+		MATRIX_TRANSLATE = F32 (flow * 4);
+	}
+	MATRIX_TRANSLATE = 0;
+	MATRIX_CONTROL = GL_MODELVIEW;
+}
+
+static void R_AlphaFormat (msurface_t *surf, int id)
+{
+	int	alpha = surf->texinfo->flags & SURF_TRANS33 ? 10 : surf->texinfo->flags & SURF_TRANS66 ? 20 : 31;
+
+	GFX_POLY_FORMAT = POLY_ALPHA (alpha) | POLY_CULL_NONE | POLY_ID (id);
+}
+
+/*
+================
+R_DrawAlphaSurfaces
+
+The translucent surfaces of the world and brush models, after everything
+else, in world coordinates
+================
+*/
+void R_DrawAlphaSurfaces (void)
+{
+	msurface_t	*s;
+	model_t		*mod = r_worldmodel;
+	int			id = POLYID_ALPHA;
+
+	currententity = NULL;
+	for (s = r_alpha_surfaces; s; s = s->texturechain)
+	{
+		R_AlphaFormat (s, id);
+		id = id == 62 ? POLYID_ALPHA : id + 1;	// overlapping ones blend
+		R_BindSurfaceTexture (s->texinfo->image, s);
+		R_DrawSurface (mod, s);
+	}
+	r_alpha_surfaces = NULL;
+	GFX_POLY_FORMAT = POLY_ALPHA (31) | POLY_CULL_NONE;
+}
+
+/*
+===============================================================================
+
+BRUSH MODELS
+
+===============================================================================
+*/
+
+qboolean R_CullBox (vec3_t mins, vec3_t maxs)
+{
+	int	i;
+
+	for (i = 0; i < 4; i++)
+		if (BoxOnPlaneSide (mins, maxs, &frustum[i]) == 2)
+			return true;
+	return false;
+}
+
+// Model to world matrix, for brush models in their scaled vertex units. The
+// "stupid quake bug" flips the pitch of brush models
+static void R_EntityMatrix (entity_t *e, float m[4][3])
+{
+	vec3_t	angles, forward, right, up;
+	int		i;
+
+	angles[0] = -e->angles[0];
+	angles[1] = e->angles[1];
+	angles[2] = e->angles[2];
+	AngleVectors (angles, forward, right, up);
+	for (i = 0; i < 3; i++)
+	{
+		m[0][i] = forward[i];
+		m[1][i] = -right[i];
+		m[2][i] = up[i];
+		m[3][i] = e->origin[i] * MATRIX_SCALE_W;
+	}
+}
+
+void R_DrawBrushModel (entity_t *e)
+{
+	int			i;
+	vec3_t		mins, maxs, modelorg, temp, angles, forward, right, up;
+	msurface_t	*psurf;
+	float		dot, m[4][3];
+	model_t		*clmodel = e->model;
+	qboolean	rotated;
+	image_t		*image, *bound;
+
+	if (clmodel->nummodelsurfaces == 0)
+		return;
+
+	rotated = e->angles[0] || e->angles[1] || e->angles[2];
+	if (rotated)
+	{
+		for (i = 0; i < 3; i++)
+		{
+			mins[i] = e->origin[i] - clmodel->radius;
+			maxs[i] = e->origin[i] + clmodel->radius;
+		}
+	}
+	else
+	{
+		VectorAdd (e->origin, clmodel->mins, mins);
+		VectorAdd (e->origin, clmodel->maxs, maxs);
+	}
+	if (R_CullBox (mins, maxs))
+		return;
+
+	VectorSubtract (r_newrefdef.vieworg, e->origin, modelorg);
+	if (rotated)
+	{
+		VectorCopy (modelorg, temp);
+		VectorSet (angles, -e->angles[0], e->angles[1], e->angles[2]);
+		AngleVectors (angles, forward, right, up);
+		modelorg[0] = DotProduct (temp, forward);
+		modelorg[1] = -DotProduct (temp, right);
+		modelorg[2] = DotProduct (temp, up);
+	}
+
+	MATRIX_PUSH = 0;
+	R_EntityMatrix (e, m);
+	R_LoadMatrix (m, true);
+
+	psurf = &clmodel->surfaces[clmodel->firstmodelsurface];
+	for (i = 0, bound = NULL; i < clmodel->nummodelsurfaces; i++, psurf++)
+	{
+		if (!psurf->gx || psurf->texinfo->flags & SURF_NODRAW)
+			continue;
+		dot = DotProduct (modelorg, psurf->plane->normal) - psurf->plane->dist;
+		if (!((psurf->flags & SURF_PLANEBACK) ? dot < BACKFACE_DIST : dot > -BACKFACE_DIST))
+			continue;
+		// translucent ones by themselves, in the model's place
+		if (psurf->texinfo->flags & (SURF_TRANS33 | SURF_TRANS66))
+		{
+			R_AlphaFormat (psurf, POLYID_ALPHA - 1);
+			R_BindSurfaceTexture (psurf->texinfo->image, psurf);
+			R_DrawSurface (clmodel, psurf);
+			GFX_POLY_FORMAT = POLY_ALPHA (31) | POLY_CULL_NONE;
+			bound = NULL;
+			continue;
+		}
+		// the texture only when it changes, liquids move theirs
+		image = R_TextureAnimation (psurf->texinfo);
+		if (image != bound || (psurf->texinfo->flags & (SURF_FLOWING | SURF_WARP)))
+			R_BindSurfaceTexture (image, psurf);
+		bound = image;
+		R_DrawSurface (clmodel, psurf);
+	}
+
+	MATRIX_POP = 1;
+}
+
+/*
+===============================================================================
+
+WORLD MODEL
+
+===============================================================================
+*/
+
+/*
+===============
+R_MarkLeaves
+
+Mark the leaves and nodes that are in the PVS for the current cluster
+===============
+*/
+void R_MarkLeaves (void)
+{
+	byte	*vis, fatvis[MAX_MAP_LEAFS/8];
+	mnode_t	*node;
+	mleaf_t	*leaf;
+	int		i, c, cluster;
+
+	if (r_oldviewcluster == r_viewcluster && r_oldviewcluster2 == r_viewcluster2 && !r_novis->value
+		&& r_viewcluster != -1)
+		return;
+
+	r_visframecount++;
+	r_oldviewcluster = r_viewcluster;
+	r_oldviewcluster2 = r_viewcluster2;
+
+	if (r_novis->value || r_viewcluster == -1 || !CM_NumClusters ())
+	{
+		// mark everything
+		for (i = 0; i < r_worldmodel->numleafs; i++)
+			r_worldmodel->leafs[i].visframe = r_visframecount;
+		for (i = 0; i < r_worldmodel->numnodes; i++)
+			r_worldmodel->nodes[i].visframe = r_visframecount;
+		return;
+	}
+
+	// the PVS of the collision map, which has the same clusters
+	vis = CM_ClusterPVS (r_viewcluster);
+	// may have to combine two clusters because of solid water boundaries
+	if (r_viewcluster2 != r_viewcluster)
+	{
+		c = (CM_NumClusters () + 31) / 32;
+		memcpy (fatvis, vis, c * 4);
+		vis = CM_ClusterPVS (r_viewcluster2);
+		for (i = 0; i < c; i++)
+			((int *)fatvis)[i] |= ((int *)vis)[i];
+		vis = fatvis;
+	}
+
+	for (i = 0, leaf = r_worldmodel->leafs; i < r_worldmodel->numleafs; i++, leaf++)
+	{
+		cluster = leaf->cluster;
+		if (cluster == -1 || !(vis[cluster >> 3] & (1 << (cluster & 7))))
+			continue;
+		node = (mnode_t *)leaf;
+		do
+		{
+			if (node->visframe == r_visframecount)
+				break;
+			node->visframe = r_visframecount;
+			node = node->parent;
+		} while (node);
+	}
+}
+
+/*
+================
+R_CullNode
+
+Frustum test of a node's bounding box in fixed point. Returns the planes its
+children still need testing against, as a node inside a plane is too, or -1
+when it's outside.
+================
+*/
+HOT_CODE static int R_CullNode (mnode_t *node, int clipflags)
+{
+	int		i, *f;
+	short	*mins = node->minmaxs, *maxs = node->minmaxs + 3;
+
+	for (i = 0, f = frustum_i[0]; i < 4; i++, f += 4)
+	{
+		if (!(clipflags & (1 << i)))
+			continue;
+		// the corner furthest along the normal is outside, the whole box is
+		if ((f[0] >= 0 ? maxs[0] : mins[0]) * f[0] + (f[1] >= 0 ? maxs[1] : mins[1]) * f[1] +
+			(f[2] >= 0 ? maxs[2] : mins[2]) * f[2] < f[3])
+			return -1;
+		// the nearest corner is inside, the whole box is
+		if ((f[0] >= 0 ? mins[0] : maxs[0]) * f[0] + (f[1] >= 0 ? mins[1] : maxs[1]) * f[1] +
+			(f[2] >= 0 ? mins[2] : maxs[2]) * f[2] >= f[3])
+			clipflags &= ~(1 << i);
+	}
+	return clipflags;
+}
+
+HOT_CODE static void R_RecursiveWorldNode (mnode_t *node, int clipflags)
+{
+	int			c, dot, front, back;
+	mplane_t	*plane;
+	msurface_t	*surf, **mark;
+	mleaf_t		*pleaf;
+	image_t		*image;
+
+	if (node->contents == CONTENTS_SOLID)
+		return;		// solid
+	if (node->visframe != r_visframecount)
+		return;
+	if (clipflags && (clipflags = R_CullNode (node, clipflags)) < 0)
+		return;
+
+	// if a leaf node, draw stuff
+	if (node->contents != -1)
+	{
+		pleaf = (mleaf_t *)node;
+
+		// check for door connected areas
+		if (r_newrefdef.areabits && !(r_newrefdef.areabits[pleaf->area >> 3] & (1 << (pleaf->area & 7))))
+			return;		// not visible
+
+		mark = pleaf->firstmarksurface;
+		for (c = pleaf->nummarksurfaces; c; c--, mark++)
+			(*mark)->visframe = r_framecount;
+		return;
+	}
+
+	// node is just a decision point, so go down both sides
+	R_RecursiveWorldNode (node->children[0], clipflags);
+	R_RecursiveWorldNode (node->children[1], clipflags);
+
+	// add the surfaces facing us to their texture chain, after the leaves
+	// below marked them: one in reach of BACKFACE_DIST has them on the other
+	// side
+	c = node->numsurfaces;
+	if (!c)
+		return;
+	plane = node->plane;
+	dot = plane->inormal[0] * modelorg_i[0] + plane->inormal[1] * modelorg_i[1] +
+		plane->inormal[2] * modelorg_i[2] - plane->idist;
+	front = dot > -BACKFACE_DIST_I;
+	back = dot < BACKFACE_DIST_I;
+	surf = r_worldmodel->surfaces + node->firstsurface;
+	for ( ; c; c--, surf++)
+	{
+		if (surf->visframe != r_framecount)
+			continue;
+		if (!((surf->flags & SURF_PLANEBACK) ? back : front))
+			continue;		// wrong side
+		if (surf->flags & SURF_DRAWSKY)
+		{
+			r_sky_visible = true;
+			continue;
+		}
+		if (surf->texinfo->flags & SURF_NODRAW)
+			continue;
+		R_MapSeen (surf - r_worldmodel->surfaces);
+		if (surf->texinfo->flags & (SURF_TRANS33 | SURF_TRANS66))
+		{
+			surf->texturechain = r_alpha_surfaces;
+			r_alpha_surfaces = surf;
+			continue;
+		}
+		image = R_TextureAnimation (surf->texinfo);
+		surf->texturechain = image->texturechain;
+		image->texturechain = surf;
+	}
+}
+
+/*
+=============
+R_DrawWorld
+
+The world's surfaces chained by texture, the sky box first behind them when
+any sky shows
+=============
+*/
+void R_DrawWorld (void)
+{
+	entity_t	ent;
+	image_t		*image;
+	msurface_t	*s;
+	int			i;
+
+	if (!r_drawworld->value || r_newrefdef.rdflags & RDF_NOWORLDMODEL)
+		return;
+
+	memset (&ent, 0, sizeof(ent));
+	ent.frame = (int)(r_newrefdef.time * 2);
+	currententity = &ent;
+
+	for (i = 0; i < r_numimages; i++)
+		r_images[i].texturechain = NULL;
+	r_sky_visible = false;
+	R_RecursiveWorldNode (r_worldmodel->nodes, 15);
+
+	for (i = 0, image = r_images; i < r_numimages; i++, image++)
+	{
+		if (!image->texturechain)
+			continue;
+		for (s = image->texturechain; s; s = s->texturechain)
+		{
+			if (s == image->texturechain || s->texinfo->flags & (SURF_FLOWING | SURF_WARP))
+				R_BindSurfaceTexture (image, s);
+			R_DrawSurface (r_worldmodel, s);
+		}
+		image->texturechain = NULL;
+	}
+	if (r_sky_visible)
+		R_DrawSky ();
+	currententity = NULL;
+}
