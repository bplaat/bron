+// r_map.c -- the map of the touch screen
+//
+// A line for each wall of the world seen from above, the bottom edge of
+// sloped ones, made when the map loads, in the far heap. A wall shows on
+// the map once the world drew it.
+
+#include "r_local.h"
+
+#include <malloc.h>
+
+// The map: world units per 2D pixel, the eye at its center, facing up
+#define	MAP_SCALE		10
+#define	MAP_EYE			22		// from the feet to the eye
+#define	MAP_BODY		56		// the player's height
+#define	MAP_LEVELS		96		// walls this far above or below are shown dimmer
+
+typedef struct mapline_s
+{
+	short	x1, y1, x2, y2;
+	short	zmin, zmax;
+	unsigned short	surf;
+	unsigned short	pad;
+} mapline_t;
+
+static mapline_t	*maplines;
+static int			nummaplines;
+static byte			*mapseen;		// a byte for each surface, in main RAM
+static int			mapsurfaces;
+
+// The position of a packed vertex in world units
+static void R_MapVertex (model_t *mod, int v, int *pos)
+{
+	pos[0] = (short) (mod->gxvertexes[v * 2] & 0xffff) / VERTEX_SCALE;
+	pos[1] = (short) (mod->gxvertexes[v * 2] >> 16) / VERTEX_SCALE;
+	pos[2] = (short) (mod->gxvertexes[v * 2 + 1] & 0xffff) / VERTEX_SCALE;
+}
+
+/*
+================
+R_BuildMap
+
+Makes a line of the map for each wall of the world: its extent along the
+wall seen from above and its height. Seen from above a sloped one, like the
+vaults of a ceiling, is its bottom edge, its corners would make a line
+across the room.
+================
+*/
+void R_BuildMap (model_t *mod)
+{
+	msurface_t	*surf;
+	mapline_t	line;
+	unsigned short	*verts;
+	float		*normal;
+	int			i, j, pos[3], vmin[3], vmax[3], t, tmin, tmax, bottom;
+
+	R_FreeMap ();
+	mapsurfaces = mod->numsurfaces;
+	mapseen = malloc (mapsurfaces);
+	maplines = far_malloc (mapsurfaces * sizeof(mapline_t));
+	if (!mapseen || !maplines)
+	{
+		R_FreeMap ();
+		return;
+	}
+	memset (mapseen, 0, mapsurfaces);
+
+	for (i = 0, surf = mod->surfaces; i < mod->numsurfaces; i++, surf++)
+	{
+		if (!surf->gx || (surf->flags & (SURF_DRAWSKY | SURF_DRAWTURB))
+			|| (surf->texinfo->flags & SURF_NODRAW) || fabsf (surf->plane->normal[2]) >= 0.7f)
+			continue;
+		normal = surf->plane->normal;
+		verts = GX_VERTS (surf->gx);
+		line.zmin = 32767;
+		line.zmax = -32768;
+		for (j = 0; j < surf->gx->numverts; j++)
+		{
+			R_MapVertex (mod, verts[j], pos);
+			line.zmin = MIN (line.zmin, pos[2]);
+			line.zmax = MAX (line.zmax, pos[2]);
+		}
+		bottom = fabsf (normal[2]) < 0.01f ? 32767 : line.zmin + 1;
+		tmin = 0x7fffffff;
+		tmax = -0x7fffffff;
+		for (j = 0; j < surf->gx->numverts; j++)
+		{
+			R_MapVertex (mod, verts[j], pos);
+			if (pos[2] > bottom)
+				continue;
+			// along the wall, seen from above
+			t = pos[1] * normal[0] - pos[0] * normal[1];
+			if (t < tmin)
+			{
+				tmin = t;
+				VectorCopy (pos, vmin);
+			}
+			if (t > tmax)
+			{
+				tmax = t;
+				VectorCopy (pos, vmax);
+			}
+		}
+		if (tmax - tmin < 1)
+			continue;
+		line.x1 = vmin[0];
+		line.y1 = vmin[1];
+		line.x2 = vmax[0];
+		line.y2 = vmax[1];
+		line.surf = i;
+		line.pad = 0;
+		// a struct copy, the far heap ignores byte writes
+		maplines[nummaplines++] = line;
+	}
+}
+
+void R_FreeMap (void)
+{
+	free (maplines);
+	free (mapseen);
+	maplines = NULL;
+	mapseen = NULL;
+	nummaplines = 0;
+	mapsurfaces = 0;
+}
+
+// The world drew a surface, its wall shows on the map
+void R_MapSeen (int surf)
+{
+	if (surf < mapsurfaces)
+		mapseen[surf] = 1;
+}
+
+// Region codes for clipping lines to the map
+static inline int R_MapOutcode (int x, int y, int top, int bottom)
+{
+	return (x < 0) | ((x >= VID_WIDTH) << 1) | ((y < top) << 2) | ((y >= bottom) << 3);
+}
+
+// Draws a line clipped to the rows from top to bottom of the touch screen
+HOT_CODE static void R_MapLine (int x1, int y1, int x2, int y2, int top, int bottom, int color)
+{
+	int		c1, c2, c, x, y, dx, dy, sx, sy, err, e2;
+	byte	*dest;
+
+	c1 = R_MapOutcode (x1, y1, top, bottom);
+	c2 = R_MapOutcode (x2, y2, top, bottom);
+	while (c1 | c2)
+	{
+		if (c1 & c2)
+			return;
+		c = c1 ? c1 : c2;
+		if (c & 1)
+		{
+			y = y1 + (y2 - y1) * (0 - x1) / (x2 - x1);
+			x = 0;
+		}
+		else if (c & 2)
+		{
+			y = y1 + (y2 - y1) * (VID_WIDTH - 1 - x1) / (x2 - x1);
+			x = VID_WIDTH - 1;
+		}
+		else if (c & 4)
+		{
+			x = x1 + (x2 - x1) * (top - y1) / (y2 - y1);
+			y = top;
+		}
+		else
+		{
+			x = x1 + (x2 - x1) * (bottom - 1 - y1) / (y2 - y1);
+			y = bottom - 1;
+		}
+		if (c == c1)
+		{
+			x1 = x;
+			y1 = y;
+			c1 = R_MapOutcode (x1, y1, top, bottom);
+		}
+		else
+		{
+			x2 = x;
+			y2 = y;
+			c2 = R_MapOutcode (x2, y2, top, bottom);
+		}
+	}
+
+	dx = abs (x2 - x1);
+	dy = -abs (y2 - y1);
+	sx = x1 < x2 ? 1 : -1;
+	sy = y1 < y2 ? 1 : -1;
+	err = dx + dy;
+	dest = vid_buffer + y1 * VID_WIDTH + x1;
+	for (;;)
+	{
+		*dest = color;
+		if (x1 == x2 && y1 == y2)
+			break;
+		e2 = 2 * err;
+		if (e2 >= dy)
+		{
+			err += dy;
+			x1 += sx;
+			dest += sx;
+		}
+		if (e2 <= dx)
+		{
+			err += dx;
+			y1 += sy;
+			dest += sy * VID_WIDTH;
+		}
+	}
+}
+
+/*
+================
+R_DrawMap
+
+The walls seen around the eye at origin, turned so it looks up, in the rows
+from top to bottom of the touch screen, the ones at its height in color,
+the others in dimcolor, the eye at cx, cy
+================
+*/
+HOT_CODE void R_DrawMap (int top, int bottom, int cx, int cy, vec3_t origin, float yaw, int color, int dimcolor)
+{
+	mapline_t	*line, *end;
+	int			ox, oy, feet, c, s, range, x1, y1, x2, y2, rx1, ry1, rx2, ry2;
+	float		angle;
+
+	VID_MarkRows (top, bottom - top);
+	if (!maplines)
+		return;
+	ox = origin[0];
+	oy = origin[1];
+	feet = origin[2] - MAP_EYE;
+	angle = yaw * (M_PI / 180);
+	// 1/65536 of a 2D pixel per world unit
+	c = cosf (angle) * 65536 / MAP_SCALE;
+	s = sinf (angle) * 65536 / MAP_SCALE;
+	range = MAP_SCALE * MAX (VID_WIDTH, bottom - top);
+
+	for (line = maplines, end = line + nummaplines; line < end; line++)
+	{
+		if (!mapseen[line->surf])
+			continue;
+		if (line->zmin >= feet + MAP_BODY + MAP_LEVELS || line->zmax <= feet - MAP_LEVELS)
+			continue;
+		x1 = line->x1 - ox;
+		y1 = line->y1 - oy;
+		x2 = line->x2 - ox;
+		y2 = line->y2 - oy;
+		if ((x1 < -range && x2 < -range) || (x1 > range && x2 > range)
+			|| (y1 < -range && y2 < -range) || (y1 > range && y2 > range))
+			continue;
+		// right is forward turned clockwise, the screen's y goes down
+		rx1 = (x1 * s - y1 * c) >> 16;
+		ry1 = (x1 * c + y1 * s) >> 16;
+		rx2 = (x2 * s - y2 * c) >> 16;
+		ry2 = (x2 * c + y2 * s) >> 16;
+		R_MapLine (cx + rx1, cy - ry1, cx + rx2, cy - ry2, top, bottom,
+			line->zmin < feet + MAP_BODY && line->zmax > feet ? color : dimcolor);
+	}
+}
