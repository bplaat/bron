+/*
+===============================================================================
+
+TEXTURES
+
+===============================================================================
+*/
+
+// Nearest power of two up to max, where the sizes in between round down
+static int R_TexSize (int size, int max)
+{
+	int	p;
+
+	for (p = 8; p < max && p * 3 / 2 < size; p <<= 1)
+		;
+	return p;
+}
+
+static int R_Log2 (int n)
+{
+	int	i;
+
+	for (i = 0; (1 << i) < n; i++)
+		;
+	return i;
+}
+
+static void R_MapTextures (qboolean cpu)
+{
+	if (tex_mapped == cpu)
+		return;
+	tex_mapped = cpu;
+	if (cpu)
+	{
+		vramSetBankA (VRAM_A_LCD);
+		vramSetBankB (VRAM_B_LCD);
+		vramSetBankD (VRAM_D_LCD);
+	}
+	else
+	{
+		vramSetBankA (VRAM_A_TEXTURE_SLOT0);
+		vramSetBankB (VRAM_B_TEXTURE_SLOT1);
+		vramSetBankD (VRAM_D_TEXTURE_SLOT2);
+	}
+}
+
+// Address of texture memory while it's mapped for the CPU, A and B follow
+// each other in the LCD mapping, D doesn't
+static u16 *R_TexVRAM (int offset)
+{
+	return offset < 0x40000 ? VRAM_A + offset / 2 : VRAM_D + (offset - 0x40000) / 2;
+}
+
+/*
+================
+R_UploadTexture
+
+Resamples a width x height 8-bit image with the given row stride to w x h in
+VRAM at tex_next, returns the texture parameters, 0 when VRAM is full. With
+transparent set the index 255 becomes the hardware's transparent 0.
+================
+*/
+static unsigned R_UploadTexture (const byte *pixels, int stride, int width, int height,
+	int w, int h, qboolean transparent)
+{
+	int			x, y, offset, u, ustep;
+	const byte	*row;
+	byte		p[2];
+	u16			*dst;
+
+	offset = tex_next;
+	// a texture doesn't cross from bank B to D, D isn't after it for the CPU
+	if (offset < 0x40000 && offset + w * h > 0x40000)
+		offset = 0x40000;
+	if (offset + w * h > tex_end)
+		return 0;
+	tex_next = offset + w * h;
+
+	// in 16.16 fixed point, the middles of the texels
+	ustep = (width << 16) / w;
+	R_MapTextures (true);
+	dst = R_TexVRAM (offset);
+	for (y = 0; y < h; y++)
+	{
+		row = pixels + ((2 * y + 1) * height / (2 * h)) * stride;
+		for (x = 0, u = ustep / 2; x < w; x += 2, u += 2 * ustep)
+		{
+			p[0] = row[u >> 16];
+			p[1] = row[(u + ustep) >> 16];
+			if (transparent)
+			{
+				p[0] = p[0] == 255 ? 0 : p[0];
+				p[1] = p[1] == 255 ? 0 : p[1];
+			}
+			*dst++ = p[0] | (p[1] << 8);
+		}
+	}
+
+	return (offset >> 3) | GL_TEXTURE_WRAP_S | GL_TEXTURE_WRAP_T |
+		((R_Log2 (w) - 3) << 20) | ((R_Log2 (h) - 3) << 23) | (GL_RGB256 << 26) |
+		(transparent ? GL_TEXTURE_COLOR0_TRANSPARENT : 0) | TEXGEN_TEXCOORD;
+}
+
+// The size in VRAM of an image at its planned size
+static int R_ImageTexSize (image_t *image)
+{
+	int	w = image->width, h = image->height;
+
+	if (image->type == it_wall)
+		return R_TexSize (w >> image->mip, MAX_TEXSIZE) * R_TexSize (h >> image->mip, MAX_TEXSIZE);
+	return R_TexSize (w, image->maxsize) * R_TexSize (h, image->maxsize);
+}
+
+// Halves an image in VRAM, false when it can't get smaller
+static qboolean R_ShrinkImage (image_t *image)
+{
+	if (image->type == it_wall)
+	{
+		if (image->mip == MIPLEVELS - 1)
+			return false;
+		image->mip++;
+		return true;
+	}
+	if (image->maxsize <= 8)
+		return false;
+	image->maxsize >>= 1;
+	return true;
+}
+
+static void R_UploadImage (image_t *image)
+{
+	byte		*pixels;
+	miptex_t	mt;
+	FILE		*f;
+	int			w, h, gw, gh, base;
+
+	image->param = 0;
+	if (image->type == it_wall)
+	{
+		// a mip level of the file, resampled to a power of two, a few
+		// textures like 96x32 aren't
+		if (FS_FOpenFile (image->name, &f) < 0)
+			return;
+		base = ftell (f);
+		FS_Read (&mt, sizeof(mt), f);
+		w = MAX (image->width >> image->mip, 1);
+		h = MAX (image->height >> image->mip, 1);
+		gw = R_TexSize (w, MAX_TEXSIZE);
+		gh = R_TexSize (h, MAX_TEXSIZE);
+		pixels = far_malloc (w * h);
+		if (!pixels)
+			ri.Sys_Error (ERR_FATAL, "R_UploadImage: not enough memory for %s", image->name);
+		fseek (f, base + LittleLong (mt.offsets[image->mip]), SEEK_SET);
+		FS_Read (pixels, w * h, f);
+		FS_FCloseFile (f);
+		image->param = R_UploadTexture (pixels, w, w, h, gw, gh, false);
+		free (pixels);
+		// the surfaces' texture coordinates are in 1/8 texels, the hardware
+		// takes 1/16
+		image->scale[0] = (2 * gw << 12) / image->width;
+		image->scale[1] = (2 * gh << 12) / image->height;
+		return;
+	}
+
+	pixels = R_LoadPCX (image->name, &w, &h, NULL);
+	if (!pixels)
+		return;
+	gw = R_TexSize (w, image->maxsize);
+	gh = R_TexSize (h, image->maxsize);
+	image->param = R_UploadTexture (pixels, w, w, h, gw, gh, image->type == it_sprite);
+	free (pixels);
+	// texture coordinates are in 1/16 texels of the file's picture
+	image->scale[0] = (gw << 12) / w;
+	image->scale[1] = (gh << 12) / h;
+}
+
+/*
+================
+R_UploadTextures
+
+Called at the end of the registration of a map: plans the sizes of the
+registered textures, halving the largest until they all fit, then reads
+them from their files into VRAM
+================
+*/
+static int R_CompareTexSize (const void *a, const void *b)
+{
+	return R_ImageTexSize (*(image_t **)b) - R_ImageTexSize (*(image_t **)a);
+}
+
+void R_UploadTextures (void)
+{
+	static image_t	*upload[MAX_RIMAGES];
+	image_t	*image, *largest;
+	int		i, n, total;
+
+	for (i = 0, image = r_images; i < r_numimages; i++, image++)
+	{
+		if (!image->registration_sequence || image->type == it_pic || image == r_notexture)
+			continue;
+		image->mip = 0;
+		image->maxsize = image->type == it_wall ? MAX_TEXSIZE : image->type == it_sky ? MAX_SKYSIZE : MAX_SKINSIZE;
+		// walls at most MAX_TEXSIZE
+		while (image->type == it_wall && image->mip < MIPLEVELS - 1
+			&& MAX (image->width, image->height) >> image->mip > MAX_TEXSIZE)
+			image->mip++;
+	}
+
+	for (;;)
+	{
+		total = 0;
+		largest = NULL;
+		for (i = 0, image = r_images; i < r_numimages; i++, image++)
+		{
+			if (!image->registration_sequence || image->type == it_pic || image == r_notexture)
+				continue;
+			total += R_ImageTexSize (image);
+			if (!largest || R_ImageTexSize (image) > R_ImageTexSize (largest))
+				largest = image;
+		}
+		// some room left for the textures registered later
+		if (total <= TEXMEM_NOTEXTURE - 16 * 1024 || !largest || !R_ShrinkImage (largest))
+			break;
+	}
+
+	// the largest first: their sizes are powers of two, so each starts at
+	// a multiple of its size and none crosses from bank B to bank D
+	for (i = 0, n = 0, image = r_images; i < r_numimages; i++, image++)
+		if (image->registration_sequence && image->type != it_pic && image != r_notexture)
+			upload[n++] = image;
+	qsort (upload, n, sizeof(upload[0]), R_CompareTexSize);
+	tex_next = 0;
+	for (i = 0; i < n; i++)
+		R_UploadImage (upload[i]);
+	R_MapTextures (false);
+}
+
+// The checkerboard for missing textures, at the end of VRAM
+static void R_InitNoTexture (void)
+{
+	byte	pixels[16 * 16];
+	int		x, y;
+
+	r_notexture = &r_images[r_numimages++];
+	strcpy (r_notexture->name, "***r_notexture***");
+	r_notexture->type = it_wall;
+	r_notexture->width = r_notexture->height = 16;
+	r_notexture->registration_sequence = -1;	// never freed
+	R_HashImages ();
+	for (y = 0; y < 16; y++)
+		for (x = 0; x < 16; x++)
+			pixels[y * 16 + x] = (x < 8) ^ (y < 8) ? 0 : 15;
+	tex_next = TEXMEM_NOTEXTURE;
+	r_notexture->param = R_UploadTexture (pixels, 16, 16, 16, 16, 16, false);
+	tex_end = TEXMEM_NOTEXTURE;
+	r_notexture->scale[0] = r_notexture->scale[1] = 2 << 12;
+	R_MapTextures (false);
+}
+
+/*
+================
+R_BindImage
+
+The texture of an image, with the texture matrix scaling its texture
+coordinates to the size in VRAM, the checkerboard while it isn't there
+================
+*/
+void R_BindImage (image_t *image)
+{
+	if (!image || !image->param)
+		image = r_notexture;
+	R_BindTexture (image->param, image->scale);
+}
+
+/*
+===============================================================================
+
+REGISTRATION
+
+===============================================================================
+*/
+
+static int R_ImageHash (const char *name)
+{
+	unsigned	h = 0;
+
+	while (*name)
+		h = h * 31 + *name++;
+	return h & (IMAGE_HASH - 1);
+}
+
+static void R_HashImages (void)
+{
+	int		i, h;
+	image_t	*image;
+
+	memset (image_hash, 0, sizeof(image_hash));
+	for (i = 0, image = r_images; i < r_numimages; i++, image++)
+		if (image->registration_sequence)
+		{
+			h = R_ImageHash (image->name);
+			image->hashnext = image_hash[h];
+			image_hash[h] = image;
+		}
+}
+
+/*
+===============
+R_FindImage
+
+Finds or registers an image, textures are uploaded when the registration
+ends, or right away after it at a small size
+===============
+*/
+image_t *R_FindImage (char *name, imagetype_t type)
+{
+	image_t		*image;
+	miptex_t	mt;
+	int			i, len, w, h;
+
+	if (!name)
+		return NULL;
+	len = strlen (name);
+	if (len < 5 || len >= MAX_QPATH)
+		return NULL;
+
+	for (image = image_hash[R_ImageHash (name)]; image; image = image->hashnext)
+		if (!strcmp (name, image->name))
+		{
+			if (image->registration_sequence > 0)
+				image->registration_sequence = registration_sequence;
+			return image;
+		}
+
+	if (!strcmp (name + len - 4, ".wal"))
+	{
+		if (!R_WALHeader (name, &mt))
+			return NULL;
+		w = LittleLong (mt.width);
+		h = LittleLong (mt.height);
+	}
+	else if (!strcmp (name + len - 4, ".pcx"))
+	{
+		if (!R_PCXSize (name, &w, &h))
+			return NULL;
+	}
+	else
+		return NULL;
+
+	for (i = 0, image = r_images; i < r_numimages; i++, image++)
+		if (!image->registration_sequence)
+			break;
+	if (i == r_numimages)
+	{
+		if (r_numimages == MAX_RIMAGES)
+			ri.Sys_Error (ERR_DROP, "MAX_RIMAGES");
+		r_numimages++;
+	}
+	memset (image, 0, sizeof(*image));
+	strcpy (image->name, name);
+	image->type = type;
+	image->width = w;
+	image->height = h;
+	image->registration_sequence = registration_sequence;
+
+	if (type == it_pic)
+	{
+		image->pixels = R_LoadPCX (name, &w, &h, NULL);
+		if (!image->pixels)
+		{
+			image->registration_sequence = 0;
+			return NULL;
+		}
+	}
+	else if (!r_registering)
+	{
+		// after the registration, small enough for what is left
+		image->mip = MIPLEVELS - 1;
+		image->maxsize = 32;
+		R_UploadImage (image);
+		R_MapTextures (false);
+	}
+	i = R_ImageHash (name);
+	image->hashnext = image_hash[i];
+	image_hash[i] = image;
+	return image;
+}
+
+image_t *R_RegisterSkin (char *name)
+{
+	return R_FindImage (name, it_skin);
+}
+
+/*
+================
+R_FreeUnusedImages
+
+Any image that was not touched on this registration sequence will be freed,
+the pics stay
+================
+*/
+void R_FreeUnusedImages (void)
+{
+	int		i;
+	image_t	*image;
+
+	for (i = 0, image = r_images; i < r_numimages; i++, image++)
+	{
+		if (image->registration_sequence == registration_sequence || image->registration_sequence <= 0)
+			continue;
+		if (image->type == it_pic)
+			continue;
+		memset (image, 0, sizeof(*image));
+	}
+	R_HashImages ();
+}
+
+/*
+===============================================================================
+
+SKY
+
+===============================================================================
+*/
+
+static char		*suf[6] = {"rt", "bk", "lf", "ft", "up", "dn"};
+static int		skytexorder[6] = {0, 2, 1, 3, 4, 5};
+static image_t	*sky_images[6];
+static float	skyrotate;
+static vec3_t	skyaxis;
+
+// 1 = s, 2 = t, 3 = the distance
+static int	st_to_vec[6][3] =
+{
+	{3,-1,2},
+	{-3,1,2},
+	{1,3,2},
+	{-1,-3,2},
+	{-2,-1,3},		// 0 degrees yaw, look straight up
+	{2,-1,-3}		// look straight down
+};
+
+void R_SetSky (char *name, float rotate, vec3_t axis)
+{
+	char	pathname[MAX_QPATH];
+	int		i;
+
+	skyrotate = rotate;
+	VectorCopy (axis, skyaxis);
+	for (i = 0; i < 6; i++)
+	{
+		Com_sprintf (pathname, sizeof(pathname), "env/%s%s.pcx", name, suf[i]);
+		sky_images[i] = R_FindImage (pathname, it_sky);
+	}
+}
+
+static void R_SkyVertex (int s, int t, int axis, int size)
+{
+	int	b[3], v[3], j, k;
+
+	b[0] = s * size;
+	b[1] = t * size;
+	b[2] = size;
+	for (j = 0; j < 3; j++)
+	{
+		k = st_to_vec[axis][j];
+		v[j] = k < 0 ? -b[-k - 1] : b[k - 1];
+	}
+	// half a texel in from the edges, the texture repeats
+	GFX_TEX_COORD = TEXTURE_PACK (s < 0 ? 8 : 255 * 16 + 8, t > 0 ? 8 : 255 * 16 + 8);
+	GFX_VERTEX16 = VERTEX_PACK (v[0], v[1]);
+	GFX_VERTEX16 = v[2] & 0xffff;
+}
+
+/*
+================
+R_DrawSky
+
+The sky box around the eye, with the projection that puts it behind
+everything else
+================
+*/
+void R_DrawSky (void)
+{
+	int	i, size = 256 * VERTEX_SCALE;
+
+	R_SetSkyProjection (true);
+	MATRIX_PUSH = 0;
+	MATRIX_TRANSLATE = F32 (r_origin[0] * MATRIX_SCALE_W);
+	MATRIX_TRANSLATE = F32 (r_origin[1] * MATRIX_SCALE_W);
+	MATRIX_TRANSLATE = F32 (r_origin[2] * MATRIX_SCALE_W);
+	if (skyrotate)
+	{
+		float	m[4][3], a = r_newrefdef.time * skyrotate * (M_PI / 180), s = sinf (a), c = cosf (a);
+		float	x = skyaxis[0], y = skyaxis[1], z = skyaxis[2];
+
+		// the rotation around the sky's axis
+		m[0][0] = c + x * x * (1 - c);
+		m[0][1] = y * x * (1 - c) + z * s;
+		m[0][2] = z * x * (1 - c) - y * s;
+		m[1][0] = x * y * (1 - c) - z * s;
+		m[1][1] = c + y * y * (1 - c);
+		m[1][2] = z * y * (1 - c) + x * s;
+		m[2][0] = x * z * (1 - c) + y * s;
+		m[2][1] = y * z * (1 - c) - x * s;
+		m[2][2] = c + z * z * (1 - c);
+		m[3][0] = m[3][1] = m[3][2] = 0;
+		R_LoadMatrix (m, true);
+	}
+	GFX_COLOR = RGB15 (GX_NORMAL_LIGHT, GX_NORMAL_LIGHT, GX_NORMAL_LIGHT);
+	for (i = 0; i < 6; i++)
+	{
+		R_BindImage (sky_images[skytexorder[i]]);
+		GFX_BEGIN = GL_QUADS;
+		R_SkyVertex (-1, -1, i, size);
+		R_SkyVertex (-1, 1, i, size);
+		R_SkyVertex (1, 1, i, size);
+		R_SkyVertex (1, -1, i, size);
+	}
+	MATRIX_POP = 1;
+	R_SetSkyProjection (false);
+}
+
+/*
+===============================================================================
+
+INIT
+
+===============================================================================
+*/
+
+void R_InitImages (void)
+{
+	byte	pal[768], *pixels;
+	int		i, w, h, r, g, b;
+
+	registration_sequence = 1;
+	pixels = R_LoadPCX ("pics/colormap.pcx", &w, &h, pal);
+	if (!pixels)
+		ri.Sys_Error (ERR_FATAL, "Couldn't load pics/colormap.pcx");
+	free (pixels);
+	for (i = 0; i < 256; i++)
+	{
+		r = pal[i * 3];
+		g = pal[i * 3 + 1];
+		b = pal[i * 3 + 2];
+		d_8to24table[i] = r | (g << 8) | (b << 16) | (255u << 24);
+	}
+	d_8to24table[255] &= 0xffffff;	// 255 is transparent
+
+	vramSetBankA (VRAM_A_TEXTURE_SLOT0);
+	vramSetBankB (VRAM_B_TEXTURE_SLOT1);
+	vramSetBankD (VRAM_D_TEXTURE_SLOT2);
+	vramSetBankG (VRAM_G_TEX_PALETTE_SLOT0);
+	R_InitNoTexture ();
+	R_SetGamma (1);
+	irqSet (IRQ_VBLANK, R_VBlank);
+	irqEnable (IRQ_VBLANK);
+}
+
+void R_ShutdownImages (void)
+{
+	irqClear (IRQ_VBLANK);
+}
