+// r_image.c -- images and textures
+//
+// Pics stay in RAM for the 2D drawing. The textures of the walls, skins,
+// sprites and the sky go to VRAM banks A, B and D, 384 KiB, 8-bit with the
+// palette in the texture palette. They are only read from their files when
+// a map's registration ends, all at once: the largest is halved until they
+// all fit, walls take a smaller mip level of their file.
+
+#include "r_local.h"
+
+#include <malloc.h>
+
+// Texture VRAM, banks A, B and D, the checkerboard at the end
+#define	TEXMEM_SIZE			(384 * 1024)
+#define	TEXMEM_NOTEXTURE	(TEXMEM_SIZE - 256)
+
+#define	MAX_TEXSIZE			256
+#define	MAX_SKINSIZE		128
+#define	MAX_SKYSIZE			64
+
+#define	IMAGE_HASH	256
+
+image_t		r_images[MAX_RIMAGES];
+static image_t	*image_hash[IMAGE_HASH];	// the registered images by name, the 2D
+											// drawing looks up its pics every frame
+int			r_numimages;
+image_t		*r_notexture;
+int			registration_sequence;
+
+unsigned	d_8to24table[256];
+u16			d_8to16table[256];
+
+static void	R_HashImages (void);
+
+static int	tex_next;			// next free texture VRAM
+static int	tex_end = TEXMEM_SIZE;	// the end of the VRAM for textures
+static qboolean	tex_mapped;		// VRAM banks mapped for the CPU
+
+// The DS screens are darker than the CRTs Quake II was made for, the
+// brightness setting scales this
+#define	SCREEN_GAMMA	0.7f
+
+static byte		screengamma[256];
+static u16		texpalette[256] __attribute__((aligned(4)));	// twice as bright
+static u16		palette2d[256] __attribute__((aligned(4)));
+static volatile qboolean	palette_dirty;
+
+/*
+===============================================================================
+
+PALETTE
+
+===============================================================================
+*/
+
+// The palettes go to VRAM in the vertical blank, the 3D engine starts
+// drawing the next frame 22 lines into it
+static void R_VBlank (void)
+{
+	// A CPU copy, DMA would miss palette writes still in the data cache
+	if (palette_dirty)
+	{
+		vramSetBankG (VRAM_G_LCD);
+		memcpy (VRAM_G, texpalette, sizeof(texpalette));
+		vramSetBankG (VRAM_G_TEX_PALETTE_SLOT0);
+		VID_SetPalette2D (palette2d);
+		palette_dirty = false;
+	}
+	VID_VBlank2D ();
+}
+
+// The brightness, vid_gamma, 1 the normal one, lower is brighter
+void R_SetGamma (float gamma)
+{
+	int	i;
+
+	for (i = 0; i < 256; i++)
+		screengamma[i] = powf (i / 255.0f, SCREEN_GAMMA * gamma) * 255 + 0.5f;
+	R_SetPalette (NULL);
+}
+
+// The game palette (NULL) or that of a cinematic
+void R_SetPalette (const unsigned char *pal)
+{
+	int	i, r, g, b;
+
+	for (i = 0; i < 256; i++)
+	{
+		if (pal)
+		{
+			r = pal[i * 3];
+			g = pal[i * 3 + 1];
+			b = pal[i * 3 + 2];
+		}
+		else
+		{
+			r = d_8to24table[i] & 0xff;
+			g = (d_8to24table[i] >> 8) & 0xff;
+			b = (d_8to24table[i] >> 16) & 0xff;
+		}
+		r = screengamma[r];
+		g = screengamma[g];
+		b = screengamma[b];
+		palette2d[i] = RGB15 (r >> 3, g >> 3, b >> 3);
+		texpalette[i] = RGB15 (MIN (r >> 2, 31), MIN (g >> 2, 31), MIN (b >> 2, 31));
+		if (!pal)
+			d_8to16table[i] = palette2d[i];
+	}
+	// for R_VBlank, the compiler mustn't move the stores to them past this
+	__asm__ volatile ("" ::: "memory");
+	palette_dirty = true;
+}
+
+/*
+===============================================================================
+
+FILES
+
+===============================================================================
+*/
+
+/*
+==============
+R_LoadPCX
+
+The 8-bit pixels of a pcx file, malloced from the far heap, and its palette
+when palette isn't NULL. The rows are decoded in main RAM, the far heap of
+the Memory Expansion Pak ignores byte writes.
+==============
+*/
+byte *R_LoadPCX (char *name, int *width, int *height, byte *palette)
+{
+	byte	*raw, *data, *out, row[640];
+	pcx_t	*pcx;
+	FILE	*f;
+	int		x, y, len, w, h, dataByte, runLength;
+
+	// the file in the far heap while it's decoded
+	len = FS_FOpenFile (name, &f);
+	if (len < 0)
+		return NULL;
+	if (!(raw = far_malloc (len)))
+		ri.Sys_Error (ERR_FATAL, "R_LoadPCX: not enough memory for %s", name);
+	FS_Read (raw, len, f);
+	FS_FCloseFile (f);
+	pcx = (pcx_t *)raw;
+	w = LittleShort (pcx->xmax) + 1;
+	h = LittleShort (pcx->ymax) + 1;
+	if (pcx->manufacturer != 0x0a || pcx->version != 5 || pcx->encoding != 1
+		|| pcx->bits_per_pixel != 8 || w > 640 || h > 480)
+	{
+		ri.Con_Printf (PRINT_ALL, "Bad pcx file %s\n", name);
+		free (raw);
+		return NULL;
+	}
+	if (palette)
+		memcpy (palette, raw + len - 768, 768);
+
+	out = far_malloc (w * h);
+	if (!out)
+		ri.Sys_Error (ERR_FATAL, "R_LoadPCX: not enough memory for %s", name);
+	data = &pcx->data;
+	for (y = 0; y < h; y++)
+	{
+		for (x = 0; x < w; )
+		{
+			dataByte = *data++;
+			if ((dataByte & 0xC0) == 0xC0)
+			{
+				runLength = dataByte & 0x3F;
+				dataByte = *data++;
+			}
+			else
+				runLength = 1;
+			while (runLength-- > 0 && x < w)
+				row[x++] = dataByte;
+		}
+		memcpy (out + y * w, row, w);
+	}
+	free (raw);
+	*width = w;
+	*height = h;
+	return out;
+}
+
+// The size of a pcx file from its header, without reading the pixels
+static qboolean R_PCXSize (char *name, int *width, int *height)
+{
+	FILE	*f;
+	pcx_t	pcx;
+
+	if (FS_FOpenFile (name, &f) < 0)
+		return false;
+	FS_Read (&pcx, sizeof(pcx), f);
+	FS_FCloseFile (f);
+	*width = LittleShort (pcx.xmax) + 1;
+	*height = LittleShort (pcx.ymax) + 1;
+	return true;
+}
+
+// The header of a wal file
+static qboolean R_WALHeader (char *name, miptex_t *mt)
+{
+	FILE	*f;
+
+	if (FS_FOpenFile (name, &f) < 0)
+		return false;
+	FS_Read (mt, sizeof(*mt), f);
+	FS_FCloseFile (f);
+	return true;
+}
