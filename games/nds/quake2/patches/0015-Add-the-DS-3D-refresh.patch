+// r_main.c -- the Nintendo DS refresh: the view, entities and particles
+
+#include "r_local.h"
+
+// The depth buffer holds w, the distance, to at least a 4096th of the
+// largest one of a polygon. The world's projection scales w to 3 times the
+// gun's per world unit, so the gun stays in front of walls, the sky's to
+// 15 times the world's, so it's behind it
+#define	VIEWMODEL_UNITS		16
+#define	WORLD_W_SCALE		(VIEWMODEL_UNITS * 3)
+#define	SKY_W_SCALE			(WORLD_W_SCALE * 15)
+
+// w of the rectangles drawn on the screen, in front of the near planes
+#define	SCREEN_W			128
+
+// The near plane is close, swimming the eye gets close to the surface of
+// the water. The gun keeps 4 units
+#define	NEAR_PLANE			(1.0f / 512)
+#define	VIEWMODEL_NEAR		(4.0f / 512)
+#define	FAR_PLANE			(8192.0f / 512)
+
+// A frame takes at most 2048 polygons and 6144 vertices, the particles get
+// what is left, keeping some for the screen rectangles drawn after them and
+// the commands still waiting in the FIFO
+#define	GX_POLYGONS			2048
+#define	GX_VERTICES			6144
+#define	GX_RESERVE			64
+#define	MAX_PARTICLES_DRAWN	512
+
+refimport_t	ri;
+
+refdef_t	r_newrefdef;
+int			r_framecount = 1;	// so frame counts initialized to 0 don't match
+vec3_t		r_origin, vpn, vright, vup;
+int			modelorg_i[3];		// r_origin * 8
+cplane_t	frustum[4];
+int			frustum_i[4][4];	// normal * 16384, dist * 16384 in world units
+entity_t	*currententity;
+qboolean	r_registering;
+
+cvar_t		*r_fullbright;
+cvar_t		*r_drawentities;
+cvar_t		*r_drawworld;
+cvar_t		*r_novis;
+static cvar_t	*r_lightlevel;		// for the server to know the player's light
+cvar_t		*r_lefthand;
+static cvar_t	*r_speeds;
+static cvar_t	*crosshair;
+static cvar_t	*vid_gamma;
+
+/*
+===============================================================================
+
+MATRICES
+
+===============================================================================
+*/
+
+// F32 rounded to nearest, for translations, the error of F32 would be up to
+// 1/8 of a world unit
+static inline int R_RoundF32 (float x)
+{
+	x *= 4096;
+	return x < 0 ? (int) (x - 0.5f) : (int) (x + 0.5f);
+}
+
+void R_LoadMatrix (float m[4][3], qboolean multiply)
+{
+	int	i, j;
+
+	for (i = 0; i < 4; i++)
+		for (j = 0; j < 3; j++)
+		{
+			if (multiply)
+				MATRIX_MULT4x3 = i < 3 ? F32 (m[i][j]) : R_RoundF32 (m[i][j]);
+			else
+				MATRIX_LOAD4x3 = i < 3 ? F32 (m[i][j]) : R_RoundF32 (m[i][j]);
+		}
+}
+
+void R_BindTexture (unsigned param, const int *scale)
+{
+	GFX_TEX_FORMAT = param;
+	MATRIX_CONTROL = GL_TEXTURE;
+	MATRIX_IDENTITY = 0;
+	MATRIX_SCALE = scale[0];
+	MATRIX_SCALE = scale[1];
+	MATRIX_SCALE = 1 << 12;
+	MATRIX_CONTROL = GL_MODELVIEW;
+}
+
+/*
+================
+R_SetProjection
+
+The perspective, a transposed OpenGL matrix times scale, for eye space in
+units / 512 world units and the near plane at near
+================
+*/
+static void R_SetProjection (float scale, float units, float near)
+{
+	static float	fov_y = -1, f;
+	float			a, b;
+
+	if (r_newrefdef.fov_y != fov_y)
+	{
+		fov_y = r_newrefdef.fov_y;
+		f = 1 / tanf (fov_y * (M_PI / 360));
+	}
+	a = (FAR_PLANE + near) / (near - FAR_PLANE);
+	b = 2 * FAR_PLANE * near / (near - FAR_PLANE) * units;
+	MATRIX_CONTROL = GL_PROJECTION;
+	MATRIX_LOAD4x4 = F32 (f * 192 / 256 * scale);
+	MATRIX_LOAD4x4 = 0;
+	MATRIX_LOAD4x4 = 0;
+	MATRIX_LOAD4x4 = 0;
+	MATRIX_LOAD4x4 = 0;
+	MATRIX_LOAD4x4 = F32 (f * scale);
+	MATRIX_LOAD4x4 = 0;
+	MATRIX_LOAD4x4 = 0;
+	MATRIX_LOAD4x4 = 0;
+	MATRIX_LOAD4x4 = 0;
+	MATRIX_LOAD4x4 = F32 (a * scale);
+	MATRIX_LOAD4x4 = F32 (-scale);
+	MATRIX_LOAD4x4 = 0;
+	MATRIX_LOAD4x4 = 0;
+	MATRIX_LOAD4x4 = F32 (b * scale);
+	MATRIX_LOAD4x4 = 0;
+	MATRIX_CONTROL = GL_MODELVIEW;
+}
+
+// The gun's projection, in its finer units, or back to the world's
+void R_SetViewModelProjection (qboolean viewmodel)
+{
+	if (viewmodel)
+		R_SetProjection (1, VIEWMODEL_UNITS, VIEWMODEL_NEAR);
+	else
+		R_SetProjection (WORLD_W_SCALE, 1, NEAR_PLANE);
+}
+
+// The sky's projection behind the world, or back to the world's
+void R_SetSkyProjection (qboolean sky)
+{
+	R_SetProjection (sky ? SKY_W_SCALE : WORLD_W_SCALE, 1, NEAR_PLANE);
+}
+
+/*
+===============================================================================
+
+SPRITES, BEAMS AND PARTICLES
+
+===============================================================================
+*/
+
+static void R_SpriteVertex (vec3_t org, vec3_t up, float u, vec3_t right, float r, int s, int t)
+{
+	int	x, y, z;
+
+	x = (org[0] + up[0] * u + right[0] * r) * VERTEX_SCALE;
+	y = (org[1] + up[1] * u + right[1] * r) * VERTEX_SCALE;
+	z = (org[2] + up[2] * u + right[2] * r) * VERTEX_SCALE;
+	GFX_TEX_COORD = TEXTURE_PACK (s, t);
+	GFX_VERTEX16 = VERTEX_PACK (x, y);
+	GFX_VERTEX16 = z & 0xffff;
+}
+
+static void R_DrawSpriteModel (entity_t *e)
+{
+	msprite_t		*psprite = e->model->sprite;
+	mspriteframe_t	*frame;
+	int				alpha, w, h;
+
+	frame = &psprite->frames[e->frame % psprite->numframes];
+	alpha = e->flags & RF_TRANSLUCENT ? CLAMP (1, (int) (e->alpha * 31), 31) : 31;
+	R_BindImage (frame->image);
+	GFX_POLY_FORMAT = POLY_ALPHA (alpha) | POLY_CULL_NONE | POLY_ID (alpha < 31 ? 5 : 0);
+	GFX_COLOR = RGB15 (GX_NORMAL_LIGHT, GX_NORMAL_LIGHT, GX_NORMAL_LIGHT);
+	w = frame->width << 4;
+	h = frame->height << 4;
+	GFX_BEGIN = GL_QUADS;
+	R_SpriteVertex (e->origin, vup, -frame->origin_y, vright, -frame->origin_x, 0, h);
+	R_SpriteVertex (e->origin, vup, frame->height - frame->origin_y, vright, -frame->origin_x, 0, 0);
+	R_SpriteVertex (e->origin, vup, frame->height - frame->origin_y, vright, frame->width - frame->origin_x, w, 0);
+	R_SpriteVertex (e->origin, vup, -frame->origin_y, vright, frame->width - frame->origin_x, w, h);
+	GFX_POLY_FORMAT = POLY_ALPHA (31) | POLY_CULL_NONE;
+}
+
+/*
+================
+R_DrawBeam
+
+A laser as a flat strip of its width facing the eye, in its palette color
+================
+*/
+static void R_DrawBeam (entity_t *e)
+{
+	vec3_t	dir, side, toeye, p;
+	float	len, w = e->frame * 0.5f;
+	int		i, alpha = CLAMP (1, (int) (e->alpha * 31), 31);
+
+	VectorSubtract (e->oldorigin, e->origin, dir);
+	VectorSubtract (e->origin, r_origin, toeye);
+	CrossProduct (dir, toeye, side);
+	len = VectorLength (side);
+	if (len < 0.001f)
+		return;
+	VectorScale (side, w / len, side);
+
+	GFX_TEX_FORMAT = 0;
+	GFX_POLY_FORMAT = POLY_ALPHA (alpha) | POLY_CULL_NONE | POLY_ID (6);
+	GFX_COLOR = d_8to16table[e->skinnum & 0xff];
+	GFX_BEGIN = GL_QUADS;
+	for (i = 0; i < 4; i++)
+	{
+		VectorMA (i == 0 || i == 3 ? e->origin : e->oldorigin, i < 2 ? 1 : -1, side, p);
+		GFX_VERTEX16 = VERTEX_PACK ((int) (p[0] * VERTEX_SCALE), (int) (p[1] * VERTEX_SCALE));
+		GFX_VERTEX16 = (int) (p[2] * VERTEX_SCALE) & 0xffff;
+	}
+	GFX_POLY_FORMAT = POLY_ALPHA (31) | POLY_CULL_NONE;
+}
+
+/*
+================
+R_DrawParticles
+
+Small triangles facing the eye, in four steps of translucency
+================
+*/
+HOT_CODE static void R_DrawParticles (void)
+{
+	static const int	levels[4] = {31, 23, 15, 8};
+	int			i, level, x, y, z, ux, uy, uz, rx, ry, rz, depth, scale, n, alpha;
+	int			pvpn[3], pup[3], pright[3];
+	particle_t	*p;
+
+	n = MIN (MAX_PARTICLES_DRAWN, MIN (GX_POLYGONS - GFX_POLYGON_RAM_USAGE,
+		(GX_VERTICES - GFX_VERTEX_RAM_USAGE) / 3) - GX_RESERVE);
+	for (i = 0; i < 3; i++)
+	{
+		pvpn[i] = vpn[i] * 16384;
+		pup[i] = vup[i] * 16384;
+		pright[i] = vright[i] * 16384;
+	}
+	GFX_TEX_FORMAT = 0;
+	for (level = 0; level < 4; level++)
+	{
+		GFX_POLY_FORMAT = POLY_ALPHA (levels[level]) | POLY_CULL_NONE | POLY_ID (level ? 7 : 0);
+		GFX_BEGIN = GL_TRIANGLES;
+		for (i = 0, p = r_newrefdef.particles; i < r_newrefdef.num_particles; i++, p++)
+		{
+			alpha = p->alpha * 4;
+			if (3 - CLAMP (0, alpha, 3) != level || n <= 0)
+				continue;
+
+			x = p->origin[0] * VERTEX_SCALE;
+			y = p->origin[1] * VERTEX_SCALE;
+			z = p->origin[2] * VERTEX_SCALE;
+
+			// a scale up keeps them from disapearing: 1.5 units and 0.004 per
+			// unit of distance, in 1/8 units. The ones closer than 8 units
+			// are left out, close to the eye they would cover the screen.
+			depth = ((x - modelorg_i[0]) * pvpn[0] + (y - modelorg_i[1]) * pvpn[1] +
+				(z - modelorg_i[2]) * pvpn[2]) >> 14;
+			if (depth < 8 * VERTEX_SCALE)
+				continue;
+			scale = depth < 20 * VERTEX_SCALE ? 12 : 12 + ((depth * 262) >> 16);
+			if (scale > depth >> 5)
+				scale = depth >> 5;
+			ux = (pup[0] * scale) >> 14;
+			uy = (pup[1] * scale) >> 14;
+			uz = (pup[2] * scale) >> 14;
+			rx = (pright[0] * scale) >> 14;
+			ry = (pright[1] * scale) >> 14;
+			rz = (pright[2] * scale) >> 14;
+
+			GFX_COLOR = d_8to16table[p->color & 255];
+			GFX_VERTEX16 = VERTEX_PACK (x, y);
+			GFX_VERTEX16 = z & 0xffff;
+			GFX_VERTEX16 = VERTEX_PACK (x + ux, y + uy);
+			GFX_VERTEX16 = (z + uz) & 0xffff;
+			GFX_VERTEX16 = VERTEX_PACK (x + rx, y + ry);
+			GFX_VERTEX16 = (z + rz) & 0xffff;
+			n--;
+		}
+	}
+	GFX_POLY_FORMAT = POLY_ALPHA (31) | POLY_CULL_NONE;
+}
+
+/*
+===============================================================================
+
+ENTITIES
+
+===============================================================================
+*/
+
+static void R_DrawEntity (entity_t *e)
+{
+	currententity = e;
+	if (e->flags & RF_BEAM)
+	{
+		R_DrawBeam (e);
+		return;
+	}
+	if (!e->model)
+		return;
+	switch (e->model->type)
+	{
+	case mod_alias:
+		R_DrawAliasModel (e);
+		break;
+	case mod_brush:
+		R_DrawBrushModel (e);
+		break;
+	case mod_sprite:
+		R_DrawSpriteModel (e);
+		break;
+	default:
+		break;
+	}
+}
+
+// The opaque entities, then the translucent ones over them, the gun last
+static void R_DrawEntitiesOnList (void)
+{
+	int			i, pass;
+	entity_t	*e;
+
+	if (!r_drawentities->value)
+		return;
+	for (pass = 0; pass < 2; pass++)
+		for (i = 0, e = r_newrefdef.entities; i < r_newrefdef.num_entities; i++, e++)
+			if (!(e->flags & RF_VIEWERMODEL) && !(e->flags & RF_WEAPONMODEL)
+				&& !!(e->flags & (RF_TRANSLUCENT | RF_BEAM)) == pass)
+				R_DrawEntity (e);
+	currententity = NULL;
+}
+
+static void R_DrawViewModels (void)
+{
+	int			i;
+	entity_t	*e;
+
+	if (!r_drawentities->value)
+		return;
+	for (i = 0, e = r_newrefdef.entities; i < r_newrefdef.num_entities; i++, e++)
+		if (e->flags & RF_WEAPONMODEL)
+			R_DrawEntity (e);
+	currententity = NULL;
+}
+
+/*
+===============================================================================
+
+FRAME
+
+===============================================================================
+*/
+
+static int SignbitsForPlane (cplane_t *out)
+{
+	int	bits, j;
+
+	// for fast box on planeside test
+	bits = 0;
+	for (j = 0; j < 3; j++)
+		if (out->normal[j] < 0)
+			bits |= 1 << j;
+	return bits;
+}
+
+static void R_SetFrustum (void)
+{
+	int		i, j;
+	float	a, sx, cx, sy, cy;
+
+	// the side planes lean in by half the field of view
+	a = r_newrefdef.fov_x * (M_PI / 360);
+	sx = sinf (a);
+	cx = cosf (a);
+	a = r_newrefdef.fov_y * (M_PI / 360);
+	sy = sinf (a);
+	cy = cosf (a);
+	for (j = 0; j < 3; j++)
+	{
+		frustum[0].normal[j] = vpn[j] * sx + vright[j] * cx;
+		frustum[1].normal[j] = vpn[j] * sx - vright[j] * cx;
+		frustum[2].normal[j] = vpn[j] * sy + vup[j] * cy;
+		frustum[3].normal[j] = vpn[j] * sy - vup[j] * cy;
+	}
+	for (i = 0; i < 4; i++)
+	{
+		frustum[i].type = PLANE_ANYZ;
+		frustum[i].dist = DotProduct (r_origin, frustum[i].normal);
+		frustum[i].signbits = SignbitsForPlane (&frustum[i]);
+		frustum_i[i][0] = frustum[i].normal[0] * 16384;
+		frustum_i[i][1] = frustum[i].normal[1] * 16384;
+		frustum_i[i][2] = frustum[i].normal[2] * 16384;
+		frustum_i[i][3] = frustum[i].dist * 16384;
+	}
+}
+
+static void R_SetupFrame (void)
+{
+	static float	fov_x = -1, fov_y;
+	float			m[4][3];
+	mleaf_t			*leaf;
+	vec3_t			temp;
+	int				i;
+
+	r_framecount++;
+
+	// the top screen is 4:3, whatever the 2D view rectangle
+	if (r_newrefdef.fov_x != fov_x)
+	{
+		fov_x = r_newrefdef.fov_x;
+		fov_y = atanf (tanf (fov_x * (M_PI / 360)) * 192 / 256) * (360 / M_PI);
+	}
+	r_newrefdef.fov_y = fov_y;
+
+	VectorCopy (r_newrefdef.vieworg, r_origin);
+	AngleVectors (r_newrefdef.viewangles, vpn, vright, vup);
+	for (i = 0; i < 3; i++)
+		modelorg_i[i] = r_origin[i] * VERTEX_SCALE;
+
+	// current viewcluster
+	if (!(r_newrefdef.rdflags & RDF_NOWORLDMODEL))
+	{
+		leaf = Mod_PointInLeaf (r_origin, r_worldmodel);
+		r_viewcluster = r_viewcluster2 = leaf->cluster;
+
+		// check above and below so crossing solid water doesn't draw wrong
+		VectorCopy (r_origin, temp);
+		temp[2] += leaf->contents ? 16 : -16;
+		leaf = Mod_PointInLeaf (temp, r_worldmodel);
+		if (!(leaf->contents & CONTENTS_SOLID) && leaf->cluster != r_viewcluster2)
+			r_viewcluster2 = leaf->cluster;
+	}
+
+	R_SetProjection (WORLD_W_SCALE, 1, NEAR_PLANE);
+
+	// world to eye space: x right, y up, looking down -z
+	MATRIX_CONTROL = GL_MODELVIEW;
+	for (i = 0; i < 3; i++)
+	{
+		m[i][0] = vright[i];
+		m[i][1] = vup[i];
+		m[i][2] = -vpn[i];
+	}
+	m[3][0] = -DotProduct (r_origin, vright) * MATRIX_SCALE_W;
+	m[3][1] = -DotProduct (r_origin, vup) * MATRIX_SCALE_W;
+	m[3][2] = DotProduct (r_origin, vpn) * MATRIX_SCALE_W;
+	R_LoadMatrix (m, false);
+
+	GFX_POLY_FORMAT = POLY_ALPHA (31) | POLY_CULL_NONE;
+	GFX_PAL_FORMAT = 0;
+
+	c_brush_polys = 0;
+	c_alias_polys = 0;
+}
+
+// Starts drawing rectangles on the screen, in front of everything
+static void R_BeginScreen (unsigned polyformat, u16 color)
+{
+	int	i;
+
+	// the identity, but with w SCREEN_W
+	MATRIX_CONTROL = GL_PROJECTION;
+	for (i = 0; i < 16; i++)
+		MATRIX_LOAD4x4 = i == 15 ? SCREEN_W : i % 5 ? 0 : 4096;
+	MATRIX_CONTROL = GL_MODELVIEW;
+	MATRIX_IDENTITY = 0;
+	GFX_TEX_FORMAT = 0;
+	GFX_POLY_FORMAT = polyformat;
+	GFX_COLOR = color;
+	GFX_BEGIN = GL_QUADS;
+}
+
+// A rectangle of whole pixels of the top screen, x and y the top left one
+static void R_ScreenRect (int x, int y, int w, int h)
+{
+	int	x1 = x * SCREEN_W / 128 - SCREEN_W, x2 = (x + w) * SCREEN_W / 128 - SCREEN_W;
+	int	y1 = SCREEN_W - (y * SCREEN_W + 95) / 96, y2 = SCREEN_W - ((y + h) * SCREEN_W + 95) / 96;
+
+	GFX_VERTEX16 = VERTEX_PACK (x1, y1);
+	GFX_VERTEX16 = 0;
+	GFX_VERTEX16 = VERTEX_PACK (x2, y1);
+	GFX_VERTEX16 = 0;
+	GFX_VERTEX16 = VERTEX_PACK (x2, y2);
+	GFX_VERTEX16 = 0;
+	GFX_VERTEX16 = VERTEX_PACK (x1, y2);
+	GFX_VERTEX16 = 0;
+}
+
+/*
+================
+R_DrawCrosshair
+
+A cross of 7 by 7 pixels around the pixel right below the middle of the
+view, in front of everything. It's translucent, though as good as opaque,
+the edge marking would outline it.
+================
+*/
+static void R_DrawCrosshair (void)
+{
+	if (!crosshair->value || r_newrefdef.rdflags & RDF_NOWORLDMODEL)
+		return;
+	R_BeginScreen (POLY_ALPHA (30) | POLY_CULL_NONE | POLY_ID (2), RGB15 (31, 31, 31));
+	R_ScreenRect (128 - 3, 96, 7, 1);
+	R_ScreenRect (128, 96 - 3, 1, 3);
+	R_ScreenRect (128, 96 + 1, 1, 3);
+}
+
+// The full screen blend of damage, pickups and liquids
+static void R_DrawBlend (void)
+{
+	float	*b = r_newrefdef.blend;
+
+	if (b[3] <= 0)
+		return;
+	R_BeginScreen (POLY_ALPHA (CLAMP (1, (int) (b[3] * 31), 30)) | POLY_CULL_NONE | POLY_ID (1),
+		RGB15 ((int) (b[0] * 31), (int) (b[1] * 31), (int) (b[2] * 31)));
+	R_ScreenRect (0, 0, 256, 192);
+}
+
+// The light at the eye, for the server to know how well monsters see the
+// player. R_LightPoint's 1.0 is a light map of 128, GL Quake II's 255.
+static void R_SetLightLevel (void)
+{
+	vec3_t	shadelight;
+
+	if (r_newrefdef.rdflags & RDF_NOWORLDMODEL)
+		return;
+	R_LightPoint (r_newrefdef.vieworg, shadelight);
+	r_lightlevel->value = 75 * MAX (shadelight[0], MAX (shadelight[1], shadelight[2]));
+}
+
+/*
+================
+R_RenderFrame
+
+r_newrefdef must be set before the first call
+================
+*/
+static void R_RenderFrame (refdef_t *fd)
+{
+	int	time1 = 0;
+
+	r_newrefdef = *fd;
+	if (!r_worldmodel && !(r_newrefdef.rdflags & RDF_NOWORLDMODEL))
+		ri.Sys_Error (ERR_DROP, "R_RenderView: NULL worldmodel");
+	if (r_speeds->value)
+		time1 = Sys_Milliseconds ();
+
+	R_SetupFrame ();
+	R_SetFrustum ();
+	if (!(r_newrefdef.rdflags & RDF_NOWORLDMODEL))
+	{
+		R_PushDlights ();
+		R_MarkLeaves ();
+	}
+	R_DrawWorld ();
+	R_DrawEntitiesOnList ();
+	R_DrawAlphaSurfaces ();
+	// the particles are left out first when a frame has too many polygons
+	R_DrawViewModels ();
+	R_DrawParticles ();
+	R_DrawCrosshair ();
+	R_DrawBlend ();
+	R_SetLightLevel ();
+
+	if (r_speeds->value)
+		ri.Con_Printf (PRINT_ALL, "%3i ms %4i wpoly %4i epoly\n", Sys_Milliseconds () - time1,
+			c_brush_polys, c_alias_polys);
+}
+
+static void R_BeginFrame (float camera_separation)
+{
+	if (vid_gamma->modified)
+	{
+		vid_gamma->modified = false;
+		R_SetGamma (CLAMP (0.5f, vid_gamma->value, 1.3f));
+	}
+}
+
+// Swaps the 3D buffers at the next vblank, the next 3D command waits for it.
+// The frame is depth tested on w. The view is dimmed behind the menu.
+static void R_EndFrame (void)
+{
+	if (VID_TopFaded ())
+	{
+		R_BeginScreen (POLY_ALPHA (16) | POLY_CULL_NONE | POLY_ID (1), RGB15 (0, 0, 0));
+		R_ScreenRect (0, 0, 256, 192);
+	}
+	GFX_FLUSH = 2;
+	VID_Update2D ();
+}
+
+/*
+===============================================================================
+
+INIT
+
+===============================================================================
+*/
+
+static qboolean R_Init (void *hinstance, void *wndproc)
+{
+	ri.Con_Printf (PRINT_ALL, "ref_nds version: "REF_VERSION"\n");
+
+	r_fullbright = ri.Cvar_Get ("r_fullbright", "0", 0);
+	r_drawentities = ri.Cvar_Get ("r_drawentities", "1", 0);
+	r_drawworld = ri.Cvar_Get ("r_drawworld", "1", 0);
+	r_novis = ri.Cvar_Get ("r_novis", "0", 0);
+	r_lightlevel = ri.Cvar_Get ("r_lightlevel", "0", 0);
+	r_lefthand = ri.Cvar_Get ("hand", "0", CVAR_USERINFO | CVAR_ARCHIVE);
+	r_speeds = ri.Cvar_Get ("r_speeds", "0", 0);
+	crosshair = ri.Cvar_Get ("crosshair", "0", CVAR_ARCHIVE);
+	vid_gamma = ri.Cvar_Get ("vid_gamma", "1", CVAR_ARCHIVE);
+	ri.Vid_NewWindow (VID_WIDTH, VID_HEIGHT);
+
+	// top screen: 3D, textures in banks A, B and D, palette in G, the 2D
+	// layers over it in banks E and F
+	videoSetMode (MODE_5_3D);
+	glInit ();
+	// Edge marking instead of antialiasing: with either the hardware fills
+	// the edges of the polygons, which it otherwise leaves gaps along, but
+	// antialiasing blends them with what is behind, the background where two
+	// polygons meet. All opaque polygons and the background have ID 0, so no
+	// edge is marked, not even at the border of the screen.
+	glEnable (GL_TEXTURE_2D | GL_OUTLINE | GL_BLEND);
+	glClearColor (0, 0, 0, 31);
+	glClearPolyID (0);
+	glClearDepth (GL_MAX_DEPTH);
+	glViewport (0, 0, 255, 191);
+	VID_InitTop ();
+
+	R_InitImages ();
+	R_InitModels ();
+	R_InitAlias ();
+	Draw_InitLocal ();
+	return true;
+}
+
+static void R_Shutdown (void)
+{
+	R_ShutdownModels ();
+	R_ShutdownImages ();
+}
+
+static void R_AppActivate (qboolean activate)
+{
+}
+
+refexport_t GetRefAPI (refimport_t rimp)
+{
+	refexport_t	re;
+
+	ri = rimp;
+	re.api_version = API_VERSION;
+	re.BeginRegistration = R_BeginRegistration;
+	re.RegisterModel = R_RegisterModel;
+	re.RegisterSkin = R_RegisterSkin;
+	re.RegisterPic = Draw_FindPic;
+	re.SetSky = R_SetSky;
+	re.EndRegistration = R_EndRegistration;
+	re.RenderFrame = R_RenderFrame;
+	re.DrawGetPicSize = Draw_GetPicSize;
+	re.DrawPic = Draw_Pic;
+	re.DrawStretchPic = Draw_StretchPic;
+	re.DrawChar = Draw_Char;
+	re.DrawTileClear = Draw_TileClear;
+	re.DrawFill = Draw_Fill;
+	re.DrawFadeScreen = Draw_FadeScreen;
+	re.DrawStretchRaw = Draw_StretchRaw;
+	re.Init = R_Init;
+	re.Shutdown = R_Shutdown;
+	re.CinematicSetPalette = R_SetPalette;
+	re.BeginFrame = R_BeginFrame;
+	re.EndFrame = R_EndFrame;
+	re.AppActivate = R_AppActivate;
+	return re;
+}
