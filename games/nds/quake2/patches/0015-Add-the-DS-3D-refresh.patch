+
+You should have received a copy of the GNU General Public License
+along with this program; if not, write to the Free Software
+Foundation, Inc., 59 Temple Place - Suite 330, Boston, MA  02111-1307, USA.
+
+*/
+// r_draw.c -- the 2D drawing on both screens
+//
+// Quake II's 2D drawing is 320x240. The touch screen shows a buffer of it in
+// main RAM, copied into an 8bpp bitmap background in VRAM bank C and scaled
+// to 256x192 by the affine background hardware. A second affine layer
+// samples it half a pixel further and is alpha blended on top, a cheap
+// hardware bilinear-like filter. What is drawn there stays until something
+// draws over it, only the rows that changed are copied. The touch screen
+// (hud_nds.c) keeps rows of it drawn and redraws them when something else
+// drew there (VID_BeginUI).
+//
+// The top screen shows the 3D view with two layers over it. The overlay is
+// for the menus, the help computer, the inventory, the loading plaque and
+// the pause: they draw into a second 320x240 buffer, which is cut into 8x8
+// tiles in VRAM bank E for the same affine layers as the touch screen,
+// scaled the same way, or at 1:1 for the 256x192 of the help computer and
+// the inventory. As tiles only the parts with something on them take VRAM.
+// The text layer has Quake II's font as tiles in bank F, at 1:1 over all of
+// it, for the messages and center prints.
+
+#include "r_local.h"
+
+#define	FB_STRIDE	512
+
+// Scale factors in 8.8 fixed point: 320 -> 256 and 240 -> 192
+#define	SCALE_X		((VID_WIDTH << 8) / 256)
+#define	SCALE_Y		((VID_HEIGHT << 8) / 192)
+
+#define	TRANSPARENT_COLOR	255
+
+// Bank E on the top screen: the overlay's tiles, its 64x64 map and the text
+// layer's 32x32 map, the font in bank F
+#define	OVERLAY_TILES		864			// 54 KiB, tile 0 stays empty
+#define	OVERLAY_MAP_BASE	27			// in 2 KiB
+#define	OVERLAY_COLS		(VID_WIDTH / 8)
+#define	OVERLAY_ROWS		(VID_HEIGHT / 8)
+#define	TEXT_MAP_BASE		31
+#define	TEXT_TILE_BASE		4			// in 16 KiB, bank F
+
+byte			vid_buffer[VID_WIDTH * VID_HEIGHT] __attribute__((aligned(32)));
+static byte		top_buffer[VID_WIDTH * VID_HEIGHT] __attribute__((aligned(32)));
+static byte		*draw_buffer = vid_buffer;	// where the 2D drawing goes
+static image_t	*draw_chars;
+static qboolean	touchscreen;				// the startup is over
+
+// Rows of the touch screen changed this frame, to copy to VRAM
+static byte		copyrows[VID_HEIGHT];
+
+// Rows the touch screen keeps drawn, it redraws them when something else
+// drew there
+static int		ui_top, ui_bottom;
+static qboolean	ui_drawing, ui_overdrawn;
+
+// Rows of the overlay drawn this frame and the last one
+static byte		toprows[VID_HEIGHT], lasttoprows[VID_HEIGHT];
+static qboolean	top_drawing, top_shown, top_fade;
+static byte		top_colors[256];	// Quake II's black is 255 there, 0 is transparent
+
+// The overlay's map and the next one, which VID_VBlank2D shows
+static u16		topmap[OVERLAY_ROWS][OVERLAY_COLS];
+static u16		nextmap[OVERLAY_ROWS][OVERLAY_COLS];
+static volatile qboolean	nextmap_ready;
+
+static u16		textmap[32 * 24] __attribute__((aligned(4)));
+static u16		shownmap[32 * 24] __attribute__((aligned(4)));
+static qboolean	font;
+
+void VID_MarkRows (int y, int height)
+{
+	int	bottom = MIN (y + height, VID_HEIGHT);
+
+	y = MAX (y, 0);
+	if (bottom <= y)
+		return;
+	if (top_drawing)
+	{
+		memset (toprows + y, 1, bottom - y);
+		return;
+	}
+	if (!ui_drawing && y < ui_bottom && bottom > ui_top)
+		ui_overdrawn = true;
+	memset (copyrows + y, 1, bottom - y);
+}
+
+/*
+================
+VID_BeginUI
+
+The touch screen keeps the rows from top to bottom drawn, returns whether
+something else drew there since the last time, then they need to be drawn
+again
+================
+*/
+qboolean VID_BeginUI (int top, int bottom)
+{
+	qboolean	overdrawn = ui_overdrawn;
+
+	ui_top = top;
+	ui_bottom = bottom;
+	ui_overdrawn = false;
+	ui_drawing = true;
+	return overdrawn;
+}
+
+void VID_EndUI (void)
+{
+	ui_drawing = false;
+}
+
+// The palette of both screens, from the vertical blank: Quake II's black is
+// 255 on the top screen
+void VID_SetPalette2D (const u16 *palette)
+{
+	memcpy (BG_PALETTE, palette, 256 * sizeof(u16));
+	BG_PALETTE[255] = palette[0];
+	if (touchscreen)
+		memcpy (BG_PALETTE_SUB, palette, 256 * sizeof(u16));
+}
+
+// The next map of the overlay, written while the screen isn't drawn
+void VID_VBlank2D (void)
+{
+	int	ty;
+
+	if (nextmap_ready)
+	{
+		for (ty = 0; ty < OVERLAY_ROWS; ty++)
+			memcpy ((u16 *) BG_MAP_RAM (OVERLAY_MAP_BASE) + ty * 64, nextmap[ty], sizeof(nextmap[ty]));
+		memcpy (topmap, nextmap, sizeof(topmap));
+		nextmap_ready = false;
+	}
+	// Writing the reference point of an affine layer while the screen is
+	// drawn restarts its picture from that line
+	bgUpdate ();
+}
+
+/*
+================
+VID_InitTop
+
+Called by R_Init: the 3D view with the overlay and the text layer over it,
+both empty
+================
+*/
+void VID_InitTop (void)
+{
+	int	bg, i;
+
+	for (i = 0; i < 256; i++)
+		top_colors[i] = i;
+	top_colors[0] = TRANSPARENT_COLOR;
+	top_colors[TRANSPARENT_COLOR] = 0;
+
+	vramSetBankE (VRAM_E_MAIN_BG);
+	vramSetBankF (VRAM_F_MAIN_BG_0x06010000);
+	memset (BG_GFX, 0, 80 * 1024);
+	REG_BG0CNT = BG_PRIORITY (3);
+	REG_BG1CNT = BG_32x32 | BG_COLOR_256 | BG_MAP_BASE (TEXT_MAP_BASE) | BG_TILE_BASE (TEXT_TILE_BASE)
+		| BG_PRIORITY (0);
+	for (i = 0; i < 32 * 24; i++)
+		textmap[i] = shownmap[i] = ' ';
+	memcpy (BG_MAP_RAM (TEXT_MAP_BASE), textmap, sizeof(textmap));
+	for (bg = 2; bg <= 3; bg++)
+		bgSetPriority (bgInit (bg, BgType_ExRotation, BgSize_ER_512x512, OVERLAY_MAP_BASE, 0), bg == 2 ? 1 : 2);
+	memset (top_buffer, TRANSPARENT_COLOR, sizeof(top_buffer));
+	REG_DISPCNT = MODE_5_3D | DISPLAY_BG0_ACTIVE | DISPLAY_BG1_ACTIVE;
+}
+
+// The 256 characters of Quake II's font as 8x8 tiles, 0 is transparent
+static void VID_UploadFont (void)
+{
+	u16		tile[32];
+	byte	*src;
+	int		num, y, x;
+
+	for (num = 0; num < 256; num++)
+	{
+		src = draw_chars->pixels + (num >> 4) * 8 * 128 + (num & 15) * 8;
+		for (y = 0; y < 8; y++, src += 128)
+			for (x = 0; x < 8; x += 2)
+				tile[y * 4 + x / 2] = top_colors[src[x]] | top_colors[src[x + 1]] << 8;
+		memcpy ((byte *) BG_TILE_RAM (TEXT_TILE_BASE) + num * sizeof(tile), tile, sizeof(tile));
+	}
+	font = true;
+}
+
+/*
+================
+VID_TextChar
+
+A character of the text layer, in its 32x24 columns and rows of the top
+screen, shown until VID_UpdateText
+================
+*/
+void VID_TextChar (int col, int row, int num)
+{
+	if (col >= 0 && col < 32 && row >= 0 && row < 24)
+		textmap[row * 32 + col] = num & 255;
+}
+
+void VID_TextString (int col, int row, const char *str, int mask)
+{
+	for (; *str; str++, col++)
+		VID_TextChar (col, row, *str ^ mask);
+}
+
+// Shows the text drawn this frame, the next frame draws it again
+static void VID_UpdateText (void)
+{
+	int	i;
+
+	if (!font && draw_chars)
+		VID_UploadFont ();
+	if (memcmp (shownmap, textmap, sizeof(textmap)))
+	{
+		memcpy (BG_MAP_RAM (TEXT_MAP_BASE), textmap, sizeof(textmap));
+		memcpy (shownmap, textmap, sizeof(textmap));
+	}
+	for (i = 0; i < 32 * 24; i++)
+		textmap[i] = ' ';
+}
+
+/*
+================
+VID_BeginTop
+
+The 2D drawing goes to the overlay of the top screen until VID_EndTop, on
+a transparent background
+================
+*/
+void VID_BeginTop (void)
+{
+	draw_buffer = top_buffer;
+	top_drawing = true;
+	top_fade = false;
+}
+
+// Only threads wait for the vertical blank, not ARM code
+static void VID_WaitForTopMap (void)
+{
+	while (nextmap_ready)
+		threadWaitForVBlank ();
+}
+
+/*
+================
+VID_CutTiles
+
+Cuts the overlay from tile column x0, row y0 on into the tiles of the top
+screen, the tiles with nothing on them are tile 0. A tile keeps its slot in
+VRAM while it shows the same picture, a changed one goes to a slot the
+shown map doesn't use and the new map is shown at the next vblank, so the
+screen never shows a tile while it's written.
+================
+*/
+__attribute__((target("arm")))
+static void VID_CutTiles (int x0, int y0, int cols, int rows)
+{
+	static u32	tilehash[OVERLAY_TILES];
+	static byte	used[OVERLAY_TILES];
+	u16		*tiles = (u16 *) BG_TILE_RAM (0);
+	byte	*row;
+	u32		*p, all, hash;
+	int		tx, ty, x, y, slot, free = 1;
+
+	memset (used, 0, sizeof(used));
+	for (ty = 0; ty < OVERLAY_ROWS; ty++)
+		for (tx = 0; tx < OVERLAY_COLS; tx++)
+			used[topmap[ty][tx]] = true;
+
+	for (ty = 0; ty < OVERLAY_ROWS; ty++)
+	{
+		row = top_buffer + ty * 8 * VID_WIDTH;
+		for (tx = 0; tx < OVERLAY_COLS; tx++)
+		{
+			all = 0xffffffff;
+			hash = 0;
+			if (tx >= x0 && tx < x0 + cols && ty >= y0 && ty < y0 + rows)
+				for (y = 0; y < 8; y++)
+				{
+					p = (u32 *) (row + y * VID_WIDTH + tx * 8);
+					all &= p[0] & p[1];
+					hash = (hash * 0x9e3779b1 + p[0]) * 0x9e3779b1 + p[1];
+				}
+			slot = topmap[ty][tx];
+			if (all == 0xffffffff)
+				slot = 0;
+			else if (!slot || tilehash[slot] != hash)
+			{
+				// a changed tile goes to a free slot, without one it's empty
+				while (free < OVERLAY_TILES && used[free])
+					free++;
+				slot = free < OVERLAY_TILES ? free : 0;
+				if (slot)
+				{
+					used[slot] = true;
+					tilehash[slot] = hash;
+					for (y = 0; y < 8; y++)
+						for (x = 0; x < 8; x += 2)
+							tiles[slot * 32 + y * 4 + x / 2] = top_colors[row[y * VID_WIDTH + tx * 8 + x]]
+								| (top_colors[row[y * VID_WIDTH + tx * 8 + x + 1]] << 8);
+				}
+			}
+			nextmap[ty][tx] = slot;
+		}
+	}
+}
+
+/*
+================
+VID_EndTop
+
+Shows what was drawn on the overlay since VID_BeginTop, scaled to the top
+screen, or a 256x192 part of it from x, y at 1:1 when full is false. The
+drawn rows are cleared for the next time.
+================
+*/
+void VID_EndTop (qboolean full, int x, int y)
+{
+	qboolean	drawn = false, shown;
+	int			i, bg;
+
+	draw_buffer = vid_buffer;
+	top_drawing = false;
+	for (i = 0; i < VID_HEIGHT; i++)
+		if (toprows[i] || lasttoprows[i])
+			drawn = true;
+	if (!drawn)
+		return;
+
+	VID_WaitForTopMap ();
+	if (full)
+		VID_CutTiles (0, 0, OVERLAY_COLS, OVERLAY_ROWS);
+	else
+		VID_CutTiles (x / 8, y / 8, 32, 24);
+	// for VID_VBlank2D, the compiler mustn't move the stores to the map after this
+	__asm__ volatile ("" ::: "memory");
+	nextmap_ready = true;
+
+	// the blend layer samples half an output pixel further, not at 1:1
+	for (bg = 2; bg <= 3; bg++)
+	{
+		bgSetScale (bg, full ? SCALE_X : 256, full ? SCALE_Y : 256);
+		bgSetScroll (bg, full ? 0 : x, full ? 0 : y);
+		if (bg == 2)
+			bgSetScrollf (bg, full ? SCALE_X / 2 : x << 8, full ? SCALE_Y / 2 : y << 8);
+	}
+	shown = false;
+	for (i = 0; i < VID_HEIGHT; i++)
+	{
+		if (toprows[i])
+		{
+			memset (top_buffer + i * VID_WIDTH, TRANSPARENT_COLOR, VID_WIDTH);
+			shown = true;
+		}
+	}
+	memcpy (lasttoprows, toprows, sizeof(toprows));
+	memset (toprows, 0, sizeof(toprows));
+	if (shown != top_shown || shown)
+	{
+		top_shown = shown;
+		REG_DISPCNT = (REG_DISPCNT & ~(DISPLAY_BG2_ACTIVE | DISPLAY_BG3_ACTIVE))
+			| (shown ? DISPLAY_BG3_ACTIVE | (full ? DISPLAY_BG2_ACTIVE : 0) : 0);
+		REG_BLDCNT = shown && full ? BLEND_ALPHA | BLEND_SRC_BG2 | BLEND_DST_BG3 : BLEND_NONE;
+		REG_BLDALPHA = 8 | (8 << 8);
+	}
+}
+
+// Whether the view is dimmed behind the menu this frame
+qboolean VID_TopFaded (void)
+{
+	return top_fade;
+}
+
+// The 3D view, off while a level loads
+void VID_Show3D (qboolean show)
+{
+	if (show)
+		REG_DISPCNT |= DISPLAY_BG0_ACTIVE;
+	else
+		REG_DISPCNT &= ~DISPLAY_BG0_ACTIVE;
+}
+
+/*
+================
+VID_InitTouchScreen
+
+The touch screen keeps the text console of the startup until the first
+frame is drawn
+================
+*/
+static void VID_InitTouchScreen (void)
+{
+	int	bg, sub;
+
+	Sys_EndTextConsole ();
+	videoSetModeSub (MODE_5_2D);
+	vramSetBankC (VRAM_C_SUB_BG);
+	memset (BG_GFX_SUB, 0, FB_STRIDE * 256);
+	for (bg = 2; bg <= 3; bg++)
+	{
+		sub = bgInitSub (bg, BgType_Bmp8, BgSize_B8_512x256, 0, 0);
+		bgSetPriority (sub, bg == 2 ? 0 : 1);
+		bgSetScale (sub, SCALE_X, SCALE_Y);
+		if (bg == 2)
+			bgSetScrollf (sub, SCALE_X / 2, SCALE_Y / 2);
+	}
+	REG_DISPCNT_SUB = MODE_5_2D | DISPLAY_BG2_ACTIVE | DISPLAY_BG3_ACTIVE;
+	REG_BLDCNT_SUB = BLEND_ALPHA | BLEND_SRC_BG2 | BLEND_DST_BG3;
+	REG_BLDALPHA_SUB = 8 | (8 << 8);
+	bgUpdate ();
+	touchscreen = true;
+	memset (copyrows, 1, sizeof(copyrows));
+	ui_overdrawn = true;
+	R_SetPalette (NULL);
+}
+
+/*
+================
+VID_Update2D
+
+Copies the rows of the touch screen that changed and shows the text layer
+================
+*/
+void VID_Update2D (void)
+{
+	u32	*src = (u32 *) vid_buffer, *dst;
+	int	y;
+
+	if (!touchscreen)
+		VID_InitTouchScreen ();
+	dst = (u32 *) BG_BMP_RAM_SUB (0);
+	for (y = 0; y < VID_HEIGHT; y++, src += VID_WIDTH / 4, dst += FB_STRIDE / 4)
+		if (copyrows[y])
+			memcpy (dst, src, VID_WIDTH);
+	memset (copyrows, 0, sizeof(copyrows));
+	VID_UpdateText ();
+}
+
+/*
+===============================================================================
+
+PICS
+
+===============================================================================
+*/
+
+image_t *Draw_FindPic (char *name)
+{
+	char	fullname[MAX_QPATH];
+
+	if (name[0] != '/' && name[0] != '\\')
+	{
+		Com_sprintf (fullname, sizeof(fullname), "pics/%s.pcx", name);
+		return R_FindImage (fullname, it_pic);
+	}
+	return R_FindImage (name + 1, it_pic);
+}
+
+void Draw_InitLocal (void)
+{
+	draw_chars = Draw_FindPic ("conchars");
+	if (!draw_chars)
+		ri.Sys_Error (ERR_FATAL, "Couldn't load pics/conchars.pcx");
+}
+
+/*
+================
+Draw_Char
+
+Draws one 8*8 graphics character with 0 being transparent.
+It can be clipped to the top of the screen to allow the console to be
+smoothly scrolled off.
+================
+*/
+void Draw_Char (int x, int y, int num)
+{
+	byte	*dest, *source;
+	int		drawline, row, col, u;
+
+	num &= 255;
+	if ((num & 127) == 32)
+		return;		// space
+	if (y <= -8 || y > VID_HEIGHT - 8 || x < 0 || x > VID_WIDTH - 8)
+		return;
+
+	row = num >> 4;
+	col = num & 15;
+	source = draw_chars->pixels + (row << 10) + (col << 3);
+	if (y < 0)
+	{
+		// clipped
+		drawline = 8 + y;
+		source -= 128 * y;
+		y = 0;
+	}
+	else
+		drawline = 8;
+	VID_MarkRows (y, drawline);
+
+	dest = draw_buffer + y * VID_WIDTH + x;
+	while (drawline--)
+	{
+		for (u = 0; u < 8; u++)
+			if (source[u] != TRANSPARENT_COLOR)
+				dest[u] = source[u];
+		source += 128;
+		dest += VID_WIDTH;
+	}
+}
+
+void Draw_GetPicSize (int *w, int *h, char *pic)
+{
+	image_t	*gl = Draw_FindPic (pic);
+
+	if (!gl)
+	{
+		*w = *h = -1;
+		return;
+	}
+	*w = gl->width;
+	*h = gl->height;
+}
+
+void Draw_StretchPic (int x, int y, int w, int h, char *name)
+{
+	image_t	*pic = Draw_FindPic (name);
+	byte	*dest, *source;
+	int		v, u, f, fstep, skip, height, width;
+
+	if (!pic)
+	{
+		ri.Con_Printf (PRINT_ALL, "Can't find pic: %s\n", name);
+		return;
+	}
+	if (x < 0 || x >= VID_WIDTH || y >= VID_HEIGHT || w <= 0 || h <= 0)
+		return;
+
+	height = MIN (h, VID_HEIGHT - y);
+	width = MIN (w, VID_WIDTH - x);
+	skip = y < 0 ? -y : 0;
+	VID_MarkRows (y + skip, height - skip);
+	dest = draw_buffer + (y + skip) * VID_WIDTH + x;
+	fstep = (pic->width << 16) / w;
+	if (w == pic->width && h == pic->height)
+	{
+		// most pics are drawn as they are
+		for (v = skip, source = pic->pixels + skip * w; v < height; v++, dest += VID_WIDTH, source += w)
+			for (u = 0; u < width; u++)
+				if (source[u] != TRANSPARENT_COLOR)
+					dest[u] = source[u];
+		return;
+	}
+	for (v = skip; v < height; v++, dest += VID_WIDTH)
+	{
+		source = pic->pixels + (v * pic->height / h) * pic->width;
+		for (u = 0, f = 0; u < width; u++, f += fstep)
+			if (source[f >> 16] != TRANSPARENT_COLOR)
+				dest[u] = source[f >> 16];
+	}
+}
+
+/*
+=============
+Draw_PicDark
+
+A pic as it is drawn, but a third as bright, for the weapons the player
+doesn't have
+=============
+*/
+void Draw_PicDark (int x, int y, char *name)
+{
+	static byte	dark[256];
+	static qboolean	made;
+	image_t	*pic = Draw_FindPic (name);
+	byte	*dest, *source;
+	int		i, j, u, v, d, best, bestd, c[3];
+
+	if (!pic || x < 0 || y < 0 || x + pic->width > VID_WIDTH || y + pic->height > VID_HEIGHT)
+		return;
+	if (!made)
+	{
+		// the palette color nearest to each one at a third of its brightness
+		for (i = 0; i < 256; i++)
+		{
+			for (j = 0; j < 3; j++)
+				c[j] = (d_8to24table[i] >> (j * 8) & 0xff) / 3;
+			best = 0;
+			bestd = 0x7fffffff;
+			for (j = 0; j < 255; j++)
+			{
+				d = 0;
+				for (u = 0; u < 3; u++)
+				{
+					v = (int) (d_8to24table[j] >> (u * 8) & 0xff) - c[u];
+					d += v * v;
+				}
+				if (d < bestd)
+				{
+					bestd = d;
+					best = j;
+				}
+			}
+			dark[i] = best;
+		}
+		made = true;
+	}
+	VID_MarkRows (y, pic->height);
+	dest = draw_buffer + y * VID_WIDTH + x;
+	for (v = 0, source = pic->pixels; v < pic->height; v++, dest += VID_WIDTH, source += pic->width)
+		for (u = 0; u < pic->width; u++)
+			if (source[u] != TRANSPARENT_COLOR)
+				dest[u] = dark[source[u]];
+}
+
+void Draw_Pic (int x, int y, char *name)
+{
+	image_t	*pic = Draw_FindPic (name);
+
+	if (!pic)
+	{
+		ri.Con_Printf (PRINT_ALL, "Can't find pic: %s\n", name);
+		return;
+	}
+	Draw_StretchPic (x, y, pic->width, pic->height, name);
+}
+
+/*
+=============
+Draw_TileClear
+
+This repeats a 64*64 tile graphic to fill the screen around a sized down
+refresh window.
+=============
+*/
+void Draw_TileClear (int x, int y, int w, int h, char *name)
+{
+	image_t	*pic;
+	byte	*psrc, *pdest;
+	int		i, j;
+
+	if (x < 0)
+	{
+		w += x;
+		x = 0;
+	}
+	if (y < 0)
+	{
+		h += y;
+		y = 0;
+	}
+	w = MIN (w, VID_WIDTH - x);
+	h = MIN (h, VID_HEIGHT - y);
+	if (w <= 0 || h <= 0)
+		return;
+	pic = Draw_FindPic (name);
+	if (!pic)
+		return;
+
+	VID_MarkRows (y, h);
+	pdest = draw_buffer + y * VID_WIDTH;
+	for (i = 0; i < h; i++, pdest += VID_WIDTH)
+	{
+		psrc = pic->pixels + pic->width * ((i + y) & 63);
+		for (j = x; j < x + w; j++)
+			pdest[j] = psrc[j & 63];
+	}
+}
+
+/*
+=============
+Draw_Fill
+
+Fills a box of pixels with a single color
+=============
+*/
+void Draw_Fill (int x, int y, int w, int h, int c)
+{
+	byte	*dest;
+	int		v;
+
+	if (x < 0)
+	{
+		w += x;
+		x = 0;
+	}
+	if (y < 0)
+	{
+		h += y;
+		y = 0;
+	}
+	w = MIN (w, VID_WIDTH - x);
+	h = MIN (h, VID_HEIGHT - y);
+	if (w <= 0 || h <= 0)
+		return;
+
+	VID_MarkRows (y, h);
+	for (v = 0, dest = draw_buffer + y * VID_WIDTH + x; v < h; v++, dest += VID_WIDTH)
+		memset (dest, c, w);
+}
+
+// Darkens the view behind the menu on the top screen (R_EndFrame), the 2D
+// drawing behind it on the touch screen: three of every four pixels black
+void Draw_FadeScreen (void)
+{
+	byte	*pbuf;
+	int		x, y, t;
+
+	if (top_drawing)
+	{
+		top_fade = true;
+		return;
+	}
+	VID_MarkRows (0, VID_HEIGHT);
+	for (y = 0; y < VID_HEIGHT; y++)
+	{
+		pbuf = vid_buffer + y * VID_WIDTH;
+		t = (y & 1) << 1;
+		for (x = 0; x < VID_WIDTH; x++)
+			if ((x & 3) != t)
+				pbuf[x] = 0;
+	}
+}
