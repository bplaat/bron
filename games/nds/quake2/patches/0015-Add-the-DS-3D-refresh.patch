+// r_model.c -- model loading and caching
+//
+// The models live in the far heap, the Memory Expansion Pak of a DS. A
+// map is read a lump at a time, its surfaces become what the 3D hardware
+// takes: packed vertices, texture coordinates and the light samples of the
+// vertices. The edges, faces and light maps are only kept while it loads.
+// The far heap ignores byte writes, what has bytes is put together in main
+// RAM and copied there, memcpy handles the bytes at its ends.
+
+#include "r_local.h"
+
+#include <malloc.h>
+
+#define	MAX_MOD_KNOWN	256
+
+// Brush texture coordinates are stored in 1/8 texels, the hardware reads 1/16
+#define	ST_SCALE		8
+
+model_t		*r_worldmodel;
+static model_t	*loadmodel;
+static model_t	mod_known[MAX_MOD_KNOWN];
+static int		mod_numknown;
+static model_t	mod_inline[MAX_MOD_KNOWN];	// the submodels of the world
+
+static FILE		*mod_file;		// the map being read
+static int		mod_fileofs;
+
+/*
+===============================================================================
+
+MEMORY
+
+===============================================================================
+*/
+
+// A model's memory, freed with it
+static void *Mod_Alloc (int size)
+{
+	void	*p = far_malloc (size);
+
+	if (!p)
+		ri.Sys_Error (ERR_DROP, "Mod_Alloc: not enough memory for %s", loadmodel->name);
+	memset (p, 0, size);
+	return p;
+}
+
+// A lump of the map, in the far heap until freed
+static void *Mod_ReadLump (lump_t *l, int size, int *count)
+{
+	void	*in;
+
+	if (l->filelen % size)
+		ri.Sys_Error (ERR_DROP, "MOD_LoadBmodel: funny lump size in %s", loadmodel->name);
+	*count = l->filelen / size;
+	in = far_malloc (l->filelen + 4);
+	if (!in)
+		ri.Sys_Error (ERR_DROP, "Mod_ReadLump: not enough memory for %s", loadmodel->name);
+	fseek (mod_file, mod_fileofs + l->fileofs, SEEK_SET);
+	FS_Read (in, l->filelen, mod_file);
+	return in;
+}
+
+// A whole file in the far heap
+static void *Mod_ReadFile (char *name, int *len)
+{
+	FILE	*f;
+	void	*buf;
+
+	*len = FS_FOpenFile (name, &f);
+	if (*len < 0)
+		return NULL;
+	buf = far_malloc (*len);
+	if (!buf)
+		ri.Sys_Error (ERR_DROP, "Mod_ReadFile: not enough memory for %s", name);
+	FS_Read (buf, *len, f);
+	FS_FCloseFile (f);
+	return buf;
+}
+
+/*
+===============================================================================
+
+BRUSH MODELS
+
+===============================================================================
+*/
+
+// What a map's surfaces are built from, only kept while it loads
+typedef struct
+{
+	int			firstedge, numedges;
+	short		texturemins[2], extents[2];
+	int			lightofs;		// -1 without light map
+} mface_t;
+
+typedef struct
+{
+	vec3_t		*vertexes;
+	dedge_t		*edges;
+	int			numedges;
+	int			*surfedges;
+	mface_t		*faces;
+	byte		*lightdata;
+} loadmap_t;
+
+static loadmap_t	lm;
+
+static void Mod_LoadVertexes (lump_t *l)
+{
+	dvertex_t	*in;
+	unsigned	*out;
+	int			i, j, count, v[3];
+
+	in = Mod_ReadLump (l, sizeof(*in), &count);
+	loadmodel->numvertexes = count;
+	lm.vertexes = far_malloc (count * sizeof(vec3_t));
+	out = loadmodel->gxvertexes = Mod_Alloc (count * 8);
+	for (i = 0; i < count; i++)
+	{
+		for (j = 0; j < 3; j++)
+		{
+			lm.vertexes[i][j] = LittleFloat (in[i].point[j]);
+			v[j] = CLAMP (-32768, (int) (lm.vertexes[i][j] * VERTEX_SCALE), 32767);
+		}
+		*out++ = VERTEX_PACK (v[0], v[1]);
+		*out++ = v[2] & 0xffff;
+	}
+	free (in);
+}
+
+static void Mod_LoadSubmodels (lump_t *l)
+{
+	dmodel_t	*in;
+	mmodel_t	*out;
+	int			i, j, count;
+
+	in = Mod_ReadLump (l, sizeof(*in), &count);
+	out = loadmodel->submodels = Mod_Alloc (count * sizeof(*out));
+	loadmodel->numsubmodels = count;
+	for (i = 0; i < count; i++, out++)
+	{
+		for (j = 0; j < 3; j++)
+		{	// spread the mins / maxs by a pixel
+			out->mins[j] = LittleFloat (in[i].mins[j]) - 1;
+			out->maxs[j] = LittleFloat (in[i].maxs[j]) + 1;
+			out->origin[j] = LittleFloat (in[i].origin[j]);
+		}
+		out->radius = MAX (VectorLength (out->mins), VectorLength (out->maxs));
+		out->headnode = LittleLong (in[i].headnode);
+		out->firstface = LittleLong (in[i].firstface);
+		out->numfaces = LittleLong (in[i].numfaces);
+	}
+	free (in);
+}
+
+static void Mod_LoadPlanes (lump_t *l)
+{
+	dplane_t	*in;
+	mplane_t	*out, p;
+	int			i, j, count, bits;
+
+	in = Mod_ReadLump (l, sizeof(*in), &count);
+	out = loadmodel->planes = Mod_Alloc (count * sizeof(*out));
+	loadmodel->numplanes = count;
+	memset (&p, 0, sizeof(p));
+	for (i = 0; i < count; i++, out++)
+	{
+		bits = 0;
+		for (j = 0; j < 3; j++)
+		{
+			p.normal[j] = LittleFloat (in[i].normal[j]);
+			p.inormal[j] = p.normal[j] * 16384;
+			if (p.normal[j] < 0)
+				bits |= 1 << j;
+		}
+		p.dist = LittleFloat (in[i].dist);
+		p.idist = p.dist * (VERTEX_SCALE * 16384);
+		p.type = LittleLong (in[i].type);
+		p.signbits = bits;
+		memcpy (out, &p, sizeof(p));
+	}
+	free (in);
+}
+
+static void Mod_LoadTexinfo (lump_t *l)
+{
+	texinfo_t	*in;
+	mtexinfo_t	*out, *step;
+	int			i, j, count, next;
+	char		name[MAX_QPATH];
+
+	in = Mod_ReadLump (l, sizeof(*in), &count);
+	out = loadmodel->texinfo = Mod_Alloc (count * sizeof(*out));
+	loadmodel->numtexinfo = count;
+	for (i = 0; i < count; i++, out++)
+	{
+		for (j = 0; j < 8; j++)
+			out->vecs[0][j] = LittleFloat (in[i].vecs[0][j]);
+		out->flags = LittleLong (in[i].flags);
+		next = LittleLong (in[i].nexttexinfo);
+		out->next = next > 0 ? loadmodel->texinfo + next : NULL;
+		Com_sprintf (name, sizeof(name), "textures/%s.wal", in[i].texture);
+		out->image = R_FindImage (name, it_wall);
+		if (!out->image)
+		{
+			ri.Con_Printf (PRINT_ALL, "Couldn't load %s\n", name);
+			out->image = r_notexture;
+		}
+	}
+	free (in);
+
+	// count animation frames
+	for (i = 0; i < count; i++)
+	{
+		out = &loadmodel->texinfo[i];
+		out->numframes = 1;
+		for (step = out->next; step && step != out; step = step->next)
+			out->numframes++;
+	}
+}
+
+// The texture extents of a face, in whole light map samples
+static void Mod_SurfaceExtents (mface_t *f, mtexinfo_t *tex)
+{
+	float	mins[2], maxs[2], val, *v;
+	int		i, j, e, bmins[2], bmaxs[2];
+
+	mins[0] = mins[1] = 999999;
+	maxs[0] = maxs[1] = -99999;
+	for (i = 0; i < f->numedges; i++)
+	{
+		e = lm.surfedges[f->firstedge + i];
+		v = lm.vertexes[e >= 0 ? lm.edges[e].v[0] : lm.edges[-e].v[1]];
+		for (j = 0; j < 2; j++)
+		{
+			val = v[0] * tex->vecs[j][0] + v[1] * tex->vecs[j][1] + v[2] * tex->vecs[j][2] + tex->vecs[j][3];
+			mins[j] = MIN (mins[j], val);
+			maxs[j] = MAX (maxs[j], val);
+		}
+	}
+	for (i = 0; i < 2; i++)
+	{
+		bmins[i] = floorf (mins[i] / 16);
+		bmaxs[i] = ceilf (maxs[i] / 16);
+		f->texturemins[i] = bmins[i] * 16;
+		f->extents[i] = (bmaxs[i] - bmins[i]) * 16;
+	}
+}
+
+static void Mod_LoadFaces (lump_t *l)
+{
+	dface_t		*in;
+	msurface_t	*out;
+	mface_t		*f;
+	int			i, count, planenum, side, ti, flags;
+
+	in = Mod_ReadLump (l, sizeof(*in), &count);
+	out = loadmodel->surfaces = Mod_Alloc (count * sizeof(*out));
+	loadmodel->numsurfaces = count;
+	f = lm.faces = far_malloc (count * sizeof(*f));
+	for (i = 0; i < count; i++, out++, f++)
+	{
+		f->firstedge = LittleLong (in[i].firstedge);
+		f->numedges = LittleShort (in[i].numedges);
+		out->flags = 0;
+		planenum = LittleShort (in[i].planenum);
+		side = LittleShort (in[i].side);
+		if (side)
+			out->flags |= SURF_PLANEBACK;
+		out->plane = loadmodel->planes + planenum;
+
+		ti = LittleShort (in[i].texinfo);
+		if (ti < 0 || ti >= loadmodel->numtexinfo)
+			ri.Sys_Error (ERR_DROP, "MOD_LoadBmodel: bad texinfo number");
+		out->texinfo = loadmodel->texinfo + ti;
+		Mod_SurfaceExtents (f, out->texinfo);
+		out->texturemins[0] = f->texturemins[0];
+		out->texturemins[1] = f->texturemins[1];
+		out->extents[0] = f->extents[0];
+		out->extents[1] = f->extents[1];
+
+		memcpy (out->styles, in[i].styles, MAXLIGHTMAPS);
+		f->lightofs = LittleLong (in[i].lightofs);
+
+		flags = out->texinfo->flags;
+		if (flags & SURF_SKY)
+			out->flags |= SURF_DRAWSKY;
+		if (flags & SURF_WARP)
+			out->flags |= SURF_DRAWTURB;
+	}
+	free (in);
+}
+
+static void Mod_SetParent (mnode_t *node, mnode_t *parent)
+{
+	node->parent = parent;
+	if (node->contents != -1)
+		return;
+	Mod_SetParent (node->children[0], node);
+	Mod_SetParent (node->children[1], node);
+}
+
+static void Mod_LoadNodes (lump_t *l)
+{
+	dnode_t	*in;
+	mnode_t	*out;
+	int		i, j, count, p;
+
+	in = Mod_ReadLump (l, sizeof(*in), &count);
+	out = loadmodel->nodes = Mod_Alloc (count * sizeof(*out));
+	loadmodel->numnodes = count;
+	for (i = 0; i < count; i++, out++)
+	{
+		for (j = 0; j < 3; j++)
+		{
+			out->minmaxs[j] = LittleShort (in[i].mins[j]);
+			out->minmaxs[3 + j] = LittleShort (in[i].maxs[j]);
+		}
+		out->plane = loadmodel->planes + LittleLong (in[i].planenum);
+		out->firstsurface = LittleShort (in[i].firstface);
+		out->numsurfaces = LittleShort (in[i].numfaces);
+		out->contents = -1;	// differentiate from leafs
+		for (j = 0; j < 2; j++)
+		{
+			p = LittleLong (in[i].children[j]);
+			out->children[j] = p >= 0 ? loadmodel->nodes + p : (mnode_t *)(loadmodel->leafs + (-1 - p));
+		}
+	}
+	free (in);
+	Mod_SetParent (loadmodel->nodes, NULL);	// sets nodes and leafs
+}
+
+static void Mod_LoadLeafs (lump_t *l)
+{
+	dleaf_t	*in;
+	mleaf_t	*out;
+	int		i, j, count;
+
+	in = Mod_ReadLump (l, sizeof(*in), &count);
+	out = loadmodel->leafs = Mod_Alloc (count * sizeof(*out));
+	loadmodel->numleafs = count;
+	for (i = 0; i < count; i++, out++)
+	{
+		for (j = 0; j < 3; j++)
+		{
+			out->minmaxs[j] = LittleShort (in[i].mins[j]);
+			out->minmaxs[3 + j] = LittleShort (in[i].maxs[j]);
+		}
+		out->contents = LittleLong (in[i].contents);
+		out->cluster = LittleShort (in[i].cluster);
+		out->area = LittleShort (in[i].area);
+		out->firstmarksurface = loadmodel->marksurfaces + LittleShort (in[i].firstleafface);
+		out->nummarksurfaces = LittleShort (in[i].numleaffaces);
+	}
+	free (in);
+}
+
+static void Mod_LoadMarksurfaces (lump_t *l)
+{
+	short		*in;
+	msurface_t	**out;
+	int			i, j, count;
+
+	in = Mod_ReadLump (l, sizeof(*in), &count);
+	out = loadmodel->marksurfaces = Mod_Alloc (count * sizeof(*out));
+	loadmodel->nummarksurfaces = count;
+	for (i = 0; i < count; i++)
+	{
+		j = LittleShort (in[i]);
+		if (j < 0 || j >= loadmodel->numsurfaces)
+			ri.Sys_Error (ERR_DROP, "Mod_ParseMarksurfaces: bad surface number");
+		out[i] = loadmodel->surfaces + j;
+	}
+	free (in);
+}
+
+/*
+===============================================================================
+
+SURFACES FOR THE HARDWARE
+
+===============================================================================
+*/
+
+static int Mod_SurfaceStyles (msurface_t *surf, mface_t *f)
+{
+	int	numstyles = 0;
+
+	if (f->lightofs >= 0 && lm.lightdata && !(surf->texinfo->flags & (SURF_SKY | SURF_WARP)))
+		while (numstyles < MAXLIGHTMAPS && surf->styles[numstyles] != 255)
+			numstyles++;
+	return numstyles;
+}
+
+// gxsurf_t, texture coordinates, vertex indices and RGB light, word aligned
+static int Mod_GXSize (int n, int numstyles)
+{
+	return (sizeof(gxsurf_t) + n * 4 + ((n * 2 + 3) & ~3) + numstyles * n * 3 + 3) & ~3;
+}
+
+#define	TJ_CELL			7		// 16 units in 1/8 units
+#define	TJ_CELLOF(x)	(((x) + 64) >> TJ_CELL)	// half a cell off the walls on the 16 unit grid
+#define	TJ_HASH			8192
+#define	TJ_MAXINSERT	32		// vertices added to an edge
+#define	TJ_END			0xffff
+
+static int Mod_TJHash (int cx, int cy, int cz)
+{
+	return (cx * 73856093 ^ cy * 19349663 ^ cz * 83492791) & (TJ_HASH - 1);
+}
+
+static int Mod_Sqrt (int n)
+{
+	int	root = 0, bit = 1 << 30;
+
+	while (bit > n)
+		bit >>= 2;
+	for (; bit; bit >>= 2)
+	{
+		if (n >= root + bit)
+		{
+			n -= root + bit;
+			root = (root >> 1) + bit;
+		}
+		else
+			root >>= 1;
+	}
+	return root;
+}
+
+/*
+================
+Mod_EdgeTJunctions
+
+A vertex of one face in the middle of an edge of another is a T-junction,
+the hardware leaves a crack along that edge. The vertices on each edge, at
+most 1/8 unit off it, are found through a hash of the vertex positions by
+16 unit cells. Returns them for Mod_SurfaceVerts, at offset ecache[edge]
+the number of them, then the vertices from v[0] to v[1].
+================
+*/
+// ARM code, the loading time is mostly spent here
+__attribute__((target("arm")))
+static unsigned short *Mod_EdgeTJunctions (model_t *mod, unsigned short **ecache)
+{
+	unsigned short	*head, *next, *elist, *ec;
+	int				i, k, a, b, v, n, total, max, x[3], lo[3], hi[3], c[3], ins[TJ_MAXINSERT];
+	int				d[3], w[3], dot, len2, len, cr, sh, at[TJ_MAXINSERT];
+
+	// positions from the hardware vertices
+#define	TJ_POS(v, k)	((k) == 2 ? (short) (mod->gxvertexes[(v) * 2 + 1] & 0xffff) : \
+						 (short) (mod->gxvertexes[(v) * 2] >> ((k) * 16)))
+
+	head = far_malloc (TJ_HASH * sizeof(*head));
+	next = far_malloc (mod->numvertexes * sizeof(*next));
+	ec = *ecache = far_malloc (lm.numedges * sizeof(*ec));
+	max = MIN (lm.numedges * 2, TJ_END);
+	elist = far_malloc (max * sizeof(*elist));
+	if (!head || !next || !ec || !elist)
+		ri.Sys_Error (ERR_DROP, "Mod_EdgeTJunctions: not enough memory");
+	for (i = 0; i < TJ_HASH; i++)
+		head[i] = TJ_END;
+	for (i = 0; i < mod->numvertexes; i++)
+	{
+		k = Mod_TJHash (TJ_CELLOF (TJ_POS (i, 0)), TJ_CELLOF (TJ_POS (i, 1)), TJ_CELLOF (TJ_POS (i, 2)));
+		next[i] = head[k];
+		head[k] = i;
+	}
+
+	total = 0;
+	for (i = 0; i < lm.numedges; i++)
+	{
+		if (total >= max)
+		{
+			ec[i] = TJ_END;
+			continue;
+		}
+		a = lm.edges[i].v[0];
+		b = lm.edges[i].v[1];
+		for (k = 0; k < 3; k++)
+		{
+			x[k] = TJ_POS (a, k);
+			lo[k] = MIN (x[k], TJ_POS (b, k)) - 1;
+			hi[k] = MAX (x[k], TJ_POS (b, k)) + 1;
+			d[k] = TJ_POS (b, k) - x[k];
+		}
+		// in 32 bits, longer edges than 2048 units are worked out in
+		// coarser steps
+		n = 0;
+		for (sh = 0; MAX (abs (d[0]), MAX (abs (d[1]), abs (d[2]))) >> sh >= 16384; sh++)
+			;
+		for (k = 0; k < 3; k++)
+			d[k] >>= sh;
+		len2 = d[0] * d[0] + d[1] * d[1] + d[2] * d[2];
+		len = Mod_Sqrt (len2);
+		for (c[2] = TJ_CELLOF (lo[2]); c[2] <= TJ_CELLOF (hi[2]); c[2]++)
+			for (c[1] = TJ_CELLOF (lo[1]); c[1] <= TJ_CELLOF (hi[1]); c[1]++)
+				for (c[0] = TJ_CELLOF (lo[0]); c[0] <= TJ_CELLOF (hi[0]); c[0]++)
+					for (v = head[Mod_TJHash (c[0], c[1], c[2])]; v != TJ_END; v = next[v])
+					{
+						if (v == a || v == b)
+							continue;
+						for (k = 0; k < 3; k++)
+						{
+							w[k] = TJ_POS (v, k);
+							if (w[k] < lo[k] || w[k] > hi[k] || TJ_CELLOF (w[k]) != c[k])
+								break;
+							w[k] = (w[k] - x[k]) >> sh;
+						}
+						if (k < 3)
+							continue;
+						dot = d[0] * w[0] + d[1] * w[1] + d[2] * w[2];
+						if (dot <= 0 || dot >= len2)
+							continue;
+						// the distance to the edge is |d x w| / |d|
+						cr = abs (d[1] * w[2] - d[2] * w[1]) + abs (d[2] * w[0] - d[0] * w[2])
+							+ abs (d[0] * w[1] - d[1] * w[0]);
+						if (cr > len + len)
+							continue;
+						for (k = 0; k < n && at[k] != dot; k++)
+							;
+						if (k < n)
+							continue;	// a vertex at the same place
+						for (k = n; k > 0 && at[k - 1] > dot; k--)
+							if (k < TJ_MAXINSERT)
+							{
+								ins[k] = ins[k - 1];
+								at[k] = at[k - 1];
+							}
+						if (k < TJ_MAXINSERT)
+						{
+							ins[k] = v;
+							at[k] = dot;
+							n = MIN (n + 1, TJ_MAXINSERT);
+						}
+					}
+		n = MIN (n, max - total - 1);
+		ec[i] = total;
+		elist[total++] = n;
+		for (k = 0; k < n; k++)
+			elist[total++] = ins[k];
+	}
+#undef	TJ_POS
+	free (head);
+	free (next);
+	return elist;
+}
+
+// The vertices of a face with those of its T-junctions, into out unless
+// it's NULL, returns how many
+static int Mod_SurfaceVerts (mface_t *f, unsigned short *elist, unsigned short *ecache, unsigned short *out)
+{
+	int				j, k, e, n = 0, num;
+	unsigned short	*ins;
+
+	for (j = 0; j < f->numedges && n < MAX_SURFVERTS; j++)
+	{
+		e = lm.surfedges[f->firstedge + j];
+		if (out)
+			out[n] = e >= 0 ? lm.edges[e].v[0] : lm.edges[-e].v[1];
+		n++;
+		if (ecache[abs (e)] == TJ_END)
+			continue;
+		ins = elist + ecache[abs (e)];
+		num = *ins++;
+		// backwards on a face that has the edge the other way around
+		for (k = 0; k < num && n < MAX_SURFVERTS; k++, n++)
+			if (out)
+				out[n] = ins[e >= 0 ? k : num - 1 - k];
+	}
+	return n;
+}
+
+/*
+================
+Mod_StripStart
+
+The 3D hardware tells the side a polygon faces from its first three
+vertices, i, j and j' of each quad of R_EmitSurface's strip. In a line it
+can get that wrong, then it leaves the edges that run more across than down
+unfilled. Returns the first vertex to start the strip at that keeps them a
+unit from a line, a T-junction is in a line with its edge. The vertices are
+there twice, one after the other.
+================
+*/
+__attribute__((target("arm")))
+static int Mod_StripStart (model_t *mod, msurface_t *surf, unsigned short *verts, int n)
+{
+	int			r, k, j, a0, a1, d[3][2];
+	long long	c;
+	unsigned	*pos;
+
+	// in the plane seen along the axis it's most across, in the 1/8 units of
+	// the vertices: the cross product over the larger side of j to j' is 8
+	// times the distance of i from their line
+	if (surf->plane->type < 3)
+		a0 = (surf->plane->type + 1) % 3;
+	else
+	{
+		// the axis the normal is most along
+		a0 = fabsf (surf->plane->normal[0]) > fabsf (surf->plane->normal[1]) ? 0 : 1;
+		a0 = fabsf (surf->plane->normal[2]) > fabsf (surf->plane->normal[a0]) ? 2 : a0;
+		a0 = (a0 + 1) % 3;
+	}
+	a1 = (a0 + 1) % 3;
+	for (r = 0; r < n; r++)
+	{
+		for (k = 0; k < (n - 1) / 2; k++)
+		{
+			for (j = 0; j < 3; j++)
+			{
+				pos = mod->gxvertexes + verts[j ? r + n - k - j + 1 : r + k + 1] * 2;
+				d[j][0] = a0 == 2 ? (short) pos[1] : (short) (pos[0] >> (a0 * 16));
+				d[j][1] = a1 == 2 ? (short) pos[1] : (short) (pos[0] >> (a1 * 16));
+			}
+			c = (long long) (d[0][0] - d[1][0]) * (d[2][1] - d[1][1]) -
+				(long long) (d[0][1] - d[1][1]) * (d[2][0] - d[1][0]);
+			if ((c < 0 ? -c : c) < MAX (abs (d[2][0] - d[1][0]), abs (d[2][1] - d[1][1])) * VERTEX_SCALE)
+				break;
+		}
+		if (k == (n - 1) / 2)
+			return r;
+	}
+	return 0;
+}
+
+// The color of a vertex from its RGB light, 128 is the texture as it is,
+// up to twice as bright
+static u16 Mod_LightColor (const byte *rgb)
+{
+	return RGB15 (MIN (rgb[0] * GX_NORMAL_LIGHT >> 7, 31), MIN (rgb[1] * GX_NORMAL_LIGHT >> 7, 31),
+		MIN (rgb[2] * GX_NORMAL_LIGHT >> 7, 31));
+}
+
+/*
+================
+Mod_BuildSurfaces
+
+Packs the vertices, texture coordinates and light samples of the surfaces
+for the 3D hardware, the sky is the sky box and needs none
+================
+*/
+static void Mod_BuildSurfaces (model_t *mod)
+{
+	static unsigned	build[(sizeof(gxsurf_t) + MAX_SURFVERTS * (4 + 2 + MAXLIGHTMAPS * 3) + 3) / 4];
+	int			i, j, k, n, x, y, numstyles, smax, tmax, ls, lt, size, sum[3];
+	unsigned short	*elist, *ecache;
+	byte		*data, *light, *sample;
+	msurface_t	*surf;
+	mface_t		*f;
+	mtexinfo_t	*tex;
+	gxsurf_t	*gx;
+	float		st[MAX_SURFVERTS][2], mins[2], base[2], *v;
+	unsigned short	*verts, start[MAX_SURFVERTS * 2];
+	u16			*colors;
+
+	elist = Mod_EdgeTJunctions (mod, &ecache);
+
+	// all surfaces in one allocation
+	size = 0;
+	for (i = 0, surf = mod->surfaces, f = lm.faces; i < mod->numsurfaces; i++, surf++, f++)
+	{
+		if (surf->flags & SURF_DRAWSKY)
+			continue;
+		n = Mod_SurfaceVerts (f, elist, ecache, NULL);
+		size += Mod_GXSize (n, Mod_SurfaceStyles (surf, f)) + n * sizeof(u16);
+	}
+	data = mod->data = Mod_Alloc (size);
+
+	for (i = 0, surf = mod->surfaces, f = lm.faces; i < mod->numsurfaces; i++, surf++, f++)
+	{
+		if (surf->flags & SURF_DRAWSKY)
+			continue;
+		n = Mod_SurfaceVerts (f, elist, ecache, NULL);
+		tex = surf->texinfo;
+		numstyles = Mod_SurfaceStyles (surf, f);
+
+		// put together in main RAM, it has bytes
+		gx = (gxsurf_t *)build;
+		surf->gx = (gxsurf_t *)data;
+		data += Mod_GXSize (n, numstyles);
+		colors = surf->colors = (u16 *)data;
+		data += n * sizeof(u16);
+		gx->numverts = n;
+		gx->numstyles = numstyles;
+		verts = GX_VERTS (gx);
+		light = GX_LIGHT (gx);
+
+		mins[0] = mins[1] = 999999;
+		Mod_SurfaceVerts (f, elist, ecache, start);
+		memcpy (start + n, start, n * sizeof(*start));
+		k = Mod_StripStart (mod, surf, start, n);
+		memcpy (verts, start + k, n * sizeof(*verts));
+		for (j = 0; j < n; j++)
+		{
+			v = lm.vertexes[verts[j]];
+			for (k = 0; k < 2; k++)
+			{
+				st[j][k] = DotProduct (v, tex->vecs[k]) + tex->vecs[k][3];
+				if (st[j][k] < mins[k])
+					mins[k] = st[j][k];
+			}
+		}
+
+		// start near 0, the hardware only takes 12 bits of texels
+		base[0] = floorf (mins[0] / tex->image->width) * tex->image->width;
+		base[1] = floorf (mins[1] / tex->image->height) * tex->image->height;
+
+		smax = (f->extents[0] >> 4) + 1;
+		tmax = (f->extents[1] >> 4) + 1;
+		for (j = 0; j < n; j++)
+		{
+			x = CLAMP (-32768, (int) ((st[j][0] - base[0]) * ST_SCALE), 32767);
+			y = CLAMP (-32768, (int) ((st[j][1] - base[1]) * ST_SCALE), 32767);
+			gx->st[j] = TEXTURE_PACK (x, y);
+
+			ls = CLAMP (0, (int) ((st[j][0] - f->texturemins[0]) * (1.0f / 16) + 0.5f), smax - 1);
+			lt = CLAMP (0, (int) ((st[j][1] - f->texturemins[1]) * (1.0f / 16) + 0.5f), tmax - 1);
+			sum[0] = sum[1] = sum[2] = 0;
+			for (k = 0; k < numstyles; k++)
+			{
+				sample = lm.lightdata + f->lightofs + (k * smax * tmax + lt * smax + ls) * 3;
+				light[(k * n + j) * 3] = sample[0];
+				light[(k * n + j) * 3 + 1] = sample[1];
+				light[(k * n + j) * 3 + 2] = sample[2];
+				sum[0] += sample[0];
+				sum[1] += sample[1];
+				sum[2] += sample[2];
+			}
+			// the colors with every style at its normal light
+			if (numstyles)
+			{
+				byte	rgb[3] = { MIN (sum[0], 255), MIN (sum[1], 255), MIN (sum[2], 255) };
+
+				colors[j] = Mod_LightColor (rgb);
+			}
+			else
+				colors[j] = RGB15 (GX_NORMAL_LIGHT, GX_NORMAL_LIGHT, GX_NORMAL_LIGHT);
+		}
+		memcpy (surf->gx, gx, Mod_GXSize (n, numstyles));
+	}
+	free (elist);
+	free (ecache);
+}
+
+/*
+=================
+Mod_LoadBrushModel
+=================
+*/
+static void Mod_LoadBrushModel (model_t *mod)
+{
+	dheader_t	header;
+	mmodel_t	*bm;
+	model_t		*starmod;
+	int			i, count;
+
+	if (FS_FOpenFile (mod->name, &mod_file) < 0)
+		ri.Sys_Error (ERR_DROP, "Mod_NumForName: %s not found", mod->name);
+	mod_fileofs = ftell (mod_file);
+	FS_Read (&header, sizeof(header), mod_file);
+	for (i = 0; i < sizeof(dheader_t) / 4; i++)
+		((int *)&header)[i] = LittleLong (((int *)&header)[i]);
+	if (header.version != BSPVERSION)
+		ri.Sys_Error (ERR_DROP, "Mod_LoadBrushModel: %s has wrong version number (%i should be %i)",
+			mod->name, header.version, BSPVERSION);
+
+	mod->type = mod_brush;
+	memset (&lm, 0, sizeof(lm));
+	Mod_LoadVertexes (&header.lumps[LUMP_VERTEXES]);
+	lm.edges = Mod_ReadLump (&header.lumps[LUMP_EDGES], sizeof(dedge_t), &lm.numedges);
+	for (i = 0; i < lm.numedges; i++)
+	{
+		lm.edges[i].v[0] = LittleShort (lm.edges[i].v[0]);
+		lm.edges[i].v[1] = LittleShort (lm.edges[i].v[1]);
+	}
+	lm.surfedges = Mod_ReadLump (&header.lumps[LUMP_SURFEDGES], sizeof(int), &count);
+	for (i = 0; i < count; i++)
+		lm.surfedges[i] = LittleLong (lm.surfedges[i]);
+	if (header.lumps[LUMP_LIGHTING].filelen)
+		lm.lightdata = Mod_ReadLump (&header.lumps[LUMP_LIGHTING], 1, &count);
+	Mod_LoadPlanes (&header.lumps[LUMP_PLANES]);
+	Mod_LoadTexinfo (&header.lumps[LUMP_TEXINFO]);
+	Mod_LoadFaces (&header.lumps[LUMP_FACES]);
+	Mod_BuildSurfaces (mod);
+	R_BuildMap (mod);
+	free (lm.faces);
+	free (lm.lightdata);
+	free (lm.surfedges);
+	free (lm.edges);
+	free (lm.vertexes);
+	Mod_LoadMarksurfaces (&header.lumps[LUMP_LEAFFACES]);
+	Mod_LoadLeafs (&header.lumps[LUMP_LEAFS]);
+	Mod_LoadNodes (&header.lumps[LUMP_NODES]);
+	Mod_LoadSubmodels (&header.lumps[LUMP_MODELS]);
+	FS_FCloseFile (mod_file);
+	mod->numframes = 2;		// regular and alternate animation
+
+	// set up the submodels
+	for (i = 0; i < mod->numsubmodels; i++)
+	{
+		bm = &mod->submodels[i];
+		starmod = &mod_inline[i];
+		*starmod = *loadmodel;
+		starmod->firstmodelsurface = bm->firstface;
+		starmod->nummodelsurfaces = bm->numfaces;
+		starmod->firstnode = bm->headnode;
+		if (starmod->firstnode >= loadmodel->numnodes)
+			ri.Sys_Error (ERR_DROP, "Inline model %i has bad firstnode", i);
+		VectorCopy (bm->maxs, starmod->maxs);
+		VectorCopy (bm->mins, starmod->mins);
+		starmod->radius = bm->radius;
+		if (i == 0)
+			*loadmodel = *starmod;
+		starmod->numleafs = bm->numfaces;
+	}
+}
+
+static void Mod_FreeBrushModel (model_t *mod)
+{
+	R_FreeMap ();
+	free (mod->gxvertexes);
+	free (mod->submodels);
+	free (mod->planes);
+	free (mod->texinfo);
+	free (mod->surfaces);
+	free (mod->marksurfaces);
+	free (mod->leafs);
+	free (mod->nodes);
+}
+
+/*
+===============================================================================
+
+ALIAS MODELS
+
+===============================================================================
+*/
+
+/*
+=================
+Mod_LoadAliasModel
+
+The frames stay as they are in the file, the GL commands become strips and
+triangle lists of xyz vertices, the fans as lists, with the packed texture
+coordinates of their vertices in 1/16 texels of the skin
+=================
+*/
+static void Mod_LoadAliasModel (model_t *mod, byte *buffer, int len)
+{
+	dmdl_t		*pinmodel = (dmdl_t *)buffer;
+	gxalias_t	*gx;
+	daliasframe_t	*frame;
+	int			*cmd, i, j, k, count, numst, numcmds, version, s, t;
+	unsigned	*st;
+	u16			*out;
+	float		r;
+	vec3_t		mins, maxs;
+
+	for (i = 0; i < sizeof(dmdl_t) / 4; i++)
+		((int *)pinmodel)[i] = LittleLong (((int *)pinmodel)[i]);
+	version = pinmodel->version;
+	if (version != ALIAS_VERSION)
+		ri.Sys_Error (ERR_DROP, "%s has wrong version number (%i should be %i)", mod->name, version, ALIAS_VERSION);
+	if (pinmodel->num_xyz <= 0 || pinmodel->num_xyz > MAX_VERTS)
+		ri.Sys_Error (ERR_DROP, "model %s has a bad number of vertices", mod->name);
+	if (pinmodel->num_frames <= 0)
+		ri.Sys_Error (ERR_DROP, "model %s has no frames", mod->name);
+
+	// how many vertices the commands send, fans as triangles
+	numst = numcmds = 0;
+	for (cmd = (int *)(buffer + pinmodel->ofs_glcmds); (count = LittleLong (*cmd)); )
+	{
+		cmd++;
+		if (count < 0)
+		{
+			count = -count;
+			numst += (count - 2) * 3;
+		}
+		else
+			numst += count;
+		numcmds++;
+		cmd += count * 3;
+	}
+
+	// what is read for every vertex drawn in main RAM, the frames in the
+	// far heap
+	gx = mod->alias = calloc (1, sizeof(*gx) + numst * sizeof(unsigned) + (numst + numcmds * 2 + 1) * sizeof(u16));
+	if (!gx)
+		ri.Sys_Error (ERR_DROP, "Mod_LoadAliasModel: not enough memory for %s", mod->name);
+	gx->numverts = pinmodel->num_xyz;
+	gx->numframes = pinmodel->num_frames;
+	gx->framesize = pinmodel->framesize;
+	gx->frames = buffer + pinmodel->ofs_frames;
+	gx->st = st = (unsigned *)(gx + 1);
+	gx->cmds = out = (u16 *)(st + numst);
+
+#define	CMD_ST(c)	(s = LittleFloat (*(float *)&(c)[0]) * pinmodel->skinwidth * 16, \
+					 t = LittleFloat (*(float *)&(c)[1]) * pinmodel->skinheight * 16, TEXTURE_PACK (s, t))
+	for (cmd = (int *)(buffer + pinmodel->ofs_glcmds); (count = LittleLong (*cmd)); )
+	{
+		cmd++;
+		if (count > 0)
+		{
+			*out++ = count;
+			*out++ = GL_TRIANGLE_STRIP;
+			for (i = 0; i < count; i++, cmd += 3)
+			{
+				*st++ = CMD_ST (cmd);
+				*out++ = LittleLong (cmd[2]);
+			}
+		}
+		else
+		{
+			count = -count;
+			*out++ = (count - 2) * 3;
+			*out++ = GL_TRIANGLES;
+			for (i = 2; i < count; i++)
+				for (k = 0; k < 3; k++)
+				{
+					j = k == 0 ? 0 : i - 2 + k;
+					*st++ = CMD_ST (cmd + j * 3);
+					*out++ = LittleLong (cmd[j * 3 + 2]);
+				}
+			cmd += count * 3;
+		}
+	}
+	*out = 0;
+#undef	CMD_ST
+
+	// the skins, and the radius around the origin of all frames
+	gx->numskins = MIN (pinmodel->num_skins, MAX_MD2SKINS);
+	for (i = 0; i < gx->numskins; i++)
+		gx->skins[i] = R_FindImage ((char *)buffer + pinmodel->ofs_skins + i * MAX_SKINNAME, it_skin);
+	r = 0;
+	for (i = 0; i < gx->numframes; i++)
+	{
+		frame = (daliasframe_t *)(gx->frames + i * gx->framesize);
+		for (j = 0; j < 3; j++)
+		{
+			frame->scale[j] = LittleFloat (frame->scale[j]);
+			frame->translate[j] = LittleFloat (frame->translate[j]);
+			mins[j] = fabsf (frame->translate[j]);
+			maxs[j] = fabsf (frame->translate[j] + frame->scale[j] * 255);
+			mins[j] = MAX (mins[j], maxs[j]);
+		}
+		r = MAX (r, VectorLength (mins));
+	}
+	gx->radius = r;
+	mod->radius = r;
+	mod->numframes = gx->numframes;
+	mod->type = mod_alias;
+	mod->data = buffer;
+}
+
+/*
+===============================================================================
+
+SPRITES
+
+===============================================================================
+*/
+
+static void Mod_LoadSpriteModel (model_t *mod, byte *buffer, int len)
+{
+	dsprite_t	*sprin = (dsprite_t *)buffer;
+	msprite_t	*sprout;
+	int			i, numframes;
+
+	if (LittleLong (sprin->version) != SPRITE_VERSION)
+		ri.Sys_Error (ERR_DROP, "%s has wrong version number (%i should be %i)",
+			mod->name, LittleLong (sprin->version), SPRITE_VERSION);
+	numframes = LittleLong (sprin->numframes);
+	if (numframes > MAX_MD2SKINS)
+		ri.Sys_Error (ERR_DROP, "%s has too many frames (%i > %i)", mod->name, numframes, MAX_MD2SKINS);
+
+	sprout = mod->sprite = Mod_Alloc (sizeof(*sprout) + numframes * sizeof(sprout->frames[0]));
+	sprout->numframes = numframes;
+	for (i = 0; i < numframes; i++)
+	{
+		sprout->frames[i].width = LittleLong (sprin->frames[i].width);
+		sprout->frames[i].height = LittleLong (sprin->frames[i].height);
+		sprout->frames[i].origin_x = LittleLong (sprin->frames[i].origin_x);
+		sprout->frames[i].origin_y = LittleLong (sprin->frames[i].origin_y);
+		sprout->frames[i].image = R_FindImage (sprin->frames[i].name, it_sprite);
+	}
+	mod->numframes = numframes;
+	mod->type = mod_sprite;
+	free (buffer);
+}
+
+/*
+===============================================================================
+
+REGISTRATION
+
+===============================================================================
+*/
+
+static void Mod_Free (model_t *mod)
+{
+	if (mod->type == mod_brush)
+		Mod_FreeBrushModel (mod);
+	free (mod->alias);
+	free (mod->sprite);
+	free (mod->data);
+	memset (mod, 0, sizeof(*mod));
+}
+
+/*
+==================
+Mod_ForName
+
+Loads in a model for the given name
+==================
+*/
+static model_t *Mod_ForName (char *name, qboolean crash)
+{
+	model_t	*mod;
+	byte	*buf;
+	int		i, len;
+
+	if (!name[0])
+		ri.Sys_Error (ERR_DROP, "Mod_ForName: NULL name");
+
+	// inline models are grabbed only from worldmodel
+	if (name[0] == '*')
+	{
+		i = atoi (name + 1);
+		if (i < 1 || !r_worldmodel || i >= r_worldmodel->numsubmodels)
+			ri.Sys_Error (ERR_DROP, "bad inline model number");
+		return &mod_inline[i];
+	}
+
+	// search the currently loaded models
+	for (i = 0, mod = mod_known; i < mod_numknown; i++, mod++)
+		if (mod->name[0] && !strcmp (mod->name, name))
+			return mod;
+
+	// find a free model slot spot
+	for (i = 0, mod = mod_known; i < mod_numknown; i++, mod++)
+		if (!mod->name[0])
+			break;
+	if (i == mod_numknown)
+	{
+		if (mod_numknown == MAX_MOD_KNOWN)
+			ri.Sys_Error (ERR_DROP, "mod_numknown == MAX_MOD_KNOWN");
+		mod_numknown++;
+	}
+	strcpy (mod->name, name);
+	loadmodel = mod;
+
+	if (strlen (name) > 4 && !strcmp (name + strlen (name) - 4, ".bsp"))
+	{
+		Mod_LoadBrushModel (mod);
+		return mod;
+	}
+
+	buf = Mod_ReadFile (name, &len);
+	if (!buf)
+	{
+		if (crash)
+			ri.Sys_Error (ERR_DROP, "Mod_NumForName: %s not found", mod->name);
+		memset (mod->name, 0, sizeof(mod->name));
+		return NULL;
+	}
+	switch (LittleLong (*(unsigned *)buf))
+	{
+	case IDALIASHEADER:
+		Mod_LoadAliasModel (mod, buf, len);
+		break;
+	case IDSPRITEHEADER:
+		Mod_LoadSpriteModel (mod, buf, len);
+		break;
+	default:
+		ri.Sys_Error (ERR_DROP, "Mod_NumForName: unknown fileid for %s", mod->name);
+		break;
+	}
+	return mod;
+}
+
+/*
+=====================
+R_BeginRegistration
+
+Specifies the model that will be used as the world
+=====================
+*/
+void R_BeginRegistration (char *model)
+{
+	char	fullname[MAX_QPATH];
+	cvar_t	*flushmap;
+
+	registration_sequence++;
+	r_registering = true;
+	r_viewcluster = -1;		// force markleafs
+
+	Com_sprintf (fullname, sizeof(fullname), "maps/%s.bsp", model);
+
+	// explicitly free the old map if different
+	// this guarantees that mod_known[0] is the world map
+	flushmap = ri.Cvar_Get ("flushmap", "0", 0);
+	if (strcmp (mod_known[0].name, fullname) || flushmap->value)
+		Mod_Free (&mod_known[0]);
+	if (!mod_numknown)
+		mod_numknown = 1;
+	r_worldmodel = Mod_ForName (fullname, true);
+	r_worldmodel->registration_sequence = registration_sequence;
+}
+
+struct model_s *R_RegisterModel (char *name)
+{
+	model_t		*mod;
+	int			i;
+
+	mod = Mod_ForName (name, false);
+	if (!mod)
+		return NULL;
+	mod->registration_sequence = registration_sequence;
+
+	// register any images used by the models
+	if (mod->type == mod_sprite)
+	{
+		for (i = 0; i < mod->sprite->numframes; i++)
+			mod->sprite->frames[i].image = R_FindImage (mod->sprite->frames[i].image ?
+				mod->sprite->frames[i].image->name : "", it_sprite);
+	}
+	else if (mod->type == mod_alias)
+	{
+		for (i = 0; i < mod->alias->numskins; i++)
+			if (mod->alias->skins[i])
+				mod->alias->skins[i] = R_FindImage (mod->alias->skins[i]->name, it_skin);
+	}
+	else if (mod->type == mod_brush)
+	{
+		for (i = 0; i < mod->numtexinfo; i++)
+			mod->texinfo[i].image = R_FindImage (mod->texinfo[i].image->name, it_wall);
+	}
+	return mod;
+}
+
+void R_EndRegistration (void)
+{
+	int		i;
+	model_t	*mod;
+
+	for (i = 0, mod = mod_known; i < mod_numknown; i++, mod++)
+		if (mod->name[0] && mod->registration_sequence != registration_sequence)
+			Mod_Free (mod);
+	R_FreeUnusedImages ();
+	R_UploadTextures ();
+	r_registering = false;
+}
+
+/*
+===============
+Mod_PointInLeaf
+===============
+*/
+mleaf_t *Mod_PointInLeaf (vec3_t p, model_t *model)
+{
+	mnode_t		*node;
+	mplane_t	*plane;
+
+	if (!model || !model->nodes)
+		ri.Sys_Error (ERR_DROP, "Mod_PointInLeaf: bad model");
+	node = model->nodes;
+	while (node->contents == -1)
+	{
+		plane = node->plane;
+		node = node->children[DotProduct (p, plane->normal) - plane->dist <= 0];
+	}
+	return (mleaf_t *)node;
+}
+
+void R_InitModels (void)
+{
+	memset (mod_known, 0, sizeof(mod_known));
+	mod_numknown = 0;
+}
+
+void R_ShutdownModels (void)
+{
+	int	i;
+
+	for (i = 0; i < mod_numknown; i++)
+		if (mod_known[i].name[0])
+			Mod_Free (&mod_known[i]);
+}
