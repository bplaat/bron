+// r_local.h -- private refresh defs of the Nintendo DS refresh
+//
+// The world, brush and alias models, sprites, beams and particles are drawn
+// by the geometry engine on the top screen, the 2D drawing stays in software
+// on the touch screen.
+//
+// - Vertices are 16-bit fixed point world coordinates times 8, the matrices
+//   work in units of 512 world units, so maps up to 4096 units fit.
+// - Textures stay 8-bit with Quake II's palette in the texture palette, so
+//   the hardware needs no other formats. They go to VRAM at the end of the
+//   registration of a map, halved until they all fit, nothing of them stays
+//   in main RAM.
+// - Light maps become vertex colors, a sample per style for each vertex,
+//   so the light styles still animate.
+// - Surfaces are polygons, drawn as quad strips zig-zagging across them,
+//   which needs half as many polygons as triangles.
+
+#include "../client/ref.h"
+
+#include <nds.h>
+
+#define	REF_VERSION	"NDS 0.01"
+
+extern refimport_t	ri;
+
+// Vertex coordinates are world units times 8, the matrices are in 1/512
+#define	VERTEX_SCALE		8
+#define	MATRIX_SCALE_W		(1.0f / 512)
+
+// The palette of the textures is twice as bright, so vertex light can go up
+// to double like the light maps of the software refresh
+#define	GX_NORMAL_LIGHT		15
+
+#define	F32(x)				((int) ((x) * 4096))
+#define	MIN(a,b)			((a) < (b) ? (a) : (b))
+#define	MAX(a,b)			((a) > (b) ? (a) : (b))
+#define	CLAMP(lo,x,hi)		((x) < (lo) ? (lo) : (x) > (hi) ? (hi) : (x))
+
+/*
+===============================================================================
+
+IMAGES
+
+===============================================================================
+*/
+
+typedef enum
+{
+	it_skin,
+	it_sprite,
+	it_wall,
+	it_pic,
+	it_sky
+} imagetype_t;
+
+typedef struct image_s
+{
+	char		name[MAX_QPATH];
+	imagetype_t	type;
+	int			width, height;			// of the picture in the file
+	int			registration_sequence;	// 0 = free
+	byte		*pixels;				// pics only, the 2D drawing reads them
+	// textures, uploaded by R_UploadTextures
+	unsigned	param;					// TEXIMAGE_PARAM, 0 while not in VRAM
+	int			scale[2];				// texels to hardware texels, 20.12
+	int			maxsize;				// largest side in VRAM
+	int			mip;					// walls: the mip level in VRAM
+	struct msurface_s	*texturechain;	// walls: the world surfaces to draw
+	struct image_s	*hashnext;			// next image with the same name hash
+} image_t;
+
+#define	MAX_RIMAGES	512
+
+extern image_t		r_images[MAX_RIMAGES];
+extern int			r_numimages;
+extern image_t		*r_notexture;
+extern int			registration_sequence;
+extern qboolean		r_registering;		// between BeginRegistration and EndRegistration
+extern unsigned		d_8to24table[256];
+extern u16			d_8to16table[256];
+
+void	R_InitImages (void);
+void	R_ShutdownImages (void);
+image_t	*R_FindImage (char *name, imagetype_t type);
+image_t	*R_RegisterSkin (char *name);
+void	R_FreeUnusedImages (void);
+void	R_UploadTextures (void);
+void	R_BindImage (image_t *image);
+void	R_SetPalette (const unsigned char *palette);
+void	R_SetGamma (float gamma);
+void	R_SetSky (char *name, float rotate, vec3_t axis);
+void	R_DrawSky (void);
+byte	*R_LoadPCX (char *name, int *width, int *height, byte *palette);
+
+/*
+===============================================================================
+
+MODELS
+
+===============================================================================
+*/
+
+// The planes are those of the file, with the normal and distance in fixed
+// point for the integer tests of the eye against them
+typedef struct mplane_s
+{
+	vec3_t	normal;
+	float	dist;
+	byte	type;			// for texture axis selection and fast side tests
+	byte	signbits;		// signx + signy<<1 + signz<<1
+	byte	pad[2];
+	int		inormal[3];		// normal * 16384
+	int		idist;			// dist * 16384 in 1/8 units
+} mplane_t;
+
+#define	SURF_PLANEBACK		2
+#define	SURF_DRAWSKY		4
+#define	SURF_DRAWTURB		0x10
+#define	SURF_UNDERWATER		0x80
+
+typedef struct mtexinfo_s
+{
+	float		vecs[2][4];
+	int			flags;
+	int			numframes;
+	struct mtexinfo_s	*next;		// animation chain
+	image_t		*image;
+} mtexinfo_t;
+
+// The hardware data of a surface: the packed texture coordinates, then the
+// vertex indices into the model's gxvertexes, word aligned, then the light
+// samples, [numstyles][numverts] of RGB
+typedef struct gxsurf_s
+{
+	byte			numverts;
+	byte			numstyles;		// light samples per vertex
+	unsigned short	pad;
+	unsigned		st[];
+} gxsurf_t;
+
+#define	GX_VERTS(gx)	((unsigned short *) ((gx)->st + (gx)->numverts))
+#define	GX_LIGHT(gx)	((byte *) GX_VERTS (gx) + (((gx)->numverts * 2 + 3) & ~3))
+#define	MAX_SURFVERTS	128
+
+typedef struct msurface_s
+{
+	int			visframe;		// should be drawn when node is crossed
+	mplane_t	*plane;
+	int			flags;
+	mtexinfo_t	*texinfo;
+	gxsurf_t	*gx;
+	struct msurface_s	*texturechain;
+	int			dlightframe;
+	int			dlightbits;
+	byte		styles[MAXLIGHTMAPS];
+	short		texturemins[2];
+	short		extents[2];
+	u16			*colors;		// the vertex colors with all styles at 1.0
+} msurface_t;
+
+typedef struct mnode_s
+{
+// common with leaf
+	int			contents;		// -1, to differentiate from leafs
+	int			visframe;		// node needs to be traversed if current
+	short		minmaxs[6];		// for bounding box culling
+	struct mnode_s	*parent;
+
+// node specific
+	mplane_t	*plane;
+	struct mnode_s	*children[2];
+	unsigned short	firstsurface;
+	unsigned short	numsurfaces;
+} mnode_t;
+
+typedef struct mleaf_s
+{
+// common with node
+	int			contents;		// wil be a negative contents number
+	int			visframe;		// node needs to be traversed if current
+	short		minmaxs[6];		// for bounding box culling
+	struct mnode_s	*parent;
+
+// leaf specific
+	int			cluster;
+	int			area;
+	msurface_t	**firstmarksurface;
+	int			nummarksurfaces;
+} mleaf_t;
+
+typedef enum {mod_bad, mod_brush, mod_sprite, mod_alias} modtype_t;
+
+// What the hardware needs of an alias model: its texture coordinates and
+// the triangle strips and lists of its GL commands
+typedef struct
+{
+	int			numverts;		// of the frames
+	int			numframes;
+	int			framesize;
+	byte		*frames;		// the frames of the file
+	unsigned	*st;			// packed texture coordinates of the commands' vertices
+	u16			*cmds;			// count, strip or list, xyz vertex and st index..., 0
+	int			numskins;
+	image_t		*skins[MAX_MD2SKINS];
+	float		radius;
+} gxalias_t;
+
+typedef struct
+{
+	int		width, height;
+	int		origin_x, origin_y;
+	image_t	*image;
+} mspriteframe_t;
+
+typedef struct
+{
+	int				numframes;
+	mspriteframe_t	frames[];
+} msprite_t;
+
+typedef struct model_s
+{
+	char		name[MAX_QPATH];
+	int			registration_sequence;
+	modtype_t	type;
+	int			numframes;
+	int			flags;
+
+	// volume occupied by the model graphics
+	vec3_t		mins, maxs;
+	float		radius;
+
+	// brush model
+	int			firstmodelsurface, nummodelsurfaces;
+
+	int			numsubmodels;
+	struct mmodel_s	*submodels;
+
+	int			numplanes;
+	mplane_t	*planes;
+
+	int			numleafs;		// number of visible leafs, not counting 0
+	mleaf_t		*leafs;
+
+	int			numvertexes;
+	unsigned	*gxvertexes;	// packed 16-bit x, y and z, 8 bytes each
+
+	int			numnodes;
+	int			firstnode;
+	mnode_t		*nodes;
+
+	int			numtexinfo;
+	mtexinfo_t	*texinfo;
+
+	int			numsurfaces;
+	msurface_t	*surfaces;
+
+	int			nummarksurfaces;
+	msurface_t	**marksurfaces;
+
+	// alias and sprite models
+	gxalias_t	*alias;
+	msprite_t	*sprite;
+
+	void		*data;			// all of a brush model's memory
+} model_t;
+
+typedef struct mmodel_s
+{
+	vec3_t	mins, maxs;
+	vec3_t	origin;
+	float	radius;
+	int		headnode;
+	int		firstface, numfaces;
+} mmodel_t;
