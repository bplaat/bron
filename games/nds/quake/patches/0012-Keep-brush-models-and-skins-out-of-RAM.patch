-byte	*mod_base;
+/*
+=================
+Mod_ReadLump
+
+Reads len bytes from ofs into a lump of the brush model being loaded
+=================
+*/
+void Mod_ReadLump (lump_t *l, int ofs, void *dest, int len)
+{
+	if (ofs < 0 || len < 0 || ofs + len > l->filelen)
+		Sys_Error ("Mod_ReadLump: bad lump in %s", loadmodel->name);
+	fseek (mod_file, mod_filebase + l->fileofs + ofs, SEEK_SET);
+	if (fread (dest, 1, len, mod_file) != len)
+		Sys_Error ("Mod_ReadLump: %s is truncated", loadmodel->name);
+}
+
+/*
+=================
+Mod_LoadLump
+
+Reads a lump into temporary memory, which the next one reuses
+=================
+*/
+void *Mod_LoadLump (lump_t *l)
+{
+	void	*buf;
+
+	buf = Hunk_TempAlloc (l->filelen);
+	if (!buf)
+		Sys_Error ("Mod_LoadLump: not enough memory for %s", loadmodel->name);
+	Mod_ReadLump (l, 0, buf, l->filelen);
+	return buf;
+}
+
+/*
+=================
+Mod_AllocGeometry
+
+On the DS the vertexes, edges and surfedges are only needed while loading,
+the 3D hardware gets its own copy of the vertices, so they go to the high
+hunk to be freed again. They are allocated before their lump is read, a high
+allocation frees the temporary memory.
+=================
+*/
+void *Mod_AllocGeometry (int size)
+{
+	void	*buf;
+
+	buf = Hunk_HighAllocName (size, loadname);
+	if (!buf)
+		Sys_Error ("Mod_AllocGeometry: not enough memory for %s", loadmodel->name);
+	return buf;
+}
 
 
