--- a/WinQuake/menu.c
+++ b/WinQuake/menu.c
@@ -64,6 +64,18 @@ qboolean	m_recursiveDraw;
 
 extern cvar_t	crosshair;
 
+// While M_PageChanged measures the page the draw functions only hash what
+// they would draw
+static qboolean	m_measuring;
+static unsigned	m_pagehash;
+
+static qboolean M_Measured (int x, int y, unsigned what)
+{
+	if (m_measuring)
+		m_pagehash = ((m_pagehash * 31 + x) * 31 + y) * 31 + what;
+	return m_measuring;
+}
+
 /*
 ================
 M_DrawCharacter
@@ -73,6 +85,8 @@ Draws one solid graphics character
 */
 void M_DrawCharacter (int cx, int line, int num)
 {
+	if (M_Measured (cx, line, num))
+		return;
 	Draw_Character ( cx + ((vid.width - 320)>>1), line, num);
 }
 
@@ -98,11 +112,36 @@ void M_PrintWhite (int cx, int cy, char *str)
 
 void M_DrawTransPic (int x, int y, qpic_t *pic)
 {
+	if (M_Measured (x, y, (unsigned) pic))
+		return;
 	Draw_TransPic (x + ((vid.width - 320)>>1), y, pic);
 }
 
+// The cursor, left out when M_CenterPage finds the page: it moves and
+// spins, the page would wobble with it
+static int	cursor_x, cursor_y, cursor_w, cursor_h;
+
+static void M_DrawCursorPic (int x, int y, qpic_t *pic)
+{
+	M_DrawTransPic (x, y, pic);
+	cursor_x = x + ((vid.width - 320)>>1);
+	cursor_y = y;
+	cursor_w = pic->width;
+	cursor_h = pic->height;
+}
+
+static void M_DrawCursorCharacter (int cx, int line)
+{
+	M_DrawCharacter (cx, line, 12+((int)(realtime*4)&1));
+	cursor_x = cx + ((vid.width - 320)>>1);
+	cursor_y = line;
+	cursor_w = cursor_h = 8;
+}
+
 void M_DrawPic (int x, int y, qpic_t *pic)
 {
+	if (M_Measured (x, y, (unsigned) pic + 1))
+		return;
 	Draw_Pic (x + ((vid.width - 320)>>1), y, pic);
 }
 
