@@ -1177,6 +1221,88 @@ void M_Init (void)
 }
 
 
+static inline qboolean M_OnPage (byte *row, int x, int y)
+{
+	return row[x] != 255 && (x < cursor_x || x >= cursor_x + cursor_w
+		|| y < cursor_y || y >= cursor_y + cursor_h);
+}
+
+/*
+================
+M_CenterPage
+
+Shows the page the menu drew on its transparent background (255) in the
+middle of the screen, like DOOM's menus on the DS, the cursor moves along
+================
+*/
+void M_CenterPage (void)
+{
+	int		x, y, top = -1, bottom = 0, left = vid.width, right = 0;
+	byte	*row;
+
+	if (m_state == m_quit && wasInMenus)
+		return;
+
+	// the first and last pixel of the page on each row, over the background
+	// four at a time
+	for (y = 0, row = vid.buffer ; y < vid.height ; y++, row += vid.rowbytes)
+	{
+		for (x = 0 ; x < vid.width ; x++)
+			if (!(x & 3) && *(unsigned *)(row + x) == 0xffffffff)
+				x += 3;
+			else if (M_OnPage (row, x, y))
+				break;
+		if (x >= vid.width)
+			continue;
+		if (top < 0)
+			top = y;
+		bottom = y;
+		if (x < left)
+			left = x;
+		for (x = vid.width - 1 ; x > right ; x--)
+			if ((x & 3) == 3 && *(unsigned *)(row + x - 3) == 0xffffffff)
+				x -= 3;
+			else if (M_OnPage (row, x, y))
+				break;
+		if (x > right)
+			right = x;
+	}
+	cursor_w = cursor_h = 0;
+	if (top < 0)
+		m_pagedx = m_pagedy = 0;
+	else
+	{
+		m_pagedx = (vid.width - (right - left + 1)) / 2 - left;
+		m_pagedy = (vid.height - (bottom - top + 1)) / 2 - top;
+	}
+	VID_MoveMenu (m_pagedx, m_pagedy);
+}
+
+/*
+================
+M_PageChanged
+
+Whether M_Draw would draw another page than it did the last frame, it runs
+it without drawing
+================
+*/
+qboolean M_PageChanged (void)
+{
+	static unsigned	lasthash;
+	static int		lastframe = -2;
+	qboolean		changed;
+
+	m_measuring = true;
+	m_pagehash = 0;
+	M_Draw ();
+	m_measuring = false;
+	cursor_w = cursor_h = 0;
+	changed = m_pagehash != lasthash || host_framecount != lastframe + 1;
+	lasthash = m_pagehash;
+	lastframe = host_framecount;
+	return changed;
+}
+
 void M_Draw (void)
 {
 	if (m_state == m_none || key_dest != key_menu)
@@ -1186,17 +1312,8 @@ void M_Draw (void)
 	{
 		scr_copyeverything = 1;
 
-		if (scr_con_current)
-		{
-			Draw_ConsoleBackground (vid.height);
-			VID_UnlockBuffer ();
-			S_ExtraUpdate ();
-			VID_LockBuffer ();
-		}
-		else
-			Draw_FadeScreen ();
-
-		scr_fullupdate = 0;
+		// the menu is on the top screen, the renderer dims the view and the
+		// touch screen keeps what it shows
 	}
 	else
 	{
