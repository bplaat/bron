+================
+VID_Flush3D
+
+Swaps the 3D buffers at the next vblank, the next 3D command waits for it.
+The frame is depth tested on w (r_nds.c)
+================
+*/
+void VID_Flush3D (void)
+{
+	GFX_FLUSH = 2;
+}
+
+// Frames per second of the last second, in the top right corner
+static void VID_DrawFPS (void)
+{
+	static double	lasttime;
+	static int		frames, totalframes;
+	static char		text[16];
+	char			log[48];
+
+	frames++;
+	totalframes++;
+	if (realtime - lasttime >= 1)
+	{
+		snprintf (text, sizeof(text), "%.0f fps", frames / (realtime - lasttime));
+		if (vid_showfps.value > 1)
+		{
+			snprintf (log, sizeof(log), "FPS %d %.3f\n", totalframes, realtime);
+			nocashMessage (log);
+		}
+		frames = 0;
+		lasttime = realtime;
+	}
+	vid_textlayer = true;
+	Draw_String (TEXT_WIDTH - strlen (text) * 8, 0, text);
+	vid_textlayer = false;
+}
+
+void VID_Update (vrect_t *rects)
+{
+	qboolean showmenu = !scr_drawloading && (key_dest == key_menu || scr_drawdialog);
+
+	if (!touchscreen && ((!con_forcedup && !scr_drawloading)
+		|| (key_dest == key_menu && cls.state == ca_disconnected && cls.demonum == -1)))
+		VID_InitTouchScreen ();
+	if (touchscreen && showmenu != menu_shown)
+	{
+		menu_shown = showmenu;
+		VID_SetLayers ();
+	}
+	if (vid_showfps.value)
+		VID_DrawFPS ();
+	VID_UpdateText ();
+
+	if (smoothing != (vid_smooth.value != 0) && touchscreen)
+	{
+		smoothing = vid_smooth.value != 0;
+		VID_SetLayers ();
+	}
+	if (touchscreen)
+		VID_CopyRows ();
+}
