 WinQuake/Makefile.nds | 41 +++++++++++++++++++
 WinQuake/fcmp_nds.s   | 94 +++++++++++++++++++++++++++++++++++++++++++
 WinQuake/mathlib.c    |  2 +-
 WinQuake/model.c      |  2 +-
 WinQuake/pr_exec.c    |  2 +-
 WinQuake/quakedef.h   |  3 ++
 WinQuake/r_light.c    |  2 +-
 WinQuake/r_part.c     |  2 +-
 9 files changed, 147 insertions(+), 5 deletions(-)
