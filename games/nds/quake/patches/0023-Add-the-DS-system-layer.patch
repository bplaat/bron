+// sys_nds.c -- Nintendo DS system driver
+//
+// Quake runs in its own thread, the ARM9 main stack lives in the 16 KiB DTCM
+// and Quake keeps arrays of up to 32 KiB on the stack. The hunk takes all RAM that is
+// left, 4 MiB on the DS and 16 MiB on the DSi. Game data comes from NitroFS
+// (embedded in the ROM) and /data/quake/ on the SD card, which also holds
+// the config and savegames. The player is named after the DS user.
+
+#include "quakedef.h"
+
+#include <nds.h>
+#include <fat.h>
+#include <filesystem.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+#define DATA_DIR		"/data/quake"
+#define QUAKE_STACK_SIZE	(64 * 1024)
+// Memory left outside the hunk for libc, which needs little once running
+#define HUNK_RESERVE		(64 * 1024)
+#define MAX_ARGS		32
+
+qboolean	isDedicated = false;
+
+static Thread	quake_thread;
+static qboolean	textconsole = true;	// the touch screen shows the text console
+static qboolean	loadingdots = true;	// with a dot for some lines of the log
+static int		loglines;
+
+#define LOG_LINES_PER_DOT	7		// the startup fills about a row, like DOOM's
+#define LOG_DOTS			28		// a row with two columns of margin on both sides
+#define LOG_ROWS			2
+static TickTask	tick_task;
+
+// The tick counter behind Sys_FloatTime only runs while a tick task is
+// scheduled, this one keeps it going
+static void Sys_TickTask (TickTask *t)
+{
+}
+
+/*
+===============================================================================
+
+FILE IO
+
+===============================================================================
+*/
+
+#define MAX_HANDLES		10
+static FILE	*sys_handles[MAX_HANDLES];
+
+static int findhandle (void)
+{
+	int	i;
+
+	for (i = 1; i < MAX_HANDLES; i++)
+		if (!sys_handles[i])
+			return i;
+	Sys_Error ("out of handles");
+	return -1;
+}
+
+static int filelength (FILE *f)
+{
+	int	pos, end;
+
+	pos = ftell (f);
+	fseek (f, 0, SEEK_END);
+	end = ftell (f);
+	fseek (f, pos, SEEK_SET);
+	return end;
+}
+
+int Sys_FileOpenRead (char *path, int *hndl)
+{
+	FILE	*f;
+	int	i;
+
+	i = findhandle ();
+	f = fopen (path, "rb");
+	if (!f)
+	{
+		*hndl = -1;
+		return -1;
+	}
+	sys_handles[i] = f;
+	*hndl = i;
+	return filelength (f);
+}
+
+int Sys_FileOpenWrite (char *path)
+{
+	FILE	*f;
+	int	i;
+
+	i = findhandle ();
+	f = fopen (path, "wb");
+	if (!f)
+		return -1;
+	sys_handles[i] = f;
+	return i;
+}
+
+void Sys_FileClose (int handle)
+{
+	fclose (sys_handles[handle]);
+	sys_handles[handle] = NULL;
+}
+
+void Sys_FileSeek (int handle, int position)
+{
+	fseek (sys_handles[handle], position, SEEK_SET);
+}
+
+int Sys_FileRead (int handle, void *dest, int count)
+{
+	return fread (dest, 1, count, sys_handles[handle]);
+}
+
+int Sys_FileWrite (int handle, void *data, int count)
+{
+	return fwrite (data, 1, count, sys_handles[handle]);
+}
+
+int Sys_FileTime (char *path)
+{
+	struct stat	st;
+
+	return stat (path, &st) == 0 ? st.st_mtime : -1;
+}
+
+void Sys_mkdir (char *path)
+{
+	mkdir (path, 0777);
+}
+
+/*
+===============================================================================
+
+SYSTEM IO
+
+===============================================================================
+*/
+
+void Sys_MakeCodeWriteable (unsigned long startaddr, unsigned long length)
+{
+}
+
+void Sys_DebugLog (char *file, char *fmt, ...)
+{
+}
+
+// Prints Quake text on the touch screen console and to the no$gba debug
+// output of emulators: the high bit selects the red font and the low
+// characters are graphics, like the separator lines
+static void Sys_PrintText (const char *text)
+{
+	static char	plain[1024];	// emulators can't read it from the DTCM stack
+	char		*out = plain;
+	int			c, dot;
+
+	for (; *text && out < plain + sizeof(plain) - 1; text++)
+	{
+		c = *text & 0x7f;
+		if (c >= 29 && c <= 31)
+			c = '-';
+		if (c >= ' ' || c == '\n')
+			*out++ = c;
+	}
+	*out = 0;
+	// while Quake starts, a dot for every few lines on the touch screen, in
+	// rows as wide as the text, its log is far too wide for the 32 column
+	// console
+	if (textconsole && loadingdots)
+	{
+		for (out = plain; *out; out++)
+			if (*out == '\n' && !(++loglines % LOG_LINES_PER_DOT)
+				&& loglines <= LOG_ROWS * LOG_DOTS * LOG_LINES_PER_DOT)
+			{
+				dot = loglines / LOG_LINES_PER_DOT;
+				if (dot > 1 && (dot - 1) % LOG_DOTS == 0)
+					fputs ("\n  ", stdout);
+				putchar ('.');
+			}
+	}
+	else if (textconsole)
+		fputs (plain, stdout);
+	nocashMessage (plain);
+}
+
+// The text console of the touch screen, its red (31) is Quake's brown
+static void Sys_TextConsole (void)
+{
+	consoleDemoInit ();
+	BG_PALETTE_SUB[1 * 16 + 15] = RGB15 (13, 9, 4);
+	BG_PALETTE_SUB[9 * 16 + 15] = RGB15 (27, 18, 8);
+}
+
+void Sys_EndTextConsole (void)
+{
+	textconsole = false;
+}
+
+void Sys_Printf (char *fmt, ...)
+{
+	va_list	argptr;
+	char	text[1024];
+
+	va_start (argptr, fmt);
+	vsnprintf (text, sizeof(text), fmt, argptr);
+	va_end (argptr);
+	Sys_PrintText (text);
+}
+
+void Sys_Error (char *error, ...)
+{
+	va_list	argptr;
+	char	text[1024];
+
+	va_start (argptr, error);
+	vsnprintf (text, sizeof(text), error, argptr);
+	va_end (argptr);
+
+	if (shm)
+		SNDDMA_Shutdown ();
+	// the video driver no longer copies Quake's palette over the console's
+	VID_Shutdown ();
+	if (!textconsole)
+	{
+		Sys_TextConsole ();
+		textconsole = true;
+	}
+	loadingdots = false;
+	printf ("\n\n\x1b[31;1m  Quake had to stop\x1b[39;0m\n\n");
+	Sys_PrintText (text);
+	printf ("\n\n\x1b[30;1m  Press START to exit\x1b[39;0m\n");
+	do
+	{
+		threadWaitForVBlank ();
+		scanKeys ();
+	} while (pmMainLoop () && !(keysDown () & KEY_START));
+	exit (1);
+}
+
+void Sys_Quit (void)
+{
+	exit (0);
+}
+
+double Sys_FloatTime (void)
+{
+	// in double precision, constants are single precision (Makefile.nds)
+	return (double) tickGetCount () / TICK_FREQ;
+}
+
+char *Sys_ConsoleInput (void)
+{
+	return NULL;
+}
+
+void Sys_Sleep (void)
+{
+}
+
+void Sys_HighFPPrecision (void)
+{
+}
+
+void Sys_LowFPPrecision (void)
+{
+}
+
+//=============================================================================
+
+// The game the startup says it loads: a mission pack or mod given with
+// -game, else the full game when pak1.pak is there, else the shareware.
+// The names fit in the 32 columns of the touch screen.
+static const char *Sys_GameTitle (int argc, char **argv)
+{
+	static char	*packs[][2] =
+	{
+		{"hipnotic", "Quake Mission Pack 1"},
+		{"rogue", "Quake Mission Pack 2"},
+	};
+	static char	title[24];
+	struct stat	st;
+	int			i, j;
+
+	for (i = 1; i < argc - 1; i++)
+		if (!Q_strcasecmp (argv[i], "-game"))
+		{
+			for (j = 0; j < sizeof(packs) / sizeof(packs[0]); j++)
+				if (!Q_strcasecmp (argv[i + 1], packs[j][0]))
+					return packs[j][1];
+			snprintf (title, sizeof(title), "%s", argv[i + 1]);
+			return title;
+		}
+	if (!stat ("nitro:/" GAMENAME "/pak1.pak", &st) || !stat (DATA_DIR "/" GAMENAME "/pak1.pak", &st))
+		return "Quake";
+	return "Quake Shareware";
+}
+
+// Extra command line options (eg. -game hipnotic or +map e1m2) can be put in
+// /data/quake/args.txt, separated by whitespace
+static void Sys_ReadArgs (int *argc, char **argv)
+{
+	static char	text[512];
+	char		*p;
+	FILE		*f;
+	int		len;
+
+	if (!(f = fopen (DATA_DIR "/args.txt", "r")))
+		return;
+	len = fread (text, 1, sizeof(text) - 1, f);
+	fclose (f);
+	text[len] = 0;
+
+	for (p = strtok (text, " \t\r\n"); p && *argc < MAX_ARGS; p = strtok (NULL, " \t\r\n"))
+		argv[(*argc)++] = p;
+}
+
+// The user name of the DS settings is the player's name, after the config
+static void Sys_SetPlayerName (void)
+{
+	char	name[16];
+	int		i, n = 0;
+
+	for (i = 0; i < PersonalData->nameLen && i < 10; i++)
+		if (PersonalData->name[i] >= ' ' && PersonalData->name[i] < 127 && PersonalData->name[i] != '"')
+			name[n++] = PersonalData->name[i];
+	name[n] = 0;
+	if (n)
+		Cbuf_AddText (va ("name \"%s\"\n", name));
+}
+
+static int Sys_QuakeMain (void *arg)
+{
+	double	time, oldtime, newtime;
+
+	Host_Init (arg);
+	Sys_SetPlayerName ();
+	oldtime = Sys_FloatTime ();
+	for (;;)
+	{
+		newtime = Sys_FloatTime ();
+		time = newtime - oldtime;
+		oldtime = newtime;
+		Host_Frame (time);
+	}
+	return 0;
+}
+
+int main (int argc, char **argv)
+{
+	extern char		*fake_heap_end;
+	static quakeparms_t	parms;
+	static char		*quake_argv[MAX_ARGS + 1] = { "quake" };
+	int			quake_argc = 1;
+	void			*stack;
+
+	// In DSi mode the ARM9 runs at twice the speed of the DS
+	if (isDSiMode ())
+		setCpuClock (true);
+
+	tickTaskStart (&tick_task, Sys_TickTask, ticksFromHz (1), ticksFromHz (1));
+	Sys_TextConsole ();
+	printf ("\x1b[31;1m  Quake\x1b[39;0m for Nintendo %s\n", isDSiMode () ? "DSi" : "DS");
+	printf ("\x1b[31m--------------------------------\x1b[39m");
+
+	nitroFSInit (NULL);
+	if (fatInitDefault ())
+	{
+		Sys_mkdir ("/data");
+		Sys_mkdir (DATA_DIR);
+		Sys_mkdir (DATA_DIR "/" GAMENAME);
+		parms.basedir = DATA_DIR;
+		Sys_ReadArgs (&quake_argc, quake_argv);
+	}
+	else
+	{
+		// Without an SD card everything comes from the ROM and nothing is saved
+		printf ("\x1b[33;1m  No SD card, saving is off\x1b[39;0m\n");
+		parms.basedir = "nitro:";
+	}
+	printf ("\n  Loading %s\n\n  ", Sys_GameTitle (quake_argc, quake_argv));
+
+	COM_InitArgv (quake_argc, quake_argv);
+	parms.argc = com_argc;
+	parms.argv = com_argv;
+
+	stack = malloc (QUAKE_STACK_SIZE);
+	parms.memsize = (fake_heap_end - (char *) sbrk (0)) - HUNK_RESERVE;
+	parms.membase = malloc (parms.memsize);
+	if (!stack || !parms.membase)
+		Sys_Error ("Unable to allocate %i KiB of RAM", parms.memsize / 1024);
+
+	threadPrepare (&quake_thread, Sys_QuakeMain, &parms, (char *) stack + QUAKE_STACK_SIZE, MAIN_THREAD_PRIO);
+	threadStart (&quake_thread);
+	return threadJoin (&quake_thread);
+}
