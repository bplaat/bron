+/*
+==============
+Cache_AllocUnused
+
+Like Cache_Alloc, but only pushes out data that wasn't used in the last
+frames, else returns NULL: data that can wait, like a sound, would push out
+a model drawn every frame, which would push it out again, every frame
+==============
+*/
+void *Cache_AllocUnused (cache_user_t *c, int size, char *name)
+{
+	return Cache_AllocSpare (c, size, name, CACHE_SPARE_FRAMES);
+}
+
+/*
+==============
+Cache_RoomUnused
+
+Whether size bytes fit in the cache without pushing out data used in the
+last frames, roughly: the free space may not be in one piece
+==============
+*/
+qboolean Cache_RoomUnused (int size)
+{
+	cache_system_t	*cs;
+	int				room = hunk_size - hunk_low_used - hunk_high_used;
+
+	for (cs = cache_head.next ; cs != &cache_head ; cs = cs->next)
+		if (host_framecount - cs->lastused < CACHE_SPARE_FRAMES)
+			room -= cs->size;
+	return room >= size;
+}
+
 /*
 ==============
 Cache_Alloc
 ==============
 */
 void *Cache_Alloc (cache_user_t *c, int size, char *name)
+{
+	return Cache_AllocSpare (c, size, name, 0);
+}
+
+/*
+==============
+Cache_AllocSpare
+
+Pushes out the least recently used data until size fits, none used in the
+last spare frames
+==============
+*/
+static void *Cache_AllocSpare (cache_user_t *c, int size, char *name, int spare)
 {
 	cache_system_t	*cs;
 
@@ -912,6 +977,8 @@ void *Cache_Alloc (cache_user_t *c, int size, char *name)
 		if (cache_head.lru_prev == &cache_head)
 			Sys_Error ("Cache_Alloc: out of memory");
 													// not enough memory at all
+		if (spare && host_framecount - cache_head.lru_prev->lastused < spare)
+			return NULL;
 		Cache_Free ( cache_head.lru_prev->user );
 	} 
 	
