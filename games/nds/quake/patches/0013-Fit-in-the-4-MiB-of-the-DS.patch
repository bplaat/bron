+sfxcache_t *S_LoadSound (sfx_t *s)
+{
+	return S_LoadSoundWith (s, Cache_Alloc);
+}
+
+// For a driver that loads what plays every frame: the sound waits until
+// there's room instead of pushing out what was just used, also for the
+// file, which is read into temporary memory first
+sfxcache_t *S_LoadSoundUnused (sfx_t *s)
+{
+	char	namebuffer[256];
+	int		len, h;
+
+	if (!Cache_Check (&s->cache))
+	{
+		sprintf (namebuffer, "sound/%s", s->name);
+		len = COM_OpenFile (namebuffer, &h);
+		if (h != -1)
+			COM_CloseFile (h);
+		if (!Cache_RoomUnused (2 * len + 1024))
+			return NULL;
+	}
+	return S_LoadSoundWith (s, Cache_AllocUnused);
+}
