+	mspriteframe_t	*frame;
+	int				width, height;
+	int				maxsize;	// VRAM size limit, lowered until all fit
+	int				stverts;	// offset of a skin's texture coordinates in the file
+	gxtex_t			tex;		// a skin's texture once uploaded
+} modeltex_t;
+
