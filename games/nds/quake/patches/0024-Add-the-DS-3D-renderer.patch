+/*
+===============================================================================
+
+BRUSH MODELS
+
+===============================================================================
+*/
+
+static int R_SurfaceStyles (msurface_t *surf)
+{
+	int	numstyles = 0;
+
+	if (surf->samples && !(surf->flags & SURF_DRAWTILED))
+		while (numstyles < MAXLIGHTMAPS && surf->styles[numstyles] != 255)
+			numstyles++;
+	return numstyles;
+}
+
+// gxsurf_t, texture coordinates, vertex indices and light, word aligned
+static int R_SurfaceSize (msurface_t *surf, int n)
+{
+	return (sizeof(gxsurf_t) + n * 4 + ((n * 2 + 3) & ~3) + R_SurfaceStyles (surf) * n + 3) & ~3;
+}
+
+#define	TJ_CELL			7		// 16 units in 1/8 units
+#define	TJ_CELLOF(x)	(((x) + 64) >> TJ_CELL)	// half a cell off the walls on the 16 unit grid
+#define	TJ_HASH			8192
+#define	TJ_MAXINSERT	32		// vertices added to an edge
+
+static int R_TJHash (int cx, int cy, int cz)
+{
+	return (cx * 73856093 ^ cy * 19349663 ^ cz * 83492791) & (TJ_HASH - 1);
+}
+
+/*
+================
+R_EdgeTJunctions
+
+A vertex of one face in the middle of an edge of another is a T-junction,
+the hardware leaves a crack along that edge. The vertices on each edge, at
+most 1/8 unit off it, are found through a hash of the vertex positions by
+16 unit cells. Returns them for R_SurfaceVerts, at offset ecache[edge] the
+number of them, then the vertices from v[0] to v[1]. In high hunk memory,
+freed with the rest of the geometry.
+================
+*/
+#define	TJ_END		0xffff
+
+// ARM code, the loading time is mostly spent here
+__attribute__((target("arm")))
+static unsigned short *R_EdgeTJunctions (model_t *mod, unsigned short **ecache)
+{
+	unsigned short	*head, *next, *elist, *ec;
+	int				i, k, a, b, v, n, total, max, x[3], lo[3], hi[3], c[3], ins[TJ_MAXINSERT];
+	int				d[3], w[3], dot, len2, len, cr, sh, at[TJ_MAXINSERT];
+
+	// positions from the hardware vertices
+#define	TJ_POS(v, k)	((k) == 2 ? (short) (mod->gxvertexes[(v) * 2 + 1] & 0xffff) : \
+						 (short) (mod->gxvertexes[(v) * 2] >> ((k) * 16)))
+
+	head = Hunk_HighAllocName (TJ_HASH * sizeof(*head), "tjhash");
+	next = Hunk_HighAllocName (mod->numvertexes * sizeof(*next), "tjnext");
+	for (i = 0; i < TJ_HASH; i++)
+		head[i] = TJ_END;
+	for (i = 0; i < mod->numvertexes; i++)
+	{
+		k = R_TJHash (TJ_CELLOF (TJ_POS (i, 0)), TJ_CELLOF (TJ_POS (i, 1)), TJ_CELLOF (TJ_POS (i, 2)));
+		next[i] = head[k];
+		head[k] = i;
+	}
+
+	ec = *ecache = Hunk_HighAllocName (mod->numedges * sizeof(*ec), "tjedges");
+	max = MIN (mod->numedges * 2, TJ_END);
+	elist = Hunk_HighAllocName (max * sizeof(*elist), "tjins");
+	total = 0;
+	for (i = 0; i < mod->numedges; i++)
+	{
+		if (total >= max)
+		{
+			ec[i] = TJ_END;
+			continue;
+		}
+		a = mod->edges[i].v[0];
+		b = mod->edges[i].v[1];
+		for (k = 0; k < 3; k++)
+		{
+			x[k] = TJ_POS (a, k);
+			lo[k] = MIN (x[k], TJ_POS (b, k)) - 1;
+			hi[k] = MAX (x[k], TJ_POS (b, k)) + 1;
+			d[k] = TJ_POS (b, k) - x[k];
+		}
+		// in 32 bits, longer edges than 2048 units are worked out in
+		// coarser steps
+		n = 0;
+		for (sh = 0; MAX (abs (d[0]), MAX (abs (d[1]), abs (d[2]))) >> sh >= 16384; sh++)
+			;
+		for (k = 0; k < 3; k++)
+			d[k] >>= sh;
+		len2 = d[0] * d[0] + d[1] * d[1] + d[2] * d[2];
+		len = sqrt32 (len2);
+		for (c[2] = TJ_CELLOF (lo[2]); c[2] <= TJ_CELLOF (hi[2]); c[2]++)
+			for (c[1] = TJ_CELLOF (lo[1]); c[1] <= TJ_CELLOF (hi[1]); c[1]++)
+				for (c[0] = TJ_CELLOF (lo[0]); c[0] <= TJ_CELLOF (hi[0]); c[0]++)
+					for (v = head[R_TJHash (c[0], c[1], c[2])]; v != TJ_END; v = next[v])
+					{
+						if (v == a || v == b)
+							continue;
+						for (k = 0; k < 3; k++)
+						{
+							w[k] = TJ_POS (v, k);
+							if (w[k] < lo[k] || w[k] > hi[k] || TJ_CELLOF (w[k]) != c[k])
+								break;
+							w[k] = (w[k] - x[k]) >> sh;
+						}
+						if (k < 3)
+							continue;
+						dot = d[0] * w[0] + d[1] * w[1] + d[2] * w[2];
+						if (dot <= 0 || dot >= len2)
+							continue;
+						// the distance to the edge is |d x w| / |d|
+						cr = abs (d[1] * w[2] - d[2] * w[1]) + abs (d[2] * w[0] - d[0] * w[2])
+							+ abs (d[0] * w[1] - d[1] * w[0]);
+						if (cr > len + len)
+							continue;
+						for (k = 0; k < n && at[k] != dot; k++)
+							;
+						if (k < n)
+							continue;	// a vertex at the same place
+						for (k = n; k > 0 && at[k - 1] > dot; k--)
+							if (k < TJ_MAXINSERT)
+							{
+								ins[k] = ins[k - 1];
+								at[k] = at[k - 1];
+							}
+						if (k < TJ_MAXINSERT)
+						{
+							ins[k] = v;
+							at[k] = dot;
+							n = MIN (n + 1, TJ_MAXINSERT);
+						}
+					}
+		n = MIN (n, max - total - 1);
+		ec[i] = total;
+		elist[total++] = n;
+		for (k = 0; k < n; k++)
+			elist[total++] = ins[k];
+	}
+#undef	TJ_POS
+	return elist;
+}
+
+// The vertices of a surface with those of its T-junctions, into out unless
+// it's NULL, returns how many
+static int R_SurfaceVerts (model_t *mod, msurface_t *surf, unsigned short *elist, unsigned short *ecache,
+	unsigned short *out)
+{
+	int				j, k, e, n = 0, num;
+	unsigned short	*ins;
+
+	for (j = 0; j < surf->numedges && n < MAX_SURFVERTS; j++)
+	{
+		e = mod->surfedges[surf->firstedge + j];
+		if (out)
+			out[n] = e >= 0 ? mod->edges[e].v[0] : mod->edges[-e].v[1];
+		n++;
+		if (ecache[abs (e)] == TJ_END)
+			continue;
+		ins = elist + ecache[abs (e)];
+		num = *ins++;
+		// backwards on a face that has the edge the other way around
+		for (k = 0; k < num && n < MAX_SURFVERTS; k++, n++)
+			if (out)
+				out[n] = ins[e >= 0 ? k : num - 1 - k];
+	}
+	return n;
+}
+
+/*
+================
+R_StripStart
+
+The 3D hardware tells the side a polygon faces from its first three
+vertices, i, j and j' of each quad of R_EmitSurface's strip. In a line it
+can get that wrong, then it leaves the edges that run more across than down
+unfilled. Returns the first vertex to start the strip at that keeps them a
+unit from a line, a T-junction is in a line with its edge. The vertices are
+there twice, one after the other.
+================
+*/
+__attribute__((target("arm")))
+static int R_StripStart (model_t *mod, msurface_t *surf, unsigned short *verts, int n)
+{
+	int			r, k, j, a0, a1, d[3][2];
+	long long	c;
+	unsigned	*pos;
+
+	// in the plane seen along the axis it's most across, in the 1/8 units of
+	// the vertices: the cross product over the larger side of j to j' is 8
+	// times the distance of i from their line
+	a0 = (surf->plane->type + 1) % 3;
+	a1 = (surf->plane->type + 2) % 3;
+	for (r = 0; r < n; r++)
+	{
+		for (k = 0; k < (n - 1) / 2; k++)
+		{
+			for (j = 0; j < 3; j++)
+			{
+				pos = mod->gxvertexes + verts[j ? r + n - k - j + 1 : r + k + 1] * 2;
+				d[j][0] = a0 == 2 ? (short) pos[1] : (short) (pos[0] >> (a0 * 16));
+				d[j][1] = a1 == 2 ? (short) pos[1] : (short) (pos[0] >> (a1 * 16));
+			}
+			c = (long long) (d[0][0] - d[1][0]) * (d[2][1] - d[1][1]) -
+				(long long) (d[0][1] - d[1][1]) * (d[2][0] - d[1][0]);
+			if ((c < 0 ? -c : c) < MAX (abs (d[2][0] - d[1][0]), abs (d[2][1] - d[1][1])) * VERTEX_SCALE)
+				break;
+		}
+		if (k == (n - 1) / 2)
+			return r;
+	}
+	return 0;
+}
+
+/*
+================
+R_BuildSurfaces
+
+Called by Mod_LoadBrushModel once the faces are loaded, packs the vertices,
+texture coordinates and light samples for the 3D hardware
+================
+*/
+void R_BuildSurfaces (model_t *mod)
+{
+	int			i, j, k, n, x, y, z, numstyles, smax, tmax, ls, lt, size;
+	unsigned short	*elist, *ecache;
+	byte		*data;
+	msurface_t	*surf;
+	mvertex_t	*v;
+	mtexinfo_t	*tex;
+	gxsurf_t	*gx;
+	float		st[MAX_SURFVERTS][2], mins[2], base[2];
+	unsigned	*out;
+	unsigned short	*verts, start[MAX_SURFVERTS * 2];
+	byte		*light;
+
+	for (i = 0; i < mod->numplanes; i++)
+	{
+		for (j = 0; j < 3; j++)
+			mod->planes[i].inormal[j] = mod->planes[i].normal[j] * 16384;
+		mod->planes[i].idist = mod->planes[i].dist * (VERTEX_SCALE * 16384);
+	}
+	for (i = 0, tex = mod->texinfo; i < mod->numtexinfo; i++, tex++)
+	{
+		for (j = 0; j < 2; j++)
+		{
+			for (k = 0; k < 3; k++)
+				tex->ivecs[j][k] = tex->vecs[j][k] * (32768 / VERTEX_SCALE);
+			tex->ivecs[j][3] = tex->vecs[j][3] * 32768;
+		}
+	}
+
+	out = mod->gxvertexes = Hunk_AllocName (mod->numvertexes * 8, "gxverts");
+	for (i = 0, v = mod->vertexes; i < mod->numvertexes; i++, v++)
+	{
+		x = CLAMP (-32768, (int) (v->position[0] * VERTEX_SCALE), 32767);
+		y = CLAMP (-32768, (int) (v->position[1] * VERTEX_SCALE), 32767);
+		z = CLAMP (-32768, (int) (v->position[2] * VERTEX_SCALE), 32767);
+		*out++ = VERTEX_PACK (x, y);
+		*out++ = z & 0xffff;
+	}
+
+	elist = R_EdgeTJunctions (mod, &ecache);
+
+	// all surfaces in one allocation, the hunk rounds each up to 16 bytes
+	size = 0;
+	for (i = 0, surf = mod->surfaces; i < mod->numsurfaces; i++, surf++)
+		size += R_SurfaceSize (surf, R_SurfaceVerts (mod, surf, elist, ecache, NULL));
+	data = Hunk_AllocName (size, "gxsurf");
+
+	for (i = 0, surf = mod->surfaces; i < mod->numsurfaces; i++, surf++)
+	{
+		n = R_SurfaceVerts (mod, surf, elist, ecache, NULL);
+		tex = surf->texinfo;
+		numstyles = R_SurfaceStyles (surf);
+
+		gx = surf->gx = (gxsurf_t *)data;
+		data += R_SurfaceSize (surf, n);
+		gx->numverts = n;
+		gx->numstyles = numstyles;
+		verts = GX_VERTS (gx);
+		light = GX_LIGHT (gx);
+
+		mins[0] = mins[1] = 999999;
+		R_SurfaceVerts (mod, surf, elist, ecache, start);
+		memcpy (start + n, start, n * sizeof(*start));
+		k = R_StripStart (mod, surf, start, n);
+		memcpy (verts, start + k, n * sizeof(*verts));
+		for (j = 0; j < n; j++)
+		{
+			v = &mod->vertexes[verts[j]];
+			for (k = 0; k < 2; k++)
+			{
+				st[j][k] = DotProduct (v->position, tex->vecs[k]) + tex->vecs[k][3];
+				if (st[j][k] < mins[k])
+					mins[k] = st[j][k];
+			}
+		}
+
+		// start near 0, the hardware only takes 12 bits of texels
+		base[0] = floorf (mins[0] / tex->texture->width) * tex->texture->width;
+		base[1] = floorf (mins[1] / tex->texture->height) * tex->texture->height;
+
+		smax = (surf->extents[0] >> 4) + 1;
+		tmax = (surf->extents[1] >> 4) + 1;
+		for (j = 0; j < n; j++)
+		{
+			x = CLAMP (-32768, (int) ((st[j][0] - base[0]) * ST_SCALE), 32767);
+			y = CLAMP (-32768, (int) ((st[j][1] - base[1]) * ST_SCALE), 32767);
+			gx->st[j] = TEXTURE_PACK (x, y);
+
+			ls = CLAMP (0, (int) ((st[j][0] - surf->texturemins[0]) * (1.0f / 16) + 0.5f), smax - 1);
+			lt = CLAMP (0, (int) ((st[j][1] - surf->texturemins[1]) * (1.0f / 16) + 0.5f), tmax - 1);
+			for (k = 0; k < numstyles; k++)
+				light[k * n + j] = surf->samples[k * smax * tmax + lt * smax + ls];
+		}
+	}
+}
+
+/*
+================
+R_SurfaceLight
+
+Called by RecursiveLightPoint for the light at texture position ds, dt of
+a world surface: the vertex light of its nearest vertex
+================
+*/
+int R_SurfaceLight (msurface_t *surf, int ds, int dt)
+{
+	gxsurf_t	*gx = surf->gx;
+	mtexinfo_t	*tex = surf->texinfo;
+	unsigned	*pos;
+	vec3_t		v;
+	float		s, t, d, best = 1e30;
+	int			i, k, nearest = 0, l = 0;
+
+	if (!gx->numstyles)
+		return 0;
+
+	for (i = 0; i < gx->numverts; i++)
+	{
+		pos = cl.worldmodel->gxvertexes + GX_VERTS (gx)[i] * 2;
+		v[0] = (short) (pos[0] & 0xffff) * (1.0f / VERTEX_SCALE);
+		v[1] = (short) (pos[0] >> 16) * (1.0f / VERTEX_SCALE);
+		v[2] = (short) (pos[1] & 0xffff) * (1.0f / VERTEX_SCALE);
+		s = DotProduct (v, tex->vecs[0]) + tex->vecs[0][3] - surf->texturemins[0] - ds;
+		t = DotProduct (v, tex->vecs[1]) + tex->vecs[1][3] - surf->texturemins[1] - dt;
+		d = s * s + t * t;
+		if (d < best)
+		{
+			best = d;
+			nearest = i;
+		}
+	}
+
+	for (k = 0; k < gx->numstyles; k++)
+		l += GX_LIGHT (gx)[k * gx->numverts + nearest] * d_lightstylevalue[surf->styles[k]];
+	return l >> 8;
+}
+
+/*
+===============
+R_TextureAnimation
+
+Returns the proper texture for a given time and base texture
+===============
+*/
+texture_t *R_TextureAnimation (texture_t *base)
+{
+	int		reletive;
+	int		count;
+
+	if (currententity->frame)
+	{
+		if (base->alternate_anims)
+			base = base->alternate_anims;
+	}
+
+	if (!base->anim_total)
+		return base;
+
+	reletive = (int)(cl.time*10) % base->anim_total;
+
+	count = 0;
+	while (base->anim_min > reletive || base->anim_max <= reletive)
+	{
+		base = base->anim_next;
+		if (!base)
+			Sys_Error ("R_TextureAnimation: broken cycle");
+		if (++count > 100)
+			Sys_Error ("R_TextureAnimation: infinite cycle");
+	}
+
+	return base;
+}
+
+HOT_CODE static int R_Sqrt (int n)
+{
+	int	root = 0, bit = 1 << 30;
+
+	while (bit > n)
+		bit >>= 2;
+	for (; bit; bit >>= 2)
+	{
+		if (n >= root + bit)
+		{
+			n -= root + bit;
+			root = (root >> 1) + bit;
+		}
+		else
+			root >>= 1;
+	}
+	return root;
+}
+
+// Adds the dynamic lights that touch a surface to its vertex light
+HOT_CODE static void R_AddDynamicLights (model_t *mod, msurface_t *surf, int *vlight)
+{
+	gxsurf_t	*gx = surf->gx;
+	unsigned short	*verts = GX_VERTS (gx);
+	unsigned	*pos;
+	int			i, k, x, y, z, d, *dl;
+
+	for (k = 0; k < MAX_DLIGHTS; k++)
+	{
+		if (!(surf->dlightbits & (1 << k)))
+			continue;
+		dl = r_dlight_i[k];
+		for (i = 0; i < gx->numverts; i++)
+		{
+			pos = mod->gxvertexes + verts[i] * 2;
+			x = ((short) (pos[0] & 0xffff) >> 3) - dl[0];
+			y = ((short) (pos[0] >> 16) >> 3) - dl[1];
+			z = ((short) (pos[1] & 0xffff) >> 3) - dl[2];
+			d = x * x + y * y + z * z;
+			if (d < dl[3] * dl[3])
+				vlight[i] += dl[3] - R_Sqrt (d);
+		}
+	}
+}
+
+static void R_EmitSurface (model_t *mod, gxsurf_t *gx, u16 *color, unsigned *st);
+
+// r_fullbright for this frame, without a float compare for every surface
+static qboolean r_fullbright_on;
+
+// The vertex colors of a surface from its light styles and the dynamic lights.
+// Most have one style and no dynamic light, their light goes to the color
+// table straight away.
+HOT_CODE static void R_SurfaceColors (model_t *mod, msurface_t *surf, u16 *color)
+{
+	gxsurf_t	*gx = surf->gx;
+	int			n = gx->numverts, i, k, l, sv[MAXLIGHTMAPS], vlight[MAX_SURFVERTS];
+	byte		*light = GX_LIGHT (gx);
+	// the world's surfaces are marked by R_PushDlights
+	qboolean	dlit = surf->dlightframe == r_framecount && mod == cl.worldmodel;
+
+	if (surf->flags & SURF_DRAWTILED || r_fullbright_on)
+	{
+		for (i = 0; i < n; i++)
+			color[i] = GRAY (GX_NORMAL_LIGHT);
+		return;
+	}
+	for (k = 0; k < gx->numstyles; k++)
+		sv[k] = d_lightstylevalue[surf->styles[k]];
+	if (gx->numstyles == 1 && !dlit)
+	{
+		for (i = 0; i < n; i++)
+			color[i] = gx_light[MIN (light[i] * sv[0] >> 8, 511)];
+		return;
+	}
+	for (i = 0; i < n; i++)
+	{
+		for (k = 0, l = 0; k < gx->numstyles; k++)
+			l += light[k * n + i] * sv[k];
+		vlight[i] = l >> 8;
+	}
+	if (dlit)
+		R_AddDynamicLights (mod, surf, vlight);
+	for (i = 0; i < n; i++)
+		color[i] = gx_light[MIN (vlight[i], 511)];
+}
+
+static void R_DrawGXSurface (model_t *mod, msurface_t *surf)
+{
+	u16	color[MAX_SURFVERTS];
+
+	R_SurfaceColors (mod, surf, color);
+	R_EmitSurface (mod, surf->gx, color, surf->gx->st);
+}
+
+// The polygon of a surface as a quad strip zig-zagging across it: 1 0, 2 n-1,
+// 3 n-2, ... with an odd number of vertices the last quad is a triangle
+HOT_CODE static void R_EmitSurface (model_t *mod, gxsurf_t *gx, u16 *color, unsigned *st)
+{
+	int				i, j, n = gx->numverts;
+	unsigned short	*verts = GX_VERTS (gx);
+
+#define EMIT(v) \
+	GFX_COLOR = color[v]; \
+	GFX_TEX_COORD = st[v]; \
+	GFX_VERTEX16 = mod->gxvertexes[verts[v] * 2]; \
+	GFX_VERTEX16 = mod->gxvertexes[verts[v] * 2 + 1];
+
+	GFX_BEGIN = GL_QUAD_STRIP;
+	for (i = 1, j = 0; ; )
+	{
+		EMIT (i);
+		EMIT (j);
+		i++;
+		j = j ? j - 1 : n - 1;
+		if (i > j)
+			break;
+		if (i == j)
+		{
+			EMIT (i);
+			EMIT (i);
+			break;
+		}
+	}
+#undef EMIT
+
+	c_brush_polys += (n - 1) / 2;
+}
+
+/*
+================
+R_DrawSkySurfaces
+
+The two sky layers like GLQuake: the texture coordinates follow the
+direction from the eye to each vertex on a flattened sphere, the front
+layer is drawn on the back one with the depth test for equal
+================
+*/
+static void R_DrawSkySurfaces (model_t *mod, texture_t *t)
+{
+	msurface_t	*surf;
+	gxsurf_t	*gx;
+	unsigned	*pos, st[2][MAX_SURFVERTS];
+	u16			color[MAX_SURFVERTS];
+	int			i, x, y, z, len, layer, speed[2];
+
+	for (layer = 0; layer < 2; layer++)
+	{
+		speed[layer] = (int) (realtime * (layer ? 16 : 8)) & 127;
+		speed[layer] <<= 4;
+	}
+	for (i = 0; i < MAX_SURFVERTS; i++)
+		color[i] = GRAY (GX_NORMAL_LIGHT);
+
+	for (surf = t->texturechain; surf; surf = surf->texturechain)
+	{
+		gx = surf->gx;
+		for (i = 0; i < gx->numverts; i++)
+		{
+			pos = mod->gxvertexes + GX_VERTS (gx)[i] * 2;
+			x = ((short) (pos[0] & 0xffff) - modelorg_i[0]) >> 3;
+			y = ((short) (pos[0] >> 16) - modelorg_i[1]) >> 3;
+			z = (((short) (pos[1] & 0xffff) - modelorg_i[2]) >> 3) * 3;
+			// 6*63 texels out on the sphere, in 1/16 texels, with one division
+			len = sqrt32 (x * x + y * y + z * z);
+			len = (6 * 63 * 16 << 12) / (len ? len : 1);
+			x = (x * len) >> 12;
+			y = (y * len) >> 12;
+			st[0][i] = TEXTURE_PACK (speed[0] + x, speed[0] + y);
+			st[1][i] = TEXTURE_PACK (speed[1] + x, speed[1] + y);
+		}
+		for (layer = 0; layer < 2; layer++)
+		{
+			R_BindTexture (t->gxparam[layer], t->gxscale);
+			GFX_POLY_FORMAT = POLY_ALPHA (31) | POLY_CULL_NONE | (layer ? POLY_DEPTH_EQUAL : 0);
+			R_EmitSurface (mod, gx, color, st[layer]);
+		}
+	}
+	GFX_POLY_FORMAT = POLY_ALPHA (31) | POLY_CULL_NONE;
+}
+
+static void R_BindBrushTexture (texture_t *t, msurface_t *surf)
+{
+	R_BindTexture (t->gxparam[0], t->gxscale);
+	if (surf->flags & SURF_DRAWTURB)
+	{
+		// liquids flow slowly, the time wraps at whole repeats of the
+		// texture before the fixed point overflows
+		float	flow = fmodf (cl.time, 256);
+
+		MATRIX_CONTROL = GL_TEXTURE;
+		MATRIX_TRANSLATE = F32 (flow * 2 * 16);
+		MATRIX_TRANSLATE = F32 (flow * 16);
+		MATRIX_TRANSLATE = 0;
+		MATRIX_CONTROL = GL_MODELVIEW;
+	}
+}
+
+static void R_LoadMatrix (float m[4][3], qboolean multiply)
+{
+	int	i, j;
+
+	for (i = 0; i < 4; i++)
+		for (j = 0; j < 3; j++)
+		{
+			if (multiply)
+				MATRIX_MULT4x3 = i < 3 ? F32 (m[i][j]) : R_RoundF32 (m[i][j]);
+			else
+				MATRIX_LOAD4x3 = i < 3 ? F32 (m[i][j]) : R_RoundF32 (m[i][j]);
+		}
+}
+
+// Model to world matrix, for brush models in their scaled vertex units
+static void R_EntityMatrix (entity_t *e, vec3_t angles, float m[4][3])
+{
+	vec3_t	forward, right, up;
+	int		i;
+
+	AngleVectors (angles, forward, right, up);
+	for (i = 0; i < 3; i++)
+	{
+		m[0][i] = forward[i];
+		m[1][i] = -right[i];
+		m[2][i] = up[i];
+		m[3][i] = e->origin[i] * MATRIX_SCALE_W;
+	}
+}
+
+qboolean R_CullBox (vec3_t mins, vec3_t maxs)
+{
+	int		i;
+
+	for (i=0 ; i<4 ; i++)
+		if (BoxOnPlaneSide (mins, maxs, &frustum[i]) == 2)
+			return true;
+	return false;
+}
+
+static void R_DrawBrushModel (entity_t *e)
+{
+	int			i;
+	vec3_t		mins, maxs, temp, forward, right, up;
+	msurface_t	*psurf;
+	float		dot, m[4][3];
+	model_t		*clmodel = e->model;
+	qboolean	rotated;
+	texture_t	*t, *bound;
+
+	rotated = e->angles[0] || e->angles[1] || e->angles[2];
+	if (rotated)
+	{
+		for (i=0 ; i<3 ; i++)
+		{
+			mins[i] = e->origin[i] - clmodel->radius;
+			maxs[i] = e->origin[i] + clmodel->radius;
+		}
+	}
+	else
+	{
+		VectorAdd (e->origin, clmodel->mins, mins);
+		VectorAdd (e->origin, clmodel->maxs, maxs);
+	}
+	if (R_CullBox (mins, maxs))
+		return;
+
+	VectorSubtract (r_origin, e->origin, modelorg);
+	if (rotated)
+	{
+		VectorCopy (modelorg, temp);
+		AngleVectors (e->angles, forward, right, up);
+		modelorg[0] = DotProduct (temp, forward);
+		modelorg[1] = -DotProduct (temp, right);
+		modelorg[2] = DotProduct (temp, up);
+	}
+
+	MATRIX_PUSH = 0;
+	R_EntityMatrix (e, e->angles, m);
+	R_LoadMatrix (m, true);
+
+	psurf = &clmodel->surfaces[clmodel->firstmodelsurface];
+	for (i=0, bound=NULL ; i<clmodel->nummodelsurfaces ; i++, psurf++)
+	{
+		dot = DotProduct (modelorg, psurf->plane->normal) - psurf->plane->dist;
+		if ((psurf->flags & SURF_PLANEBACK) ? dot < BACKFACE_DIST : dot > -BACKFACE_DIST)
+		{
+			// the texture only when it changes, liquids move theirs
+			t = R_TextureAnimation (psurf->texinfo->texture);
+			if (t != bound || (psurf->flags & SURF_DRAWTURB))
+				R_BindBrushTexture (t, psurf);
+			bound = t;
+			R_DrawGXSurface (clmodel, psurf);
+		}
+	}
+
+	MATRIX_POP = 1;
+}
+
+/*
+===============================================================================
+
+WORLD MODEL
+
+===============================================================================
+*/
+
+static void R_MarkLeaves (void)
+{
+	byte	*vis;
+	mnode_t	*node;
+	int		i;
+	static byte	solid[MAX_MAP_LEAFS/8];
+
+	if (r_oldviewleaf == r_viewleaf && !r_novis.value)
+		return;
+
+	r_visframecount++;
+	r_oldviewleaf = r_viewleaf;
+
+	if (r_novis.value)
+	{
+		vis = solid;
+		memset (solid, 0xff, (cl.worldmodel->numleafs+7)>>3);
+	}
+	else
+		vis = Mod_LeafPVS (r_viewleaf, cl.worldmodel);
+
+	for (i=0 ; i<cl.worldmodel->numleafs ; i++)
+	{
+		if (vis[i>>3] & (1<<(i&7)))
+		{
+			node = (mnode_t *)&cl.worldmodel->leafs[i+1];
+			do
+			{
+				if (node->visframe == r_visframecount)
+					break;
+				node->visframe = r_visframecount;
+				node = node->parent;
+			} while (node);
+		}
+	}
+}
+
+/*
+================
+R_CullNode
+
+Frustum test of a node's bounding box in fixed point. Returns the planes its
+children still need testing against, as a node inside a plane is too, or -1
+when it's outside.
+================
+*/
+HOT_CODE static int R_CullNode (mnode_t *node, int clipflags)
+{
+	int		i, *f;
+	short	*mins = node->minmaxs, *maxs = node->minmaxs + 3;
+
+	for (i = 0, f = frustum_i[0]; i < 4; i++, f += 4)
+	{
+		if (!(clipflags & (1 << i)))
+			continue;
+		// the corner furthest along the normal is outside, the whole box is
+		if ((f[0] >= 0 ? maxs[0] : mins[0]) * f[0] + (f[1] >= 0 ? maxs[1] : mins[1]) * f[1] +
+			(f[2] >= 0 ? maxs[2] : mins[2]) * f[2] < f[3])
+			return -1;
+		// the nearest corner is inside, the whole box is
+		if ((f[0] >= 0 ? mins[0] : maxs[0]) * f[0] + (f[1] >= 0 ? mins[1] : maxs[1]) * f[1] +
+			(f[2] >= 0 ? mins[2] : maxs[2]) * f[2] >= f[3])
+			clipflags &= ~(1 << i);
+	}
+	return clipflags;
+}
+
+HOT_CODE static void R_RecursiveWorldNode (mnode_t *node, int clipflags)
+{
+	int			c, dot, front, back;
+	mplane_t	*plane;
+	msurface_t	*surf, **mark;
+	mleaf_t		*pleaf;
+	texture_t	*t;
+	byte		*seen;
+
+	if (node->contents == CONTENTS_SOLID)
+		return;		// solid
+
+	if (node->visframe != r_visframecount)
+		return;
+	if (clipflags && (clipflags = R_CullNode (node, clipflags)) < 0)
+		return;
+
+// if a leaf node, draw stuff
+	if (node->contents < 0)
+	{
+		pleaf = (mleaf_t *)node;
+
+		mark = pleaf->firstmarksurface;
+		c = pleaf->nummarksurfaces;
+
+		if (c)
+		{
+			do
+			{
+				(*mark)->visframe = r_framecount;
+				mark++;
+			} while (--c);
+		}
+
+	// deal with model fragments in this leaf
+		if (pleaf->efrags)
+			R_StoreEfrags (&pleaf->efrags);
+
+		return;
+	}
+
+// node is just a decision point, so go down both sides
+	R_RecursiveWorldNode (node->children[0], clipflags);
+	R_RecursiveWorldNode (node->children[1], clipflags);
+
+// add the surfaces facing us to their texture chain, after the leaves below
+// marked them: one in reach of BACKFACE_DIST has them on the other side
+	c = node->numsurfaces;
+	if (c)
+	{
+		plane = node->plane;
+		dot = plane->inormal[0] * modelorg_i[0] + plane->inormal[1] * modelorg_i[1] +
+			plane->inormal[2] * modelorg_i[2] - plane->idist;
+		front = dot > -BACKFACE_DIST_I;
+		back = dot < BACKFACE_DIST_I;
+		surf = cl.worldmodel->surfaces + node->firstsurface;
+		seen = cl.worldmodel->mapseen + node->firstsurface;
+		for ( ; c ; c--, surf++, seen++)
+		{
+			if (surf->visframe != r_framecount)
+				continue;
+			if (!((surf->flags & SURF_PLANEBACK) ? back : front))
+				continue;		// wrong side
+			*seen = 1;		// for the map
+			t = surf->texinfo->texture;
+			surf->texturechain = t->texturechain;
+			t->texturechain = surf;
+		}
+	}
+}
+
+// The texture of the next world surface chain to draw, the sky's are drawn
+// apart
+static texture_t *R_NextWorldTexture (model_t *mod, int *i)
+{
+	texture_t	*t;
+
+	while (*i <= mod->numtextures)
+	{
+		t = *i < mod->numtextures ? mod->textures[*i] : r_notexture_mip;
+		(*i)++;
+		if (t && t->texturechain)
+			return t;
+	}
+	return NULL;
+}
+
+static void R_DrawWorld (void)
+{
+	int			i, n, numcolors;
+	model_t		*mod = cl.worldmodel;
+	texture_t	*t, *anim;
+	msurface_t	*s;
+	gxsurf_t	*gx;
+
+	currententity = &r_worldentity;
+	VectorCopy (r_origin, modelorg);
+
+	for (i = 0; i < mod->numtextures; i++)
+		if (mod->textures[i])
+			mod->textures[i]->texturechain = NULL;
+	r_notexture_mip->texturechain = NULL;
+
+	for (i = 0; i < 3; i++)
+		modelorg_i[i] = modelorg[i] * VERTEX_SCALE;
+	R_RecursiveWorldNode (mod->nodes, 15);
+
+	// The vertex colors before any surface goes to the hardware: until it
+	// showed the last frame it takes no more than a FIFO full of commands,
+	// this work fills that wait
+	numcolors = 0;
+	for (i = 0; (t = R_NextWorldTexture (mod, &i)); )
+	{
+		if (t->texturechain->flags & SURF_DRAWSKY)
+			continue;
+		for (s = t->texturechain; s; s = s->texturechain)
+		{
+			if (numcolors + s->gx->numverts > MAX_WORLDCOLORS)
+				goto colored;	// the rest work them out as they go
+			R_SurfaceColors (mod, s, world_colors + numcolors);
+			numcolors += s->gx->numverts;
+		}
+	}
+colored:
+
+	for (i = 0, n = 0; (t = R_NextWorldTexture (mod, &i)); )
+	{
+		if (t->texturechain->flags & SURF_DRAWSKY)
+		{
+			R_DrawSkySurfaces (mod, t);
+			continue;
+		}
+		anim = R_TextureAnimation (t);
+		R_BindBrushTexture (anim, t->texturechain);
+		for (s = t->texturechain; s; s = s->texturechain)
+		{
+			gx = s->gx;
+			if (n + gx->numverts <= numcolors)
+				R_EmitSurface (mod, gx, world_colors + n, gx->st);
+			else
+				R_DrawGXSurface (mod, s);
+			n += gx->numverts;
+		}
+	}
+}
+
+/*
+===============================================================================
+
+ALIAS MODELS
+
+===============================================================================
+*/
+
+static trivertx_t *R_AliasFrame (aliashdr_t *paliashdr, mdl_t *pmdl, entity_t *e)
+{
+	int				frame, i, numframes;
+	maliasgroup_t	*paliasgroup;
+	float			*pintervals, fullinterval, targettime, time;
+
+	frame = e->frame;
+	if ((frame >= pmdl->numframes) || (frame < 0))
+		frame = 0;
+
+	if (paliashdr->frames[frame].type == ALIAS_SINGLE)
+		return (trivertx_t *)((byte *)paliashdr + paliashdr->frames[frame].frame);
+
+	paliasgroup = (maliasgroup_t *)((byte *)paliashdr + paliashdr->frames[frame].frame);
+	pintervals = (float *)((byte *)paliashdr + paliasgroup->intervals);
+	numframes = paliasgroup->numframes;
+	fullinterval = pintervals[numframes-1];
+
+	time = cl.time + e->syncbase;
+	targettime = time - ((int)(time / fullinterval)) * fullinterval;
+	for (i=0 ; i<(numframes-1) ; i++)
+		if (pintervals[i] > targettime)
+			break;
+
+	return (trivertx_t *)((byte *)paliashdr + paliasgroup->frames[i].frame);
+}
+
+static int R_AliasSkin (aliashdr_t *paliashdr, mdl_t *pmdl, entity_t *e)
+{
+	int					skinnum, i, numskins;
+	maliasskindesc_t	*pskindesc;
+	maliasskingroup_t	*paliasskingroup;
+	float				*pskinintervals, fullskininterval, skintargettime, skintime;
+
+	skinnum = e->skinnum;
+	if ((skinnum >= pmdl->numskins) || (skinnum < 0))
+		skinnum = 0;
+
+	pskindesc = ((maliasskindesc_t *)((byte *)paliashdr + paliashdr->skindesc)) + skinnum;
+	if (pskindesc->type == ALIAS_SKIN_GROUP)
+	{
+		paliasskingroup = (maliasskingroup_t *)((byte *)paliashdr + pskindesc->skin);
+		pskinintervals = (float *)((byte *)paliashdr + paliasskingroup->intervals);
+		numskins = paliasskingroup->numskins;
+		fullskininterval = pskinintervals[numskins-1];
+		skintime = cl.time + e->syncbase;
+		skintargettime = skintime - ((int)(skintime / fullskininterval)) * fullskininterval;
+		for (i=0 ; i<(numskins-1) ; i++)
+			if (pskinintervals[i] > skintargettime)
+				break;
+		pskindesc = &paliasskingroup->skindescs[i];
+	}
+	return pskindesc->skin;
+}
+
+// R_LightPoint, looked up again when the model moved or a while ago
+static int R_AliasLight (entity_t *e)
+{
+	lightcache_t	*c = &lightcache[((unsigned) e >> 3) % LIGHTCACHE_SIZE];
+
+	if (c->entity != e || !VectorCompare (c->origin, e->origin) ||
+		r_framecount - c->framecount >= LIGHTCACHE_FRAMES)
+	{
+		c->entity = e;
+		VectorCopy (e->origin, c->origin);
+		c->light = R_LightPoint (e->origin);
+		c->framecount = r_framecount;
+	}
+	return c->light;
+}
+
+HOT_CODE static void R_DrawAliasModel (entity_t *e, int minlight)
+{
+	model_t		*clmodel = e->model;
+	aliashdr_t	*paliashdr;
+	mdl_t		*pmdl;
+	trivertx_t	*verts, *v;
+	mtriangle_t	*tris;
+	gxalias_t	*gx;
+	gxtex_t		*tex = NULL;
+	vec3_t		mins, maxs, angles, forward, right, up, dist;
+	float		m[4][3], add, units, *eye;
+	int			i, j, skin, lnum, light, shade, n;
+	unsigned	*st;
+	const u16	*dots;
+
+	paliashdr = Mod_Extradata (clmodel);
+	pmdl = (mdl_t *)((byte *)paliashdr + paliashdr->model);
+
+	for (i = 0; i < 3; i++)
+	{
+		mins[i] = e->origin[i] - pmdl->boundingradius;
+		maxs[i] = e->origin[i] + pmdl->boundingradius;
+	}
+	if (minlight == 0 && R_CullBox (mins, maxs))
+		return;
+
+	gx = clmodel->gxalias;
+	if (!gx || pmdl->numverts > MAXALIASVERTS)
+		return;
+	skin = R_AliasSkin (paliashdr, pmdl, e);
+	for (i = 0; i < gx->numskins; i++)
+		if (gx->skins[i].offset == skin)
+			tex = &gx->skins[i].tex;
+	if (!tex)
+		return;
+
+	// lighting like the software renderer, shaded by the normals like GLQuake
+	light = R_AliasLight (e);
+	if (light < minlight)
+		light = minlight;
+	for (lnum = 0; lnum < r_numdlights; lnum++)
+	{
+		VectorSubtract (e->origin, r_dlights[lnum]->origin, dist);
+		add = r_dlights[lnum]->radius;
+		if (DotProduct (dist, dist) < add * add)
+			light += add - Length (dist);
+	}
+	if (light > 192)
+		light = 192;
+	// 1.0 at 200 like GLQuake, times the 8.8 normal dots
+	shade = light * GX_NORMAL_LIGHT * 256 / 200;
+	dots = gx_dots[((int)(e->angles[1] * (SHADEDOT_QUANT / 360.0))) & (SHADEDOT_QUANT - 1)];
+
+	// the vertices are bytes scaled by the model, sent doubled as 10-bit
+	// vertices, a 64th of the 16-bit ones with one write instead of two. The
+	// "stupid quake bug" flips the pitch of alias models
+	angles[0] = -e->angles[0];
+	angles[1] = e->angles[1];
+	angles[2] = e->angles[2];
+	AngleVectors (angles, forward, right, up);
+	for (i = 0; i < 3; i++)
+	{
+		m[0][i] = forward[i] * pmdl->scale[0] * 32;
+		m[1][i] = -right[i] * pmdl->scale[1] * 32;
+		m[2][i] = up[i] * pmdl->scale[2] * 32;
+		m[3][i] = e->origin[i] + forward[i] * pmdl->scale_origin[0] -
+			right[i] * pmdl->scale_origin[1] + up[i] * pmdl->scale_origin[2];
+	}
+	// straight to eye space, x right, y up, looking down -z, so the position
+	// relative to the eye isn't the difference of two rounded positions. The
+	// gun stays with the view when R_AwayFromLiquid moved the eye
+	units = (e == &cl.viewent ? VIEWMODEL_UNITS : 1) * MATRIX_SCALE_W;
+	eye = e == &cl.viewent ? r_refdef.vieworg : r_origin;
+	VectorSubtract (m[3], eye, m[3]);
+	for (i = 0; i < 4; i++)
+	{
+		VectorCopy (m[i], dist);
+		m[i][0] = DotProduct (dist, vright) * units;
+		m[i][1] = DotProduct (dist, vup) * units;
+		m[i][2] = -DotProduct (dist, vpn) * units;
+	}
+	MATRIX_PUSH = 0;
+	R_LoadMatrix (m, false);
+
+	R_BindTexture (tex->param, tex->scale);
+	GFX_POLY_FORMAT = POLY_ALPHA (31) | POLY_CULL_FRONT;
+
+	// each vertex once, then the triangles
+	verts = R_AliasFrame (paliashdr, pmdl, e);
+	for (i = 0, v = verts; i < pmdl->numverts; i++, v++)
+	{
+		alias_color[i] = GRAY (MIN ((dots[v->lightnormalindex] * shade) >> 16, 31));
+		alias_xyz[i] = (v->v[0] << 1) | (v->v[1] << 11) | (v->v[2] << 21);
+	}
+
+	if (gx->strips)
+	{
+		const u16	*cmd = gx->strips;
+
+		while ((j = *cmd++))
+		{
+			st = *cmd++ ? gx->st : gx->st + pmdl->numverts;
+			GFX_BEGIN = GL_TRIANGLE_STRIP;
+			for (; j; j--)
+			{
+				n = *cmd++;
+				GFX_COLOR = alias_color[n];
+				GFX_TEX_COORD = st[n];
+				GFX_VERTEX10 = alias_xyz[n];
+			}
+		}
+	}
+	else
+	{
+		tris = (mtriangle_t *)((byte *)paliashdr + paliashdr->triangles);
+		GFX_BEGIN = GL_TRIANGLES;
+		for (i = 0; i < pmdl->numtris; i++, tris++)
+		{
+			st = tris->facesfront ? gx->st : gx->st + pmdl->numverts;
+			for (j = 0; j < 3; j++)
+			{
+				n = tris->vertindex[j];
+				GFX_COLOR = alias_color[n];
+				GFX_TEX_COORD = st[n];
+				GFX_VERTEX10 = alias_xyz[n];
+			}
+		}
+	}
+	c_alias_polys += pmdl->numtris;
+
+	GFX_POLY_FORMAT = POLY_ALPHA (31) | POLY_CULL_NONE;
+	MATRIX_POP = 1;
+}
