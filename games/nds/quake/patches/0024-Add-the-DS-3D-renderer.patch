+
+	total = 0;
+	for (i = 0; i < numtextures; i++)
+	{
+		mip[i] = 0;
+		shared[i] = NULL;
+		if (!textures[i])
+			continue;
+		if (instance)
+			for (j = 0; j < num_shared_textures; j++)
+				if (!strcmp (shared_textures[j]->name, textures[i]->name)
+					&& shared_textures[j]->width == textures[i]->width
+					&& shared_textures[j]->height == textures[i]->height)
+					shared[i] = shared_textures[j];
+		if (!shared[i])
+			total += R_BrushTexSize (textures[i], 0);
+	}
+
+	// halve the largest texture until everything fits
+	while (total > avail)
+	{
+		largest = -1;
+		for (i = 0; i < numtextures; i++)
+			if (textures[i] && !shared[i] && mip[i] < MIPLEVELS - 1 && (largest < 0 ||
+				R_BrushTexSize (textures[i], mip[i]) > R_BrushTexSize (textures[largest], mip[largest])))
+				largest = i;
+		if (largest < 0)
+			break;
+		total -= R_BrushTexSize (textures[largest], mip[largest]);
+		mip[largest]++;
+		total += R_BrushTexSize (textures[largest], mip[largest]);
+	}
+
+	for (i = 0; i < numtextures; i++)
+	{
+		tx = textures[i];
+		if (!tx)
+			continue;
+		if (shared[i])
+		{
+			memcpy (tx->gxparam, shared[i]->gxparam, sizeof(tx->gxparam));
+			memcpy (tx->gxscale, shared[i]->gxscale, sizeof(tx->gxscale));
+			continue;
+		}
+
+		w = tx->width >> mip[i];
+		h = tx->height >> mip[i];
+		if (total > avail || tex_world + R_BrushTexSize (tx, mip[i]) > TEXMEM_MODELS)
+		{
+			// out of VRAM, use the checkerboard
+			tx->gxparam[0] = tx->gxparam[1] = r_notexture_mip->gxparam[0];
+			tx->gxscale[0] = r_notexture_mip->gxscale[0] * 16 / tx->width;
+			tx->gxscale[1] = r_notexture_mip->gxscale[1] * 16 / tx->height;
+			continue;
+		}
+
+		pixels = Hunk_TempAlloc (w * h);
+		if (!pixels)
+			Sys_Error ("R_LoadTextures: not enough memory");
+		Mod_ReadLump (l, tx->offsets[mip[i]], pixels, w * h);
+
+		if (!Q_strncmp (tx->name, "sky", 3))
+		{
+			// the solid back layer on the right, the front on the left
+			// with index 0 transparent, their coordinates are in 1/16 texels
+			gw = R_TexSize (w / 2, MAX_TEXSIZE);
+			gh = R_TexSize (h, MAX_TEXSIZE);
+			tx->gxparam[0] = R_UploadTexture (pixels + w / 2, w, w / 2, h, gw, gh, &tex_world, false);
+			tx->gxparam[1] = R_UploadTexture (pixels, w, w / 2, h, gw, gh, &tex_world, false) |
+				GL_TEXTURE_COLOR0_TRANSPARENT;
+			tx->gxscale[0] = (gw << 12) / (tx->width / 2);
+			tx->gxscale[1] = (gh << 12) / tx->height;
+			continue;
+		}
+		gw = R_TexSize (w, MAX_TEXSIZE);
+		gh = R_TexSize (h, MAX_TEXSIZE);
+		tx->gxparam[0] = tx->gxparam[1] = R_UploadTexture (pixels, w, w, h, gw, gh, &tex_world, false);
+		tx->gxscale[0] = (2 * gw << 12) / tx->width;
+		tx->gxscale[1] = (2 * gh << 12) / tx->height;
+		if (instance && num_shared_textures < MAX_SHARED_TEXTURES)
+			shared_textures[num_shared_textures++] = tx;
+	}
+	R_MapTextures (false);
+}
+
+/*
+================
+R_InitTextures
+
+The checkerboard for missing textures, uploaded by R_Init
+================
+*/
+void R_InitTextures (void)
+{
+	r_notexture_mip = Hunk_AllocName (sizeof(texture_t), "notexture");
+	strcpy (r_notexture_mip->name, "notexture");
+	r_notexture_mip->width = r_notexture_mip->height = 16;
+}
+
+static void R_UploadNoTexture (void)
+{
+	byte	pixels[16 * 16];
+	int		x, y, mem = TEXMEM_WORLD;
+
+	for (y = 0; y < 16; y++)
+		for (x = 0; x < 16; x++)
+			pixels[y * 16 + x] = (x < 8) ^ (y < 8) ? 0 : 15;
+	r_notexture_mip->gxparam[0] = r_notexture_mip->gxparam[1] =
+		R_UploadTexture (pixels, 16, 16, 16, 16, 16, &mem, false);
+	r_notexture_mip->gxscale[0] = r_notexture_mip->gxscale[1] = 2 << 12;
+	R_MapTextures (false);
+}
