+/*
+================
+R_RenderView
+
+r_refdef must be set before the first call
+================
+*/
+// The menu is on the top screen over the view, which is darker behind it
+static void R_DimView (void)
+{
+	R_BeginScreen (POLY_ALPHA (DIM_ALPHA) | POLY_CULL_NONE | POLY_ID (1), 0);
+	R_ScreenRect (0, 0, 256, 192);
+}
+
+void R_RenderView (void)
+{
+	double	time1 = 0;
+
+	if (!r_worldentity.model || !cl.worldmodel)
+		Sys_Error ("R_RenderView: NULL worldmodel");
+	r_fullbright_on = r_fullbright.value != 0;
+
+	if (r_speeds.value)
+		time1 = Sys_FloatTime ();
+
+	R_SetupFrame ();
+	R_SetFrustum ();
+	R_MarkLeaves ();
+	R_DrawWorld ();
+	R_DrawEntitiesOnList ();
+	// the particles are left out first when a frame has too many polygons
+	R_DrawViewModel ();
+	R_DrawParticles ();
+	R_DrawCrosshair ();
+	if (key_dest == key_menu || scr_drawdialog)
+		R_DimView ();
+	VID_Flush3D ();
+
+	if (r_speeds.value)
+		Con_Printf ("%3i ms  %4i wpoly %4i epoly\n", (int)((Sys_FloatTime () - time1)*1000),
+			c_brush_polys, c_alias_polys);
+}
