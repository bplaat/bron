+// the commands still waiting in the FIFO
+#define	GX_POLYGONS			2048
+#define	GX_VERTICES			6144
+#define	GX_RESERVE			64
+
+#define	F32(x)				((int) ((x) * 4096))
+#define	MIN(a,b)			((a) < (b) ? (a) : (b))
+#define	MAX(a,b)			((a) > (b) ? (a) : (b))
+#define	CLAMP(lo,x,hi)		((x) < (lo) ? (lo) : (x) > (hi) ? (hi) : (x))
+#define	GRAY(c)				((c) | ((c) << 5) | ((c) << 10))
+
