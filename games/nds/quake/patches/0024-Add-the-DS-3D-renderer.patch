+	Cvar_RegisterVariable (&r_dspeeds);
+	Cvar_RegisterVariable (&r_reportsurfout);
+	Cvar_RegisterVariable (&r_maxsurfs);
+	Cvar_RegisterVariable (&r_numsurfs);
+	Cvar_RegisterVariable (&r_reportedgeout);
+	Cvar_RegisterVariable (&r_maxedges);
+	Cvar_RegisterVariable (&r_numedges);
+	Cvar_RegisterVariable (&r_aliastransbase);
+	Cvar_RegisterVariable (&r_aliastransadj);
+	Cvar_RegisterVariable (&r_novis);
+
+	R_InitParticles ();
+	vramSetBankH (VRAM_H_LCD);	// world_colors
+	vramSetBankI (VRAM_I_LCD);	// modeltex
+
+	// light 128 is the texture as it is, up to twice as bright
+	for (i = 0; i < 512; i++)
+	{
+		j = MIN (i * GX_NORMAL_LIGHT / 128, 31);
+		gx_light[i] = RGB15 (j, j, j);
+	}
+
+	// the sprites' black can't be the hardware's transparent 0
+	c = 1e9;
+	for (i = 1; i < 256; i++)
+	{
+		j = host_basepal[i * 3] + host_basepal[i * 3 + 1] + host_basepal[i * 3 + 2];
+		if (j < c)
+		{
+			c = j;
+			tex_black = i;
+		}
+	}
+
+	D_FlushCaches ();
+	R_UploadNoTexture ();
+}
