+
+static int SignbitsForPlane (mplane_t *out)
+{
+	int	bits, j;
+
+	// for fast box on planeside test
+	bits = 0;
+	for (j=0 ; j<3 ; j++)
+	{
+		if (out->normal[j] < 0)
+			bits |= 1<<j;
+	}
+	return bits;
+}
+
+static void R_SetFrustum (void)
+{
+	int		i, j;
+	float	a, sx, cx, sy, cy;
+
+	// the side planes lean in by half the field of view
+	a = r_refdef.fov_x * (float)(M_PI / 360);
+	sx = sinf (a);
+	cx = cosf (a);
+	a = r_refdef.fov_y * (float)(M_PI / 360);
+	sy = sinf (a);
+	cy = cosf (a);
+	for (j = 0; j < 3; j++)
+	{
+		frustum[0].normal[j] = vpn[j] * sx + vright[j] * cx;
+		frustum[1].normal[j] = vpn[j] * sx - vright[j] * cx;
+		frustum[2].normal[j] = vpn[j] * sy + vup[j] * cy;
+		frustum[3].normal[j] = vpn[j] * sy - vup[j] * cy;
+	}
+
+	for (i=0 ; i<4 ; i++)
+	{
+		frustum[i].type = PLANE_ANYZ;
+		frustum[i].dist = DotProduct (r_origin, frustum[i].normal);
+		frustum[i].signbits = SignbitsForPlane (&frustum[i]);
+		frustum_i[i][0] = frustum[i].normal[0] * 16384;
+		frustum_i[i][1] = frustum[i].normal[1] * 16384;
+		frustum_i[i][2] = frustum[i].normal[2] * 16384;
+		frustum_i[i][3] = frustum[i].dist * 16384;
+	}
+}
+
+/*
+================
+R_SetProjection
+
+The perspective, a transposed OpenGL matrix times scale, for eye space in
+units / 512 world units and the near plane at near
+================
+*/
+static void R_SetProjection (float scale, float units, float near)
+{
+	static float	fov_y = -1, f;
+	float			a, b;
+
+	if (r_refdef.fov_y != fov_y)
+	{
+		fov_y = r_refdef.fov_y;
+		f = 1 / tan (fov_y * (float)(M_PI / 360));
+	}
+	a = (FAR_PLANE + near) / (near - FAR_PLANE);
+	b = 2 * FAR_PLANE * near / (near - FAR_PLANE) * units;
+	MATRIX_CONTROL = GL_PROJECTION;
+	MATRIX_LOAD4x4 = F32 (f * 192 / 256 * scale);
+	MATRIX_LOAD4x4 = 0;
+	MATRIX_LOAD4x4 = 0;
+	MATRIX_LOAD4x4 = 0;
+	MATRIX_LOAD4x4 = 0;
+	MATRIX_LOAD4x4 = F32 (f * scale);
+	MATRIX_LOAD4x4 = 0;
+	MATRIX_LOAD4x4 = 0;
+	MATRIX_LOAD4x4 = 0;
+	MATRIX_LOAD4x4 = 0;
+	MATRIX_LOAD4x4 = F32 (a * scale);
+	MATRIX_LOAD4x4 = F32 (-scale);
+	MATRIX_LOAD4x4 = 0;
+	MATRIX_LOAD4x4 = 0;
+	MATRIX_LOAD4x4 = F32 (b * scale);
+	MATRIX_LOAD4x4 = 0;
+	MATRIX_CONTROL = GL_MODELVIEW;
+}
+
+#define	IS_LIQUID(c)	((c) <= CONTENTS_WATER && (c) >= CONTENTS_LAVA)
+
+/*
+================
+R_AwayFromLiquid
+
+Swimming, the eye gets as close as the 1/32 unit view.c keeps it to the
+surface of the liquid. Looking along it the near plane would cut out of
+view all of it below the middle, so the eye goes up or down to dist from
+it: the near plane over the cosine of half the vertical field of view, how
+close the top or bottom edge of the view gets to it, pitched either way.
+Returns whether it moved the eye.
+================
+*/
+static qboolean R_AwayFromLiquid (mleaf_t *leaf, float dist)
+{
+	vec3_t	p;
+	int		dir, i, c;
+	float	lo, hi, mid;
+	qboolean	liquid = IS_LIQUID (leaf->contents);
+
+	// the surface is a side of the leaf, a unit within its bounds
+	if (leaf->minmaxs[2] < r_origin[2] - dist - 1 && leaf->minmaxs[5] > r_origin[2] + dist + 1)
+		return false;
+	for (dir = -1; dir <= 1; dir += 2)
+	{
+		VectorCopy (r_origin, p);
+		p[2] += dir * dist;
+		c = Mod_PointInLeaf (p, cl.worldmodel)->contents;
+		if (c == CONTENTS_SOLID || IS_LIQUID (c) == liquid)
+			continue;
+		// the surface is between lo and hi
+		for (i = 0, lo = 0, hi = dist; i < 6; i++)
+		{
+			mid = (lo + hi) / 2;
+			p[2] = r_origin[2] + dir * mid;
+			if (IS_LIQUID (Mod_PointInLeaf (p, cl.worldmodel)->contents) == liquid)
+				lo = mid;
+			else
+				hi = mid;
+		}
+		r_origin[2] -= dir * (dist - lo);
+		return true;
+	}
+	return false;
+}
+
+void R_SetupFrame (void)
+{
+	static float	fov_x = -1, fov_y, liquid_dist;
+	float	m[4][3];
+	int		i;
+
+	R_AnimateLight ();
+	r_framecount++;
+
+	// the top screen is 4:3, whatever the 2D view rectangle
+	if (r_refdef.fov_x != fov_x)
+	{
+		fov_x = r_refdef.fov_x;
+		fov_y = atan (tan (fov_x * M_PI / 360) * 192 / 256) * 360 / M_PI;
+		liquid_dist = NEAR_PLANE * 512 / cos (fov_y * M_PI / 360) + 0.125f;
+	}
+	r_refdef.fov_y = fov_y;
+
+	VectorCopy (r_refdef.vieworg, r_origin);
+	AngleVectors (r_refdef.viewangles, vpn, vright, vup);
+
+	r_oldviewleaf = r_viewleaf;
+	r_viewleaf = Mod_PointInLeaf (r_origin, cl.worldmodel);
+	if (R_AwayFromLiquid (r_viewleaf, liquid_dist))
+		r_viewleaf = Mod_PointInLeaf (r_origin, cl.worldmodel);
+	V_SetContentsColor (r_viewleaf->contents);
+
+	R_SetProjection (WORLD_W_SCALE, 1, NEAR_PLANE);
+
+	// world to eye space: x right, y up, looking down -z
+	MATRIX_CONTROL = GL_MODELVIEW;
+	for (i = 0; i < 3; i++)
+	{
+		m[i][0] = vright[i];
+		m[i][1] = vup[i];
+		m[i][2] = -vpn[i];
+	}
+	m[3][0] = -DotProduct (r_origin, vright) * MATRIX_SCALE_W;
+	m[3][1] = -DotProduct (r_origin, vup) * MATRIX_SCALE_W;
+	m[3][2] = DotProduct (r_origin, vpn) * MATRIX_SCALE_W;
+	R_LoadMatrix (m, false);
+
+	GFX_POLY_FORMAT = POLY_ALPHA (31) | POLY_CULL_NONE;
+	GFX_PAL_FORMAT = 0;
+
+	r_numdlights = 0;
+	for (i = 0; i < MAX_DLIGHTS; i++)
+		if (cl_dlights[i].die >= cl.time && cl_dlights[i].radius)
+		{
+			r_dlights[r_numdlights++] = &cl_dlights[i];
+			r_dlight_i[i][0] = cl_dlights[i].origin[0];
+			r_dlight_i[i][1] = cl_dlights[i].origin[1];
+			r_dlight_i[i][2] = cl_dlights[i].origin[2];
+			r_dlight_i[i][3] = cl_dlights[i].radius;
+		}
+
+	c_brush_polys = 0;
+	c_alias_polys = 0;
+}
+
+static void R_DrawEntitiesOnList (void)
+{
+	int	i;
+
+	if (!r_drawentities.value)
+		return;
+
+	for (i=0 ; i<cl_numvisedicts ; i++)
+	{
+		currententity = cl_visedicts[i];
+		if (currententity == &cl_entities[cl.viewentity])
+			continue;	// don't draw the player
+
+		switch (currententity->model->type)
+		{
+		case mod_brush:
+			R_DrawBrushModel (currententity);
+			break;
+		case mod_alias:
+			R_DrawAliasModel (currententity, 0);
+			break;
+		case mod_sprite:
+			R_DrawSpriteModel (currententity);
+			break;
+		default:
+			break;
+		}
+	}
+	currententity = &r_worldentity;
+}
+
+// Starts drawing rectangles on the screen, in front of everything
+static void R_BeginScreen (unsigned polyformat, u16 color)
+{
+	int	i;
+
+	// the identity, but with w SCREEN_W
+	MATRIX_CONTROL = GL_PROJECTION;
+	for (i = 0; i < 16; i++)
+		MATRIX_LOAD4x4 = i == 15 ? SCREEN_W : i % 5 ? 0 : 4096;
+	MATRIX_CONTROL = GL_MODELVIEW;
+	MATRIX_IDENTITY = 0;
+	GFX_TEX_FORMAT = 0;
+	GFX_POLY_FORMAT = polyformat;
+	GFX_COLOR = color;
+	GFX_BEGIN = GL_QUADS;
+}
+
+// A rectangle of whole pixels of the top screen, x and y the top left one
+static void R_ScreenRect (int x, int y, int w, int h)
+{
+	int	x1 = x * SCREEN_W / 128 - SCREEN_W, x2 = (x + w) * SCREEN_W / 128 - SCREEN_W;
+	int	y1 = SCREEN_W - (y * SCREEN_W + 95) / 96, y2 = SCREEN_W - ((y + h) * SCREEN_W + 95) / 96;
+
+	GFX_VERTEX16 = VERTEX_PACK (x1, y1);
+	GFX_VERTEX16 = 0;
+	GFX_VERTEX16 = VERTEX_PACK (x2, y1);
+	GFX_VERTEX16 = 0;
+	GFX_VERTEX16 = VERTEX_PACK (x2, y2);
+	GFX_VERTEX16 = 0;
+	GFX_VERTEX16 = VERTEX_PACK (x1, y2);
+	GFX_VERTEX16 = 0;
+}
+
+static void R_DrawViewModel (void)
+{
+	if (!r_drawviewmodel.value || !r_drawentities.value || chase_active.value)
+		return;
+	if (cl.items & IT_INVISIBILITY)
+		return;
+	if (cl.stats[STAT_HEALTH] <= 0)
+		return;
+	currententity = &cl.viewent;
+	if (!currententity->model)
+		return;
+	// always give some light on gun, in the finer units of its matrix
+	R_SetProjection (1, VIEWMODEL_UNITS, VIEWMODEL_NEAR);
+	R_DrawAliasModel (currententity, 24);
+	R_SetProjection (WORLD_W_SCALE, 1, NEAR_PLANE);
+	currententity = &r_worldentity;
+}
+
+/*
+================
+R_DrawCrosshair
+
+A cross of 7 by 7 pixels around the pixel right below the middle of the
+view, in front of everything. It's translucent, though as good as opaque,
+the edge marking would outline it.
+================
+*/
+static void R_DrawCrosshair (void)
+{
+	int	x = 256 / 2 + (int) cl_crossx.value, y = 192 / 2 + (int) cl_crossy.value;
+
+	if (!crosshair.value)
+		return;
+
+	R_BeginScreen (POLY_ALPHA (30) | POLY_CULL_NONE | POLY_ID (2), RGB15 (31, 31, 31));
+	R_ScreenRect (x - 3, y, 7, 1);
+	R_ScreenRect (x, y - 3, 1, 3);
+	R_ScreenRect (x, y + 1, 1, 3);
+}
