+/*
+==================
+Mod_LoadAliasFile
+
+Loads an alias model from its whole file in temporary memory, which it
+frees, for the renderer that read it for the skins
+==================
+*/
+void Mod_LoadAliasFile (model_t *mod, void *buffer)
+{
+	loadmodel = mod;
+	COM_FileBase (mod->name, loadname);
+	mod->needload = NL_PRESENT;
+	Mod_LoadAliasModel (mod, buffer);
+}
+
