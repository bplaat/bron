+/*
+================
+D_FlushCaches
+
+Called by Host_ClearMemory before a new map, frees all textures
+================
+*/
+void D_FlushCaches (void)
+{
+	tex_world = TEXMEM_NOTEXTURE;
+	tex_models = TEXMEM_MODELS;
+}
+
+static void R_AddModelTexture (model_t *mod, int skin, mspriteframe_t *frame, int width, int height)
+{
+	modeltex_t	*t;
+
+	if (nummodeltex == MAX_MODELTEXTURES)
+		return;
+	t = &modeltex[nummodeltex++];
+	t->model = mod;
+	t->skin = skin;
+	t->frame = frame;
+	t->width = width;
+	t->height = height;
+	t->maxsize = MAX_SKINSIZE;
+}
+
+// The skins of an alias model from its file, without loading the model: the
+// type of each and the offset of its pixels, which the loaded model has too
+static void R_AddAliasSkins (model_t *mod)
+{
+	FILE	*f;
+	mdl_t	header;
+	int		i, j, base, pos, size, numskins, type, groupskins, first = nummodeltex;
+
+	if (COM_FOpenFile (mod->name, &f) < 0)
+		Sys_Error ("R_AddAliasSkins: can't open %s", mod->name);
+	base = ftell (f);
+	fread (&header, 1, sizeof(header), f);
+	numskins = LittleLong (header.numskins);
+	size = LittleLong (header.skinwidth) * LittleLong (header.skinheight);
+	for (i = 0, pos = sizeof(header); i < numskins; i++)
+	{
+		fseek (f, base + pos, SEEK_SET);
+		fread (&type, 1, sizeof(type), f);
+		pos += sizeof(type);
+		if (LittleLong (type) == ALIAS_SKIN_SINGLE)
+			groupskins = 1;
+		else
+		{
+			// the number of skins and their intervals before the pixels
+			fread (&groupskins, 1, sizeof(groupskins), f);
+			groupskins = LittleLong (groupskins);
+			pos += sizeof(daliasskingroup_t) + groupskins * sizeof(daliasskininterval_t);
+		}
+		for (j = 0; j < groupskins; j++, pos += size)
+			R_AddModelTexture (mod, pos, NULL, LittleLong (header.skinwidth), LittleLong (header.skinheight));
+	}
+	// the texture coordinates follow the skins
+	for (i = first; i < nummodeltex; i++)
+		modeltex[i].stverts = pos;
+	fclose (f);
+}
+
+static void R_AddSprite (model_t *mod)
+{
+	msprite_t		*psprite = mod->cache.data;
+	mspritegroup_t	*pgroup;
+	int				i, j;
+
+	for (i = 0; i < psprite->numframes; i++)
+	{
+		if (psprite->frames[i].type == SPR_SINGLE)
+		{
+			R_AddModelTexture (mod, -1, psprite->frames[i].frameptr,
+				psprite->frames[i].frameptr->width, psprite->frames[i].frameptr->height);
+			continue;
+		}
+		pgroup = (mspritegroup_t *)psprite->frames[i].frameptr;
+		for (j = 0; j < pgroup->numframes; j++)
+			R_AddModelTexture (mod, -1, pgroup->frames[j], pgroup->frames[j]->width, pgroup->frames[j]->height);
+	}
+}
+
+// Allocates the hardware data of an alias model and packs its texture coordinates
+// Triangle strips through the triangles of an alias model, like GLQuake's
+// gl_mesh.c without fans, which the hardware doesn't have: a strip takes the
+// triangles that share its last edge, on the same side of the skin seam.
+// The vertices go to the hardware once per strip instead of three times per
+// triangle. Returns the size of the strips, written to out when not NULL.
+#define	MAXSTRIPTRIS	1024
+
+// The triangle edges by their vertices, to find the next triangle of a strip
+// without searching them all
+#define	EDGE_HASH			1024
+#define	EDGE_KEY(a,b)		(((a) * 31 + (b)) & (EDGE_HASH - 1))
+
+// What building the strips works with, for models of up to MAXSTRIPTRIS
+// triangles, Quake's have less than 500
+typedef struct
+{
+	byte	used[MAXSTRIPTRIS];
+	short	edge_first[EDGE_HASH], edge_next[MAXSTRIPTRIS * 3];
+	u16		verts[MAXSTRIPTRIS + 2], striptris[MAXSTRIPTRIS];
+	u16		bestverts[MAXSTRIPTRIS + 2], besttris[MAXSTRIPTRIS];
+} stripwork_t;
+
+static void R_HashEdges (stripwork_t *w, mtriangle_t *tris, int numtris)
+{
+	int	i, k, key;
+
+	memset (w->edge_first, -1, sizeof(w->edge_first));
+	// in reverse, so each chain lists the triangles in order
+	for (i = numtris - 1; i >= 0; i--)
+		for (k = 2; k >= 0; k--)
+		{
+			key = EDGE_KEY (tris[i].vertindex[k], tris[i].vertindex[(k + 1) % 3]);
+			w->edge_next[i * 3 + k] = w->edge_first[key];
+			w->edge_first[key] = i * 3 + k;
+		}
+}
+
+static int R_StripLength (stripwork_t *w, mtriangle_t *tris, int numtris, int start, int startv)
+{
+	byte		*used = w->used;
+	u16			*verts = w->verts, *striptris = w->striptris;
+	mtriangle_t	*last = &tris[start], *check;
+	int			m1, m2, e, j, k, count = 1;
+
+	used[start] = 2;
+	verts[0] = last->vertindex[startv % 3];
+	verts[1] = last->vertindex[(startv + 1) % 3];
+	verts[2] = last->vertindex[(startv + 2) % 3];
+	striptris[0] = start;
+	m1 = last->vertindex[(startv + 2) % 3];
+	m2 = last->vertindex[(startv + 1) % 3];
+next:
+	// the first triangle after the start with the strip's last edge
+	for (e = w->edge_first[EDGE_KEY (m1, m2)]; e >= 0; e = w->edge_next[e])
+	{
+		j = e / 3;
+		k = e % 3;
+		check = &tris[j];
+		if (j <= start || check->facesfront != last->facesfront
+			|| check->vertindex[k] != m1 || check->vertindex[(k + 1) % 3] != m2)
+			continue;
+		if (used[j])
+			goto done;
+		// the new edge alternates sides, like the strip
+		if (count & 1)
+			m2 = check->vertindex[(k + 2) % 3];
+		else
+			m1 = check->vertindex[(k + 2) % 3];
+		verts[count + 2] = check->vertindex[(k + 2) % 3];
+		striptris[count] = j;
+		count++;
+		used[j] = 2;
+		goto next;
+	}
+done:
+	for (j = 0; j < count; j++)
+		used[striptris[j]] = 0;
+	return count;
+}
+
+static int R_BuildStrips (mtriangle_t *tris, int numtris, u16 *out)
+{
+	static stripwork_t	w;
+	int			i, j, startv, len, bestlen, size = 1;
+
+	memset (w.used, 0, numtris);
+	R_HashEdges (&w, tris, numtris);
+	for (i = 0; i < numtris; i++)
+	{
+		if (w.used[i])
+			continue;
+		bestlen = 0;
+		for (startv = 0; startv < 3; startv++)
+		{
+			len = R_StripLength (&w, tris, numtris, i, startv);
+			if (len > bestlen)
+			{
+				bestlen = len;
+				memcpy (w.bestverts, w.verts, (len + 2) * sizeof(w.verts[0]));
+				memcpy (w.besttris, w.striptris, len * sizeof(w.striptris[0]));
+			}
+		}
+		for (j = 0; j < bestlen; j++)
+			w.used[w.besttris[j]] = 1;
+		if (out)
+		{
+			out[size - 1] = bestlen + 2;
+			out[size] = tris[i].facesfront;
+			memcpy (out + size + 1, w.bestverts, (bestlen + 2) * sizeof(w.verts[0]));
+		}
+		size += bestlen + 4;
+	}
+	if (out)
+		out[size - 1] = 0;
+	return size;
+}
+
+static void R_SetupAliasModel (model_t *mod, int numskins)
+{
+	aliashdr_t	*paliashdr;
+	mdl_t		*pmdl;
+	stvert_t	*stverts;
+	gxalias_t	*gx;
+	int			i, s, t, strips;
+
+	paliashdr = Mod_Extradata (mod);
+	pmdl = (mdl_t *)((byte *)paliashdr + paliashdr->model);
+	strips = pmdl->numtris <= MAXSTRIPTRIS ?
+		R_BuildStrips ((mtriangle_t *)((byte *)paliashdr + paliashdr->triangles), pmdl->numtris, NULL) : 0;
+	gx = Hunk_AllocName (sizeof(gxalias_t) + numskins * sizeof(gx->skins[0]) +
+		pmdl->numverts * 2 * sizeof(unsigned) + strips * sizeof(u16), "gxalias");
+	gx->st = (unsigned *)&gx->skins[numskins];
+	gx->strips = strips ? (u16 *)(gx->st + pmdl->numverts * 2) : NULL;
+	mod->gxalias = gx;
+
+	// the hunk allocation may have evicted the model, the texture
+	// coordinates are 16.16 fixed point, the hardware takes 12.4
+	paliashdr = Mod_Extradata (mod);
+	pmdl = (mdl_t *)((byte *)paliashdr + paliashdr->model);
+	stverts = (stvert_t *)((byte *)paliashdr + paliashdr->stverts);
+	for (i = 0; i < pmdl->numverts; i++)
+	{
+		s = (stverts[i].s >> 12) + 8;
+		t = (stverts[i].t >> 12) + 8;
+		gx->st[i] = TEXTURE_PACK (s, t);
+		if (stverts[i].onseam)
+			s += pmdl->skinwidth << 3;
+		gx->st[pmdl->numverts + i] = TEXTURE_PACK (s, t);
+	}
+	if (gx->strips)
+		R_BuildStrips ((mtriangle_t *)((byte *)paliashdr + paliashdr->triangles), pmdl->numtris, gx->strips);
+}
+
+/*
+================
+R_SkinCoverage
+
+Marks the texels of a skin the triangles of its model cover, their middles
+inside a triangle, from the texture coordinates and triangles in the file. The texels around them aren't painted or have the
+background, like the blue around the shotguns.
+================
+*/
+__attribute__((target("arm")))
+static void R_SkinCoverage (byte *file, int stverts, byte *mask, int w, int h)
+{
+	mdl_t		*header = (mdl_t *)file;
+	stvert_t	*st = (stvert_t *)(file + stverts);
+	dtriangle_t	*tri = (dtriangle_t *)(st + LittleLong (header->numverts));
+	int			i, j, k, y, y0, y1, s[3], t[3], miny, maxy;
+	int			x0[MAX_LBM_HEIGHT], x1[MAX_LBM_HEIGHT];	// the span of each row
+	int			dt, step, q, r, sign, numtris = LittleLong (header->numtris);
+
+	// the spans between the edges at the middles of the rows, in half texels
+	memset (mask, 0, w * h);
+	for (i = 0; i < numtris; i++, tri++)
+	{
+		for (j = 0; j < 3; j++)
+		{
+			k = LittleLong (tri->vertindex[j]);
+			s[j] = 2 * (LittleLong (st[k].s) + (!LittleLong (tri->facesfront) && LittleLong (st[k].onseam) ? w / 2 : 0));
+			t[j] = 2 * LittleLong (st[k].t);
+		}
+		miny = MAX (MIN (t[0], MIN (t[1], t[2])) / 2, 0);
+		maxy = MIN (MAX (t[0], MAX (t[1], t[2])) / 2, h - 1);
+		for (y = miny; y <= maxy; y++)
+		{
+			x0[y] = 0x7fffffff;
+			x1[y] = -1;
+		}
+		for (j = 0; j < 3; j++)
+		{
+			// the edge at the rows with their middle, 2 * y + 1, in its
+			// span: s[j] + (s[k] - s[j]) * (2 * y + 1 - t[j]) / (t[k] - t[j]),
+			// stepped as the quotient q and remainder r of |s[k] - s[j]| *
+			// |2 * y + 1 - t[j]| / |t[k] - t[j]| for its sign
+			k = j == 2 ? 0 : j + 1;
+			if (t[j] == t[k])
+				continue;
+			y0 = MAX (MIN (t[j], t[k]) / 2, miny);	// 2 * y + 1 >= the smaller
+			y1 = MIN ((MAX (t[j], t[k]) - 1) / 2, maxy);	// 2 * y + 1 <= the larger
+			if (MAX (t[j], t[k]) < 1 || y0 > y1)
+				continue;
+			dt = abs (t[k] - t[j]);
+			sign = s[k] < s[j] ? -1 : 1;
+			step = 2 * abs (s[k] - s[j]);
+			q = abs (s[k] - s[j]) * abs (2 * y0 + 1 - t[j]);
+			r = q % dt;
+			q /= dt;
+			for (y = y0; ; y++)
+			{
+				x0[y] = MIN (x0[y], s[j] + sign * q);
+				x1[y] = MAX (x1[y], s[j] + sign * q);
+				if (y == y1)
+					break;
+				// |2 * y + 1 - t[j]| grows away from t[j] and shrinks towards it
+				if (t[k] > t[j])
+				{
+					q += step / dt;
+					r += step % dt;
+					if (r >= dt)
+					{
+						r -= dt;
+						q++;
+					}
+				}
+				else
+				{
+					q -= step / dt;
+					r -= step % dt;
+					if (r < 0)
+					{
+						r += dt;
+						q--;
+					}
+				}
+			}
+		}
+		for (y = miny; y <= maxy; y++)
+		{
+			// the texels with their middle, 2 * x + 1, in the span
+			x0[y] = MAX (x0[y] / 2, 0);
+			x1[y] = MIN ((x1[y] - 1) / 2, w - 1);
+			if (x0[y] <= x1[y])
+				memset (mask + y * w + x0[y], 1, x1[y] - x0[y] + 1);
+		}
+	}
+}
+
+/*
+================
+R_FillSkin
+
+Every texel of a skin, resampled to the size of its hardware texture, that
+isn't covered takes the color of a covered one along its row, then along
+its column for the rows without any, from both ends: the edges of the
+triangles sample next to what's painted, triangles thinner than a texel
+cover none.
+================
+*/
+__attribute__((target("arm")))
+static void R_FillSkin (byte *pixels, byte *mask, int w, int h)
+{
+	int		i, j, k, last, step, len, pass;
+	byte	*p, *m;
+
+	for (pass = 0; pass < 2; pass++)
+		for (i = 0; i < (pass ? w : h); i++)
+			for (step = -1; step <= 1; step += 2)
+			{
+				len = pass ? h : w;
+				p = pass ? pixels + i : pixels + i * w;
+				m = pass ? mask + i : mask + i * w;
+				k = pass ? w : 1;
+				if (step < 0)
+				{
+					p += (len - 1) * k;
+					m += (len - 1) * k;
+					k = -k;
+				}
+				for (j = 0, last = -1; j < len; j++, p += k, m += k)
+				{
+					if (*m && *m <= pass + 1)
+						last = j;
+					else if (!*m && last >= 0)
+					{
+						*p = p[-k * (j - last)];
+						*m = pass + 2;
+					}
+				}
+			}
+}
+
+static int R_ModelTexSize (modeltex_t *t)
+{
+	return R_TexSize (t->width, t->maxsize) * R_TexSize (t->height, t->maxsize);
+}
+
+/*
+================
+R_UploadSkins
+
+Uploads the n skins of an alias model from its file, which loads the model
+too when it's not in the cache: a level's models don't all fit in it, each
+is loaded once for its skins and hardware data. Each skin and the texels its
+triangles cover are resampled to the texture size together and filled in
+there. Returns false when VRAM is full.
+================
+*/
+static qboolean R_UploadSkins (model_t *mod, modeltex_t *skins, int n)
+{
+	int			i, k, x, y, u, ustep, w, h, gw, gh, len, mark;
+	aliashdr_t	*cached = Cache_Check (&mod->cache);
+	mdl_t		*pmdl;
+	modeltex_t	*t;
+	gxalias_t	*gx;
+	byte		*file, *pixels, *mask, *skin;
+	FILE		*f;
+
+	// a model in the cache only needs its skins, texture coordinates and
+	// triangles, from the start of the file
+	len = COM_FOpenFile (mod->name, &f);
+	if (len < 0)
+		Sys_Error ("R_UploadSkins: can't open %s", mod->name);
+	if (cached)
+	{
+		pmdl = (mdl_t *)((byte *)cached + cached->model);
+		len = skins->stverts + pmdl->numverts * sizeof(stvert_t) + pmdl->numtris * sizeof(dtriangle_t);
+	}
+	file = Hunk_TempAlloc (len);
+	if (!file)
+		Sys_Error ("R_UploadSkins: not enough memory for %s", mod->name);
+	fread (file, 1, len, f);
+	fclose (f);
+
+	for (i = 0, t = skins; i < n; i++, t++)
+	{
+		w = t->width;
+		h = t->height;
+		gw = R_TexSize (w, t->maxsize);
+		gh = R_TexSize (h, t->maxsize);
+		if (tex_models + gw * gh > TEXMEM_END)
+			break;
+		mark = Hunk_LowMark ();
+		mask = Hunk_AllocName (w * h + gw * gh * 2, "skin");
+		skin = mask + w * h;
+		pixels = file + t->skin;
+		R_SkinCoverage (file, t->stverts, mask, w, h);
+		ustep = (w << 16) / gw;	// 16.16 fixed point, the middles of the texels
+		for (y = 0; y < gh; y++)
+		{
+			k = ((2 * y + 1) * h / (2 * gh)) * w;
+			for (x = 0, u = ustep / 2; x < gw; x++, u += ustep)
+			{
+				skin[y * gw + x] = pixels[k + (u >> 16)];
+				skin[gw * gh + y * gw + x] = mask[k + (u >> 16)];
+			}
+		}
+		R_FillSkin (skin, skin + gw * gh, gw, gh);
+		t->tex.param = R_UploadTexture (skin, gw, gw, gh, gw, gh, &tex_models, false);
+		t->tex.scale[0] = (gw << 12) / w;
+		t->tex.scale[1] = (gh << 12) / h;
+		Hunk_FreeToLowMark (mark);
+	}
+
+	if (cached)
+		Hunk_FreeTemp ();
+	else
+		Mod_LoadAliasFile (mod, file);
+	if (i)
+	{
+		R_SetupAliasModel (mod, i);
+		gx = mod->gxalias;
+		for (k = 0; k < i; k++)
+		{
+			gx->skins[k].offset = skins[k].skin;
+			gx->skins[k].tex = skins[k].tex;
+		}
+		gx->numskins = i;
+	}
+	return i == n;
+}
+
+/*
+================
+R_UploadModelTextures
+
+Uploads the skins of all alias models and the frames of all sprites of the
+map, halving the largest until they fit in their part of VRAM
+================
+*/
+static void R_UploadModelTextures (void)
+{
+	int			i, j, total, gw, gh;
+	model_t		*mod;
+	modeltex_t	*t, *largest;
+	gxtex_t		*tex;
+
+	nummodeltex = 0;
+	for (i = 1; i < MAX_MODELS && cl.model_precache[i]; i++)
+	{
+		mod = cl.model_precache[i];
+		if (mod->type == mod_alias)
+			R_AddAliasSkins (mod);
+		else if (mod->type == mod_sprite)
+			R_AddSprite (mod);
+	}
+
+	for (;;)
+	{
+		total = 0;
+		largest = NULL;
+		for (i = 0, t = modeltex; i < nummodeltex; i++, t++)
+		{
+			total += R_ModelTexSize (t);
+			if (t->maxsize > 8 && (!largest || R_ModelTexSize (t) > R_ModelTexSize (largest)))
+				largest = t;
+		}
+		if (total <= TEXMEM_END - TEXMEM_MODELS || !largest)
+			break;
+		largest->maxsize >>= 1;
+	}
+
+	tex_models = TEXMEM_MODELS;
+	for (i = 0; i < nummodeltex; i = j)
+	{
+		t = &modeltex[i];
+		for (j = i + 1; j < nummodeltex && t->skin >= 0 && modeltex[j].model == t->model; j++)
+			;
+		if (t->skin >= 0)
+		{
+			if (!R_UploadSkins (t->model, t, j - i))
+				break;
+			continue;
+		}
+		gw = R_TexSize (t->width, t->maxsize);
+		gh = R_TexSize (t->height, t->maxsize);
+		if (tex_models + gw * gh > TEXMEM_END)
+			break;
+		tex = Hunk_AllocName (sizeof(*tex), "gxsprite");
+		t->frame->pcachespot = tex;
+		tex->param = R_UploadTexture (t->frame->pixels, t->width, t->width, t->height, gw, gh, &tex_models, true);
+		tex->scale[0] = (gw << 12) / t->width;
+		tex->scale[1] = (gh << 12) / t->height;
+	}
+	R_MapTextures (false);
+}
+
+static void R_BindTexture (unsigned param, const int *scale)
+{
+	GFX_TEX_FORMAT = param;
+	MATRIX_CONTROL = GL_TEXTURE;
+	MATRIX_IDENTITY = 0;
+	MATRIX_SCALE = scale[0];
+	MATRIX_SCALE = scale[1];
+	MATRIX_SCALE = 1 << 12;
+	MATRIX_CONTROL = GL_MODELVIEW;
+}
