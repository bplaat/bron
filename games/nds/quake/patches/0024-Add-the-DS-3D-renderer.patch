+// boxes share some, a texture is uploaded once
+#define	MAX_SHARED_TEXTURES	64
+static texture_t	*shared_textures[MAX_SHARED_TEXTURES];
+static int		num_shared_textures;
+static qboolean	tex_mapped;					// VRAM banks mapped for the CPU
+static byte		tex_black;					// darkest color that isn't 0
+// in VRAM bank I that nothing else uses, the RAM is short, all its fields
