+#define	LIGHTCACHE_SIZE		128
+#define	LIGHTCACHE_FRAMES	8
+#define	NUMVERTEXNORMALS	162
+#define	SHADEDOT_QUANT		16
+
+extern cvar_t	crosshair, cl_crossx, cl_crossy;
+extern qboolean	scr_drawdialog;
+
+
+// The hardware data of a surface: the packed texture coordinates, then the
+// vertex indices into the model's gxvertexes, word aligned, then the light
+// samples, [numstyles][numverts]
+typedef struct gxsurf_s
+{
+	byte			numverts;
+	byte			numstyles;		// light samples per vertex
+	unsigned short	pad;
+	unsigned		st[];
+} gxsurf_t;
+
+#define	GX_VERTS(gx)	((unsigned short *) ((gx)->st + (gx)->numverts))
+#define	GX_LIGHT(gx)	((byte *) GX_VERTS (gx) + (((gx)->numverts * 2 + 3) & ~3))
+
+// Hardware textures of a skin or sprite frame
+typedef struct
+{
+	unsigned	param;
+	int			scale[2];
+} gxtex_t;
+
+// What the hardware needs of an alias model: the uploaded skins, by their
+// offset in the model file, and the packed texture coordinates of the front
+// and back sides of the seam. It lives until the next map, the model itself
+// may be evicted from the cache and reloaded meanwhile.
+typedef struct gxalias_s
+{
+	unsigned	*st;		// [2][numverts], the back adds half the skin width on the seam
+	u16			*strips;	// vertex count, front side, the vertices, ..., 0
+	int			numskins;
+	struct
+	{
+		int		offset;
+		gxtex_t	tex;
+	} skins[1];		// variable sized
+} gxalias_t;
+
+// Light of an alias model, only looked up again when it moved or a while ago
+typedef struct
+{
+	entity_t	*entity;
+	vec3_t		origin;
+	int			light;
+	int			framecount;
+} lightcache_t;
+
+// A skin or sprite frame to upload, planned by R_UploadModelTextures
+typedef struct
+{
