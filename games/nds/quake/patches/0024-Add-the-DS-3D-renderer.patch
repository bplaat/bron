+// r_nds.c -- renderer for the Nintendo DS 3D hardware
+//
+// The world, brush and alias models, sprites and particles are drawn by the
+// geometry engine on the top screen, the 2D drawing stays in software on the
+// touch screen (vid_nds.c).
+//
+// - Vertices are 16-bit fixed point world coordinates times 8, the matrices
+//   work in units of 512 world units, so maps up to 4096 units fit.
+// - Textures stay 8-bit with Quake's palette in the texture palette, so the
+//   palette shifts for damage and pickups are free. They go to VRAM when a
+//   map loads, at the largest mip level that fits, with texture coordinates
+//   scaled to their size by the texture matrix. Nothing stays in main RAM.
+// - Light maps become vertex light, one sample per style for each vertex, so
+//   the light styles still animate.
+// - Surfaces are polygons, drawn as quad strips zig-zagging across them,
+//   which needs half as many polygons as triangles.
+
+#include "quakedef.h"
+#include "r_local.h"
+
+#include <nds.h>
+
+// Texture VRAM: banks A and B for brush models, D for skins and sprites
+#define	TEXMEM_WORLD		0x00000
+#define	TEXMEM_MODELS		0x40000
+#define	TEXMEM_END			0x60000
+#define	TEXMEM_NOTEXTURE	256		// the checkerboard stays at the start
+#define	TEXMEM_INSTANCES	(32 * 1024)	// kept for brush models after the world
+
+#define	MAX_TEXSIZE			256
+#define	MAX_SKINSIZE		128
+
+// Vertex coordinates are world units times 8, the matrices are in 1/512
+#define	VERTEX_SCALE		8
+#define	MATRIX_SCALE_W		(1.0 / 512)
+
+// The view model's matrix is relative to the eye in 1/32 world units: in the
+// 1/512 of the world its position and axes were rounded so much that the gun
+// wobbled while turning
+#define	VIEWMODEL_UNITS		16
+
+// The depth buffer holds w, the distance, to at least a 4096th of the
+// largest one of a polygon, 1/8 unit at 512 units. z / w had 15 bits for all
+// of it, 2 units at 512 and 8 at 1024: monsters right behind doors showed
+// through them. The world's projection scales w to 3 times the gun's per
+// world unit, so the gun stays in front of walls like with the software
+// renderer's depth scale for it
+#define	WORLD_W_SCALE		(VIEWMODEL_UNITS * 3)
+
+// w of the rectangles drawn on the screen, in front of the near planes, 384
+// for the world and 512 for the gun. The least w with whole pixels across,
+// rows are rounded down the screen, the hardware truncates to whole pixels
+#define	SCREEN_W			128
+
+// How dark the view gets behind the menu, the alpha of black of 31
+#define	DIM_ALPHA			14
+
+// Poly format bit for the depth test for equal instead of less
+#define	POLY_DEPTH_EQUAL	(1 << 14)
+
+// Brush texture coordinates are stored in 1/8 texels, the hardware reads 1/16
+#define	ST_SCALE			8
+
+// The texture palette is twice as bright, so vertex light can go up to
+// double like the software renderer's overbright light
+#define	GX_NORMAL_LIGHT		15
+
+// Surfaces are left out when the eye is this far behind them: the integer
+// plane tests are up to a unit off for slanted planes far from the origin,
+// the eye of the matrices 1/8, so a surface seen edge on could face the one
+// and not the other, a crack. The back of one is hidden behind its solid.
+#define	BACKFACE_DIST		1.5
+#define	BACKFACE_DIST_I		((int) (BACKFACE_DIST * VERTEX_SCALE * 16384))	// for the planes' inormal and idist
+
+// The near plane is closer than the 4 units of GLQuake, which z / w needed:
+// swimming, the eye gets that close to the surface of the liquid. The gun
+// keeps 4 units
+#define	NEAR_PLANE			(1.0 / 512)
+#define	VIEWMODEL_NEAR		(4.0 / 512)
+#define	FAR_PLANE			(8192.0 / 512)
+
+#define	MAX_SURFVERTS		128
+#define	MAX_PARTICLES_DRAWN	512
