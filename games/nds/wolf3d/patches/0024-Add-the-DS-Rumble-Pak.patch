 // arguments from /data/wolf3d/args.txt. Errors are shown on the touch screen console.
+// Also rumbles a Rumble Pak in the GBA slot, without one it is left alone.
 //
 
 // libnds and Wolf4SDL both have a Keyboard and a SoundMode
@@ -213,6 +214,42 @@ static void ReadArgs (const char *path, int *argc, char **argv)
         argv[(*argc)++] = s;
 }
 
+// The Rumble Pak only moves while it is switched back and forth, which a tick
+// task does at 60 Hz for as long as the rumble lasts. Only a DS has a GBA
+// slot, on a DSi gbacartOpen fails.
+#define RUMBLE_HZ     60
+#define RUMBLE_MAX_MS 500
+
+static bool rumble_inserted;
+static volatile int rumble_ticks;
+static TickTask rumble_task;
+
+static void RumbleTick (TickTask *task)
+{
+    if (rumble_ticks > 0)
+        rumble_ticks--;
+    rumbleSet (rumble_ticks & 1);
+}
+
+static void InitRumble (void)
+{
+    if (!gbacartOpen ())
+        return;
+    rumble_inserted = rumbleIsInserted ();
+    if (rumble_inserted)
+        tickTaskStart (&rumble_task, RumbleTick, ticksFromHz (RUMBLE_HZ), ticksFromHz (RUMBLE_HZ));
+    else
+        gbacartClose ();
+}
+
+void NDS_Rumble (int ms)
+{
+    int ticks = (ms < RUMBLE_MAX_MS ? ms : RUMBLE_MAX_MS) * RUMBLE_HZ / 1000;
+
+    if (rumble_inserted && rumbleenabled && !demoplayback && ticks > rumble_ticks)
+        rumble_ticks = ticks;
+}
+
 void NDS_Init (int *argc, char ***argv)
 {
     // The names fit in the 32 columns of the touch screen
@@ -230,6 +267,8 @@ void NDS_Init (int *argc, char ***argv)
     if (isDSiMode ())
         setCpuClock (true);
 
+    InitRumble ();
+
     // A black top screen until the title shows
     videoSetMode (MODE_0_2D);
     setBackdropColor (0);
