+    // Every save uses the current level, including quicksave overwrites
+    snprintf (input,sizeof(input),"Episode %d Floor %d",gamestate.episode + 1,gamestate.mapon + 1);
 
     //
     // QUICKSAVE?
@@ -1528,7 +1530,7 @@ CP_SaveGame (int quick)
             unlink (savepath);
             file = fopen (savepath, "wb");
 
-            snprintf (input,sizeof(input),"%s",SaveGameNames[which]);
+            snprintf (SaveGameNames[which],sizeof(SaveGameNames[which]),"%s",input);
 
             fwrite (input, 1, 32, file);
             fseek (file, 32, SEEK_SET);
