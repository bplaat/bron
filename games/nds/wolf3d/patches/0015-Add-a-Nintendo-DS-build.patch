diff --git a/Makefile.nds b/Makefile.nds
new file mode 100644
index 0000000..49c6b73
--- /dev/null
+++ b/Makefile.nds
@@ -0,0 +1,34 @@
+# Nintendo DS build of Wolf4SDL with the nds-ports toolchain
+#   make -f Makefile.nds TOOLCHAIN=<toolchain> ICON=<icon.bmp> [NITRO_DIR=<dir>]
+
+NAME := wolf3d
+GAME_TITLE := Wolfenstein 3D
+GAME_SUBTITLE1 := id Software (1992)
+GAME_SUBTITLE2 := Wolf4SDL NDS port
+HEADER_TITLE := WOLF3D
+BUILD := build-nds
+
+SOURCES := id_ca id_in id_pm id_sd id_us id_vh id_vl wl_act1 wl_act2 wl_agent wl_atmos \
+	wl_cloudsky wl_debug wl_game wl_inter wl_main wl_menu wl_parallax wl_plane wl_play wl_shade \
+	wl_state wl_text nds/opl nds/sdl nds/sdl_input nds/sdl_mixer nds/sdl_video nds/wl_nds nds/wl_touch
+
+# Hot code (the ray caster, the scaler and the fixed point math) runs from ITCM
+ITCM_SOURCES := wl_draw wl_scale wl_utils
+
+# The ARM7 plays the AdLib
+ARM7_SOURCES := nds/opl7
+
+# Cold code (startup, config and savegames, the menus, the intermission and
+# the help texts) is optimized for size
+COLD_SOURCES := wl_inter wl_main wl_menu wl_text
+
+include $(TOOLCHAIN)/nds.mk
+
+# Savegames hold structs with enums, int sized like on the PC instead of only
+# as big as their values. The Apogee v1.4 layout also runs the shareware and
+# GT data.
+CFLAGS += -Wno-unused -Wno-pointer-sign -Wno-parentheses -Wno-char-subscripts -Wno-format \
+	-Wno-misleading-indentation -Wno-pragma-pack \
+	-Wno-missing-braces -fno-strict-aliasing -fno-short-enums -std=gnu99 \
+	-DVERSIONALREADYCHOSEN -DCARMACIZED -Inds -I.
+$(addprefix $(BUILD)/,$(addsuffix .o,$(COLD_SOURCES))): CFLAGS += -Os
diff --git a/id_ca.c b/id_ca.c
