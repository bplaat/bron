 Makefile.nds | 34 ++++++++++++++++++++++++++++++++++
 id_ca.c      |  3 +--
 id_vl.c      |  6 +++---
 version.h    |  2 +-
 5 files changed, 43 insertions(+), 6 deletions(-)
 create mode 100644 Makefile.nds

