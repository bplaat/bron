+//
+// Writing the view down the columns of the frame misses the data cache with
+// every pixel, which is slow in DS main RAM. The ray caster and the sprites
+// only note their columns instead, the view is then put together in strips
+// of VIEWSTRIP columns that stay in DTCM and are copied into the frame in
+// words: the ceiling and floor, the wall post of each column and the
+// sprite columns queued over it by ScaleLine.
+//
+
+extern byte vgaCeiling[];
+
+static byte viewstrip[VIEWSTRIP * TOPSCREENHEIGHT] __attribute__((section(".sbss"), aligned(32)));
+static byte *postsources[TOPSCREENWIDTH];
+boolean viewdrawn;
+
 void ScalePost (void)
 {
-    int ywcount, yoffs, yw, yd, yendoffs;
-    byte col;
-
 #ifdef USE_SKYWALLPARALLAX
     if (tilehit == 16)
     {
@@ -309,59 +321,82 @@ void ScalePost (void)
     }
 #endif
 
-#ifdef USE_SHADING
-    byte *curshades = shadetable[GetShade(wallheight[postx])];
-#endif
-
-    ywcount = yd = wallheight[postx] >> 3;
-    if(yd <= 0) yd = 100;
+    postsources[postx] = postsource;
+}
 
-    yoffs = (centery - ywcount) * bufferPitch;
-    if(yoffs < 0) yoffs = 0;
-    yoffs += postx;
+// Draws the wall post of column x into its column of the strip, from row
+// y1 for n rows
+static void DrawPost (byte *post, int x, int y1, int n)
+{
+    // The texture steps in 16.16 fixed point, from the top of the wall
+    const byte *src = postsources[x];
+    int height = wallheight[x] >> 3;            // half the height in pixels
+    fixed step = div32((TEXTURESIZE/2) << FRACBITS, height);
+    fixed frac = (y1 - (centery - height)) * step;
+
+    post += y1 * VIEWSTRIP;
+    // Four pixels per loop, a branch costs the ARM9 three cycles, the loads
+    // go first so none waits for the one before
+    for (; n >= 4; n -= 4, post += 4 * VIEWSTRIP)
+    {
+        byte a = src[frac >> FRACBITS];
+        byte b = src[(frac + step) >> FRACBITS];
+        byte c = src[(frac + 2 * step) >> FRACBITS];
+        byte d = src[(frac + 3 * step) >> FRACBITS];
+        frac += 4 * step;
+        post[0] = a;
+        post[VIEWSTRIP] = b;
+        post[2 * VIEWSTRIP] = c;
+        post[3 * VIEWSTRIP] = d;
+    }
+    for (; n > 0; n--, post += VIEWSTRIP, frac += step)
+        *post = src[frac >> FRACBITS];
+}
 
-    yendoffs = centery + ywcount - 1;
-    yw=TEXTURESIZE-1;
+// Puts the view together a strip at a time, into the frame at vbuf
+static void DrawView (void)
+{
+    byte ceiling = vgaCeiling[gamestate.episode*10+gamestate.mapon];
+    int pitch = bufferPitch, height = viewheight;
+    int x, i, y;
 
-    while(yendoffs >= viewheight)
+    for (x = 0; x < viewwidth; x += VIEWSTRIP)
     {
-        ywcount -= TEXTURESIZE/2;
-        while(ywcount <= 0)
+        const uint32_t *src = (const uint32_t *) viewstrip;
+        byte *dest = vbuf + x;
+        int y1[VIEWSTRIP], y2[VIEWSTRIP];
+        int top = 0, bottom = height;
+
+        // The rows of the posts, the ceiling above the lowest top and the
+        // floor below the highest bottom, the rows between are wall in
+        // every column
+        for (i = 0; i < VIEWSTRIP; i++)
         {
-            ywcount += yd;
-            yw--;
+            int h = wallheight[x + i] >> 3;
+            y1[i] = h > 0 ? MAX(centery - h, 0) : centery;
+            y2[i] = h > 0 ? MIN(centery + h, height) : centery;
+            top = MAX(top, y1[i]);
+            bottom = MIN(bottom, y2[i]);
         }
-        yendoffs--;
-    }
-    if(yw < 0) return;
-
-#ifdef USE_SHADING
-    col = curshades[postsource[yw]];
-#else
-    col = postsource[yw];
-#endif
-    yendoffs = yendoffs * bufferPitch + postx;
-    while(yoffs <= yendoffs)
-    {
-        vbuf[yendoffs] = col;
-        ywcount -= TEXTURESIZE/2;
-        if(ywcount <= 0)
+        memset(viewstrip, ceiling, top * VIEWSTRIP);
+        memset(viewstrip + bottom * VIEWSTRIP, 0x19, (height - bottom) * VIEWSTRIP);
+        for (i = 0; i < VIEWSTRIP; i++)
         {
-            do
-            {
-                ywcount += yd;
-                yw--;
-            }
-            while(ywcount <= 0);
-            if(yw < 0) break;
-#ifdef USE_SHADING
-            col = curshades[postsource[yw]];
-#else
-            col = postsource[yw];
-#endif
+            if (y2[i] > y1[i])
+                DrawPost (viewstrip + i, x + i, y1[i], y2[i] - y1[i]);
+            DrawSpriteColumns (viewstrip + i, x + i);
+        }
+        // A row of the strip is four words, written as one burst
+        for (y = 0; y < height; y++, dest += pitch, src += 4)
+        {
+            uint32_t a = src[0], b = src[1], c = src[2], d = src[3];
+            ((uint32_t *) dest)[0] = a;
+            ((uint32_t *) dest)[1] = b;
+            ((uint32_t *) dest)[2] = c;
+            ((uint32_t *) dest)[3] = d;
         }
-        yendoffs -= bufferPitch;
     }
+    viewdrawn = true;
 }
 
