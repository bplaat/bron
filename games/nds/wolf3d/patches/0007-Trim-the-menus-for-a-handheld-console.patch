+{
+    int i, n = 0;
+
+    if (!ingame)
+        return MainMenu;
+    gamemenuitem[n++] = backtodemo;
+    for (i = 0; i < quit; i++)
+        if (i != backtodemo && i != viewscores)
+            gamemenuitem[n++] = i;
+    gamemenuitem[n++] = viewscores;
+    for (i = 0; i < n; i++)
+        GameMenu[i] = MainMenu[gamemenuitem[i]];
+    return GameMenu;
+}
