From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Bastiaan van der Plaat <bastiaan.v.d.plaat@gmail.com>
Date: Tue, 6 Oct 2026 12:00:00 +0200
Subject: [PATCH] Use single precision and reduce floating point work

Use float math for trig, projection and OPL tables, the OPL tables
without powf. Share the direction conversion and multiply by a constant
instead of dividing for each aim. CalcRotate works in integers instead of
doubles for every sprite, and the audio buffer size is found with a bit
scan instead of the double log2. No double math is left.
---
 id_sd.c    |  2 +-
 nds/opl.c  | 24 ++++++++++++-----
 wl_act2.c  | 31 ++++------------------
 wl_def.h   |  4 +--
 wl_draw.c  |  3 ++-
 wl_game.c  |  7 +----
 wl_inter.c | 78 +++++++++++++++++++++++++++---------------------------
 wl_main.c  | 10 +++----
 wl_utils.c | 12 +++++++++
 wl_utils.h |  1 +
 10 files changed, 85 insertions(+), 87 deletions(-)

diff --git a/id_sd.c b/id_sd.c
index 4667fc3..cdc3151 100644
--- a/id_sd.c
+++ b/id_sd.c
@@ -878,7 +878,7 @@ SD_Startup(void)
         if (!param_samplerate || param_samplerate > 44100)
             Quit ("Divide by zero caused by invalid samplerate!");
 
-        chunksize = 1 << (int)log2(param_audiobuffer / (44100 / param_samplerate));
+        chunksize = 1 << (31 - __builtin_clz(param_audiobuffer / (44100 / param_samplerate)));
     }
 
     if (Mix_OpenAudioDevice(param_samplerate,AUDIO_S16,2,chunksize,NULL,SDL_AUDIO_ALLOW_FREQUENCY_CHANGE))
diff --git a/nds/opl.c b/nds/opl.c
index db40887..96bc7a7 100644
--- a/nds/opl.c
+++ b/nds/opl.c
@@ -25,10 +25,11 @@ static const u8 eg_inc[15][8] =
 static void InitTables (opl_tables_t *t)
 {
     int i, w;
+    float volume;
 
     for (i = 0; i < SIN_LEN; ++i)
     {
-        s16 s = (s16) lrint (sin ((i * 2 + 1) * M_PI / SIN_LEN) * 4095);
+        s16 s = (s16) lrintf (sinf ((i * 2 + 1) * (float) M_PI / SIN_LEN) * 4095);
         int quarter = i / (SIN_LEN / 4);
 
         t->sin_tab[0][i] = s;
@@ -36,8 +37,10 @@ static void InitTables (opl_tables_t *t)
         t->sin_tab[2][i] = s > 0 ? s : -s;
         t->sin_tab[3][i] = quarter & 1 ? 0 : t->sin_tab[2][i];
     }
-    for (w = 0; w < 32; ++w)
-        t->att_volume[w] = (u16) lrint (2047 * pow (2.0, -w / 32.0));
+    // 2047 * 2^(-w/32), multiplied up step by step instead of with powf
+    volume = 2047;
+    for (w = 0; w < 32; ++w, volume *= 0.97857206f)
+        t->att_volume[w] = (u16) lrintf (volume);
 
     // The first 16 rates are infinite, rates 0-12 step every 2^(12-n)
     // samples and 13-15 every sample, with the increments of the MAME
@@ -45,7 +48,7 @@ static void InitTables (opl_tables_t *t)
     for (i = 0; i < 96; ++i)
     {
         int rate = (i - 16) / 4, sel, shift = 0;
-        double avg = 0, updates;
+        float avg = 0, updates, factor;
 
         if (i < 16)
             sel = 14;
@@ -56,12 +59,19 @@ static void InitTables (opl_tables_t *t)
         }
         else
             sel = rate < 15 ? 4 + (rate - 13) * 4 + ((i - 16) & 3) : 12;
-        updates = (double) EG_QUANTUM / (1 << shift);
+        updates = (float) EG_QUANTUM / (1 << shift);
 
         for (w = 0; w < 8; ++w)
-            avg += eg_inc[sel][w] / 8.0;
+            avg += eg_inc[sel][w] / 8.0f;
         t->rate_inc[i] = (s32) (avg * updates * 65536);
-        t->rate_att[i] = (u32) (pow (1.0 - avg / 8.0, updates) * 65536);
+        // (1 - avg/8)^updates, updates being EG_QUANTUM / 2^shift: squared
+        // to the EG_QUANTUM power, then shift square roots, the same as powf
+        factor = 1.0f - avg / 8.0f;
+        for (w = 1; w < EG_QUANTUM; w *= 2)
+            factor *= factor;
+        for (w = 0; w < shift; ++w)
+            factor = sqrtf (factor);
+        t->rate_att[i] = (u32) (factor * 65536);
     }
 }
 
