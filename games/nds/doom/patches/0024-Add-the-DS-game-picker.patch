+#include <ctype.h>
+#include <fat.h>
+#include <filesystem.h>
+#include <stdio.h>
+#include <string.h>
+#include <dirent.h>
+#include <stdlib.h>
+#include <sys/iosupport.h>
+#include <sys/stat.h>
+#include <unistd.h>
