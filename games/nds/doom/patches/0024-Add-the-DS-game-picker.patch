+// ---------------------------------------------------------------------------
+// Entry point
+// ---------------------------------------------------------------------------
+
+// Doom runs in a thread of its own, with its stack in main RAM: DTCM is
+// mostly used by the light tables (r_data.c), and Doom's deepest recursion
+// grows with the size of a map
+static char *doom_argv[8] = { "doom", "-iwad" };
+static int doom_argc = 3;
+static u64 doom_stack[64 * 1024 / sizeof(u64)];
+
+static int DoomMain(void *arg)
+{
+    doomgeneric_Create(doom_argc, doom_argv);
+    for (;;)
+        doomgeneric_Tick();
+    return 0;
+}
+
+int main(int argc, char **argv)
+{
+    static Thread doom_thread;
+    const wad_entry_t *wad;
+
+    // In DSi mode the ARM9 runs at twice the speed of the DS
+    if (isDSiMode())
+        setCpuClock(true);
+
+    I_NDS_InitVideo();
+    ConsoleMode();
+    PrintHeader();
+
+    have_fat = fatInitDefault();
+    nitroFSInit(NULL);
+    // Paths without a device need a current device, use the ROM if there is no SD card
+    if (!have_fat)
+        chdir("nitro:/");
+
+    // A mod runs as -file on top of its IWAD
+    wad = PickWad();
+    doom_argv[2] = wads[wad->base].path;
+    if (!wad->iwad)
+    {
+        doom_argv[doom_argc++] = "-file";
+        doom_argv[doom_argc++] = (char *) wad->path;
+    }
+    PrintHeader();
+    EnterDataDir(wad);
+    printf("\n  Loading %s\n\n  ", wad->title);
+    fflush(stdout);
+    SetLoadingOutput(true);
+
+    // Extra command line options (eg. -skill 4 -warp 1 3) can be put in
+    // /data/doom/args.txt, expanded as a Doom response file
+    if (have_fat && FileExists(DATA_DIR "/args.txt"))
+        doom_argv[doom_argc++] = "@" DATA_DIR "/args.txt";
+
+    threadPrepare(&doom_thread, DoomMain, NULL, (byte *) doom_stack + sizeof(doom_stack), MAIN_THREAD_PRIO);
+    threadAttachLocalStorage(&doom_thread, NULL);
+    threadStart(&doom_thread);
+    return threadJoin(&doom_thread);
+}
