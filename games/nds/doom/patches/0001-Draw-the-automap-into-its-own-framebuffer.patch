From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Bastiaan van der Plaat <bastiaan.v.d.plaat@gmail.com>
Date: Sat, 3 Oct 2026 11:04:38 +0200
Subject: [PATCH] Draw the automap into its own framebuffer

AM_SetFramebuffer() makes the automap render into a separate buffer of a
different size, such as the touch screen of a Nintendo DS. The player
view, border and status bar then keep being drawn on the main screen
while the map is up, automap marks are drawn into that buffer too and
the level name is left to that screen.

A map always shown around the player clips far more lines that lie far
outside its window. The clipping now computes the intersections in 64
bits and gives up after four clips: the 32-bit products overflowed, and
the wrong intersections could make it bounce between the edges forever.

The automap on its own screen also stays up when the player dies, vanilla
stops it there so the death is seen in the view.
---
 doomgeneric/am_map.c   | 69 ++++++++++++++++++++++++++++++++++++++----
 doomgeneric/am_map.h   |  5 +++
 doomgeneric/d_main.c   |  8 ++---
 doomgeneric/hu_lib.c   |  3 +-
 doomgeneric/hu_stuff.c |  4 ++-
 doomgeneric/p_inter.c  |  2 +-
 doomgeneric/st_stuff.c |  2 +-
 7 files changed, 79 insertions(+), 14 deletions(-)

diff --git a/doomgeneric/am_map.c b/doomgeneric/am_map.c
index d3d504e..459f578 100644
--- a/doomgeneric/am_map.c
+++ b/doomgeneric/am_map.c
@@ -31,6 +31,7 @@
 #include "m_cheat.h"
 #include "m_controls.h"
 #include "m_misc.h"
+#include "i_swap.h"
 #include "i_system.h"
 
 // Needs access to LFB.
@@ -211,6 +212,7 @@ static int	f_h;
 
 static int 	lightlev; 		// used for funky strobing effect
 static byte*	fb; 			// pseudo-frame buffer
+static byte*	am_fb;			// separate automap screen, if any
 static int 	amclock;
 
 static mpoint_t m_paninc; // how far the window pans each tic (map coords)
@@ -421,13 +423,27 @@ void AM_changeWindowLoc(void)
 //
 //
 //
+// Draws the automap into its own framebuffer (e.g. a second screen)
+// instead of over the player view.
+void AM_SetFramebuffer(byte *buffer, int width, int height)
+{
+    am_fb = buffer;
+    finit_width = width;
+    finit_height = height;
+}
+
+boolean AM_HasOwnScreen(void)
+{
+    return am_fb != NULL;
+}
+
 void AM_initVariables(void)
 {
     int pnum;
     static event_t st_notify = { ev_keyup, AM_MSGENTERED, 0, 0 };
 
     automapactive = true;
-    fb = I_VideoBuffer;
+    fb = am_fb != NULL ? am_fb : I_VideoBuffer;
 
     f_oldloc.x = INT_MAX;
     amclock = 0;
@@ -860,6 +876,7 @@ AM_clipMline
     register int	outcode1 = 0;
     register int	outcode2 = 0;
     register int	outside;
+    int		clips = 0;
     
     fpoint_t	tmp;
     int		dx;
@@ -923,32 +940,35 @@ AM_clipMline
 	    outside = outcode2;
 	
 	// clip to each side
+	// the products are 64-bit: lines far outside the screen overflow
+	// 32 bits, and the wrong intersections could make the clipping
+	// bounce between the edges forever
 	if (outside & TOP)
 	{
 	    dy = fl->a.y - fl->b.y;
 	    dx = fl->b.x - fl->a.x;
-	    tmp.x = fl->a.x + (dx*(fl->a.y))/dy;
+	    tmp.x = fl->a.x + (int64_t) dx*(fl->a.y)/dy;
 	    tmp.y = 0;
 	}
 	else if (outside & BOTTOM)
 	{
 	    dy = fl->a.y - fl->b.y;
 	    dx = fl->b.x - fl->a.x;
-	    tmp.x = fl->a.x + (dx*(fl->a.y-f_h))/dy;
+	    tmp.x = fl->a.x + (int64_t) dx*(fl->a.y-f_h)/dy;
 	    tmp.y = f_h-1;
 	}
 	else if (outside & RIGHT)
 	{
 	    dy = fl->b.y - fl->a.y;
 	    dx = fl->b.x - fl->a.x;
-	    tmp.y = fl->a.y + (dy*(f_w-1 - fl->a.x))/dx;
+	    tmp.y = fl->a.y + (int64_t) dy*(f_w-1 - fl->a.x)/dx;
 	    tmp.x = f_w-1;
 	}
 	else if (outside & LEFT)
 	{
 	    dy = fl->b.y - fl->a.y;
 	    dx = fl->b.x - fl->a.x;
-	    tmp.y = fl->a.y + (dy*(-fl->a.x))/dx;
+	    tmp.y = fl->a.y + (int64_t) dy*(-fl->a.x)/dx;
 	    tmp.x = 0;
 	}
         else
@@ -970,6 +990,10 @@ AM_clipMline
 	
 	if (outcode1 & outcode2)
 	    return false; // trivially outside
+
+	// each end is clipped to at most two edges
+	if (++clips > 4)
+	    return false;
     }
 
     return true;
@@ -1308,6 +1332,34 @@ AM_drawThings
     }
 }
 
+// V_DrawPatch only knows the main screen, so draw marks into fb directly
+static void AM_drawPatch(int x, int y, patch_t *patch)
+{
+    int col, w = SHORT(patch->width);
+
+    x -= SHORT(patch->leftoffset);
+    y -= SHORT(patch->topoffset);
+    for (col = 0; col < w; col++)
+    {
+        column_t *column = (column_t *) ((byte *) patch + LONG(patch->columnofs[col]));
+
+        while (column->topdelta != 0xff)
+        {
+            byte *source = (byte *) column + 3;
+            int i;
+
+            for (i = 0; i < column->length; i++)
+            {
+                int py = y + column->topdelta + i;
+
+                if (x + col >= 0 && x + col < f_w && py >= 0 && py < f_h)
+                    fb[py * f_w + x + col] = source[i];
+            }
+            column = (column_t *) ((byte *) column + column->length + 4);
+        }
+    }
+}
+
 void AM_drawMarks(void)
 {
     int i, fx, fy, w, h;
@@ -1323,7 +1375,12 @@ void AM_drawMarks(void)
 	    fx = CXMTOF(markpoints[i].x);
 	    fy = CYMTOF(markpoints[i].y);
 	    if (fx >= f_x && fx <= f_w - w && fy >= f_y && fy <= f_h - h)
-		V_DrawPatch(fx, fy, marknums[i]);
+	    {
+		if (am_fb != NULL)
+		    AM_drawPatch(fx, fy, marknums[i]);
+		else
+		    V_DrawPatch(fx, fy, marknums[i]);
+	    }
 	}
     }
 
