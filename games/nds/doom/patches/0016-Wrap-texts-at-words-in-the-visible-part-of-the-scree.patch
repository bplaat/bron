diff --git a/doomgeneric/hu_lib.c b/doomgeneric/hu_lib.c
index 04e34ba..264fe9a 100644
--- a/doomgeneric/hu_lib.c
+++ b/doomgeneric/hu_lib.c
@@ -91,6 +91,20 @@ boolean HUlib_delCharFromTextLine(hu_textline_t* t)
 
 }
 
+// The width of the word starting at character i of a line
+static int HUlib_wordWidth(hu_textline_t *l, int i)
+{
+    int w = 0;
+    unsigned char c;
+
+    for ( ; i < l->len && l->l[i] != ' '; i++)
+    {
+	c = toupper((int)l->l[i]);
+	w += c >= l->sc && c <= '_' ? SHORT(l->f[c - l->sc]->width) : 4;
+    }
+    return w;
+}
+
 void
 HUlib_drawTextLine
 ( hu_textline_t*	l,
@@ -100,10 +114,13 @@ HUlib_drawTextLine
     int			i;
     int			w;
     int			x;
+    int			y;
+    int			right = V_VISIBLEX + V_VISIBLEW;
     unsigned char	c;
 
     // draw the new stuff
     x = l->x;
+    y = l->y;
     for (i=0;i<l->len;i++)
     {
 	c = toupper((int)l->l[i]);
@@ -112,24 +129,31 @@ HUlib_drawTextLine
 	    && c <= '_')
 	{
 	    w = SHORT(l->f[c - l->sc]->width);
-	    if (x+w > SCREENWIDTH)
+	    if (x+w > right)
 		break;
-	    V_DrawPatchDirect(x, l->y, l->f[c - l->sc]);
+	    V_DrawPatchDirect(x, y, l->f[c - l->sc]);
 	    x += w;
 	}
 	else
 	{
 	    x += 4;
-	    if (x >= SCREENWIDTH)
+	    // a visible part narrower than the screen wraps long lines
+	    if (V_VISIBLEW < SCREENWIDTH && c == ' '
+	     && x + HUlib_wordWidth(l, i + 1) > right)
+	    {
+		x = l->x;
+		y += SHORT(l->f[0]->height) + 1;
+	    }
+	    if (x >= right)
 		break;
 	}
     }
 
     // draw the cursor if requested
     if (drawcursor
-	&& x + SHORT(l->f['_' - l->sc]->width) <= SCREENWIDTH)
+	&& x + SHORT(l->f['_' - l->sc]->width) <= right)
     {
-	V_DrawPatchDirect(x, l->y, l->f['_' - l->sc]);
+	V_DrawPatchDirect(x, y, l->f['_' - l->sc]);
     }
 }
 
diff --git a/doomgeneric/m_menu.c b/doomgeneric/m_menu.c
index 6054318..385018c 100644
--- a/doomgeneric/m_menu.c
+++ b/doomgeneric/m_menu.c
@@ -1302,6 +1302,43 @@ M_DrawSelCell
 }
 
 
+//
+// M_WrapMessage
+// Breaks lines wider than the visible part at spaces
+//
+static char *M_WrapMessage(char *string)
+{
+    static char wrapped[512];
+    char *p, *space = NULL;
+    int w = 0, wspace = 0;
+
+    if (V_VISIBLEW == SCREENWIDTH)
+	return string;
+    M_StringCopy(wrapped, string, sizeof(wrapped));
+    for (p = wrapped; *p; p++)
+    {
+	if (*p == '\n')
+	{
+	    w = 0;
+	    space = NULL;
+	    continue;
+	}
+	w += M_CharWidth(*p);
+	if (*p == ' ')
+	{
+	    space = p;
+	    wspace = w;
+	}
+	else if (w > V_VISIBLEW - 8 && space)
+	{
+	    *space = '\n';
+	    w -= wspace;
+	    space = NULL;
+	}
+    }
+    return wrapped;
+}
+
 void
 M_StartMessage
 ( char*		string,
@@ -1310,7 +1347,7 @@ M_StartMessage
 {
     messageLastMenuActive = menuactive;
     messageToPrint = 1;
-    messageString = string;
+    messageString = M_WrapMessage(string);
     messageRoutine = routine;
     messageNeedsInput = input;
     menuactive = true;
@@ -1329,20 +1366,20 @@ void M_StopMessage(void)
 //
 // Find string width from hu_font chars
 //
+int M_CharWidth(char ch)
+{
+    int c = toupper(ch) - HU_FONTSTART;
+
+    return c < 0 || c >= HU_FONTSIZE ? 4 : SHORT (hu_font[c]->width);
+}
+
 int M_StringWidth(char* string)
 {
     size_t             i;
     int             w = 0;
-    int             c;
 	
     for (i = 0;i < strlen(string);i++)
-    {
-	c = toupper(string[i]) - HU_FONTSTART;
-	if (c < 0 || c >= HU_FONTSIZE)
-	    w += 4;
-	else
-	    w += SHORT (hu_font[c]->width);
-    }
+	w += M_CharWidth(string[i]);
 		
     return w;
 }
