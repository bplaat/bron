From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Bastiaan van der Plaat <bastiaan.v.d.plaat@gmail.com>
Date: Sat, 3 Oct 2026 11:04:42 +0200
Subject: [PATCH] Wrap texts at words in the visible part of the screen

HUD messages, menu messages and the finale texts are drawn inside the
visible part and wrap at words where they are wider. A wrapped finale
text taller than the visible part has its lines set closer, so it never
runs off the bottom: the longest, E4's and DOOM II's second, take 21
lines.
---
 doomgeneric/f_finale.c | 109 ++++++++++++++++++++++++++++-------------
 doomgeneric/hu_lib.c   |  34 +++++++++++--
 doomgeneric/m_menu.c   |  55 +++++++++++++++++----
 doomgeneric/m_menu.h   |   3 ++
 4 files changed, 152 insertions(+), 49 deletions(-)

diff --git a/doomgeneric/f_finale.c b/doomgeneric/f_finale.c
index 5126aad..dadea2d 100644
--- a/doomgeneric/f_finale.c
+++ b/doomgeneric/f_finale.c
@@ -221,20 +221,80 @@ void F_Ticker (void)
 //
 
 #include "hu_stuff.h"
+#include "m_menu.h"
 extern	patch_t *hu_font[HU_FONTSIZE];
 
 
+// The width of the word that starts at s, in the HUD font
+static int F_WordWidth (const char *s)
+{
+    int w = 0;
+
+    for ( ; *s && *s != ' ' && *s != '\n'; s++)
+	w += M_CharWidth(*s);
+    return w;
+}
+
+// Lays out the first count characters of the finale text (all of it when
+// negative) from cy down, lines lineheight apart, drawing them when draw is
+// set. Returns the number of lines.
+static int F_LayoutText (signed int count, int cy, int lineheight, boolean draw)
+{
+    boolean	wrap = V_VISIBLEW < SCREENWIDTH;
+    int		left = V_VISIBLEX + (wrap ? 6 : 10);
+    int		right = V_VISIBLEX + V_VISIBLEW - (wrap ? 6 : 0);
+    int		cx = left;
+    int		lines = 1;
+    char*	ch = finaletext;
+    int		c, w;
+
+    for ( ; count ; count-- )
+    {
+	c = *ch++;
+	if (!c)
+	    break;
+	// a visible part narrower than the screen wraps the text again: a
+	// single newline is a space and a word that doesn't fit goes on the
+	// next line
+	if (wrap && c == '\n' && *ch != '\n' && (ch - 2 < finaletext || ch[-2] != '\n'))
+	    c = ' ';
+	if (c == '\n' || (wrap && c == ' ' && cx + 4 + F_WordWidth(ch) > right))
+	{
+	    cx = left;
+	    cy += lineheight;
+	    lines++;
+	    continue;
+	}
+
+	c = toupper(c) - HU_FONTSTART;
+	if (c < 0 || c> HU_FONTSIZE)
+	{
+	    cx += 4;
+	    continue;
+	}
+
+	w = SHORT (hu_font[c]->width);
+	if (cx+w > right)
+	    break;
+	if (draw)
+	    V_DrawPatch(cx, cy, hu_font[c]);
+	cx+=w;
+    }
+    return lines;
+}
+
+// Characters of the HUD font are up to 8 pixels tall
+#define TEXTHEIGHT	8
+
 void F_TextWrite (void)
 {
     byte*	src;
     byte*	dest;
     
-    int		x,y,w;
+    int		x,y;
     signed int	count;
-    char*	ch;
-    int		c;
-    int		cx;
-    int		cy;
+    int		lines;
+    int		lineheight;
     
     // erase the entire screen to a tiled background
     src = W_CacheLumpName ( finaleflat , PU_CACHE);
@@ -256,40 +316,19 @@ void F_TextWrite (void)
 
     V_MarkRect (0, 0, SCREENWIDTH, SCREENHEIGHT);
     
+    // wrapped texts take more lines, the lines of one taller than the
+    // visible part move closer and up
+    lines = F_LayoutText(-1, 0, 0, false);
+    lineheight = 11;
+    if (lines > 1 && (V_VISIBLEH - 2 - TEXTHEIGHT) / (lines - 1) < lineheight)
+	lineheight = (V_VISIBLEH - 2 - TEXTHEIGHT) / (lines - 1);
+    y = V_VISIBLEH - TEXTHEIGHT - (lines - 1) * lineheight;
+
     // draw some of the text onto the screen
-    cx = 10;
-    cy = 10;
-    ch = finaletext;
-	
     count = ((signed int) finalecount - 10) / TEXTSPEED;
     if (count < 0)
 	count = 0;
-    for ( ; count ; count-- )
-    {
-	c = *ch++;
-	if (!c)
-	    break;
-	if (c == '\n')
-	{
-	    cx = 10;
-	    cy += 11;
-	    continue;
-	}
-		
-	c = toupper(c) - HU_FONTSTART;
-	if (c < 0 || c> HU_FONTSIZE)
-	{
-	    cx += 4;
-	    continue;
-	}
-		
-	w = SHORT (hu_font[c]->width);
-	if (cx+w > SCREENWIDTH)
-	    break;
-	V_DrawPatch(cx, cy, hu_font[c]);
-	cx+=w;
-    }
-	
+    F_LayoutText(count, V_VISIBLEY + (y < 10 ? y : 10), lineheight, true);
 }
 
