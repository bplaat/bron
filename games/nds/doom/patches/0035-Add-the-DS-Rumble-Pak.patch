 //
 static char *msgNames[2] = {"M_MSGOFF","M_MSGON"};
 
+// Rumble has no menu graphic, it is cut from the letters of others. The
+// sizes of id's graphics make sure no other art is cut up, which gets the
+// HUD font instead.
+#define RUMBLE_WIDTH    90
+#define RUMBLE_HEIGHT   16
+
+static const struct
+{
+    char *name;
+    short width, height;
+} rumbleLumps[] =
+{
+    {"M_RDTHIS", 121, 15},
+    {"M_SVOL", 168, 15},
+    {"M_ROUGH", 248, 16},
+    {"M_LOADG", 125, 15},
+    {"M_MESSG", 118, 15}
+};
+
+// The rows y0 to y1 of columns x0 to x1 of a graphic, moved dy rows. A new
+// letter starts with a part as wide as it.
+static const struct
+{
+    byte lump, x0, x1, y0, y1;
+    signed char dy;
+    boolean letter;
+} rumbleParts[] =
+{
+    {0, 0, 16, 0, 16, 0, true},         // R of Read This!
+    {1, 124, 139, 0, 16, 0, true},      // u of Sound Volume
+    {1, 139, 155, 0, 16, 0, true},      // m
+    {2, 167, 182, 0, 9, 0, true},       // b: the top of the r of rough,
+    {2, 167, 173, 10, 12, -4, false},   // its stem filling the notch
+    {3, 45, 60, 9, 16, 0, false},       // and the bottom of the d of Load
+    {1, 114, 124, 0, 16, 0, true},      // l of Sound Volume
+    {1, 155, 168, 0, 16, 0, true},      // e
+    {4, 113, 118, 0, 16, 0, true}       // : of Messages:
+};
+
+static patch_t *M_BuildRumblePatch(void)
+{
+    patch_t *src[arrlen(rumbleLumps)], *patch;
+    byte pixels[RUMBLE_HEIGHT][RUMBLE_WIDTH];
+    boolean opaque[RUMBLE_HEIGHT][RUMBLE_WIDTH] = { 0 };
+    byte data[8 + RUMBLE_WIDTH * 4 + RUMBLE_WIDTH * (RUMBLE_HEIGHT * 3 + 1)];
+    byte *p;
+    unsigned int i;
+    int x, y, sx, width = 0;
+
+    for (i = 0; i < arrlen(rumbleLumps); ++i)
+    {
+        if (W_CheckNumForName(rumbleLumps[i].name) < 0)
+            return NULL;
+        src[i] = W_CacheLumpName(rumbleLumps[i].name, PU_CACHE);
+        if (SHORT(src[i]->width) != rumbleLumps[i].width
+         || SHORT(src[i]->height) != rumbleLumps[i].height)
+            return NULL;
+    }
+    // static now, caching the next one could purge them
+    for (i = 0; i < arrlen(rumbleLumps); ++i)
+        src[i] = W_CacheLumpName(rumbleLumps[i].name, PU_STATIC);
+
+    x = 0;
+    for (i = 0; i < arrlen(rumbleParts); ++i)
+    {
+        if (rumbleParts[i].letter)
+        {
+            x += width;
+            width = rumbleParts[i].x1 - rumbleParts[i].x0;
+        }
+        for (sx = rumbleParts[i].x0; sx < rumbleParts[i].x1; ++sx)
+        {
+            patch_t *s = src[rumbleParts[i].lump];
+            column_t *column = (column_t *) ((byte *) s + LONG(s->columnofs[sx]));
+
+            while (column->topdelta != 0xff)
+            {
+                for (y = column->topdelta; y < column->topdelta + column->length; ++y)
+                    if (y >= rumbleParts[i].y0 && y < rumbleParts[i].y1)
+                    {
+                        int dx = x + sx - rumbleParts[i].x0, dy = y + rumbleParts[i].dy;
+
+                        pixels[dy][dx] = ((byte *) column)[3 + y - column->topdelta];
+                        opaque[dy][dx] = true;
+                    }
+                column = (column_t *) ((byte *) column + column->length + 4);
+            }
+        }
+    }
+    for (i = 0; i < arrlen(rumbleLumps); ++i)
+        W_ReleaseLumpName(rumbleLumps[i].name);
+
+    // A post for each run of pixels in a column
+    patch = (patch_t *) data;
+    patch->width = SHORT(RUMBLE_WIDTH);
+    patch->height = SHORT(RUMBLE_HEIGHT);
+    patch->leftoffset = patch->topoffset = 0;
+    p = (byte *) &patch->columnofs[RUMBLE_WIDTH];
+    for (x = 0; x < RUMBLE_WIDTH; ++x)
+    {
+        patch->columnofs[x] = LONG(p - data);
+        for (y = 0; y < RUMBLE_HEIGHT; ++y)
+            if (opaque[y][x] && (y == 0 || !opaque[y - 1][x]))
+            {
+                byte *post = p;
+
+                post[0] = y;
+                post[2] = 0;
+                p += 3;
+                while (y < RUMBLE_HEIGHT && opaque[y][x])
+                    *p++ = pixels[y++][x];
+                post[1] = p - post - 3;
+                *p++ = 0;
+            }
+        *p++ = 0xff;
+    }
+    patch = Z_Malloc(p - data, PU_STATIC, NULL);
+    memcpy(patch, data, p - data);
+    return patch;
+}
+
 void M_DrawOptions(void)
 {
+    static patch_t *rumblePatch;
+    static boolean rumbleBuilt;
+
     V_DrawPatchDirect(108, 15, W_CacheLumpName(DEH_String("M_OPTTTL"),
                                                PU_CACHE));
 
     V_DrawPatchDirect(OptionsDef.x + 120, OptionsDef.y + LINEHEIGHT * messages,
                       W_CacheLumpName(DEH_String(msgNames[showMessages]),
                                       PU_CACHE));
+
+    if (!rumbleBuilt)
+    {
+        rumblePatch = M_BuildRumblePatch();
+        rumbleBuilt = true;
+    }
+    if (rumblePatch != NULL)
+        V_DrawPatchDirect(OptionsDef.x, OptionsDef.y + LINEHEIGHT * rumbling, rumblePatch);
+    else
+        M_WriteText(OptionsDef.x, OptionsDef.y + LINEHEIGHT * rumbling + 4, "RUMBLE:");
+    V_DrawPatchDirect(OptionsDef.x + 120, OptionsDef.y + LINEHEIGHT * rumbling,
+                      W_CacheLumpName(DEH_String(msgNames[rumble]),
+                                      PU_CACHE));
 }
 
 void M_Options(int choice)
@@ -1052,6 +1192,16 @@ void M_ChangeMessages(int choice)
 }
 
 
+//
+//      Toggle the Rumble Pak on/off, it rumbles once turned on
+//
+void M_ChangeRumble(int choice)
+{
+    rumble = 1 - rumble;
+    I_Tactile(0, 0, 100);
+}
