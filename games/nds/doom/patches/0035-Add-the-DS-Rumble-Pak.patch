 //
 
 #include <nds.h>
@@ -44,6 +45,44 @@ static const button_binding_t bindings[] =
 // opened or closed in between
 static int held_keys[arrlen(bindings)];
 
+// The Rumble Pak only moves while it is switched back and forth, which a tick
+// task does at 60 Hz for as long as the rumble lasts. Only a DS has a GBA
+// slot, on a DSi gbacartOpen fails.
+#define RUMBLE_HZ 60
+
+int rumble = 1;
+
+static boolean rumble_inserted;
+static volatile int rumble_ticks;
+static TickTask rumble_task;
+
+static void RumbleTick(TickTask *task)
+{
+    if (rumble_ticks > 0)
+        --rumble_ticks;
+    rumbleSet(rumble_ticks & 1);
+}
+
+void NDS_InitRumble(void)
+{
+    if (!gbacartOpen())
+        return;
+    rumble_inserted = rumbleIsInserted();
+    if (rumble_inserted)
+        tickTaskStart(&rumble_task, RumbleTick, ticksFromHz(RUMBLE_HZ), ticksFromHz(RUMBLE_HZ));
+    else
+        gbacartClose();
+}
+
+// Rumbles for twice the total of Doom's tactile feedback in milliseconds
+void I_Tactile(int on, int off, int total)
+{
+    int ticks = total * 2 * RUMBLE_HZ / 1000;
+
+    if (rumble_inserted && rumble && ticks > rumble_ticks)
+        rumble_ticks = ticks;
+}
+
 void NDS_PostKey(evtype_t type, int key)
 {
     event_t ev = { 0 };
