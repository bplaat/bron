From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Bastiaan van der Plaat <bastiaan.v.d.plaat@gmail.com>
Date: Sat, 3 Oct 2026 11:04:44 +0200
Subject: [PATCH] Read response files

doomgeneric left response files out, the DS reads extra options from
one in /data/doom/args.txt. A missing file is skipped, a read that stops
early is an error instead of retrying forever, and a file with more
arguments than fit is an error instead of overflowing the list.
---
 doomgeneric/m_argv.c | 27 +++++++++++++++++++++------
 1 file changed, 21 insertions(+), 6 deletions(-)

diff --git a/doomgeneric/m_argv.c b/doomgeneric/m_argv.c
index 1582450..00e3e3c 100644
--- a/doomgeneric/m_argv.c
+++ b/doomgeneric/m_argv.c
@@ -74,7 +74,7 @@ int M_CheckParm(char *check)
 
 static void LoadResponseFile(int argv_index)
 {
-#if ORIGCODE
+    // The Nintendo DS reads extra options from a response file
     FILE *handle;
     int size;
     char *infile;
@@ -92,9 +92,7 @@ static void LoadResponseFile(int argv_index)
     if (handle == NULL)
     {
         printf ("\nNo such response file!");
-#if ORIGCODE
-        exit(1);
-#endif
+        return;
     }
 
     printf("Found response file %s!\n", response_filename);
@@ -108,13 +106,20 @@ static void LoadResponseFile(int argv_index)
 
     file = malloc(size + 1);
 
+    if (file == NULL)
+    {
+        I_Error("Not enough memory for response file '%s'", response_filename);
+    }
+
     i = 0;
 
     while (i < size)
     {
         k = fread(file + i, 1, size - i, handle);
 
-        if (k < 0)
+        // fread returns 0 at an early end or a read error, retrying would
+        // never end
+        if (k <= 0)
         {
             I_Error("Failed to read full contents of '%s'", response_filename);
         }
@@ -127,6 +132,10 @@ static void LoadResponseFile(int argv_index)
     // Create new arguments list array
 
     newargv = malloc(sizeof(char *) * MAXARGVS);
+    if (newargv == NULL)
+    {
+        I_Error("Not enough memory for response file '%s'", response_filename);
+    }
     newargc = 0;
     memset(newargv, 0, sizeof(char *) * MAXARGVS);
 
@@ -143,6 +152,13 @@ static void LoadResponseFile(int argv_index)
 
     while(k < size)
     {
+        // Leave room for the arguments after the response file
+        if (newargc >= MAXARGVS - myargc)
+        {
+            I_Error("Too many arguments in response file '%s'",
+                    response_filename);
+        }
+
         // Skip past space characters to the next argument
 
         while(k < size && isspace((int)infile[k]))
@@ -225,7 +241,6 @@ static void LoadResponseFile(int argv_index)
         printf("'%s'\n", myargv[k]);
     }
 #endif
-#endif
 }
 
