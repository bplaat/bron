diff --git a/Game/src/premap.c b/Game/src/premap.c
index c28f39e..26f4cbb 100644
--- a/Game/src/premap.c
+++ b/Game/src/premap.c
@@ -992,8 +992,11 @@ void newgame(uint8_t  vn,uint8_t  ln,uint8_t  sk)
     struct player_struct *p = &ps[0];
     short i;
 
+    // The lock drops when the sound ends, which the input and sound
+    // polling of _idle() report
     if(globalskillsound >= 0)
-        while(Sound[globalskillsound].lock>=200);
+        while(Sound[globalskillsound].lock>=200)
+            _idle();
     globalskillsound = -1;
 
     waitforeverybody();
