From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Bastiaan van der Plaat <bastiaan.v.d.plaat@gmail.com>
Date: Wed, 7 Oct 2026 12:00:00 +0200
Subject: [PATCH] Align what the cache holds to 16 bytes

Ken's cache allocated whole 16 byte blocks, this one adds 15 bytes to
every size instead, so tiles, sounds and the LZW buffers start anywhere.
The x86 doesn't mind, the ARM can't read or write words and halfwords at
unaligned addresses. Blocks are 16 bytes again, from an aligned start.
---
 Engine/src/cache.c | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/Engine/src/cache.c b/Engine/src/cache.c
index 58e35f5..55d32a3 100644
--- a/Engine/src/cache.c
+++ b/Engine/src/cache.c
@@ -80,8 +80,8 @@ void initcache(uint8_t* dacachestart, int32_t dacachesize)
 
 	for(i=1;i<200;i++) lockrecip[i] = (1<<28)/(200-i);
 
-	cachestart = dacachestart;
-	cachesize = dacachesize;
+	cachestart = (uint8_t *)(((intptr_t)dacachestart+15)&~15);
+	cachesize = (dacachesize-(cachestart-dacachestart))&~15;
 
 	cac[0].leng = cachesize;
 	cac[0].lock = &zerochar;
@@ -92,7 +92,8 @@ void allocache (uint8_t** newhandle, int32_t newbytes, uint8_t  *newlockptr)
 {
 	int32_t i, z, zz, bestz=0, daval, bestval, besto=0, o1, o2, sucklen, suckz;
 
-	newbytes = newbytes+15;
+	/* Whole 16 byte blocks, so everything in the cache is aligned */
+	newbytes = (newbytes+15)&~15;
 
 	if ((uint32_t)newbytes > (uint32_t)cachesize)
 	{
