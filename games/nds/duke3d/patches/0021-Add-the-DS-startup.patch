+//
+// Nintendo DS startup
+//
+// Finds the game data in NitroFS (embedded in the ROM) and on the SD card,
+// shows the progress on the touch screen console and runs the game in a
+// thread with its stack in main RAM. Config and savegames go to
+// /data/duke3d/<version>/ on the SD card: shareware, registered or atomic.
+//
+
+#include <nds.h>
+#include <fat.h>
+#include <filesystem.h>
+#include <stdarg.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/iosupport.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+#include "duke3d_nds.h"
+
+int DukeMain(int argc, char **argv);
+
+#define DATA_DIR "/data/duke3d"
+
+static PrintConsole console;
+static bool have_fat;
+
+// ---------------------------------------------------------------------------
+// Touch screen console
+// ---------------------------------------------------------------------------
+
+// The startup log is far too wide for the 32 column console, so while
+// loading every log line only prints a progress dot, in rows with the same
+// two columns of margin on both sides as the text
+#define LOADING_DOTS 28
+
+static const devoptab_t *console_out;
+static devoptab_t loading_out;
+// Once the touch screen shows the HUD nothing is printed at all
+static bool quiet;
+
+// The last lines printed, an error box shows them, they often explain it
+#define LOG_LINES   3
+#define LOG_COLS    30
+static char log_lines[LOG_LINES][LOG_COLS + 1];
+static int log_line, log_col;
+
+static void LogChar(char c)
+{
+    if (c == '\n')
+    {
+        if (log_col > 0)
+            log_line = (log_line + 1) % LOG_LINES;
+        log_col = 0;
+        log_lines[log_line][0] = '\0';
+    }
+    else if (log_col < LOG_COLS && c >= ' ')
+    {
+        log_lines[log_line][log_col++] = c;
+        log_lines[log_line][log_col] = '\0';
+    }
+}
+
+static ssize_t LoadingWrite(struct _reent *r, void *fd, const char *ptr, size_t len)
+{
+    static int dots;
+    size_t i;
+
+    for (i = 0; i < len; ++i)
+    {
+        LogChar(ptr[i]);
+        if (ptr[i] == '\n' && !quiet)
+        {
+            if (dots && dots % LOADING_DOTS == 0)
+                console_out->write_r(r, fd, "\n  ", 3);
+            console_out->write_r(r, fd, ".", 1);
+            ++dots;
+        }
+    }
+    return len;
+}
+
+static void SetLoadingOutput(bool loading)
+{
+    if (console_out == NULL)
+    {
+        console_out = devoptab_list[STD_OUT];
+        loading_out = *console_out;
+        loading_out.write_r = LoadingWrite;
+    }
+    devoptab_list[STD_OUT] = devoptab_list[STD_ERR] = loading ? &loading_out : console_out;
+}
+
+// The touch screen's bitmap replaces the console
+void NDS_QuietOutput(void)
+{
+    quiet = true;
+}
+
+static void ConsoleMode(void)
+{
+    // The HUD's copy to the same VRAM may still run
+    while (dmaBusy(NDS_HUD_DMA))
+        ;
+    // Banks H and I, the bitmap of the touch screen HUD replaces it later
+    videoSetModeSub(MODE_0_2D);
+    vramSetBankH(VRAM_H_SUB_BG);
+    vramSetBankI(VRAM_I_SUB_BG_0x06208000);
+    consoleInit(&console, 0, BgType_Text4bpp, BgSize_T_256x256, 22, 0, false, true);
+    consoleSelect(&console);
+    // Yellow is orange and bright yellow the yellow of the Duke Nukem logo
+    BG_PALETTE_SUB[3 * 16 + 15] = RGB15(31, 15, 0);
+    BG_PALETTE_SUB[11 * 16 + 15] = RGB15(31, 27, 4);
+}
+
+static void PrintHeader(void)
+{
+    consoleClear();
+    printf("\x1b[33;1m  Duke Nukem 3D\x1b[39;0m for %s\n", isDSiMode() ? "NDSi" : "NDS");
+    printf("\x1b[33m--------------------------------\x1b[39m");
+}
+
+// Waits for the next frame and reads the buttons, sleeps while the lid is
+// closed, exits on the DSi power button or L+R+START+SELECT
+static void NextFrame(void)
+{
+    if (!pmMainLoop())
+        exit(0);
+    threadWaitForVBlank();
+    scanKeys();
+}
+
+static void WaitForStart(void)
+{
+    do
+        NextFrame();
+    while (!(keysDown() & KEY_START));
+}
+
+// Shows a fatal error on the touch screen until START is pressed, with the
+// last lines printed before it
+void NDS_ErrorBox(const char *fmt, va_list args)
+{
+    int i;
+
+    SetLoadingOutput(false);
+    quiet = false;
+    ConsoleMode();
+    PrintHeader();
+    printf("\n\x1b[31;1m  Duke Nukem 3D had to stop\x1b[39;0m\n\n");
+    vprintf(fmt, args);
+    printf("\n\x1b[30;1m");
+    for (i = 1; i <= LOG_LINES; ++i)
+        if (log_lines[(log_line + i) % LOG_LINES][0])
+            printf("\n  %s", log_lines[(log_line + i) % LOG_LINES]);
+    printf("\n\n  Press START to exit\x1b[39;0m\n");
+    WaitForStart();
+}
+
+// ---------------------------------------------------------------------------
+// Entry point
+// ---------------------------------------------------------------------------
+
+static bool FileExists(const char *path)
+{
+    struct stat st;
+    return stat(path, &st) == 0 && S_ISREG(st.st_mode);
+}
+
+// The game data, from the SD card first so a retail duke3d.grp there wins
+// over the embedded shareware. With its device, the current directory
+// changes later.
+static const char *FindGroupFile(void)
+{
+    static char path[64];
+    char *colon;
+
+    if (have_fat && getcwd(path, sizeof(path)) != NULL && (colon = strchr(path, ':')) != NULL)
+    {
+        strcpy(colon + 1, DATA_DIR "/duke3d.grp");
+        if (FileExists(path))
+            return path;
+    }
+    return FileExists("nitro:/duke3d.grp") ? "nitro:/duke3d.grp" : NULL;
+}
+
+// The version of the game data, known by the size of the official GRPs: its
+// folder, each keeps its settings and savegames in a folder of its own, and
+// its title for the loading screen, which fits the 32 columns
+typedef struct
+{
+    off_t size;
+    const char *name, *title;
+} game_version_t;
+
+static const game_version_t *GameVersion(const char *grp)
+{
+    static const game_version_t versions[] =
+    {
+        { 11035779, "shareware", "Duke3D Shareware" },
+        { 26524524, "registered", "Duke Nukem 3D" },
+        { 44348015, "atomic", "Duke Nukem 3D Atomic" },
+        { 44356548, "atomic", "Duke Nukem 3D Atomic" },
+        { 0, "other", "Duke Nukem 3D" },
+    };
+    struct stat st;
+    unsigned i;
+
+    if (stat(grp, &st) == 0)
+        for (i = 0; i < sizeof(versions) / sizeof(versions[0]) - 1; ++i)
+            if (versions[i].size == st.st_size)
+                return &versions[i];
+    return &versions[sizeof(versions) / sizeof(versions[0]) - 1];
+}
+
+// ---------------------------------------------------------------------------
+// Title while loading
+// ---------------------------------------------------------------------------
+
+// The title screen at the end of the game's intro, the background with the
+// Duke Nukem and 3D logos, in the title palette
+#define TITLE_TILE      2493    // BETASCREEN
+#define LOGO_TILE       2497    // DUKENUKEM, at (160, 104)
+#define LOGO_3D_TILE    2498    // THREEDEE, at (160, 129)
+#define LOGO_ZOOM       60      // in 64ths, the size the intro ends with
+
+typedef struct
+{
+    int width, height;
+    uint8_t *pixels;    // in columns, like in the ART files
+} title_tile_t;
+
+static uint32_t ReadLE32(const uint8_t *p)
+{
+    return p[0] | (p[1] << 8) | (p[2] << 16) | ((uint32_t) p[3] << 24);
+}
+
+// Finds a file in the GRP, a directory of 12 character names and sizes
+// after a "KenSilverman" header, the files follow it in that order
+static bool FindInGroup(FILE *f, const char *name, uint32_t *offset, uint32_t *size)
+{
+    uint8_t entry[16];
+    char entry_name[13];
+    uint32_t count, i;
+
+    if (fseek(f, 0, SEEK_SET) != 0 || fread(entry, 1, 16, f) != 16 || memcmp(entry, "KenSilverman", 12) != 0)
+        return false;
+    count = ReadLE32(entry + 12);
+    *offset = 16 + count * 16;
+    for (i = 0; i < count && fread(entry, 1, 16, f) == 16; ++i)
+    {
+        memcpy(entry_name, entry, 12);
+        entry_name[12] = '\0';
+        *size = ReadLE32(entry + 12);
+        if (strcasecmp(entry_name, name) == 0)
+            return true;
+        *offset += *size;
+    }
+    return false;
+}
+
+// Reads a tile from the ART files in the GRP, each has a range of tiles with
+// their widths, heights and animation words, then their pixels in order
+static bool ReadTile(FILE *f, int tile, title_tile_t *t)
+{
+    static int16_t widths[256], heights[256];
+    uint8_t header[16];
+    uint32_t offset, size, at;
+    int art, start, count, i;
+    char name[16];
+
+    for (art = 0; art < 100; ++art)
+    {
+        snprintf(name, sizeof(name), "TILES%03d.ART", art);
+        if (!FindInGroup(f, name, &offset, &size))
+            return false;
+        if (fseek(f, offset, SEEK_SET) != 0 || fread(header, 1, 16, f) != 16)
+            return false;
+        start = ReadLE32(header + 8);
+        count = (int32_t) ReadLE32(header + 12) - start + 1;
+        if (tile < start || tile >= start + count)
+            continue;
+        if (count > 256 || fread(widths, 2, count, f) != (size_t) count || fread(heights, 2, count, f) != (size_t) count)
+            return false;
+        at = offset + 16 + count * 8;
+        for (i = start; i < tile; ++i)
+            at += widths[i - start] * heights[i - start];
+        t->width = widths[tile - start];
+        t->height = heights[tile - start];
+        t->pixels = malloc(t->width * t->height);
+        return t->pixels != NULL && t->width > 0 && t->height > 0 && fseek(f, at, SEEK_SET) == 0 &&
+               fread(t->pixels, 1, t->width * t->height, f) == (size_t) (t->width * t->height);
+    }
+    return false;
+}
+
+// The pixel of a logo centered at (cx, cy) at the 320x200 spot (x, y), 255
+// where it has none, which is also its transparent color
+static uint8_t LogoPixel(const title_tile_t *t, int cx, int cy, int x, int y)
+{
+    int tx = (x - cx) * 64 / LOGO_ZOOM + t->width / 2;
+    int ty = (y - cy) * 64 / LOGO_ZOOM + t->height / 2;
+
+    if (tx < 0 || tx >= t->width || ty < 0 || ty >= t->height)
+        return 255;
+    return t->pixels[tx * t->height + ty];
+}
+
+// Shows the title screen on the top screen while the game loads, scaled
+// from 320x200 like the game scales it. The palette comes after the shade
+// tables in lookup.dat, the third of its five.
+static void ShowTitle(const char *grp)
+{
+    title_tile_t title = { 0 }, logo = { 0 }, logo3d = { 0 };
+    uint8_t *frame = NULL, palette[768], count;
+    uint32_t offset, size;
+    FILE *f = fopen(grp, "rb");
+    int x, y;
+
+    if (f == NULL)
+        return;
+    if (FindInGroup(f, "LOOKUP.DAT", &offset, &size) && fseek(f, offset, SEEK_SET) == 0 && fread(&count, 1, 1, f) == 1 &&
+        fseek(f, offset + 1 + count * 257 + 2 * 768, SEEK_SET) == 0 && fread(palette, 1, 768, f) == 768 &&
+        ReadTile(f, TITLE_TILE, &title) && title.width == 320 && title.height == 200 &&
+        ReadTile(f, LOGO_TILE, &logo) && ReadTile(f, LOGO_3D_TILE, &logo3d) &&
+        (frame = malloc(NDS_SCREEN_W * NDS_SCREEN_H)) != NULL)
+    {
+        for (y = 0; y < NDS_SCREEN_H; ++y)
+            for (x = 0; x < NDS_SCREEN_W; ++x)
+            {
+                int sx = x * 320 / NDS_SCREEN_W, sy = y * 200 / NDS_SCREEN_H;
+                uint8_t c = LogoPixel(&logo, 160, 104, sx, sy);
+
+                if (c == 255)
+                    c = LogoPixel(&logo3d, 160, 129, sx, sy);
+                frame[y * NDS_SCREEN_W + x] = c != 255 ? c : title.pixels[sx * 200 + sy];
+            }
+        DC_FlushRange(frame, NDS_SCREEN_W * NDS_SCREEN_H);
+        NDS_ShowSplash(frame, palette);
+    }
+    free(frame);
+    free(title.pixels);
+    free(logo.pixels);
+    free(logo3d.pixels);
+    fclose(f);
+}
+
+// The game data the startup found
+static const char *group_file;
+
+void findGRPToUse(char *path)
+{
+    strcpy(path, group_file);
+}
+
+// The game runs in a thread of its own, with its stack in main RAM
+#define MAX_ARGS 16
+static char *duke_argv[MAX_ARGS + 1] = { "duke3d" };
+static int duke_argc = 1;
+
+// Extra command line options (eg. /v1 /l3 /s2) can be put in
+// /data/duke3d/args.txt
+static void ReadArgs(void)
+{
+    static char text[256];
+    FILE *f = fopen(DATA_DIR "/args.txt", "r");
+    size_t len;
+    char *arg;
+
+    if (f == NULL)
+        return;
+    len = fread(text, 1, sizeof(text) - 1, f);
+    fclose(f);
+    text[len] = '\0';
+    for (arg = strtok(text, " \t\r\n"); arg != NULL && duke_argc < MAX_ARGS; arg = strtok(NULL, " \t\r\n"))
+        duke_argv[duke_argc++] = arg;
+}
+static u64 duke_stack[64 * 1024 / sizeof(u64)];
+
+static int GameThread(void *arg)
+{
+    return DukeMain(duke_argc, duke_argv);
+}
+
+int main(int argc, char **argv)
+{
+    static Thread game_thread;
+    static char version_dir[64];
+    const char *grp;
+    const game_version_t *version;
+
+    // In DSi mode the ARM9 runs at twice the speed of the DS
+    if (isDSiMode())
+        setCpuClock(true);
+
+    NDS_InitVideo();
+    ConsoleMode();
+    PrintHeader();
+    keysSetRepeat(15, 4);
+
+    have_fat = fatInitDefault();
+    nitroFSInit(NULL);
+
+    grp = FindGroupFile();
+    if (grp == NULL)
+    {
+        printf("\n\n\x1b[31;1m  No game data found!\x1b[39;0m\n\n"
+               "  Copy duke3d.grp to\n"
+               "  /data/duke3d/ on the SD card\n"
+               "  or embed it in the ROM at\n"
+               "  build time (see README).\n\n"
+               "  Press START to exit\n");
+        WaitForStart();
+        return 1;
+    }
+
+    version = GameVersion(grp);
+
+    // Config and savegames go to the version's folder in the data folder on
+    // the SD card, paths without a device need a current device, the ROM
+    // without an SD card
+    if (have_fat)
+    {
+        mkdir("/data", 0777);
+        mkdir(DATA_DIR, 0777);
+        snprintf(version_dir, sizeof(version_dir), DATA_DIR "/%s", version->name);
+        mkdir(version_dir, 0777);
+    }
+    ReadArgs();
+    if (!have_fat || chdir(version_dir) != 0)
+    {
+        chdir("nitro:/");
+        printf("\n\x1b[33;1m  %s, saving is off\x1b[39;0m\n", have_fat ? "Can't write the SD card" : "No SD card");
+    }
+    printf("\n  Loading %s\n\n  ", version->title);
+    fflush(stdout);
+    ShowTitle(grp);
+    SetLoadingOutput(true);
+
+    group_file = grp;
+    threadPrepare(&game_thread, GameThread, NULL, (u8 *) duke_stack + sizeof(duke_stack), MAIN_THREAD_PRIO);
+    threadAttachLocalStorage(&game_thread, NULL);
+    threadStart(&game_thread);
+    return threadJoin(&game_thread);
+}
