 }
 
+// The Rumble Pak only moves while it is switched back and forth, which a tick
+// task does at 60 Hz for as long as the rumble lasts. Only a DS has a GBA
+// slot, on a DSi gbacartOpen fails.
+#define RUMBLE_HZ       60
+#define RUMBLE_MAX_MS   500
+
+int32_t nds_rumble = 1;
+
+static bool rumble_inserted;
+static volatile int rumble_ticks;
+static TickTask rumble_task;
+
+static void RumbleTick(TickTask *task)
+{
+    if (rumble_ticks > 0)
+        --rumble_ticks;
+    rumbleSet(rumble_ticks & 1);
+}
+
+void NDS_InitRumble(void)
+{
+    if (!gbacartOpen())
+        return;
+    rumble_inserted = rumbleIsInserted();
+    if (rumble_inserted)
+        tickTaskStart(&rumble_task, RumbleTick, ticksFromHz(RUMBLE_HZ), ticksFromHz(RUMBLE_HZ));
+    else
+        gbacartClose();
+}
+
+void NDS_Rumble(int ms)
+{
+    int ticks = min(ms, RUMBLE_MAX_MS) * RUMBLE_HZ / 1000;
+
+    if (rumble_inserted && nds_rumble && ticks > rumble_ticks)
+        rumble_ticks = ticks;
+}
+
 // Playing: in a level, no menu or typing
 static bool Playing(void)
 {
@@ -68,6 +107,19 @@ static bool Playing(void)
     return (gm & MODE_GAME) && !(gm & (MODE_MENU | MODE_TYPE));
 }
 
+// Taking damage rumbles, longer for more, whatever hurt you: the health of
+// your sprite is watched while playing. The demos playing behind the menu
+// don't rumble.
+static void WatchHealth(bool playing)
+{
+    static int shown = -1;
+    int health = playing && ud.recstat != 2 ? sprite[ps[myconnectindex].i].extra : -1;
+
+    if (health >= 0 && shown >= 0 && health < shown)
+        NDS_Rumble(80 + (shown - health) * 8);
+    shown = health;
+}
+
 void NDS_PollInput(void)
 {
     static uint32_t scanned;
@@ -118,5 +170,6 @@ void NDS_PollInput(void)
         tap_key = 0;
     }
     NDS_PollTouch(down);
+    WatchHealth(playing);
 }
 
