diff --git a/Makefile.nds b/Makefile.nds
new file mode 100644
index 0000000..060fb65
--- /dev/null
+++ b/Makefile.nds
@@ -0,0 +1,41 @@
+# Nintendo DS build of Chocolate Duke3D with the nds-ports toolchain
+#   make -f Makefile.nds TOOLCHAIN=<toolchain> ICON=<icon.bmp> [NITRO_DIR=<dir>]
+
+NAME := duke3d
+GAME_TITLE := Duke Nukem 3D
+GAME_SUBTITLE1 := 3D Realms (1996)
+GAME_SUBTITLE2 := Chocolate Duke3D NDS port
+HEADER_TITLE := DUKENUKEM3D
+
+SOURCES := $(addprefix Engine/src/,cache dummy_multi filesystem network tiles) \
+	$(addprefix Game/src/,actors animlib config console control cvar_defs cvars game gamedef global \
+	keyboard menues player premap rts scriplib sector sounds audiolib/pitch) \
+	$(addprefix nds/,duke3d_nds display_nds input_nds hud_nds fx_nds music_nds)
+
+# The drawers run from ITCM, the rest of the renderer as ARM code in main RAM
+ITCM_SOURCES := Engine/src/draw
+ARM_SOURCES := Engine/src/engine Engine/src/fixedPoint_math
+OFILES := $(addprefix build/,$(addsuffix .arm.o,$(ARM_SOURCES)))
+
+include $(TOOLCHAIN)/nds.mk
+
+# The old code mixes pointers and integers and redefines libnds' integer types and true and false,
+# the engine's headers go before the toolchain's, which has a filesystem.h of its own
+CFLAGS := -IEngine/src -IGame/src -Inds $(CFLAGS) -Wno-unused -Wno-pointer-sign -Wno-parentheses \
+	-Wno-pointer-to-int-cast -Wno-int-to-pointer-cast -Wno-int-conversion \
+	-Wno-incompatible-pointer-types -Wno-absolute-value -Wno-misleading-indentation \
+	-Wno-deprecated-declarations -Wno-typedef-redefinition -Wno-macro-redefined \
+	-fno-strict-aliasing -fno-short-enums -fcommon -std=gnu99 -DPLATFORM_UNIX
+
+# The game code that isn't run every frame is optimized for size, which leaves more RAM to the
+# tile cache
+COLD_SOURCES := animlib config console control cvar_defs cvars global keyboard menues premap rts scriplib
+$(addprefix $(BUILD)/Game/src/,$(addsuffix .o,$(COLD_SOURCES))): CFLAGS += -Os
+# The startup wants libdvm's filesystem.h, not the engine's
+$(BUILD)/nds/duke3d_nds.o: CFLAGS := -I$(TOOLCHAIN_TARGET)/libdvm/include $(CFLAGS)
+
+$(BUILD)/%.arm.o: CFLAGS += -marm
+
+$(BUILD)/%.arm.o: %.c
+	@mkdir -p $(dir $@)
+	$(CC) $(CFLAGS) -MMD -MP -c $< -o $@
