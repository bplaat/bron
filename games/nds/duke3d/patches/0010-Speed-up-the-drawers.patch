    #include <inttypes.h>
 #endif
 
+/*
+ * The bits of (float)i, which Ken's reciprocals read the exponent and the top
+ * of the mantissa from, worked out in integers: the ARM has no floating point
+ * unit but counts leading zeros. Rounded to nearest even like the conversion.
+ */
+static inline int32_t floatbits(int32_t i)
+{
+    uint32_t a = i < 0 ? -(uint32_t)i : (uint32_t)i, m;
+    int32_t e;
+
+    if (a == 0)
+        return 0;
+    e = 31 - __builtin_clz(a);
+    if (e <= 23)
+        m = a << (23 - e);
+    else
+    {
+        uint32_t shift = e - 23, rest = a & ((1u << shift) - 1), half = 1u << (shift - 1);
+
+        m = a >> shift;
+        if (rest > half || (rest == half && (m & 1)))
+            m++;
+        if (m == 1u << 24)
+            m >>= 1, e++;
+    }
+    return (int32_t)((i < 0 ? 0x80000000u : 0) | ((uint32_t)(127 + e) << 23) | (m & 0x7fffff));
+}
