From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Bastiaan van der Plaat <bastiaan.v.d.plaat@gmail.com>
Date: Wed, 7 Oct 2026 12:00:00 +0200
Subject: [PATCH] Use the DS hardware divider

The ARM9 has no divide instruction, and scale() and divscale() divide 64
by 32 bits, which compiler-rt does slowly in software. On the DS they use
libnds' div64() with the hardware divider, which only the game thread
uses. Its headers define bool, so the script parameters named bool are
renamed.
---
 Engine/src/fixedPoint_math.h | 15 +++++++++++++--
 Game/src/scriplib.c          |  4 ++--
 Game/src/scriplib.h          |  4 ++--
 3 files changed, 17 insertions(+), 6 deletions(-)

diff --git a/Engine/src/fixedPoint_math.h b/Engine/src/fixedPoint_math.h
index d1442cf..6d2f5d7 100644
--- a/Engine/src/fixedPoint_math.h
+++ b/Engine/src/fixedPoint_math.h
@@ -57,9 +57,20 @@ static inline int64_t mul32_64(int32_t i1,int32_t i2)
 {
 	return (int64_t)i1*i2;
 }
+/* The ARM9 has no divide instruction, libnds divides 64 by 32 bits with the
+   DS hardware divider. Only the game thread uses it. */
+#ifdef __NDS__
+#include <nds/arm9/math.h>
+#else
+static inline int32_t div64(int64_t num, int32_t den)
+{
+	return (int32_t)(num/den);
+}
+#endif
+
 static inline int scale (int32_t input1, int32_t input2, int32_t input3)
 {
-	return (int)(mul32_64(input1,input2)/(int64_t)input3);
+	return div64(mul32_64(input1,input2),input3);
 }
 static inline int mulscale (int32_t input1, int32_t input2, int32_t input3)
 {
@@ -75,7 +86,7 @@ static inline int tmulscale(int32_t i1, int32_t i2, int32_t i3, int32_t i4, int3
 }
 static inline int32_t divscale(int32_t i1, int32_t i2, int32_t i3)
 {
-	return (int32_t)(((int64_t)i1<<i3)/i2);
+	return div64((int64_t)i1<<i3,i2);
 }
 
 #define DEFFUNCS \
diff --git a/Game/src/scriplib.c b/Game/src/scriplib.c
index f77b9df..4164c22 100644
--- a/Game/src/scriplib.c
+++ b/Game/src/scriplib.c
@@ -724,7 +724,7 @@ void SCRIPT_GetBoolean
    int32 scripthandle,
    uint8_t  * sectionname,
    uint8_t  * entryname,
-   boolean * bool
+   boolean * value
    )
 {
 	STUBBED("GetBoolean");
@@ -1035,7 +1035,7 @@ void SCRIPT_PutBoolean
    int32 scripthandle,
    uint8_t  * sectionname,
    uint8_t  * entryname,
-   boolean bool
+   boolean value
    )
 {
 	STUBBED("PutBoolean");
diff --git a/Game/src/scriplib.h b/Game/src/scriplib.h
index e6b647f..d6dcb77 100644
--- a/Game/src/scriplib.h
+++ b/Game/src/scriplib.h
@@ -190,7 +190,7 @@ void SCRIPT_GetBoolean
    int32 scripthandle,
    uint8_t  * sectionname,
    uint8_t  * entryname,
-   boolean * bool
+   boolean * value
    );
 
