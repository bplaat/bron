From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Bastiaan van der Plaat <bastiaan.v.d.plaat@gmail.com>
Date: Wed, 7 Oct 2026 12:00:00 +0200
Subject: [PATCH] Build files on every platform but Windows

filelength() is built everywhere but on Windows, not only on macOS and
Linux, and files in the game directory are opened with a forward slash,
which works on every platform.
---
 Engine/src/filesystem.c | 4 ++--
 Engine/src/filesystem.h | 2 +-
 2 files changed, 3 insertions(+), 3 deletions(-)

diff --git a/Engine/src/filesystem.c b/Engine/src/filesystem.c
index 4365d99..f7166ee 100644
--- a/Engine/src/filesystem.c
+++ b/Engine/src/filesystem.c
@@ -405,7 +405,7 @@ int32_t klseek(int32_t handle, int32_t offset, int whence){
 	
 }
 
-#if defined(__APPLE__) || defined(__linux__)
+#ifndef _WIN32
 int32_t filelength(int32_t fd){
     struct stat stats;
     fstat(fd, &stats);
@@ -705,7 +705,7 @@ int32_t TCkopen4load(const char  *filename, int readfromGRP)
     
 	if(game_dir[0] != '\0' && !readfromGRP)
 	{
-		sprintf(fullfilename, "%s\\%s", game_dir, filename);
+		sprintf(fullfilename, "%s/%s", game_dir, filename);
 		if (!SafeFileExists(fullfilename)) // try root
 			sprintf(fullfilename, "%s", filename);
 	}
diff --git a/Engine/src/filesystem.h b/Engine/src/filesystem.h
index 59e0e9e..55f1a5e 100644
--- a/Engine/src/filesystem.h
+++ b/Engine/src/filesystem.h
@@ -42,7 +42,7 @@ void     setGameDir(char* gameDir);
 
 int32_t  TCkopen4load(const char  *filename, int32_t readfromGRP);
 
-#if defined(__APPLE__) || defined(__linux__)
+#ifndef _WIN32
 int32_t  filelength(int32_t fd);
 #endif
 
