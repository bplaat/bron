From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Bastiaan van der Plaat <bastiaan.v.d.plaat@gmail.com>
Date: Mon, 2 Nov 2026 18:00:00 +0100
Subject: [PATCH] Implement getentropy with NSSGetRandom

Provide picolibc getentropy in wutpicolibc through nlibnss. Initialize
NSS when needed, keep the service available to other callers and
report failures with POSIX errno values.
---
 libraries/wutpicolibc/wut_entropy.c | 44 ++++++++++++++++++++++++++++++++++++++++
 1 file changed, 44 insertions(+)
 create mode 100644 libraries/wutpicolibc/wut_entropy.c

diff --git a/libraries/wutpicolibc/wut_entropy.c b/libraries/wutpicolibc/wut_entropy.c
new file mode 100644
index 0000000..9d0c72b
--- /dev/null
+++ b/libraries/wutpicolibc/wut_entropy.c
@@ -0,0 +1,44 @@
+/*
+ * Copyright (c) 2026 Bastiaan van der Plaat
+ *
+ * SPDX-License-Identifier: MIT
+ */
+
+#include <errno.h>
+#include <stdint.h>
+#include <string.h>
+#include <sys/lock.h>
+#include <unistd.h>
+
+// nlibnss.rpl exports these functions; WUT supplies the import stubs.
+int32_t NSSInit(void);
+int32_t NSSLibReady(void);
+int32_t NSSGetRandom(void* buffer, int32_t size);
+
+int getentropy(void* buffer, size_t length) {
+    if (length > 256) {
+        errno = EIO;
+        return -1;
+    }
+    if (length == 0)
+        return 0;
+    if (buffer == NULL) {
+        errno = EFAULT;
+        return -1;
+    }
+
+    // Serialize initialization and leave NSS initialized for other users. A
+    // caller may have finished it since our last call, so check every time.
+    __LIBC_LOCK();
+    int32_t result = NSSLibReady() < 0 ? NSSInit() : 0;
+    _Alignas(64) uint8_t bytes[256];
+    if (result == 0)
+        result = NSSGetRandom(bytes, (int32_t)length);
+    __LIBC_UNLOCK();
+    if (result != 0) {
+        errno = EIO;
+        return -1;
+    }
+    memcpy(buffer, bytes, length);
+    return 0;
+}
