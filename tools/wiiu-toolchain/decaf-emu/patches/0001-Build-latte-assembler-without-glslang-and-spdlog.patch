-            return -1;
-         }
-
-         auto vertexShaderPath = options.get<std::string>("vsh");
-         auto pixelShaderPath = options.get<std::string>("psh");
-         auto shaderAnalyzerPath = options.get<std::string>("amd-shader-analyzer");
