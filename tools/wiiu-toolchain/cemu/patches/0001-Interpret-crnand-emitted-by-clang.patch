From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Bastiaan van der Plaat <bastiaan.v.d.plaat@gmail.com>
Date: Mon, 2 Nov 2026 12:00:00 +0100
Subject: [PATCH] Interpret crnand emitted by clang

Implement the condition register NAND instruction used by clang in
picolibc floating-point formatting.
---
 src/Cafe/HW/Espresso/Interpreter/PPCInterpreterImpl.cpp | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/src/Cafe/HW/Espresso/Interpreter/PPCInterpreterImpl.cpp b/src/Cafe/HW/Espresso/Interpreter/PPCInterpreterImpl.cpp
index cacfa4a..1a42c46 100644
--- a/src/Cafe/HW/Espresso/Interpreter/PPCInterpreterImpl.cpp
+++ b/src/Cafe/HW/Espresso/Interpreter/PPCInterpreterImpl.cpp
@@ -658,6 +658,11 @@ public:
 			case 193:
 				PPCInterpreter_CRXOR(hCPU, opcode);
 				break;
+			case 225: // crnand
+				hCPU->cr[(opcode >> 21) & 31] =
+					!(hCPU->cr[(opcode >> 16) & 31] & hCPU->cr[(opcode >> 11) & 31]);
+				PPCInterpreter_nextInstruction(hCPU);
+				break;
 			case 257:
 				PPCInterpreter_CRAND(hCPU, opcode);
 				break;
