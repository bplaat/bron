+#[path = "unsupported.rs"]
+#[allow(dead_code)]
+mod unsupported_stdio;
+
+pub use unsupported_stdio::{STDIN_BUF_SIZE, Stdin};
+
+use crate::ffi::c_void;
+use crate::io;
+
+unsafe extern "C" {
+    static stdout: *mut c_void;
+    static stderr: *mut c_void;
+    fn fflush(stream: *mut c_void) -> i32;
+    fn write(fd: i32, buffer: *const u8, length: usize) -> isize;
+}
+
+pub struct Stdout;
+pub struct Stderr;
+
+impl Stdout {
+    pub const fn new() -> Self {
+        Self
+    }
+}
+
+impl Stderr {
+    pub const fn new() -> Self {
+        Self
+    }
+}
+
+fn write_fd(fd: i32, buf: &[u8]) -> io::Result<usize> {
+    let count = unsafe { write(fd, buf.as_ptr(), buf.len()) };
+    if count < 0 {
+        Err(io::Error::last_os_error())
+    } else {
+        Ok(count as usize)
+    }
+}
+
+impl io::Write for Stdout {
+    fn write(&mut self, buf: &[u8]) -> io::Result<usize> {
+        write_fd(1, buf)
+    }
+
+    fn flush(&mut self) -> io::Result<()> {
+        flush_fd(1)
+    }
+}
+
+impl io::Write for Stderr {
+    fn write(&mut self, buf: &[u8]) -> io::Result<usize> {
+        write_fd(2, buf)
+    }
+
+    fn flush(&mut self) -> io::Result<()> {
+        flush_fd(2)
+    }
+}
+
+pub fn is_ebadf(error: &io::Error) -> bool {
+    error.raw_os_error() == Some(9)
+}
+
+pub fn panic_output() -> Option<impl io::Write> {
+    Some(Stderr::new())
+}
+
+fn flush_fd(fd: i32) -> io::Result<()> {
+    if unsafe { fflush(if fd == 2 { stderr } else { stdout }) } == 0 {
+        Ok(())
+    } else {
+        Err(io::Error::last_os_error())
+    }
+}
