diff --git a/library/std/src/sys/sync/futex/wiiu.rs b/library/std/src/sys/sync/futex/wiiu.rs
new file mode 100644
index 0000000..3958c1d
--- /dev/null
+++ b/library/std/src/sys/sync/futex/wiiu.rs
@@ -0,0 +1,130 @@
+use crate::cell::UnsafeCell;
+use crate::ptr;
+use crate::sync::atomic::{AtomicU32, Ordering};
+use crate::time::Duration;
+
+pub type Futex = AtomicU32;
+pub type SmallFutex = AtomicU32;
+pub type Primitive = u32;
+pub type SmallPrimitive = u32;
+
+struct Waiter {
+    next: *mut Waiter,
+    address: *const Futex,
+    notified: bool,
+    event: Event,
+}
+
+struct Queue {
+    lock: UnsafeCell<NativeMutex>,
+    head: UnsafeCell<*mut Waiter>,
+}
+
+// The native mutex protects the list and the linked stack waiters.
+unsafe impl Sync for Queue {}
+
+static QUEUE: Queue = Queue {
+    lock: UnsafeCell::new(Mutex([0; 11])),
+    head: UnsafeCell::new(ptr::null_mut()),
+};
+
+// Layouts from wut's coreinit/mutex.h and coreinit/event.h.
+#[repr(C)]
+struct Mutex([u32; 11]);
+#[repr(C)]
+struct Event([u32; 9]);
+type NativeMutex = Mutex;
+
+unsafe extern "C" {
+    fn OSInitMutex(mutex: *mut Mutex);
+    fn OSLockMutex(mutex: *mut Mutex);
+    fn OSUnlockMutex(mutex: *mut Mutex);
+    fn OSInitEvent(event: *mut Event, value: i32, mode: i32);
+    fn OSWaitEvent(event: *mut Event);
+    fn OSWaitEventWithTimeout(event: *mut Event, timeout: i64) -> i32;
+    fn OSSignalEvent(event: *mut Event);
+}
+
+pub(crate) unsafe fn init() {
+    unsafe { OSInitMutex(QUEUE.lock.get()) };
+}
+
+struct Locked;
+impl Locked {
+    fn new() -> Self {
+        unsafe { OSLockMutex(QUEUE.lock.get()) };
+        Self
+    }
+}
+
+impl Drop for Locked {
+    fn drop(&mut self) {
+        unsafe { OSUnlockMutex(QUEUE.lock.get()) };
+    }
+}
+
+pub fn futex_wait(futex: &Futex, expected: Primitive, timeout: Option<Duration>) -> bool {
+    let lock = Locked::new();
+    if futex.load(Ordering::Relaxed) != expected {
+        return true;
+    }
+
+    let mut waiter = Waiter {
+        next: unsafe { *QUEUE.head.get() },
+        address: futex,
+        notified: false,
+        event: Event([0; 9]),
+    };
+    let waiter = &raw mut waiter;
+    unsafe { OSInitEvent(&raw mut (*waiter).event, 0, 1) }; // OS_EVENT_MODE_AUTO
+    unsafe { *QUEUE.head.get() = waiter };
+    drop(lock);
+    let event = unsafe { &raw mut (*waiter).event };
+    match timeout {
+        None => unsafe { OSWaitEvent(event) },
+        Some(timeout) if !timeout.is_zero() => {
+            unsafe {
+                OSWaitEventWithTimeout(event, timeout.as_nanos().min(i64::MAX as u128) as i64)
+            };
+        }
+        Some(_) => {}
+    }
+    let _lock = Locked::new();
+    // Remove the stack waiter before releasing the lock or returning.
+    unsafe {
+        let mut link = QUEUE.head.get();
+        while *link != waiter {
+            link = &raw mut (**link).next;
+        }
+        *link = (*waiter).next;
+        (*waiter).notified
+    }
+}
+
+fn wake(futex: &Futex, all: bool) -> bool {
+    let _lock = Locked::new();
+    let mut found = false;
+    let mut waiter = unsafe { *QUEUE.head.get() };
+    while !waiter.is_null() {
+        unsafe {
+            if ptr::eq((*waiter).address, futex) && !(*waiter).notified {
+                (*waiter).notified = true;
+                found = true;
+                OSSignalEvent(&raw mut (*waiter).event);
+                if !all {
+                    break;
+                }
+            }
+            waiter = (*waiter).next;
+        }
+    }
+    found
+}
+
+pub fn futex_wake(futex: &Futex) -> bool {
+    wake(futex, false)
+}
+
+pub fn futex_wake_all(futex: &Futex) {
+    wake(futex, true);
+}
