diff --git a/library/std/src/sys/thread/wiiu.rs b/library/std/src/sys/thread/wiiu.rs
new file mode 100644
index 0000000..c2159cf
--- /dev/null
+++ b/library/std/src/sys/thread/wiiu.rs
@@ -0,0 +1,148 @@
+use crate::ffi::{CStr, c_void};
+use crate::num::NonZero;
+use crate::sync::Arc;
+use crate::sync::atomic::{AtomicU32, Ordering};
+use crate::sys::ffi::{Timespec, nanosleep};
+use crate::sys::sync::futex::{futex_wait, futex_wake};
+use crate::thread::ThreadInit;
+use crate::time::{Duration, Instant};
+use crate::{io, ptr};
+
+// OSThread's layout is defined by wut's coreinit/thread.h.
+#[repr(C, align(16))]
+struct OSThread([u8; 0x6a0]);
+
+type Entry = extern "C" fn(i32, *const *const u8) -> i32;
+
+unsafe extern "C" {
+    fn memalign(alignment: usize, size: usize) -> *mut c_void;
+    fn free(ptr: *mut c_void);
+    fn OSCreateThread(
+        thread: *mut OSThread,
+        entry: Entry,
+        argc: i32,
+        data: *mut c_void,
+        stack_end: *mut c_void,
+        size: u32,
+        priority: i32,
+        attributes: u8,
+    ) -> i32;
+    fn OSSetThreadDeallocator(
+        thread: *mut OSThread,
+        callback: extern "C" fn(*mut OSThread, *mut c_void),
+    );
+    fn OSResumeThread(thread: *mut OSThread) -> i32;
+    fn OSGetCurrentThread() -> *mut OSThread;
+    fn OSYieldThread();
+}
+
+extern "C" fn free_thread(thread: *mut OSThread, stack: *mut c_void) {
+    unsafe {
+        free(stack);
+        free(thread.cast());
+    }
+}
+
+fn spawn(arg: *mut c_void, size: u32) -> i32 {
+    unsafe {
+        let thread = memalign(16, size_of::<OSThread>()).cast::<OSThread>();
+        let stack = memalign(16, size as usize).cast::<u8>();
+        if thread.is_null() || stack.is_null() {
+            free_thread(thread, stack.cast());
+            return 12; // ENOMEM
+        }
+        const AFFINITY_ANY: u8 = 7;
+        const DETACHED: u8 = 8;
+        if OSCreateThread(
+            thread,
+            entry,
+            0,
+            arg,
+            stack.add(size as usize).cast(),
+            size,
+            16,
+            AFFINITY_ANY | DETACHED,
+        ) == 0
+        {
+            free_thread(thread, stack.cast());
+            return 11; // EAGAIN
+        }
+        OSSetThreadDeallocator(thread, free_thread);
+        OSResumeThread(thread);
+        0
+    }
+}
+
+pub const DEFAULT_MIN_STACK_SIZE: usize = 64 * 1024;
+
+pub struct Thread(Arc<AtomicU32>);
+
+impl Thread {
+    pub unsafe fn new(stack: usize, init: Box<ThreadInit>) -> io::Result<Self> {
+        let stack = u32::try_from(stack.max(DEFAULT_MIN_STACK_SIZE))
+            .ok()
+            .and_then(|n| n.checked_add(31).map(|n| n & !31))
+            .ok_or(io::Error::from(io::ErrorKind::InvalidInput))?;
+        let done = Arc::new(AtomicU32::new(0));
+        let data = Box::into_raw(Box::new((init, done.clone())));
+        // Cafe OS frees the detached native thread after it stops using its stack.
+        let result = spawn(data.cast(), stack);
+        if result != 0 {
+            unsafe { drop(Box::from_raw(data)) };
+            return Err(io::Error::from_raw_os_error(result));
+        }
+        Ok(Self(done))
+    }
+
+    pub fn join(self) {
+        while self.0.load(Ordering::Acquire) == 0 {
+            futex_wait(&self.0, 0, None);
+        }
+    }
+}
+
+extern "C" fn entry(_argc: i32, data: *const *const u8) -> i32 {
+    let (init, done) =
+        *unsafe { Box::<(Box<ThreadInit>, Arc<AtomicU32>)>::from_raw(data.cast_mut().cast()) };
+    (init.init())();
+    crate::sys::thread_local::key::run_dtors();
+    done.store(1, Ordering::Release);
+    futex_wake(&done);
+    0
+}
+
+pub fn available_parallelism() -> io::Result<NonZero<usize>> {
+    Ok(NonZero::new(3).unwrap())
+}
+
+pub fn current_os_id() -> Option<u64> {
+    Some(unsafe { OSGetCurrentThread().addr() } as u64)
+}
+
+pub fn set_name(_name: &CStr) {}
+
+pub fn yield_now() {
+    unsafe { OSYieldThread() }
+}
+
+pub fn sleep(duration: Duration) {
+    if duration.is_zero() {
+        return;
+    }
+    let start = Instant::now();
+    let mut remaining = duration;
+    loop {
+        let nanos = i64::try_from(remaining.as_nanos())
+            .unwrap_or(i64::MAX)
+            .max(1000);
+        let time = Timespec {
+            sec: nanos / 1_000_000_000,
+            nsec: (nanos % 1_000_000_000) as i32,
+        };
+        unsafe { nanosleep(&time, crate::ptr::null_mut()) };
+        remaining = duration.saturating_sub(start.elapsed());
+        if remaining.is_zero() {
+            break;
+        }
+    }
+}
