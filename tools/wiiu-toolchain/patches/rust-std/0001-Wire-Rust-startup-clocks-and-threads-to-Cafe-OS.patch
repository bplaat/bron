diff --git a/library/std/src/sys/io/error/wiiu.rs b/library/std/src/sys/io/error/wiiu.rs
new file mode 100644
index 0000000..979c043
--- /dev/null
+++ b/library/std/src/sys/io/error/wiiu.rs
@@ -0,0 +1,62 @@
+use crate::ffi::{CStr, c_char};
+use crate::fmt;
+use crate::io::ErrorKind;
+
+unsafe extern "C" {
+    fn __xpg_strerror_r(error: i32, buffer: *mut c_char, length: usize) -> i32;
+}
+
+pub fn errno() -> i32 {
+    unsafe { *crate::sys::ffi::__errno() }
+}
+
+pub fn is_interrupted(code: i32) -> bool {
+    code == 4
+}
+
+pub fn format_error(code: i32, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+    let mut buffer = [0; 128];
+    if unsafe { __xpg_strerror_r(code, buffer.as_mut_ptr(), buffer.len()) } == 0 {
+        return f.write_str(&unsafe { CStr::from_ptr(buffer.as_ptr()) }.to_string_lossy());
+    }
+    write!(f, "Wii U error {code}")
+}
+
+// Error numbers from picolibc's <sys/errno.h>.
+pub fn decode_error_kind(code: i32) -> ErrorKind {
+    use ErrorKind::*;
+    match code {
+        1 | 13 => PermissionDenied,
+        2 => NotFound,
+        4 => Interrupted,
+        11 => WouldBlock,
+        12 => OutOfMemory,
+        17 => AlreadyExists,
+        20 => NotADirectory,
+        21 => IsADirectory,
+        22 => InvalidInput,
+        27 => FileTooLarge,
+        28 => StorageFull,
+        30 => ReadOnlyFilesystem,
+        29 => NotSeekable,
+        32 => BrokenPipe,
+        88 | 134 | 95 => Unsupported,
+        90 => DirectoryNotEmpty,
+        112 => AddrInUse,
+        125 => AddrNotAvailable,
+        113 => ConnectionAborted,
+        111 => ConnectionRefused,
+        104 => ConnectionReset,
+        128 => NotConnected,
+        116 => TimedOut,
+        115 => NetworkDown,
+        114 => NetworkUnreachable,
+        118 => HostUnreachable,
+        16 => ResourceBusy,
+        18 => CrossesDevices,
+        45 => Deadlock,
+        91 => InvalidFilename,
+        92 => FilesystemLoop,
+        _ => Uncategorized,
+    }
+}
