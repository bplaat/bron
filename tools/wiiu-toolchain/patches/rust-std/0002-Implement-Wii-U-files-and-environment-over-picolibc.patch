+pub use super::common::Env;
+use crate::ffi::{CStr, OsStr, OsString, c_char};
+use crate::io;
+use crate::sync::{PoisonError, RwLock};
+use crate::sys::helpers::run_with_cstr;
+
+static ENV: RwLock<()> = RwLock::new(());
+
+unsafe extern "C" {
+    static environ: *const *const c_char;
+    #[link_name = "getenv"]
+    fn getenv_c(name: *const c_char) -> *const c_char;
+    #[link_name = "setenv"]
+    fn setenv_c(name: *const c_char, value: *const c_char, overwrite: i32) -> i32;
+    #[link_name = "unsetenv"]
+    fn unsetenv_c(name: *const c_char) -> i32;
+}
+
+fn os_string(bytes: &[u8]) -> OsString {
+    // Wii U uses a byte-based OsString.
+    unsafe { OsString::from_encoded_bytes_unchecked(bytes.to_vec()) }
+}
+
+pub fn env() -> Env {
+    let _lock = ENV.read().unwrap_or_else(PoisonError::into_inner);
+    let mut pairs = Vec::new();
+    unsafe {
+        let mut vars = environ;
+        while !vars.is_null() && !(*vars).is_null() {
+            let bytes = CStr::from_ptr(*vars).to_bytes();
+            if let Some(i) = bytes.iter().position(|b| *b == b'=')
+                && i != 0
+            {
+                pairs.push((os_string(&bytes[..i]), os_string(&bytes[i + 1..])));
+            }
+            vars = vars.add(1);
+        }
+    }
+    Env::new(pairs)
+}
+
+pub fn getenv(name: &OsStr) -> Option<OsString> {
+    run_with_cstr(name.as_encoded_bytes(), &|name| {
+        let _lock = ENV.read().unwrap_or_else(PoisonError::into_inner);
+        let ptr = unsafe { getenv_c(name.as_ptr()) };
+        Ok((!ptr.is_null()).then(|| os_string(unsafe { CStr::from_ptr(ptr) }.to_bytes())))
+    })
+    .ok()
+    .flatten()
+}
+
+pub unsafe fn setenv(name: &OsStr, value: &OsStr) -> io::Result<()> {
+    run_with_cstr(name.as_encoded_bytes(), &|name| {
+        run_with_cstr(value.as_encoded_bytes(), &|value| {
+            let _lock = ENV.write().unwrap_or_else(PoisonError::into_inner);
+            status(unsafe { setenv_c(name.as_ptr(), value.as_ptr(), 1) })
+        })
+    })
+}
+
+pub unsafe fn unsetenv(name: &OsStr) -> io::Result<()> {
+    run_with_cstr(name.as_encoded_bytes(), &|name| {
+        let _lock = ENV.write().unwrap_or_else(PoisonError::into_inner);
+        status(unsafe { unsetenv_c(name.as_ptr()) })
+    })
+}
+
+fn status(result: i32) -> io::Result<()> {
+    if result == 0 {
+        Ok(())
+    } else {
+        Err(io::Error::last_os_error())
+    }
+}
