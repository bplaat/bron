new file mode 100644
index 0000000..567bd98
--- /dev/null
+++ b/library/std/src/sys/paths/wiiu.rs
@@ -0,0 +1,120 @@
+use crate::ffi::{CStr, OsStr, OsString, c_char};
+use crate::path::{Path, PathBuf};
+use crate::sys::helpers::run_path_with_cstr;
+use crate::sys::{unsupported};
+use crate::{fmt, io};
+
+unsafe extern "C" {
+    #[link_name = "getcwd"]
+    fn getcwd_c(output: *mut c_char, size: usize) -> *mut c_char;
+    #[link_name = "chdir"]
+    fn chdir_c(path: *const c_char) -> i32;
+}
+
+pub fn getcwd() -> io::Result<PathBuf> {
+    let mut buf = [0; 1025];
+    {
+        if unsafe { getcwd_c(buf[1..].as_mut_ptr(), buf.len() - 1) }.is_null() {
+            return Err(io::Error::last_os_error());
+        }
+    }
+    if buf[1] == 0 {
+        return unsupported();
+    }
+    buf[0] = b'/' as _;
+    let bytes = unsafe { CStr::from_ptr(buf.as_ptr()) }.to_bytes();
+    Ok(PathBuf::from(unsafe {
+        OsString::from_encoded_bytes_unchecked(bytes.to_vec())
+    }))
+}
+
+pub fn chdir(path: &Path) -> io::Result<()> {
+    run_path_with_cstr(path, &|path| {
+        if unsafe { chdir_c(path.as_ptr()) } == 0 {
+            Ok(())
+        } else {
+            Err(io::Error::last_os_error())
+        }
+    })
+}
+
+pub fn current_exe() -> io::Result<PathBuf> {
+    if let Some(path) = crate::sys::args::EXECUTABLE.get() {
+        path.canonicalize()
+    } else {
+        unsupported()
+    }
+}
+
+pub fn temp_dir() -> PathBuf {
+    PathBuf::from("/sd:/")
+}
+
+pub fn home_dir() -> Option<PathBuf> {
+    let path = temp_dir();
+    path.is_dir().then_some(path)
+}
+
+pub struct SplitPathsRef<'a>(crate::slice::Split<'a, u8, fn(&u8) -> bool>);
+pub struct SplitPaths<'a>(SplitPathsRef<'a>);
+
+impl<'a> Iterator for SplitPathsRef<'a> {
+    type Item = &'a Path;
+
+    fn next(&mut self) -> Option<Self::Item> {
+        self.0
+            .next()
+            .map(|p| Path::new(unsafe { OsStr::from_encoded_bytes_unchecked(p) }))
+    }
+}
+
+impl Iterator for SplitPaths<'_> {
+    type Item = PathBuf;
+
+    fn next(&mut self) -> Option<Self::Item> {
+        self.0.next().map(Path::to_path_buf)
+    }
+}
+
+fn split(paths: &OsStr) -> SplitPathsRef<'_> {
+    // Device paths use a colon, for example sd:/apps.
+    SplitPathsRef(paths.as_encoded_bytes().split(|b| *b == b';'))
+}
+
+pub fn split_paths(paths: &OsStr) -> SplitPaths<'_> {
+    SplitPaths(split(paths))
+}
+
+pub fn split_paths_ref(paths: &OsStr) -> Option<SplitPathsRef<'_>> {
+    Some(split(paths))
+}
+
+#[derive(Debug)]
+pub struct JoinPathsError;
+
+impl fmt::Display for JoinPathsError {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.write_str("path contains ';'")
+    }
+}
+
+impl crate::error::Error for JoinPathsError {}
+
+pub fn join_paths<I, T>(paths: I) -> Result<OsString, JoinPathsError>
+where
+    I: Iterator<Item = T>,
+    T: AsRef<OsStr>,
+{
+    let mut bytes = Vec::new();
+    for (i, path) in paths.enumerate() {
+        let path = path.as_ref().as_encoded_bytes();
+        if path.contains(&b';') {
+            return Err(JoinPathsError);
+        }
+        if i > 0 {
+            bytes.push(b';');
+        }
+        bytes.extend_from_slice(path);
+    }
+    Ok(unsafe { OsString::from_encoded_bytes_unchecked(bytes) })
+}
