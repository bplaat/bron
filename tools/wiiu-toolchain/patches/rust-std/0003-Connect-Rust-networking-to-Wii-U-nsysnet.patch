+
+fn socket_error(raw: i32) -> i32 {
+    // nsysnet has its own error numbers. Map them to picolibc errno values.
+    const ERRNO: &[i32] = &[
+        5, 105, 116, 127, 95, 113, 11, 111, 104, 128, 120, 22, 122, 32, 121, 110, 109, 16, 12, 125,
+        112, 106, 119, 5, 108, 22, 22, 5, 129, 14, 114, 123, 107,
+    ];
+    ERRNO.get(raw as usize).copied().unwrap_or(5)
+}
+
+fn wait(fd: i32, writing: bool, timeout_ms: i32) -> io::Result<i32> {
+    const FD_SETSIZE: i32 = 32;
+    if !(0..FD_SETSIZE).contains(&fd) {
+        return Err(io::Error::from_raw_os_error(9)); // EBADF
+    }
+    let mut set = 1_u32 << fd;
+    let mut errors = set;
+    let mut time = SelectTimeout {
+        sec: timeout_ms / 1000,
+        usec: timeout_ms % 1000 * 1000,
+    };
+    let (read, write) = if writing {
+        (ptr::null_mut(), &raw mut set)
+    } else {
+        (&raw mut set, ptr::null_mut())
+    };
+    cvt(unsafe { select(fd + 1, read, write, &mut errors, &mut time) })
+}
+
+pub fn cvt(result: i32) -> io::Result<i32> {
+    if result < 0 {
+        let errno = if result == -1 {
+            socket_error(unsafe { socketlasterr() })
+        } else {
+            result.saturating_neg()
+        };
+        Err(io::Error::from_raw_os_error(errno))
+    } else {
+        Ok(result)
+    }
+}
+
+pub fn cvt_r(mut f: impl FnMut() -> i32) -> io::Result<i32> {
+    loop {
+        match cvt(f()) {
+            Err(err) if err.kind() == ErrorKind::Interrupted => continue,
+            result => return result,
+        }
+    }
+}
+
+// The Wii U backend initializes nsysnet once, on first use.
+pub fn init() {}
+
+fn ensure_network() {
+    static INIT: crate::sync::Once = crate::sync::Once::new();
+    INIT.call_once(|| unsafe { socket_lib_init() });
+}
+
+pub type LookupHost = crate::vec::IntoIter<SocketAddr>;
+
+pub fn lookup_host(host: &str, port: u16) -> io::Result<LookupHost> {
+    ensure_network();
+    run_with_cstr(host.as_bytes(), &|name: &CStr| {
+        // nsysnet returns a pointer into a reusable static buffer.
+        static DNS: Mutex<()> = Mutex::new(());
+        let _lock = DNS.lock().unwrap_or_else(PoisonError::into_inner);
+        let result = unsafe { net_gethostbyname(name.as_ptr()).as_ref() }
+            .filter(|entry| entry.family == netc::AF_INET && entry.length == 4)
+            .ok_or_else(|| io::Error::from(ErrorKind::NotFound))?;
+        let mut addresses = Vec::new();
+        let mut next = result.addresses;
+        if !next.is_null() {
+            unsafe {
+                while let Some(ip) = (*next).as_ref() {
+                    addresses.push(SocketAddr::from((Ipv4Addr::from(*ip), port)));
+                    next = next.add(1);
+                }
+            }
+        }
+        Ok(addresses.into_iter())
+    })
+}
+
+#[derive(Default)]
+struct Options {
+    nonblocking: bool,
+    read_timeout: Option<Duration>,
+    write_timeout: Option<Duration>,
+}
+
+struct SocketRef {
+    fd: i32,
+    datagram: bool,
+    options: Mutex<Options>,
+}
+
+impl Drop for SocketRef {
+    fn drop(&mut self) {
+        unsafe { net_close(self.fd) };
+    }
+}
+
+pub struct Socket(Arc<SocketRef>);
+
+impl Socket {
+    fn from_fd(fd: i32, datagram: bool) -> Self {
+        Self(Arc::new(SocketRef {
+            fd,
+            datagram,
+            options: Mutex::new(Options::default()),
+        }))
+    }
+
+    pub fn new(family: i32, kind: i32) -> io::Result<Self> {
+        if family != netc::AF_INET {
+            return crate::sys::unsupported();
+        }
+        ensure_network();
+        Ok(Self::from_fd(
+            cvt(unsafe { net_socket(family, kind, 0) })?,
+            kind == netc::SOCK_DGRAM,
+        ))
+    }
+
+    pub fn as_raw(&self) -> i32 {
+        self.0.fd
+    }
+
+    pub fn duplicate(&self) -> io::Result<Self> {
+        Ok(Self(self.0.clone()))
+    }
+
+    pub fn connect(&self, address: &SocketAddr) -> io::Result<()> {
+        let (address, length) = socket_addr_to_c(address);
+        cvt_r(|| unsafe { netc::connect(self.as_raw(), address.as_ptr(), length) }).map(drop)
+    }
+
+    pub fn poll_connected(&self, timeout: Duration) -> io::Result<()> {
+        if timeout.is_zero() {
+            return Err(io::Error::ZERO_TIMEOUT);
+        }
+        self.poll_until(POLLOUT, Instant::now(), timeout)?;
+        if let Some(error) = self.take_error()? {
+            return Err(error);
+        }
+        unsafe {
+            super::sockname(|address, length| netc::getpeername(self.as_raw(), address, length))
+        }
+        .map(drop)
+    }
+
+    fn poll_until(&self, events: u32, start: Instant, timeout: Duration) -> io::Result<()> {
+        loop {
+            let millis = timeout
+                .saturating_sub(start.elapsed())
+                .as_nanos()
+                .div_ceil(1_000_000);
+            if millis == 0 {
+                return Err(ErrorKind::TimedOut.into());
+            }
+            match wait(
+                self.as_raw(),
+                events == POLLOUT,
+                millis.min(i32::MAX as u128) as i32,
+            ) {
+                Ok(0) => continue,
+                Ok(_) => return Ok(()),
+                Err(err) if err.kind() == ErrorKind::Interrupted => continue,
+                Err(err) => return Err(err),
+            }
+        }
+    }
+
+    pub fn accept(&self, address: *mut sockaddr, length: *mut socklen_t) -> io::Result<Self> {
+        let fd = cvt_r(|| unsafe {
+            *length = size_of::<sockaddr>() as socklen_t;
+            net_accept(self.as_raw(), address, length)
+        })?;
+        Ok(Self::from_fd(fd, false))
+    }
+
+    fn with_io(
+        &self,
+        writing: bool,
+        flags: u32,
+        mut call: impl FnMut(u32) -> i32,
+    ) -> io::Result<usize> {
+        let (nonblocking, timeout) = {
+            let opts = self
+                .0
+                .options
+                .lock()
+                .unwrap_or_else(PoisonError::into_inner);
+            (
+                opts.nonblocking,
+                if writing {
+                    opts.write_timeout
+                } else {
+                    opts.read_timeout
+                },
+            )
+        };
+
+        if nonblocking {
+            return cvt(call(flags | MSG_DONTWAIT)).map(|n| n as usize);
+        }
+        if let Some(timeout) = timeout {
+            let start = Instant::now();
+            loop {
+                match cvt(call(flags | MSG_DONTWAIT)) {
+                    Err(err) if err.kind() == ErrorKind::WouldBlock => {
+                        self.poll_until(if writing { POLLOUT } else { POLLIN }, start, timeout)?;
+                    }
+                    result => return result.map(|n| n as usize),
+                }
+            }
+        }
+        cvt(call(flags)).map(|n| n as usize)
+    }
+
+    fn recv_raw(
+        &self,
+        buf: *mut u8,
+        len: usize,
+        flags: u32,
+        address: *mut sockaddr,
+        length: *mut socklen_t,
+    ) -> io::Result<usize> {
+        if len == 0 && !self.0.datagram {
+            return Ok(0);
+        }
+        let len = len.min(if self.0.datagram { 65535 } else { STREAM_CHUNK }) as i32;
+        self.with_io(false, flags, |flags| unsafe {
+            if address.is_null() {
+                recv(self.as_raw(), buf, len, flags)
+            } else {
+                recvfrom(self.as_raw(), buf, len, flags, address, length)
+            }
+        })
+    }
+
+    fn recv_with_flags(&self, mut buf: BorrowedCursor<'_, u8>, flags: u32) -> io::Result<()> {
+        let start = unsafe { buf.as_mut().as_mut_ptr().cast() };
+        let n = self.recv_raw(
+            start,
+            buf.capacity(),
+            flags,
+            ptr::null_mut(),
+            ptr::null_mut(),
+        )?;
+        unsafe { buf.advance(n) };
+        Ok(())
+    }
+
+    pub fn read_buf(&self, buf: BorrowedCursor<'_, u8>) -> io::Result<()> {
+        self.recv_with_flags(buf, 0)
+    }
+
+    pub fn read(&self, buf: &mut [u8]) -> io::Result<usize> {
+        let mut buf = BorrowedBuf::from(buf);
+        self.read_buf(buf.unfilled())?;
+        Ok(buf.len())
+    }
+
+    pub fn peek(&self, buf: &mut [u8]) -> io::Result<usize> {
+        self.recv_raw(
+            buf.as_mut_ptr(),
+            buf.len(),
+            MSG_PEEK,
+            ptr::null_mut(),
+            ptr::null_mut(),
+        )
+    }
+
+    fn recv_from_flags(&self, buf: &mut [u8], flags: u32) -> io::Result<(usize, SocketAddr)> {
+        let mut address: sockaddr_storage = unsafe { crate::mem::zeroed() };
+        let mut length = size_of::<sockaddr_storage>() as socklen_t;
+        let n = self.recv_raw(
+            buf.as_mut_ptr(),
+            buf.len(),
+            flags,
+            (&raw mut address).cast(),
+            &mut length,
+        )?;
+        Ok((n, unsafe {
+            super::socket_addr_from_c(&address, length as usize)?
+        }))
+    }
+
+    pub fn recv_from(&self, buf: &mut [u8]) -> io::Result<(usize, SocketAddr)> {
+        self.recv_from_flags(buf, 0)
+    }
+
+    pub fn peek_from(&self, buf: &mut [u8]) -> io::Result<(usize, SocketAddr)> {
+        self.recv_from_flags(buf, MSG_PEEK)
+    }
+
+    pub fn send(&self, buf: &[u8], address: *const sockaddr) -> io::Result<usize> {
+        let len = if self.0.datagram {
+            if buf.len() > MAX_DATAGRAM {
+                return Err(io::Error::from_raw_os_error(netc::EMSGSIZE));
+            }
+            buf.len()
+        } else {
+            if buf.is_empty() {
+                return Ok(0);
+            }
+            buf.len().min(STREAM_CHUNK)
+        };
+        if !address.is_null() && unsafe { (*address).sin_family } as i32 != netc::AF_INET {
+            return Err(io::Error::from_raw_os_error(106)); // EAFNOSUPPORT
+        }
+        self.with_io(true, 0, |flags| unsafe {
+            if address.is_null() {
+                send(self.as_raw(), buf.as_ptr(), len as i32, flags)
+            } else {
+                sendto(
+                    self.as_raw(),
+                    buf.as_ptr(),
+                    len as i32,
+                    flags,
+                    address,
+                    size_of::<sockaddr>() as socklen_t,
+                )
+            }
+        })
+    }
+
+    pub fn read_vectored(&self, bufs: &mut [IoSliceMut<'_>]) -> io::Result<usize> {
+        match bufs.iter_mut().find(|buf| !buf.is_empty()) {
+            Some(buf) => self.read(buf),
+            None => Ok(0),
+        }
+    }
+
+    pub fn write_vectored(&self, bufs: &[IoSlice<'_>]) -> io::Result<usize> {
+        match bufs.iter().find(|buf| !buf.is_empty()) {
+            Some(buf) => self.send(buf, ptr::null()),
+            None => Ok(0),
+        }
+    }
+
+    pub fn is_read_vectored(&self) -> bool {
+        false
+    }
+
+    pub fn is_write_vectored(&self) -> bool {
+        false
+    }
+
+    pub fn set_timeout(&self, timeout: Option<Duration>, kind: i32) -> io::Result<()> {
+        if timeout.is_some_and(|duration| duration.is_zero()) {
+            return Err(io::Error::ZERO_TIMEOUT);
+        }
+        let mut opts = self
+            .0
+            .options
+            .lock()
+            .unwrap_or_else(PoisonError::into_inner);
+        if kind == netc::SO_RCVTIMEO {
+            opts.read_timeout = timeout;
+        } else {
+            opts.write_timeout = timeout;
+        }
+        Ok(())
+    }
+
+    pub fn timeout(&self, kind: i32) -> io::Result<Option<Duration>> {
+        let opts = self
+            .0
+            .options
+            .lock()
+            .unwrap_or_else(PoisonError::into_inner);
+        Ok(if kind == netc::SO_RCVTIMEO {
+            opts.read_timeout
+        } else {
+            opts.write_timeout
+        })
+    }
+
+    pub fn shutdown(&self, how: Shutdown) -> io::Result<()> {
+        let how = match how {
+            Shutdown::Read => 0,
+            Shutdown::Write => 1,
+            Shutdown::Both => 2,
+        };
+        cvt(unsafe { net_shutdown(self.as_raw(), how) }).map(drop)
+    }
+
+    pub fn set_linger(&self, linger: Option<Duration>) -> io::Result<()> {
+        let value = [
+            i32::from(linger.is_some()),
+            linger.unwrap_or_default().as_secs().min(i32::MAX as u64) as i32,
+        ];
+        unsafe { setsockopt(self, netc::SOL_SOCKET, netc::SO_LINGER, value) }
+    }
+
+    pub fn linger(&self) -> io::Result<Option<Duration>> {
+        let [enabled, seconds] =
+            unsafe { getsockopt::<[i32; 2]>(self, netc::SOL_SOCKET, netc::SO_LINGER)? };
+        Ok((enabled != 0).then(|| Duration::from_secs(seconds.max(0) as u64)))
+    }
+
+    pub fn set_keepalive(&self, keepalive: bool) -> io::Result<()> {
+        self.set_bool_option(netc::SOL_SOCKET, netc::SO_KEEPALIVE, keepalive)
+    }
+
+    pub fn keepalive(&self) -> io::Result<bool> {
+        self.get_bool_option(netc::SOL_SOCKET, netc::SO_KEEPALIVE)
+    }
+
+    pub fn set_nodelay(&self, nodelay: bool) -> io::Result<()> {
+        self.set_bool_option(netc::IPPROTO_TCP, netc::TCP_NODELAY, nodelay)
+    }
+
+    pub fn nodelay(&self) -> io::Result<bool> {
+        self.get_bool_option(netc::IPPROTO_TCP, netc::TCP_NODELAY)
+    }
+
+    fn set_bool_option(&self, level: i32, kind: i32, enabled: bool) -> io::Result<()> {
+        unsafe { setsockopt(self, level, kind, i32::from(enabled)) }
+    }
+
+    fn get_bool_option(&self, level: i32, kind: i32) -> io::Result<bool> {
+        unsafe { getsockopt::<i32>(self, level, kind) }.map(|value| value != 0)
+    }
+
+    pub fn take_error(&self) -> io::Result<Option<io::Error>> {
+        let raw = unsafe { getsockopt::<i32>(self, netc::SOL_SOCKET, netc::SO_ERROR)? };
+        Ok((raw != 0).then(|| io::Error::from_raw_os_error(socket_error(raw))))
+    }
+
+    pub fn set_nonblocking(&self, enabled: bool) -> io::Result<()> {
+        let mut options = self
+            .0
+            .options
+            .lock()
+            .unwrap_or_else(PoisonError::into_inner);
+        self.set_bool_option(netc::SOL_SOCKET, SO_NONBLOCK, enabled)?;
+        options.nonblocking = enabled;
+        Ok(())
+    }
+}
