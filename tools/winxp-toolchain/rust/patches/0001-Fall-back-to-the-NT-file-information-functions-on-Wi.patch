diff --git a/library/std/src/sys/pal/windows/c/xp.rs b/library/std/src/sys/pal/windows/c/xp.rs
new file mode 100644
index 0000000..c91660d
--- /dev/null
+++ b/library/std/src/sys/pal/windows/c/xp.rs
@@ -0,0 +1,104 @@
+//! The file information functions Windows XP lacks, as fallbacks for `compat_fn_with_fallback!`.
+//!
+//! `GetFileInformationByHandleEx` and `SetFileInformationByHandle` came with Vista, but they
+//! only wrap NT functions XP already has. Their structures are the NT ones, only the class
+//! numbers differ.
+
+use super::*;
+
+windows_link::link!("ntdll.dll" "system" fn NtQueryInformationFile(
+    filehandle: HANDLE,
+    iostatusblock: *mut IO_STATUS_BLOCK,
+    fileinformation: *mut c_void,
+    length: u32,
+    fileinformationclass: FILE_INFORMATION_CLASS
+) -> NTSTATUS);
+windows_link::link!("ntdll.dll" "system" fn NtQueryDirectoryFile(
+    filehandle: HANDLE,
+    event: HANDLE,
+    apcroutine: PIO_APC_ROUTINE,
+    apccontext: *const c_void,
+    iostatusblock: *mut IO_STATUS_BLOCK,
+    fileinformation: *mut c_void,
+    length: u32,
+    fileinformationclass: FILE_INFORMATION_CLASS,
+    returnsingleentry: bool,
+    filename: *const UNICODE_STRING,
+    restartscan: bool
+) -> NTSTATUS);
+
+/// The NT class of a Win32 class std uses, with whether it lists a directory from the start.
+#[allow(non_upper_case_globals)]
+fn nt_class(class: FILE_INFO_BY_HANDLE_CLASS) -> Option<(FILE_INFORMATION_CLASS, Option<bool>)> {
+    Some(match class {
+        FileBasicInfo => (4, None),
+        FileStandardInfo => (5, None),
+        FileNameInfo => (9, None),
+        FileDispositionInfo => (13, None),
+        FileAllocationInfo => (19, None),
+        FileEndOfFileInfo => (20, None),
+        FileAttributeTagInfo => (35, None),
+        FileIdBothDirectoryInfo => (37, Some(false)),
+        FileIdBothDirectoryRestartInfo => (37, Some(true)),
+        _ => return None,
+    })
+}
+
+/// Sets the last error like the Win32 functions do.
+fn result(status: NTSTATUS) -> BOOL {
+    if nt_success(status) {
+        TRUE
+    } else {
+        unsafe { SetLastError(RtlNtStatusToDosError(status)) };
+        FALSE
+    }
+}
+
+pub unsafe fn get_file_information_by_handle_ex(
+    handle: HANDLE,
+    class: FILE_INFO_BY_HANDLE_CLASS,
+    info: *mut c_void,
+    size: u32,
+) -> BOOL {
+    let Some((class, directory)) = nt_class(class) else {
+        return result(STATUS_INVALID_PARAMETER);
+    };
+    let mut io = IO_STATUS_BLOCK::PENDING;
+    unsafe {
+        let status = match directory {
+            Some(restart) => NtQueryDirectoryFile(
+                handle,
+                ptr::null_mut(),
+                None,
+                ptr::null(),
+                &mut io,
+                info,
+                size,
+                class,
+                false,
+                ptr::null(),
+                restart,
+            ),
+            None => NtQueryInformationFile(handle, &mut io, info, size, class),
+        };
+        // Listing a directory opened for asynchronous I/O finishes later
+        if status == STATUS_PENDING {
+            WaitForSingleObject(handle, INFINITE);
+            return result(io.status());
+        }
+        result(status)
+    }
+}
+
+pub unsafe fn set_file_information_by_handle(
+    handle: HANDLE,
+    class: FILE_INFO_BY_HANDLE_CLASS,
+    info: *const c_void,
+    size: u32,
+) -> BOOL {
+    let Some((class, None)) = nt_class(class) else {
+        return result(STATUS_INVALID_PARAMETER);
+    };
+    let mut io = IO_STATUS_BLOCK::PENDING;
+    result(unsafe { NtSetInformationFile(handle, &mut io, info, size, class) })
+}
diff --git a/library/std/src/sys/pal/windows/stack_overflow.rs b/library/std/src/sys/pal/windows/stack_overflow.rs
index 2154975..538b2b8 100644
--- a/library/std/src/sys/pal/windows/stack_overflow.rs
+++ b/library/std/src/sys/pal/windows/stack_overflow.rs
@@ -8,7 +8,11 @@ pub fn reserve_stack() {
     let result = unsafe { c::SetThreadStackGuarantee(&mut 0x5000) };
     // Reserving stack space is not critical so we allow it to fail in the released build of libstd.
     // We still use debug assert here so that CI will test that we haven't made a mistake calling the function.
-    debug_assert_ne!(result, 0, "failed to reserve stack space for exception handling");
+    // Windows XP doesn't have the function, there it always fails.
+    debug_assert!(
+        result != 0 || cfg!(target_vendor = "win7"),
+        "failed to reserve stack space for exception handling"
+    );
 }
 
 unsafe extern "system" fn vectored_handler(ExceptionInfo: *mut c::EXCEPTION_POINTERS) -> i32 {
