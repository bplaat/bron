From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Bastiaan van der Plaat <bastiaan.v.d.plaat@gmail.com>
Date: Mon, 16 Nov 2026 18:33:56 +0100
Subject: [PATCH] Fall back to the NT file information functions on Windows XP

---
 library/std/src/sys/fs/windows.rs             |   5 +-
 library/std/src/sys/pal/windows/c.rs          |  33 ++++++
 library/std/src/sys/pal/windows/c/xp.rs       | 104 ++++++++++++++++++
 .../std/src/sys/pal/windows/stack_overflow.rs |   6 +-
 4 files changed, 146 insertions(+), 2 deletions(-)
 create mode 100644 library/std/src/sys/pal/windows/c/xp.rs

diff --git a/library/std/src/sys/fs/windows.rs b/library/std/src/sys/fs/windows.rs
index 77311d2..b5f46c7 100644
--- a/library/std/src/sys/fs/windows.rs
+++ b/library/std/src/sys/fs/windows.rs
@@ -1262,9 +1262,12 @@ pub fn readdir(p: &Path) -> io::Result<ReadDir> {
         //
         // We can pass FIND_FIRST_EX_LARGE_FETCH to dwAdditionalFlags to speed up things more,
         // but as we don't know user's use profile of this function, lets be conservative.
+        // Windows XP only has `FindExInfoStandard`, `FindExInfoBasic` came with Windows 7.
+        let info_level =
+            if cfg!(target_vendor = "win7") { c::FindExInfoStandard } else { c::FindExInfoBasic };
         let find_handle = c::FindFirstFileExW(
             path.as_ptr(),
-            c::FindExInfoBasic,
+            info_level,
             &mut wfd as *mut _ as _,
             c::FindExSearchNameMatch,
             ptr::null(),
diff --git a/library/std/src/sys/pal/windows/c.rs b/library/std/src/sys/pal/windows/c.rs
index 439edba..45dea38 100644
--- a/library/std/src/sys/pal/windows/c.rs
+++ b/library/std/src/sys/pal/windows/c.rs
@@ -15,6 +15,8 @@ use core::ptr;
 #[allow(unused)]
 mod windows_sys;
 pub use windows_sys::*;
+#[cfg(target_vendor = "win7")]
+mod xp;
 
 pub type WCHAR = u16;
 
@@ -280,6 +282,8 @@ pub const AF_UNIX: ADDRESS_FAMILY = windows_sys::AF_UNIX as ADDRESS_FAMILY;
 pub const CONDITION_VARIABLE_INIT: CONDITION_VARIABLE = CONDITION_VARIABLE { Ptr: ptr::null_mut() };
 #[cfg(target_vendor = "win7")]
 pub const SRWLOCK_INIT: SRWLOCK = SRWLOCK { Ptr: ptr::null_mut() };
+#[cfg(target_vendor = "win7")]
+pub const FindExInfoStandard: FINDEX_INFO_LEVELS = 0;
 #[cfg(not(target_thread_local))]
 pub const INIT_ONCE_STATIC_INIT: INIT_ONCE = INIT_ONCE { Ptr: ptr::null_mut() };
 
@@ -418,6 +422,35 @@ compat_fn_with_fallback! {
     pub fn GetTempPath2W(bufferlength: u32, buffer: PWSTR) -> u32 {
         unsafe {  GetTempPathW(bufferlength, buffer) }
     }
+
+    // >= Vista / Server 2008, Windows XP has the NT functions they wrap
+    // https://learn.microsoft.com/en-us/windows/win32/api/winbase/nf-winbase-getfileinformationbyhandleex
+    #[cfg(target_vendor = "win7")]
+    pub fn GetFileInformationByHandleEx(
+        hfile: HANDLE,
+        fileinformationclass: FILE_INFO_BY_HANDLE_CLASS,
+        lpfileinformation: *mut c_void,
+        dwbuffersize: u32
+    ) -> BOOL {
+        unsafe { xp::get_file_information_by_handle_ex(hfile, fileinformationclass, lpfileinformation, dwbuffersize) }
+    }
+    // https://learn.microsoft.com/en-us/windows/win32/api/fileapi/nf-fileapi-setfileinformationbyhandle
+    #[cfg(target_vendor = "win7")]
+    pub fn SetFileInformationByHandle(
+        hfile: HANDLE,
+        fileinformationclass: FILE_INFO_BY_HANDLE_CLASS,
+        lpfileinformation: *const c_void,
+        dwbuffersize: u32
+    ) -> BOOL {
+        unsafe { xp::set_file_information_by_handle(hfile, fileinformationclass, lpfileinformation, dwbuffersize) }
+    }
+
+    // >= Vista / Server 2008, std reserves no stack for stack overflow messages without it
+    // https://learn.microsoft.com/en-us/windows/win32/api/processthreadsapi/nf-processthreadsapi-setthreadstackguarantee
+    #[cfg(target_vendor = "win7")]
+    pub fn SetThreadStackGuarantee(stacksizeinbytes: *mut u32) -> BOOL {
+        unsafe { SetLastError(ERROR_CALL_NOT_IMPLEMENTED as u32); FALSE }
+    }
 }
 
