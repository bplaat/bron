-//! System Mutexes
-//!
-//! The Windows implementation of mutexes is a little odd and it might not be
-//! immediately obvious what's going on. The primary oddness is that SRWLock is
-//! used instead of CriticalSection, and this is done because:
-//!
-//! 1. SRWLock is several times faster than CriticalSection according to
-//!    benchmarks performed on both Windows 8 and Windows 7.
-//!
-//! 2. CriticalSection allows recursive locking while SRWLock deadlocks. The
-//!    Unix implementation deadlocks so consistency is preferred. See #19962 for
-//!    more details.
-//!
-//! 3. While CriticalSection is fair and SRWLock is not, the current Rust policy
-//!    is that there are no guarantees of fairness.
-
-use crate::cell::UnsafeCell;
-use crate::sys::c;
+//! A mutex on keyed events, as Windows XP has no SRW locks.
 
-pub struct Mutex {
-    srwlock: UnsafeCell<c::SRWLOCK>,
-}
+use core::sync::atomic::Atomic;
+use core::sync::atomic::Ordering::{Acquire, Relaxed, Release};
 
-unsafe impl Send for Mutex {}
-unsafe impl Sync for Mutex {}
+use crate::sys::sync::keyed_event;
 
-#[inline]
-pub unsafe fn raw(m: &Mutex) -> *mut c::SRWLOCK {
-    m.srwlock.get()
+/// Set while the mutex is locked.
+const LOCKED: u32 = 1;
+/// Added for every thread that waits for the mutex.
+const WAITER: u32 = 2;
+
+pub struct Mutex {
+    state: Atomic<u32>,
 }
 
 impl Mutex {
     #[inline]
     pub const fn new() -> Mutex {
-        Mutex { srwlock: UnsafeCell::new(c::SRWLOCK_INIT) }
+        Mutex { state: Atomic::<u32>::new(0) }
     }
 
     #[inline]
     pub fn lock(&self) {
-        unsafe {
-            c::AcquireSRWLockExclusive(raw(self));
+        if self.state.compare_exchange(0, LOCKED, Acquire, Relaxed).is_err() {
+            self.lock_contended();
+        }
+    }
+
+    #[cold]
+    fn lock_contended(&self) {
+        let mut state = self.state.load(Relaxed);
+        loop {
+            // Take the lock when it's free, otherwise wait until an unlock wakes us
+            let result = if state & LOCKED == 0 {
+                self.state.compare_exchange_weak(state, state | LOCKED, Acquire, Relaxed)
+            } else {
+                self.state.compare_exchange_weak(state, state + WAITER, Relaxed, Relaxed)
+            };
+            match result {
+                Ok(_) if state & LOCKED == 0 => return,
+                Ok(_) => {
+                    keyed_event::wait(self.key());
+                    state = self.state.load(Relaxed);
+                }
+                Err(new) => state = new,
+            }
         }
     }
 
     #[inline]
     pub fn try_lock(&self) -> bool {
-        unsafe { c::TryAcquireSRWLockExclusive(raw(self)) }
+        self.state.fetch_or(LOCKED, Acquire) & LOCKED == 0
     }
 
     #[inline]
     pub unsafe fn unlock(&self) {
-        c::ReleaseSRWLockExclusive(raw(self));
+        if self.state.fetch_sub(LOCKED, Release) != LOCKED {
+            self.wake();
+        }
+    }
+
+    /// Wakes a waiting thread, unless the mutex is locked again, then its unlock does.
+    #[cold]
+    fn wake(&self) {
+        let mut state = self.state.load(Relaxed);
+        while state >= WAITER && state & LOCKED == 0 {
+            match self.state.compare_exchange_weak(state, state - WAITER, Relaxed, Relaxed) {
+                Ok(_) => return keyed_event::release(self.key()),
+                Err(new) => state = new,
+            }
+        }
+    }
+
+    fn key(&self) -> *const core::ffi::c_void {
+        self.state.as_ptr().cast()
     }
 }
