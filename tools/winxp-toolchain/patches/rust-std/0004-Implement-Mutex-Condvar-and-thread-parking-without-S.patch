diff --git a/library/std/src/sys/sync/condvar/windows_xp.rs b/library/std/src/sys/sync/condvar/windows_xp.rs
new file mode 100644
index 0000000..96759ed
--- /dev/null
+++ b/library/std/src/sys/sync/condvar/windows_xp.rs
@@ -0,0 +1,152 @@
+//! A condition variable for Windows XP, which has no condition variables: the waiting threads
+//! queue up and park until a notify takes them from the queue.
+
+use core::cell::Cell;
+use core::ptr;
+use core::sync::atomic::Ordering::{Acquire, Release};
+use core::sync::atomic::{Atomic, AtomicBool};
+
+use crate::cell::UnsafeCell;
+use crate::sys::sync::Mutex;
+use crate::thread::{self, Thread};
+use crate::time::{Duration, Instant};
+
+/// A waiting thread, it lives on that thread's stack while it is queued.
+struct Waiter {
+    thread: Thread,
+    notified: Atomic<bool>,
+    next: Cell<*const Waiter>,
+}
+
+pub struct Condvar {
+    /// Guards the queue, notifies can come without the mutex of the waiters.
+    lock: Mutex,
+    /// The first and the last waiting thread.
+    queue: UnsafeCell<(*const Waiter, *const Waiter)>,
+}
+
+unsafe impl Send for Condvar {}
+unsafe impl Sync for Condvar {}
+
+impl Condvar {
+    #[inline]
+    pub const fn new() -> Condvar {
+        Condvar { lock: Mutex::new(), queue: UnsafeCell::new((ptr::null(), ptr::null())) }
+    }
+
+    #[inline]
+    pub unsafe fn wait(&self, mutex: &Mutex) {
+        unsafe { self.wait_optional_timeout(mutex, None) };
+    }
+
+    pub unsafe fn wait_timeout(&self, mutex: &Mutex, dur: Duration) -> bool {
+        unsafe { self.wait_optional_timeout(mutex, Some(dur)) }
+    }
+
+    unsafe fn wait_optional_timeout(&self, mutex: &Mutex, timeout: Option<Duration>) -> bool {
+        let waiter = Waiter {
+            thread: thread::current_or_unnamed(),
+            notified: AtomicBool::new(false),
+            next: Cell::new(ptr::null()),
+        };
+        self.with_queue(|(first, last)| {
+            match unsafe { last.as_ref() } {
+                Some(last) => last.next.set(&waiter),
+                None => *first = &waiter,
+            }
+            *last = &waiter;
+        });
+        unsafe { mutex.unlock() };
+
+        // A deadline that doesn't fit waits forever
+        let deadline = timeout.and_then(|timeout| Instant::now().checked_add(timeout));
+        let mut notified = true;
+        // Parks with the waiter's handle, `thread::park` fails after the thread's locals are gone
+        while !waiter.notified.load(Acquire) {
+            let Some(deadline) = deadline else {
+                // SAFETY: the handle is of this thread
+                unsafe { waiter.thread.park() };
+                continue;
+            };
+            let left = deadline.saturating_duration_since(Instant::now());
+            if !left.is_zero() {
+                // SAFETY: the handle is of this thread
+                unsafe { waiter.thread.park_timeout(left) };
+                continue;
+            }
+            // Timed out, unless a notify took it from the queue meanwhile, under the lock a
+            // waiter is queued exactly when it isn't notified
+            notified = self.with_queue(|queue| {
+                let notified = waiter.notified.load(Acquire);
+                if !notified {
+                    remove(queue, &waiter);
+                }
+                notified
+            });
+            break;
+        }
+        mutex.lock();
+        notified
+    }
+
+    #[inline]
+    pub fn notify_one(&self) {
+        if let Some(thread) = self.with_queue(|(first, last)| unsafe {
+            let waiter = first.as_ref()?;
+            *first = waiter.next.get();
+            if first.is_null() {
+                *last = ptr::null();
+            }
+            Some(take(waiter))
+        }) {
+            thread.unpark();
+        }
+    }
+
+    #[inline]
+    pub fn notify_all(&self) {
+        // Under the lock, a waiter that times out could go once the queue is empty
+        self.with_queue(|queue| {
+            let mut waiter = core::mem::replace(queue, (ptr::null(), ptr::null())).0;
+            while let Some(current) = unsafe { waiter.as_ref() } {
+                waiter = current.next.get();
+                unsafe { take(current) }.unpark();
+            }
+        });
+    }
+
+    fn with_queue<T>(&self, f: impl FnOnce(&mut (*const Waiter, *const Waiter)) -> T) -> T {
+        self.lock.lock();
+        let result = f(unsafe { &mut *self.queue.get() });
+        unsafe { self.lock.unlock() };
+        result
+    }
+}
+
+/// Marks a waiter taken from the queue as notified, returns its thread to unpark. After that the
+/// waiter can return and its stack go, so its thread is cloned first.
+unsafe fn take(waiter: &Waiter) -> Thread {
+    let thread = waiter.thread.clone();
+    waiter.notified.store(true, Release);
+    thread
+}
+
+/// Removes a waiter from the queue.
+fn remove((first, last): &mut (*const Waiter, *const Waiter), waiter: *const Waiter) {
+    let mut previous: *const Waiter = ptr::null();
+    let mut current = *first;
+    while let Some(node) = unsafe { current.as_ref() } {
+        if current == waiter {
+            match unsafe { previous.as_ref() } {
+                Some(previous) => previous.next.set(node.next.get()),
+                None => *first = node.next.get(),
+            }
+            if *last == waiter {
+                *last = previous;
+            }
+            return;
+        }
+        previous = current;
+        current = node.next.get();
+    }
+}
diff --git a/library/std/src/sys/sync/keyed_event.rs b/library/std/src/sys/sync/keyed_event.rs
new file mode 100644
index 0000000..8a310b7
--- /dev/null
+++ b/library/std/src/sys/sync/keyed_event.rs
@@ -0,0 +1,54 @@
+//! Keyed events, the wait queue Windows has since Windows XP, the mutex is built on them.
+//!
+//! A thread waits on a key, an address, until another thread releases that key. Releasing blocks
+//! until a thread waits on the key, so only release a key when a thread has committed to wait on
+//! it. There are no timeouts: Windows XP can give a release to a wait that times out at the same
+//! time, which then reports the timeout.
+
+use core::ffi::c_void;
+use core::ptr;
+use core::sync::atomic::Ordering::Relaxed;
+use core::sync::atomic::{Atomic, AtomicPtr};
+
+use crate::sys::c;
+
+/// Waits until a thread releases the key.
+pub fn wait(key: *const c_void) {
+    unsafe { c::NtWaitForKeyedEvent(handle(), key, false, ptr::null_mut()) };
+}
+
+/// Wakes one thread that waits on the key, waiting until one does.
+pub fn release(key: *const c_void) {
+    unsafe { c::NtReleaseKeyedEvent(handle(), key, false, ptr::null_mut()) };
+}
+
+/// The keyed event of the process, Windows XP has no default one.
+fn handle() -> c::HANDLE {
+    const INVALID: c::HANDLE = ptr::without_provenance_mut(!0);
+    static HANDLE: Atomic<*mut c_void> = AtomicPtr::new(INVALID);
+    match HANDLE.load(Relaxed) {
+        INVALID => {
+            let mut handle = c::INVALID_HANDLE_VALUE;
+            unsafe {
+                match c::NtCreateKeyedEvent(
+                    &mut handle,
+                    c::GENERIC_READ | c::GENERIC_WRITE,
+                    ptr::null_mut(),
+                    0,
+                ) {
+                    c::STATUS_SUCCESS => {}
+                    r => panic!("Unable to create keyed event handle: error {r}"),
+                }
+            }
+            match HANDLE.compare_exchange(INVALID, handle, Relaxed, Relaxed) {
+                Ok(_) => handle,
+                Err(h) => {
+                    // Another thread created one first, use that one
+                    unsafe { c::CloseHandle(handle) };
+                    h
+                }
+            }
+        }
+        handle => handle,
+    }
+}
