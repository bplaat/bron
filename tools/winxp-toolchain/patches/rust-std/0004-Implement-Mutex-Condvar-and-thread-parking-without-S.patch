diff --git a/library/std/src/sys/sync/thread_parking/windows_xp.rs b/library/std/src/sys/sync/thread_parking/windows_xp.rs
new file mode 100644
index 0000000..61f500c
--- /dev/null
+++ b/library/std/src/sys/sync/thread_parking/windows_xp.rs
@@ -0,0 +1,198 @@
+// Thread parker implementation for Windows.
+//
+// This uses WaitOnAddress and WakeByAddressSingle if available (Windows 8+).
+// This modern API is exactly the same as the futex syscalls the Linux thread
+// parker uses. When These APIs are available, the implementation of this
+// thread parker matches the Linux thread parker exactly.
+//
+// However, when the modern API is not available, each thread parker waits on
+// an auto-reset event of its own, which unpark() sets when the thread parked.
+// NT keyed events would need no handle per thread, but Windows XP can give a
+// NtReleaseKeyedEvent to a NtWaitForKeyedEvent that times out at the same time,
+// which then reports the timeout, so park_timeout() would miss its unpark().
+//
+// The fast path (calling park() after unpark() was already called) and the
+// possible states are the same for both implementations. This is used here to
+// make sure the fast path does not even check which API to use, but can return
+// right away, independent of the used API. Only the slow paths (which will
+// actually block/wake a thread) check which API is available and have
+// different implementations.
+
+use core::ffi::c_void;
+
+use crate::pin::Pin;
+use crate::ptr;
+use crate::sync::atomic::Ordering::{Acquire, Release};
+use crate::sync::atomic::{Atomic, AtomicI8};
+use crate::sys::{c, dur2timeout};
+use crate::time::Duration;
+
+pub struct Parker {
+    state: Atomic<i8>,
+    /// Without `WaitOnAddress` the thread waits on an event of its own.
+    event: c::HANDLE,
+}
+
+// SAFETY: the event handle is only used to wait on and set the event.
+unsafe impl Send for Parker {}
+unsafe impl Sync for Parker {}
+
+impl Drop for Parker {
+    fn drop(&mut self) {
+        if !self.event.is_null() {
+            unsafe { c::CloseHandle(self.event) };
+        }
+    }
+}
+
+const PARKED: i8 = -1;
+const EMPTY: i8 = 0;
+const NOTIFIED: i8 = 1;
+
+// Notes about memory ordering:
+//
+// Memory ordering is only relevant for the relative ordering of operations
+// between different variables. Even Ordering::Relaxed guarantees a
+// monotonic/consistent order when looking at just a single atomic variable.
+//
+// So, since this parker is just a single atomic variable, we only need to look
+// at the ordering guarantees we need to provide to the 'outside world'.
+//
+// The only memory ordering guarantee that parking and unparking provide, is
+// that things which happened before unpark() are visible on the thread
+// returning from park() afterwards. Otherwise, it was effectively unparked
+// before unpark() was called while still consuming the 'token'.
+//
+// In other words, unpark() needs to synchronize with the part of park() that
+// consumes the token and returns.
+//
+// This is done with a release-acquire synchronization, by using
+// Ordering::Release when writing NOTIFIED (the 'token') in unpark(), and using
+// Ordering::Acquire when reading this state in park() after waking up.
+impl Parker {
+    /// Constructs the Windows parker. The UNIX parker implementation
+    /// requires this to happen in-place.
+    pub unsafe fn new_in_place(parker: *mut Parker) {
+        parker.write(Self {
+            state: AtomicI8::new(EMPTY),
+            event: if c::WaitOnAddress::option().is_none() {
+                let event = c::CreateEventW(ptr::null(), c::FALSE, c::FALSE, ptr::null());
+                if event.is_null() {
+                    rtabort!("failed to create the thread parker event");
+                }
+                event
+            } else {
+                ptr::null_mut()
+            },
+        });
+    }
+
+    // Assumes this is only called by the thread that owns the Parker,
+    // which means that `self.state != PARKED`. This implementation doesn't require `Pin`,
+    // but other implementations do.
+    pub unsafe fn park(self: Pin<&Self>) {
+        // Change NOTIFIED=>EMPTY or EMPTY=>PARKED, and directly return in the
+        // first case.
+        if self.state.fetch_sub(1, Acquire) == NOTIFIED {
+            return;
+        }
+
+        if c::WaitOnAddress::option().is_none() {
+            return event::park(self);
+        }
+
+        loop {
+            // Wait for something to happen, assuming it's still set to PARKED.
+            c::WaitOnAddress(self.ptr(), &PARKED as *const _ as *const c_void, 1, c::INFINITE);
+            // Change NOTIFIED=>EMPTY but leave PARKED alone.
+            if self.state.compare_exchange(NOTIFIED, EMPTY, Acquire, Acquire).is_ok() {
+                // Actually woken up by unpark().
+                return;
+            } else {
+                // Spurious wake up. We loop to try again.
+            }
+        }
+    }
+
+    // Assumes this is only called by the thread that owns the Parker,
+    // which means that `self.state != PARKED`. This implementation doesn't require `Pin`,
+    // but other implementations do.
+    pub unsafe fn park_timeout(self: Pin<&Self>, timeout: Duration) {
+        // Change NOTIFIED=>EMPTY or EMPTY=>PARKED, and directly return in the
+        // first case.
+        if self.state.fetch_sub(1, Acquire) == NOTIFIED {
+            return;
+        }
+
+        if c::WaitOnAddress::option().is_none() {
+            return event::park_timeout(self, timeout);
+        }
+
+        // Wait for something to happen, assuming it's still set to PARKED.
+        c::WaitOnAddress(self.ptr(), &PARKED as *const _ as *const c_void, 1, dur2timeout(timeout));
+        // Set the state back to EMPTY (from either PARKED or NOTIFIED).
+        // Note that we don't just write EMPTY, but use swap() to also
+        // include an acquire-ordered read to synchronize with unpark()'s
+        // release-ordered write.
+        if self.state.swap(EMPTY, Acquire) == NOTIFIED {
+            // Actually woken up by unpark().
+        } else {
+            // Timeout or spurious wake up.
+            // We return either way, because we can't easily tell if it was the
+            // timeout or not.
+        }
+    }
+
+    // This implementation doesn't require `Pin`, but other implementations do.
+    pub fn unpark(self: Pin<&Self>) {
+        // Change PARKED=>NOTIFIED, EMPTY=>NOTIFIED, or NOTIFIED=>NOTIFIED, and
+        // wake the thread in the first case.
+        //
+        // Note that even NOTIFIED=>NOTIFIED results in a write. This is on
+        // purpose, to make sure every unpark() has a release-acquire ordering
+        // with park().
+        if self.state.swap(NOTIFIED, Release) == PARKED {
+            unsafe {
+                if c::WakeByAddressSingle::option().is_none() {
+                    return event::unpark(self);
+                }
+                c::WakeByAddressSingle(self.ptr());
+            }
+        }
+    }
+
+    fn ptr(&self) -> *const c_void {
+        (&raw const self.state).cast::<c_void>()
+    }
+}
+
+// Windows XP has keyed events, but they can give a release to a wait that times out at the same
+// time, which then reports the timeout, so the thread waits on its own auto-reset event instead.
+mod event {
+    use core::pin::Pin;
+    use core::sync::atomic::Ordering::Acquire;
+    use core::time::Duration;
+
+    use super::{EMPTY, NOTIFIED, Parker};
+    use crate::sys::{c, dur2timeout};
+
+    windows_link::link!("kernel32.dll" "system" fn SetEvent(hevent: c::HANDLE) -> c::BOOL);
+
+    pub unsafe fn park(parker: Pin<&Parker>) {
+        // Only unpark() sets the event, but one that came after a timeout can still be set
+        loop {
+            c::WaitForSingleObject(parker.event, c::INFINITE);
+            if parker.state.compare_exchange(NOTIFIED, EMPTY, Acquire, Acquire).is_ok() {
+                return;
+            }
+        }
+    }
+    pub unsafe fn park_timeout(parker: Pin<&Parker>, timeout: Duration) {
+        c::WaitForSingleObject(parker.event, dur2timeout(timeout));
+        // Set the state back to EMPTY (from either PARKED or NOTIFIED).
+        parker.state.swap(EMPTY, Acquire);
+    }
+    pub unsafe fn unpark(parker: Pin<&Parker>) {
+        SetEvent(parker.event);
+    }
+}
