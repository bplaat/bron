 libc/stdlib/CMakeLists.txt |  1 +
 libc/stdlib/far-malloc.c   | 66 ++++++++++++++++++++++++++++++++++++++
 libc/stdlib/free.c         |  2 +-
 libc/stdlib/local-malloc.h | 18 +++++++++++
 libc/stdlib/malloc.c       |  4 +++
 libc/stdlib/meson.build    |  1 +
 libc/stdlib/realloc.c      |  4 +--
 8 files changed, 99 insertions(+), 3 deletions(-)
 create mode 100644 libc/stdlib/far-malloc.c

