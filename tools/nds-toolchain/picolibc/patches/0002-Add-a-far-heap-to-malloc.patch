diff --git a/libc/stdlib/local-malloc.h b/libc/stdlib/local-malloc.h
index e171a16..847f11a 100644
--- a/libc/stdlib/local-malloc.h
+++ b/libc/stdlib/local-malloc.h
@@ -207,6 +207,24 @@ extern chunk_t *__malloc_free_list;
 extern char    *__malloc_sbrk_start;
 extern char    *__malloc_sbrk_top;
 
+/* The far heap of far_malloc, memory sbrk doesn't give, with its own free list */
+extern chunk_t *__malloc_far_free_list;
+extern char    *__malloc_far_start;
+extern char    *__malloc_far_end;
+
+static inline bool
+__malloc_is_far(void *ptr)
+{
+    return (char *)ptr >= __malloc_far_start && (char *)ptr < __malloc_far_end;
+}
+
+/* The free list a chunk goes back to */
+static inline chunk_t **
+__malloc_free_list_of(chunk_t *c)
+{
+    return __malloc_is_far(c) ? &__malloc_far_free_list : &__malloc_free_list;
+}
+
 #ifdef MALLOC_MAX_BUCKET_POT
 
 /* Every power-of-two bucket gets padded by this amount */
