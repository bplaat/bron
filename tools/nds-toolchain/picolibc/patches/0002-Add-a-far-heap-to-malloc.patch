diff --git a/libc/stdlib/far-malloc.c b/libc/stdlib/far-malloc.c
new file mode 100644
index 0000000..9f0d12c
--- /dev/null
+++ b/libc/stdlib/far-malloc.c
@@ -0,0 +1,66 @@
+/*
+ * SPDX-License-Identifier: BSD-3-Clause
+ *
+ * Copyright (c) 2026 Bastiaan van der Plaat
+ */
+
+#include "local-malloc.h"
+
+/* Gives the memory to the far heap, free puts it in the far free list */
+void
+far_heap_init(void *start, size_t size)
+{
+    char *blob = (char *)__align_up((uintptr_t)start + MALLOC_HEAD_SIZE, MALLOC_CHUNK_ALIGN) - MALLOC_HEAD_SIZE;
+    char *end = (char *)start + size;
+
+    if (end < blob + MALLOC_CHUNK_MIN)
+        return;
+    size = (size_t)(end - blob) & ~(size_t)(MALLOC_CHUNK_ALIGN - 1);
+    MALLOC_LOCK;
+    __malloc_far_start = blob;
+    __malloc_far_end = blob + size;
+    MALLOC_UNLOCK;
+    make_free_chunk(blob_to_chunk(blob), size);
+}
+
+/* Takes the first free chunk of the far heap that fits, else memory like malloc */
+void *
+far_malloc(size_t s)
+{
+    chunk_t **p, *c;
+
+    if (s > MALLOC_ALLOC_MAX) {
+        errno = ENOMEM;
+        return NULL;
+    }
+
+    size_t alloc_size = chunk_size(s);
+
+    MALLOC_LOCK;
+    for (p = &__malloc_far_free_list; (c = *p) != NULL; p = &c->next) {
+        if (_size(c) >= alloc_size) {
+            size_t rem = _size(c) - alloc_size;
+
+            if (rem >= MALLOC_CHUNK_MIN) {
+                /* Split off the rest, which stays free */
+                chunk_t *r = (chunk_t *)((char *)c + alloc_size);
+                _set_size(c, alloc_size);
+                _set_size(r, rem);
+                _mark_free(r);
+                r->next = c->next;
+                *p = r;
+            } else {
+                *p = c->next;
+            }
+            break;
+        }
+    }
+    MALLOC_UNLOCK;
+
+    if (c == NULL)
+        return malloc(s);
+
+    _mark_busy(c);
+    memset(chunk_to_ptr(c), '\0', _size(c) - MALLOC_HEAD_SIZE);
+    return chunk_to_ptr(c);
+}
