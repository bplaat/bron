 void *memalign(size_t __alignment, size_t __size) __malloc_like __warn_unused_result __alloc_size(2)
 __nothrow __picolibc_export;
 
+/* Memory sbrk doesn't give, like the RAM of a Memory Expansion Pak on a
+   Nintendo DS, as a far heap: far_malloc takes from it first, then like
+   malloc, which never takes from it. free and realloc take both. */
+void  far_heap_init(void *__start, size_t __size) __picolibc_export;
+void *far_malloc(size_t __size) __malloc_like __warn_unused_result __alloc_size(1) __nothrow __picolibc_export;
+
