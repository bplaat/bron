 libc/machine/arm/memcpy.c       |   3 +-
 libc/machine/arm/memmove.c      |   4 +
 libc/machine/arm/memset.c       |   3 +-
 libc/machine/arm/meson.build    |   1 +
 libc/machine/arm/nds-memory.c   | 185 ++++++++++++++++++++++++++++++++
 6 files changed, 195 insertions(+), 2 deletions(-)
 create mode 100644 libc/machine/arm/nds-memory.c

