index b29a7cb..0416c4e 100644
--- a/source/nds/pxi/mic.h
+++ b/source/nds/pxi/mic.h
@@ -2,12 +2,16 @@
 // SPDX-FileCopyrightText: Copyright fincs, devkitPro
 #pragma once
 #include <calico/nds/pxi.h>
+#include <calico/nds/mic.h>
+#include <calico/nds/mm.h>
+#include <calico/nds/system.h>
 
 typedef enum PxiMicCmd {
 	PxiMicCmd_SetCpuTimer = 0,
 	PxiMicCmd_SetDmaRate  = 1,
 	PxiMicCmd_Start       = 2,
 	PxiMicCmd_Stop        = 3,
+	PxiMicCmd_Entropy     = 4,
 } PxiMicCmd;
 
 typedef union PxiMicImmDivTimer {
@@ -45,3 +49,17 @@
 {
 	return msg >> 3;
 }
+
+// Only canonical main RAM can be shared between the CPUs through this request.
+MK_INLINE bool pxiMicEntropyBufferValid(u32 address)
+{
+    u32 end = MM_MAINRAM + (systemIsTwlMode() ? MM_MAINRAM_SZ_TWL : MM_MAINRAM_SZ_NTR);
+    if ((address & 31) || address < MM_MAINRAM || address > end - MIC_ENTROPY_SAMPLES * sizeof(u16))
+        return false;
+#if defined(ARM9)
+    // DTCM overlays main RAM on ARM9, but ARM7 sees different storage there.
+    if (address < MM_DTCM + MM_DTCM_SZ && address + MIC_ENTROPY_SAMPLES * sizeof(u16) > MM_DTCM)
+        return false;
+#endif
+    return true;
+}
diff --git a/source/nds/arm9/mic.c b/source/nds/arm9/mic.c
index af1094f..e20950c 100644
