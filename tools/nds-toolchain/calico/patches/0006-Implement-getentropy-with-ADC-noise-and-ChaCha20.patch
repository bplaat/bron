 source/nds/pxi/mic.h       |  18 ++++++++++++++++++
 source/nds/arm9/mic.c      |  15 +++++++++++++++
 source/nds/arm7/mic.32.c   |  88 +++++++++++++++++++++++++++++++++++
 source/system/getentropy.c | 248 +++++++++++++++++++++++++++++++++++
 5 files changed, 384 insertions(+)
 create mode 100644 source/system/getentropy.c

diff --git a/include/calico/nds/mic.h b/include/calico/nds/mic.h
index d15a494..823c8c9 100644
--- a/include/calico/nds/mic.h
+++ b/include/calico/nds/mic.h
@@ -40,4 +40,19 @@
 	return 512*((unsigned)rate + 1);
 }
 
+//! Number of raw ADC samples collected for an entropy reseed.
+#define MIC_ENTROPY_SAMPLES 1024
+
+MK_EXTERN_C_START
+
+/*! @brief Collects microphone ADC samples without taking over an active recording.
+    @param[out] samples 32-byte-aligned main RAM buffer of MIC_ENTROPY_SAMPLES halfwords.
+    @return false for an invalid buffer, absent/busy service or sampling failure.
+    @note Enables the microphone briefly, then restores its amplifier and capture state.
+    The samples are unconditioned; their entropy has not been assessed on hardware.
+*/
+bool micReadEntropy(u16 samples[MIC_ENTROPY_SAMPLES]);
+
+MK_EXTERN_C_END
+
 //! @}
