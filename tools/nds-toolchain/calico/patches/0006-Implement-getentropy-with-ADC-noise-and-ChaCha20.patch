@@ -1,10 +1,12 @@
 // SPDX-License-Identifier: ZPL-2.1
 // SPDX-FileCopyrightText: Copyright fincs, devkitPro
 #include <calico/types.h>
+#include <calico/arm/cache.h>
 #include <calico/system/thread.h>
 #include <calico/system/mailbox.h>
 #include <calico/nds/arm9/mic.h>
 #include "../pxi/mic.h"
+#include "../transfer.h"
 
 static struct {
 	MicBufferFn fn;
@@ -106,3 +108,16 @@
 {
 	_micIssueCmd(PxiMicCmd_Stop, 0);
 }
+
+// Preserve the application's microphone callback and capture parameters.
+bool micReadEntropy(u16 samples[MIC_ENTROPY_SAMPLES]) {
+    if (!(s_pxiRemotePxiMask & (1U << PxiChannel_Mic)))
+        return false;
+    if (!pxiMicEntropyBufferValid((u32)samples))
+        return false;
+    armDCacheFlush(samples, MIC_ENTROPY_SAMPLES * sizeof(u16));
+    // An aligned main RAM address fits in the command's immediate field.
+    bool result = _micIssueCmd(PxiMicCmd_Entropy, (u32)samples >> 5);
+    armDCacheInvalidate(samples, MIC_ENTROPY_SAMPLES * sizeof(u16));
+    return result;
+}
