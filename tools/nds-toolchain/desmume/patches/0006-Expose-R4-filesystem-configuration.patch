From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Bastiaan van der Plaat <bastiaan.v.d.plaat@gmail.com>
Date: Fri, 16 Oct 2026 12:00:00 +0200
Subject: [PATCH] Expose R4 filesystem configuration to the interface

---
diff --git a/desmume/src/frontend/interface/interface.cpp b/desmume/src/frontend/interface/interface.cpp
--- a/desmume/src/frontend/interface/interface.cpp
+++ b/desmume/src/frontend/interface/interface.cpp
@@ -32,6 +32,7 @@
 #include "../../firmware.h"
 #include "../../armcpu.h"
 #include "../../slot2.h"
+#include "../../slot1.h"
 #include "../posix/shared/sndsdl.h"
 #include "../posix/shared/ctrlssdl.h"
 #include <locale>
@@ -562,6 +563,12 @@
 	WAV_End();
 }
 
+EXPORTED void desmume_set_fat_directory(const char* directory)
+{
+	slot1_SetFatDir(directory);
+	slot1_Change(NDS_SLOT1_R4);
+}
+
 EXPORTED BOOL desmume_insert_expansion_pak(void)
 {
 	return slot2_Change(NDS_SLOT2_EXPMEMORY);
diff --git a/desmume/src/frontend/interface/interface.h b/desmume/src/frontend/interface/interface.h
--- a/desmume/src/frontend/interface/interface.h
+++ b/desmume/src/frontend/interface/interface.h
@@ -194,6 +194,9 @@
 // Records the sound to a WAV file until the recording ends
 EXPORTED BOOL desmume_wav_begin(const char *file_name);
 EXPORTED void desmume_wav_end(void);
+
+// Selects an R4 card backed by a directory, before loading the ROM
+EXPORTED void desmume_set_fat_directory(const char* directory);
 
 // Puts the Memory Expansion Pak of the DS Browser in the GBA slot
 EXPORTED BOOL desmume_insert_expansion_pak(void);
