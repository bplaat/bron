diff --git a/libogc/system.c b/libogc/system.c
index 8164bc4..eb1b594 100644
--- a/libogc/system.c
+++ b/libogc/system.c
@@ -1104,9 +1104,22 @@ void SYS_PreMain(void)
 // The main thread runs this, libogc's crt0 has set up the system
 extern int main(int argc, char **argv);
 
+typedef void (*init_function)(void);
+extern init_function __init_array_start[], __init_array_end[];
+extern init_function __fini_array_start[], __fini_array_end[];
+
+static void __run_fini_array(void)
+{
+	for (init_function* fn = __fini_array_end; fn != __fini_array_start; )
+		(*--fn)();
+}
+
 void __crtmain(void)
 {
 	SYS_PreMain();
+	atexit(__run_fini_array);
+	for (init_function* fn = __init_array_start; fn != __init_array_end; fn++)
+		(*fn)();
 	exit(main(__system_argv->argc, __system_argv->argv));
 }
 
