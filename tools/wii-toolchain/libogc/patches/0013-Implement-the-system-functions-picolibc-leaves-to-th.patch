 libogc/exception.c  |   5 ++
 libogc/sbrk.c       |  16 ++----
 libogc/sys_report.c | 132 +++++++++++++++-----------------------------
 libogc/system.c     |  20 ++++++-
 5 files changed, 93 insertions(+), 100 deletions(-)

diff --git a/libogc/argv.c b/libogc/argv.c
index 6dea388..588bddf 100644
--- a/libogc/argv.c
+++ b/libogc/argv.c
@@ -29,7 +29,25 @@ distribution.
 
 extern u8 __Arena1Lo[];
 extern char *__argvArena1Lo;
-void build_argv (struct __argv* argstruct );
+
+// Splits the null separated command line into argv, behind it in the arena
+void build_argv(struct __argv *argstruct)
+{
+	char **argv = (char **)(((u32)argstruct->commandLine + argstruct->length + 3) & ~3);
+	char *arg = argstruct->commandLine;
+	int argc = 0;
+
+	for (int len = argstruct->length; len > 0;) {
+		int size = strlen(arg) + 1;
+		argv[argc++] = arg;
+		arg += size;
+		len -= size;
+	}
+	argv[argc] = NULL;
+	argstruct->argc = argc;
+	argstruct->argv = argv;
+	argstruct->endARGV = &argv[argc + 1];
+}
 
 void __CheckARGV() {
 
