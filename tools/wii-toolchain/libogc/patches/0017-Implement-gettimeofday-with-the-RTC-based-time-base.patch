From: Bastiaan van der Plaat <bastiaan.v.d.plaat@gmail.com>
Date: Thu, 29 Oct 2026 14:05:00 +0100
Subject: [PATCH] Implement gettimeofday with the RTC based time base

picolibc leaves gettimeofday to the platform, without it time() fails
and the FAT driver can't give files their modification time.
---
 libogc/timesupp.c | 12 ++++++++++++
 1 file changed, 12 insertions(+)

diff --git a/libogc/timesupp.c b/libogc/timesupp.c
index 527cc26..672e13c 100644
--- a/libogc/timesupp.c
+++ b/libogc/timesupp.c
@@ -8,6 +8,7 @@
 #include "conf.h"
 
 #include <stdio.h>
+#include <sys/time.h>
 #include <time.h>
 
 #include "lwp_threads.inl"
@@ -165,3 +166,14 @@ int __libogc_nanosleep(const struct timespec *tb, struct timespec *rem)
 	__lwp_thread_dispatchenable();
 	return TB_SUCCESSFUL;
 }
+
+// The time base starts at the console's RTC time, which counts from 2000
+int gettimeofday(struct timeval *tp, void *tz)
+{
+	if (tp) {
+		u64 now = gettime();
+		tp->tv_sec = ticks_to_secs(now) + 946684800;
+		tp->tv_usec = tick_microsecs(now);
+	}
+	return 0;
+}
