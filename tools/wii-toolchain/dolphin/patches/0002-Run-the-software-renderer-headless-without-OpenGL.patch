From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Bastiaan van der Plaat <bastiaan.v.d.plaat@gmail.com>
Date: Fri, 30 Oct 2026 13:30:48 +0100
Subject: [PATCH] Run the software renderer headless without OpenGL

With a headless window system the software renderer no longer creates
an OpenGL context to show its frames, so it runs without a GPU or a
display, like for automated tests. It still renders to the EFB and
copies the XFB to emulated RAM.
---
 Source/Core/VideoBackends/Software/SWGfx.cpp  |  7 +++++--
 Source/Core/VideoBackends/Software/SWmain.cpp | 11 ++++++++---
 2 files changed, 13 insertions(+), 5 deletions(-)

diff --git a/Source/Core/VideoBackends/Software/SWGfx.cpp b/Source/Core/VideoBackends/Software/SWGfx.cpp
index 7004c50..f5e799e 100644
--- a/Source/Core/VideoBackends/Software/SWGfx.cpp
+++ b/Source/Core/VideoBackends/Software/SWGfx.cpp
@@ -26,7 +26,7 @@ SWGfx::~SWGfx() = default;
 
 bool SWGfx::IsHeadless() const
 {
-  return m_window->IsHeadless();
+  return !m_window || m_window->IsHeadless();
 }
 
 bool SWGfx::SupportsUtilityDrawing() const
@@ -58,7 +58,7 @@ SWGfx::CreateFramebuffer(AbstractTexture* color_attachment, AbstractTexture* dep
 bool SWGfx::BindBackbuffer(const ClearColor& clear_color)
 {
   // Look for framebuffer resizes
-  if (!g_presenter->SurfaceResizedTestAndClear())
+  if (!m_window || !g_presenter->SurfaceResizedTestAndClear())
     return true;
 
   GLContext* context = m_window->GetContext();
@@ -137,6 +137,9 @@ void SWGfx::SetScissorRect(const MathUtil::Rectangle<int>& rc)
 
 SurfaceInfo SWGfx::GetSurfaceInfo() const
 {
+  if (!m_window)
+    return {1, 1, 1.0f, AbstractTextureFormat::RGBA8};
+
   GLContext* context = m_window->GetContext();
   return {std::max(context->GetBackBufferWidth(), 1u), std::max(context->GetBackBufferHeight(), 1u),
           1.0f, AbstractTextureFormat::RGBA8};
diff --git a/Source/Core/VideoBackends/Software/SWmain.cpp b/Source/Core/VideoBackends/Software/SWmain.cpp
index 66c96f5..40dcfaf 100644
--- a/Source/Core/VideoBackends/Software/SWmain.cpp
+++ b/Source/Core/VideoBackends/Software/SWmain.cpp
@@ -91,9 +91,14 @@ void VideoSoftware::InitBackendInfo(const WindowSystemInfo& wsi)
 
 bool VideoSoftware::Initialize(const WindowSystemInfo& wsi)
 {
-  std::unique_ptr<SWOGLWindow> window = SWOGLWindow::Create(wsi);
-  if (!window)
-    return false;
+  // Without a window the renderer runs headless, without OpenGL to show the frames
+  std::unique_ptr<SWOGLWindow> window;
+  if (wsi.type != WindowSystemType::Headless)
+  {
+    window = SWOGLWindow::Create(wsi);
+    if (!window)
+      return false;
+  }
 
   Clipper::Init();
   Rasterizer::Init();
