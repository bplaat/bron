From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Bastiaan van der Plaat <bastiaan.v.d.plaat@gmail.com>
Date: Fri, 30 Oct 2026 13:34:54 +0100
Subject: [PATCH] Let frontends wait for saved states to be written

Saved states are compressed and written by a worker thread, so a
frontend that uses the file right after saving, like a test runner,
can now wait until they are written.
---
 Source/Core/Core/State.cpp | 5 +++++
 Source/Core/Core/State.h   | 3 +++
 2 files changed, 8 insertions(+)

diff --git a/Source/Core/Core/State.cpp b/Source/Core/Core/State.cpp
index 2dcd2ca..13e1f4c 100644
--- a/Source/Core/Core/State.cpp
+++ b/Source/Core/Core/State.cpp
@@ -504,6 +504,11 @@ void SaveAs(Core::System& system, std::string filename)
       });
 }
 
+void WaitForSavesWritten()
+{
+  s_compress_and_dump_thread.WaitForCompletion();
+}
+
 static bool GetVersionFromLZO(StateHeader& header, File::IOFile& f)
 {
   // Just read the first block, since it will contain the full revision string
diff --git a/Source/Core/Core/State.h b/Source/Core/Core/State.h
index cd35ea1..674b6ef 100644
--- a/Source/Core/Core/State.h
+++ b/Source/Core/Core/State.h
@@ -98,6 +98,9 @@ void Load(Core::System& system, u32 slot);
 void SaveAs(Core::System& system, std::string filename);
 void LoadAs(Core::System& system, std::string filename);
 
+// Waits until the states that are being saved are written to their files
+void WaitForSavesWritten();
+
 void LoadLastSaved(Core::System& system, int i = 1);
 void SaveFirstSaved(Core::System& system);
 void UndoSaveState(Core::System& system);
