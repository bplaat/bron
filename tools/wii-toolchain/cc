#!/bin/sh
set -eu
dir=$(cd "$(dirname "$0")" && pwd)

# Apple's clang can't target PowerPC, so prefer Homebrew's LLVM like build.sh
llvm=''
for bin in /opt/homebrew/opt/llvm/bin/ /usr/local/opt/llvm/bin/; do
    [ -d "$bin" ] && llvm="$bin" && break
done

"$dir/build.sh" >&2
exec "${llvm}clang" --target=powerpc-none-eabi -mcpu=750 -ffreestanding -nostdlibinc \
    -ffunction-sections -fdata-sections -DGEKKO -DHW_RVL -D_DEFAULT_SOURCE -Os \
    -I"$dir/../../target/wii-toolchain/sysroot/include" "$@"
