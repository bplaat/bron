index c23032d..15fa392 100644
--- a/libc/machine/powerpc/meson.build
+++ b/libc/machine/powerpc/meson.build
@@ -40,6 +40,9 @@ srcs_machine = [
 #  'atoufix32.c',
 #  'atoufix64.c',
   'hwcap.c',
+  'memcpy.c',
+  'memmove.c',
+  'memset.c',
   'setjmp.S',
   'tls.c',
 #  'strtosfix16.c',
