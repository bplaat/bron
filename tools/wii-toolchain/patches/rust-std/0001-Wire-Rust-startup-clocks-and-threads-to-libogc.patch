diff --git a/library/std/src/sys/args/wii.rs b/library/std/src/sys/args/wii.rs
new file mode 100644
index 0000000..e7f945d
--- /dev/null
+++ b/library/std/src/sys/args/wii.rs
@@ -0,0 +1,30 @@
+pub use super::common::Args;
+use crate::ffi::{CStr, OsString};
+use crate::ptr;
+use crate::sync::atomic::{AtomicIsize, AtomicPtr, Ordering};
+
+static ARGC: AtomicIsize = AtomicIsize::new(0);
+static ARGV: AtomicPtr<*const u8> = AtomicPtr::new(ptr::null_mut());
+
+pub unsafe fn init(argc: isize, argv: *const *const u8) {
+    ARGC.store(argc, Ordering::Relaxed);
+    ARGV.store(argv.cast_mut(), Ordering::Release);
+}
+
+pub fn args() -> Args {
+    let argv = ARGV.load(Ordering::Acquire);
+    if argv.is_null() {
+        return Args::new(Vec::new());
+    }
+    let mut args = Vec::new();
+    for i in 0..ARGC.load(Ordering::Relaxed) {
+        let arg = unsafe { argv.offset(i).read() };
+        if arg.is_null() {
+            break;
+        }
+        let bytes = unsafe { CStr::from_ptr(arg.cast()) }.to_bytes();
+        // On Wii, OsString uses the same byte representation as the loader.
+        args.push(unsafe { OsString::from_encoded_bytes_unchecked(bytes.to_vec()) });
+    }
+    Args::new(args)
+}
