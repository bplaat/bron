diff --git a/library/std/src/sys/thread/wii.rs b/library/std/src/sys/thread/wii.rs
new file mode 100644
index 0000000..d3608dc
--- /dev/null
+++ b/library/std/src/sys/thread/wii.rs
@@ -0,0 +1,99 @@
+use crate::ffi::{CStr, c_void};
+use crate::num::NonZero;
+use crate::sync::Arc;
+use crate::sync::atomic::{AtomicU32, Ordering};
+use crate::sys::ffi::{Timespec, nanosleep};
+use crate::sys::sync::futex::{futex_wait, futex_wake};
+use crate::thread::ThreadInit;
+use crate::time::{Duration, Instant};
+use crate::{io, ptr};
+
+unsafe extern "C" {
+    fn LWP_CreateThread(
+        handle: *mut u32,
+        entry: extern "C" fn(*mut c_void) -> *mut c_void,
+        arg: *mut c_void,
+        stack: *mut c_void,
+        stack_size: u32,
+        priority: u8,
+    ) -> i32;
+    fn LWP_GetSelf() -> u32;
+    fn LWP_YieldThread();
+}
+
+pub const DEFAULT_MIN_STACK_SIZE: usize = 32 * 1024;
+
+pub struct Thread(Arc<AtomicU32>);
+
+impl Thread {
+    pub unsafe fn new(stack: usize, init: Box<ThreadInit>) -> io::Result<Self> {
+        let stack = u32::try_from(stack.max(DEFAULT_MIN_STACK_SIZE))
+            .ok()
+            .and_then(|n| n.checked_add(31).map(|n| n & !31))
+            .ok_or(io::Error::from(io::ErrorKind::InvalidInput))?;
+        let done = Arc::new(AtomicU32::new(0));
+        let data = Box::into_raw(Box::new((init, done.clone())));
+        let mut handle = 0;
+        // LWP owns the stack and releases it when the entry point returns. Its handle can
+        // be reused immediately, so each Rust JoinHandle keeps its own completion word.
+        let result = unsafe {
+            LWP_CreateThread(&mut handle, entry, data.cast(), ptr::null_mut(), stack, 64)
+        };
+        if result != 0 {
+            unsafe { drop(Box::from_raw(data)) };
+            return Err(io::Error::from(io::ErrorKind::WouldBlock));
+        }
+        Ok(Self(done))
+    }
+
+    pub fn join(self) {
+        while self.0.load(Ordering::Acquire) == 0 {
+            futex_wait(&self.0, 0, None);
+        }
+    }
+}
+
+extern "C" fn entry(data: *mut c_void) -> *mut c_void {
+    let (init, done) = *unsafe { Box::<(Box<ThreadInit>, Arc<AtomicU32>)>::from_raw(data.cast()) };
+    (init.init())();
+    crate::sys::thread_local::key::run_dtors();
+    done.store(1, Ordering::Release);
+    futex_wake(&done);
+    ptr::null_mut()
+}
+
+pub fn available_parallelism() -> io::Result<NonZero<usize>> {
+    Ok(NonZero::<usize>::MIN)
+}
+
+pub fn current_os_id() -> Option<u64> {
+    Some(unsafe { LWP_GetSelf() } as u64)
+}
+
+pub fn set_name(_name: &CStr) {}
+
+pub fn yield_now() {
+    unsafe { LWP_YieldThread() }
+}
+
+pub fn sleep(duration: Duration) {
+    if duration.is_zero() {
+        return;
+    }
+    let start = Instant::now();
+    let mut remaining = duration;
+    loop {
+        let nanos = i64::try_from(remaining.as_nanos())
+            .unwrap_or(i64::MAX)
+            .max(1000);
+        let time = Timespec {
+            sec: nanos / 1_000_000_000,
+            nsec: (nanos % 1_000_000_000) as i32,
+        };
+        unsafe { nanosleep(&time, crate::ptr::null_mut()) };
+        remaining = duration.saturating_sub(start.elapsed());
+        if remaining.is_zero() {
+            break;
+        }
+    }
+}
diff --git a/library/std/src/sys/thread_local/key/wii.rs b/library/std/src/sys/thread_local/key/wii.rs
new file mode 100644
index 0000000..66d396b
--- /dev/null
+++ b/library/std/src/sys/thread_local/key/wii.rs
@@ -0,0 +1,87 @@
+use crate::alloc::System;
+use crate::ptr;
+
+type Dtor = unsafe extern "C" fn(*mut u8);
+struct Entry {
+    key: Key,
+    value: *mut u8,
+}
+type Table = Vec<Entry, System>;
+
+pub type Key = usize;
+
+unsafe extern "C" {
+    fn __wii_lwp_tls_get() -> *mut Table;
+    fn __wii_lwp_tls_set(table: *mut Table, cleanup: Option<extern "C" fn()>);
+}
+
+pub fn create(dtor: Option<Dtor>) -> Key {
+    Box::into_raw_with_allocator(Box::new_in(dtor, System))
+        .0
+        .expose_provenance()
+}
+
+pub unsafe fn destroy(key: Key) {
+    unsafe {
+        drop(Box::from_raw_in(
+            ptr::with_exposed_provenance_mut::<Option<Dtor>>(key),
+            System,
+        ))
+    }
+}
+
+pub unsafe fn get(key: Key) -> *mut u8 {
+    let table = unsafe { __wii_lwp_tls_get().as_ref() };
+    table
+        .and_then(|table| table.iter().find(|entry| entry.key == key))
+        .map_or(ptr::null_mut(), |entry| entry.value)
+}
+
+pub unsafe fn set(key: Key, value: *mut u8) {
+    unsafe {
+        let mut table = __wii_lwp_tls_get();
+        if table.is_null() {
+            if value.is_null() {
+                return;
+            }
+            table = Box::into_raw_with_allocator(Box::new_in(Vec::new_in(System), System)).0;
+            __wii_lwp_tls_set(table, Some(run_dtors));
+        }
+        if let Some(entry) = (*table).iter_mut().find(|entry| entry.key == key) {
+            entry.value = value;
+        } else if !value.is_null() {
+            (*table).push(Entry { key, value });
+        }
+    }
+}
+
+// Use raw pointers into the current thread's table only between callbacks.
+// A destructor can access TLS, grow the table, or repopulate a cleared entry.
+pub(crate) extern "C" fn run_dtors() {
+    let table = unsafe { __wii_lwp_tls_get() };
+    if table.is_null() {
+        return;
+    }
+    for _ in 0..4 {
+        let len = unsafe { (*table).len() };
+        let mut ran = false;
+        for i in 0..len {
+            let entry = unsafe { &mut (&mut *table)[i] };
+            let dtor = unsafe { *ptr::with_exposed_provenance::<Option<Dtor>>(entry.key) };
+            if let Some(dtor) = dtor
+                && !entry.value.is_null()
+            {
+                let value = crate::mem::replace(&mut entry.value, ptr::null_mut());
+                unsafe { dtor(value) };
+                ran = true;
+            }
+        }
+        if !ran {
+            break;
+        }
+    }
+    unsafe {
+        __wii_lwp_tls_set(ptr::null_mut(), None);
+        drop(Box::from_raw_in(table, System));
+    }
+}
