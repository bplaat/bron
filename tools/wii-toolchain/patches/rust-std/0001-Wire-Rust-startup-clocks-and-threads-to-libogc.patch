+// ABI from the PowerPC picolibc headers.
+use crate::ffi::{c_char, c_long, c_void};
+
+#[repr(C)]
+#[derive(Default)]
+pub(crate) struct Timespec {
+    pub sec: i64,
+    pub nsec: c_long,
+}
+
+#[repr(C)]
+#[derive(Default)]
+pub(crate) struct Stat {
+    dev: u64,
+    ino: u64,
+    pub mode: u32,
+    links: u64,
+    uid: u32,
+    gid: u32,
+    rdev: u64,
+    pub size: i64,
+    block_size: i32,
+    blocks: i64,
+    atime: Timespec,
+    pub mtime: Timespec,
+    ctime: Timespec,
+}
+
+#[repr(C)]
+pub(crate) struct Dirent {
+    ino: u64,
+    pub kind: u8,
+    pub name: [c_char; 256],
+}
+
+pub(crate) const O_RDONLY: i32 = 0;
+pub(crate) const O_WRONLY: i32 = 1;
+pub(crate) const O_RDWR: i32 = 2;
+pub(crate) const O_CREAT: i32 = 0x40;
+pub(crate) const O_TRUNC: i32 = 0x200;
+pub(crate) const O_APPEND: i32 = 0x400;
+pub(crate) const O_EXCL: i32 = 0x800;
+pub(crate) const DT_DIR: u8 = 3;
+pub(crate) const DT_REG: u8 = 6;
+
+unsafe extern "C" {
+    pub(crate) fn __errno() -> *mut i32;
+    pub(crate) fn open(path: *const c_char, flags: i32, ...) -> i32;
+    pub(crate) fn stat(path: *const c_char, output: *mut Stat) -> i32;
+    pub(crate) fn fstat(fd: i32, output: *mut Stat) -> i32;
+    pub(crate) fn readdir(dir: *mut c_void) -> *const Dirent;
+    pub(crate) fn realpath(path: *const c_char, output: *mut c_char) -> *mut c_char;
+    pub(crate) fn nanosleep(request: *const Timespec, remaining: *mut Timespec) -> i32;
+}
