+#[path = "../unsupported/common.rs"]
+#[allow(dead_code)]
+mod unsupported_common;
+
+pub use unsupported_common::{unsupported, unsupported_err};
+
+unsafe extern "C" {
+    fn wiiMountSd(fat32_only: i32) -> i32;
+    #[link_name = "exit"]
+    pub(crate) fn wii_exit(code: i32) -> !;
+    fn _exit(code: i32) -> !;
+}
+
+pub unsafe fn init(argc: isize, argv: *const *const u8, _sigpipe: u8) {
+    unsafe {
+        crate::sys::sync::futex::init();
+        crate::sys::args::init(argc, argv);
+        wiiMountSd(0);
+    }
+}
+
+pub unsafe fn cleanup() {
+    crate::sys::thread_local::key::run_dtors();
+}
+
+pub fn abort_internal() -> ! {
+    unsafe { _exit(134) }
+}
+
+pub(crate) fn wii_fs_lock() -> crate::sync::MutexGuard<'static, ()> {
+    static FS_LOCK: crate::sync::Mutex<()> = crate::sync::Mutex::new(());
+    FS_LOCK
+        .lock()
+        .unwrap_or_else(crate::sync::PoisonError::into_inner)
+}
+
+pub(crate) mod ffi;
