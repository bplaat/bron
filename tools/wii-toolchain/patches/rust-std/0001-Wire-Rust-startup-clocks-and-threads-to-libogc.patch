--- /dev/null
+++ b/library/std/src/sys/alloc/wii.rs
@@ -0,0 +1,35 @@
+use super::{MIN_ALIGN, realloc_fallback};
+use crate::alloc::Layout;
+
+unsafe extern "C" {
+    fn malloc(size: usize) -> *mut u8;
+    fn memalign(align: usize, size: usize) -> *mut u8;
+    #[link_name = "realloc"]
+    fn realloc_c(ptr: *mut u8, size: usize) -> *mut u8;
+    fn free(ptr: *mut u8);
+}
+
+#[inline]
+pub unsafe fn alloc(layout: Layout) -> *mut u8 {
+    if layout.align() <= MIN_ALIGN && layout.align() <= layout.size() {
+        unsafe { malloc(layout.size()) }
+    } else {
+        unsafe { memalign(layout.align(), layout.size()) }
+    }
+}
+
+#[inline]
+pub unsafe fn dealloc(ptr: *mut u8, _layout: Layout) {
+    unsafe { free(ptr) }
+}
+
+#[inline]
+pub unsafe fn realloc(ptr: *mut u8, layout: Layout, new_size: usize) -> *mut u8 {
+    unsafe {
+        if layout.align() <= MIN_ALIGN && layout.align() <= new_size {
+            realloc_c(ptr, new_size)
+        } else {
+            realloc_fallback(ptr, layout, new_size)
+        }
+    }
+}
