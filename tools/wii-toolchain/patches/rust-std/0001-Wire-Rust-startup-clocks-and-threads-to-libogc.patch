+pub type SmallFutex = AtomicU32;
+pub type Primitive = u32;
+pub type SmallPrimitive = u32;
+
+struct Waiter {
+    next: *mut Waiter,
+    address: *const Futex,
+    notified: bool,
+}
+
+struct Queue {
+    lock: UnsafeCell<NativeMutex>,
+    cond: UnsafeCell<u32>,
+    head: UnsafeCell<*mut Waiter>,
+}
+
+// The native mutex protects the list and the linked stack waiters.
+unsafe impl Sync for Queue {}
+
+static QUEUE: Queue = Queue {
+    lock: UnsafeCell::new(0),
+    cond: UnsafeCell::new(0),
+    head: UnsafeCell::new(ptr::null_mut()),
+};
+
+use crate::sys::ffi::Timespec;
+use crate::time::Instant;
+
+type NativeMutex = u32;
+
+unsafe extern "C" {
+    fn LWP_MutexInit(mutex: *mut NativeMutex, recursive: bool) -> i32;
+    fn LWP_MutexLock(mutex: NativeMutex) -> i32;
+    fn LWP_MutexUnlock(mutex: NativeMutex) -> i32;
+    fn LWP_CondInit(cond: *mut u32) -> i32;
+    fn LWP_CondWait(cond: u32, mutex: NativeMutex) -> i32;
+    fn LWP_CondTimedWait(cond: u32, mutex: NativeMutex, remaining: *const Timespec) -> i32;
+    fn LWP_CondBroadcast(cond: u32) -> i32;
+}
+
+pub(crate) unsafe fn init() {
+    if unsafe { LWP_MutexInit(QUEUE.lock.get(), false) } != 0
+        || unsafe { LWP_CondInit(QUEUE.cond.get()) } != 0
+    {
+        crate::process::abort();
+    }
+}
+
+fn check(result: i32) {
+    if result != 0 {
+        crate::process::abort();
+    }
+}
+
+struct Locked;
+impl Locked {
+    fn new() -> Self {
+        check(unsafe { LWP_MutexLock(*QUEUE.lock.get()) });
+        Self
+    }
+}
+
+impl Drop for Locked {
+    fn drop(&mut self) {
+        check(unsafe { LWP_MutexUnlock(*QUEUE.lock.get()) });
+    }
+}
+
+pub fn futex_wait(futex: &Futex, expected: Primitive, timeout: Option<Duration>) -> bool {
+    let start = timeout.map(|_| Instant::now());
+    let lock = Locked::new();
+    if futex.load(Ordering::Relaxed) != expected {
+        return true;
+    }
+
+    let mut waiter = Waiter {
+        next: unsafe { *QUEUE.head.get() },
+        address: futex,
+        notified: false,
+    };
+    let waiter = &raw mut waiter;
+    unsafe { *QUEUE.head.get() = waiter };
+    let (cond, mutex) = unsafe { (*QUEUE.cond.get(), *QUEUE.lock.get()) };
+    while !unsafe { (*waiter).notified } {
+        match timeout.zip(start) {
+            None => check(unsafe { LWP_CondWait(cond, mutex) }),
+            Some((timeout, start)) => {
+                let remaining = timeout.saturating_sub(start.elapsed());
+                if remaining.is_zero() {
+                    break;
+                }
+                // LWP uses a relative timeout and interprets zero ticks as an unbounded wait.
+                let remaining = remaining.max(Duration::from_micros(1));
+                let time = Timespec {
+                    sec: remaining.as_secs().min(i64::MAX as u64) as i64,
+                    nsec: remaining.subsec_nanos() as i32,
+                };
+                let status = unsafe { LWP_CondTimedWait(cond, mutex, &time) };
+                if status != 116 {
+                    // ETIMEDOUT
+                    check(status);
+                }
+            }
+        }
+    }
+    let _lock = lock;
+    // Remove the stack waiter before releasing the lock or returning.
+    unsafe {
+        let mut link = QUEUE.head.get();
+        while *link != waiter {
+            link = &raw mut (**link).next;
+        }
+        *link = (*waiter).next;
+        (*waiter).notified
+    }
+}
+
+fn wake(futex: &Futex, all: bool) -> bool {
+    let _lock = Locked::new();
+    let mut found = false;
+    let mut waiter = unsafe { *QUEUE.head.get() };
+    while !waiter.is_null() {
+        unsafe {
+            if ptr::eq((*waiter).address, futex) && !(*waiter).notified {
+                (*waiter).notified = true;
+                found = true;
+                if !all {
+                    break;
+                }
+            }
+            waiter = (*waiter).next;
+        }
+    }
+    if found {
+        check(unsafe { LWP_CondBroadcast(*QUEUE.cond.get()) });
+    }
+    found
+}
+
+pub fn futex_wake(futex: &Futex) -> bool {
+    wake(futex, false)
+}
+
+pub fn futex_wake_all(futex: &Futex) {
+    wake(futex, true);
+}
