; Answer file for the unattended Windows XP install, {{PRODUCT_KEY}} is filled in by install.mjs
[Data]
AutoPartition=1
MsDosInitiated="0"
UnattendedInstall="Yes"
AutomaticUpdates=No

[Unattended]
UnattendMode=FullUnattended
UnattendSwitch=Yes
OemSkipEula=Yes
OemPreinstall=No
ComputerType="Standard PC", Retail
TargetPath=\WINDOWS
Repartition=No
FileSystem=LeaveAlone
WaitForReboot=No
DriverSigningPolicy=Ignore
NonDriverSigningPolicy=Ignore
Hibernation=No

[SystemFileProtection]
SFCQuota=0

[GuiUnattended]
AdminPassword=*
EncryptedAdminPassword=No
AutoLogon=Yes
AutoLogonCount=9
OEMSkipRegional=1
OemSkipWelcome=1
TimeZone=110

[UserData]
ProductKey="{{PRODUCT_KEY}}"
FullName="Bastiaan"
OrgName=""
ComputerName=WINXP

[RegionalSettings]
LanguageGroup=1
SystemLocale=00000409
UserLocale=00000409
InputLocale=0409:00000409

[Identification]
JoinWorkgroup=WORKGROUP

[Networking]
InstallDefaultComponents=Yes

[TerminalServices]
AllowConnections=0

[PCHealth]
ER_Display_UI=0
ER_Enable_Reporting=0
RA_AllowToGetHelp=0

[Components]
msmsgs=Off
msnexplr=Off
zonegames=Off
AutoUpdate=Off

[Shell]
DefaultStartPanelOff=No
DefaultThemesOff=No

[Display]
BitsPerPel=32
Xresolution=1024
YResolution=768
Vrefresh=60

[GuiRunOnce]
Command0="cmd /c echo WINXP_SETUP_COMPLETE > COM1"
Command1="shutdown -s -f -t 0"
