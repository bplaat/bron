<?xml version="1.0" encoding="UTF-8" ?>
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
    <mime-type type="image/qoi">
        <comment>QOI image</comment>
        <sub-class-of type="application/octet-stream" />
        <magic priority="50">
            <match type="string" value="qoif" offset="0" />
        </magic>
        <glob pattern="*.qoi" />
    </mime-type>
    <mime-type type="image/tinyvg">
        <comment>TinyVG image</comment>
        <sub-class-of type="application/octet-stream" />
        <magic priority="50">
            <match type="string" value="rV" offset="0" />
        </magic>
        <glob pattern="*.tvg" />
    </mime-type>
</mime-info>
