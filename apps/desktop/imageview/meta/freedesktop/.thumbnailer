[Thumbnailer Entry]
TryExec=$BIN_DIR/ImageView
Exec="$BIN_DIR/ImageView" --thumbnail -s %s %u %o
MimeType=image/apng;image/bmp;image/gif;image/jp2;image/jpeg;image/png;image/qoi;image/svg+xml;image/svg+xml-compressed;image/tinyvg;image/vnd.microsoft.icon;image/webp;image/x-icns;image/x-jp2-codestream;image/x-tga;
