<?xml version="1.0" encoding="utf-8" ?>
<Grid
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent"
>
    <Grid.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <StaticResource x:Key="ButtonBackground" ResourceKey="SubtleFillColorTransparentBrush" />
                    <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="SubtleFillColorSecondaryBrush" />
                    <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="SubtleFillColorTertiaryBrush" />
                    <StaticResource x:Key="ButtonBorderBrush" ResourceKey="SubtleFillColorTransparentBrush" />
                    <StaticResource
                        x:Key="ButtonBorderBrushPointerOver"
                        ResourceKey="SubtleFillColorTransparentBrush"
                    />
                    <StaticResource x:Key="ButtonBorderBrushPressed" ResourceKey="SubtleFillColorTransparentBrush" />
                    <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="TextFillColorSecondaryBrush" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <StaticResource x:Key="ButtonBackground" ResourceKey="SubtleFillColorTransparentBrush" />
                    <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="SubtleFillColorSecondaryBrush" />
                    <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="SubtleFillColorTertiaryBrush" />
                    <StaticResource x:Key="ButtonBorderBrush" ResourceKey="SubtleFillColorTransparentBrush" />
                    <StaticResource
                        x:Key="ButtonBorderBrushPointerOver"
                        ResourceKey="SubtleFillColorTransparentBrush"
                    />
                    <StaticResource x:Key="ButtonBorderBrushPressed" ResourceKey="SubtleFillColorTransparentBrush" />
                    <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="TextFillColorSecondaryBrush" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Width" Value="40" />
                <Setter Property="Height" Value="32" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="AllowFocusOnInteraction" Value="False" />
            </Style>
            <Style TargetType="FontIcon">
                <Setter Property="FontSize" Value="16" />
            </Style>
        </ResourceDictionary>
    </Grid.Resources>
    <Grid.RowDefinitions>
        <RowDefinition Height="48" />
        <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Grid x:Name="Header" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Border
            x:Name="Background"
            Grid.ColumnSpan="4"
            Visibility="Collapsed"
            Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
        />

        <Image x:Name="Icon" Width="16" Height="16" Margin="16,0,12,0" />

        <StackPanel x:Name="Start" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="Previous" ToolTipService.ToolTip="Previous image (Left)">
                <FontIcon Glyph="&#xE72B;" />
            </Button>
            <Button x:Name="Next" ToolTipService.ToolTip="Next image (Right)">
                <FontIcon Glyph="&#xE72A;" />
            </Button>
        </StackPanel>

        <StackPanel
            x:Name="Heading"
            Grid.Column="2"
            Margin="12,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
        >
            <TextBlock
                x:Name="Title"
                HorizontalAlignment="Center"
                TextWrapping="NoWrap"
                TextTrimming="CharacterEllipsis"
                FontWeight="SemiBold"
                Style="{StaticResource CaptionTextBlockStyle}"
            />
            <TextBlock
                x:Name="Subtitle"
                HorizontalAlignment="Center"
                FontSize="11"
                TextWrapping="NoWrap"
                TextTrimming="CharacterEllipsis"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
            />
        </StackPanel>

        <Border
            x:Name="End"
            Grid.Column="3"
            VerticalAlignment="Center"
            CornerRadius="4"
            BorderThickness="1"
            Background="{ThemeResource ControlFillColorDefaultBrush}"
            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
        >
            <StackPanel Orientation="Horizontal">
                <Button
                    x:Name="ZoomOut"
                    Width="36"
                    Height="30"
                    CornerRadius="3,0,0,3"
                    ToolTipService.ToolTip="Zoom out (Ctrl+-)"
                >
                    <FontIcon Glyph="&#xE738;" FontSize="12" />
                </Button>
                <Button
                    x:Name="ResetZoom"
                    Width="56"
                    Height="30"
                    CornerRadius="0"
                    BorderThickness="1,0"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    ToolTipService.ToolTip="Reset zoom (Ctrl+9)"
                >
                    <TextBlock x:Name="Zoom" Style="{StaticResource CaptionTextBlockStyle}" />
                </Button>
                <Button
                    x:Name="ZoomIn"
                    Width="36"
                    Height="30"
                    CornerRadius="0,3,3,0"
                    ToolTipService.ToolTip="Zoom in (Ctrl+=)"
                >
                    <FontIcon Glyph="&#xE710;" FontSize="12" />
                </Button>
            </StackPanel>
        </Border>
    </Grid>

    <Grid Grid.Row="1">
        <Image x:Name="Checkerboard" Stretch="Fill" HorizontalAlignment="Center" VerticalAlignment="Center" />
        <ScrollViewer
            x:Name="Scroller"
            ZoomMode="Enabled"
            IsTabStop="True"
            MinZoomFactor="{MIN_ZOOM}"
            MaxZoomFactor="{MAX_ZOOM}"
            HorizontalScrollMode="Auto"
            VerticalScrollMode="Auto"
            HorizontalScrollBarVisibility="Auto"
            VerticalScrollBarVisibility="Auto"
        >
            <Image x:Name="Media" Stretch="Fill" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </ScrollViewer>
    </Grid>
</Grid>
