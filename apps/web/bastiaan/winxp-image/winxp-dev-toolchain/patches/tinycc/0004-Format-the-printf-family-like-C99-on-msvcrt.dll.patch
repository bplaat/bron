From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Bastiaan van der Plaat <bastiaan.v.d.plaat@gmail.com>
Date: Sat, 28 Nov 2026 10:31:56 +0100
Subject: [PATCH] Format the printf family like C99 on msvcrt.dll

The msvcrt.dll of Windows XP reads %lld as 32 bits, doesn't know %hhd,
%jd, %zu and %td, and its _snprintf neither terminates nor counts a
truncated result. stdio.h maps printf, fprintf, sprintf, snprintf and
their v forms to a formatter in libtcc1 that leaves floating point and
wide characters to msvcrt. __TCC_MSVCRT_PRINTF keeps msvcrt's own.
---
 lib/Makefile          |   2 +-
 tcc.h                 |   2 +
 win32/include/stdio.h |  29 ++++
 win32/lib/stdio99.c   | 361 ++++++++++++++++++++++++++++++++++++++++++
 4 files changed, 393 insertions(+), 1 deletion(-)
 create mode 100644 win32/lib/stdio99.c

diff --git a/lib/Makefile b/lib/Makefile
index e70803c..3ccef09 100644
--- a/lib/Makefile
+++ b/lib/Makefile
@@ -41,7 +41,7 @@ ARM_O = libtcc1.o armeabi.o armflush.o $(COMMON_O)
 ARM64_O = lib-arm64.o $(COMMON_O)
 RISCV64_O = lib-arm64.o $(COMMON_O)
 COMMON_O = stdatomic.o atomic.o builtin.o alloca.o alloca-bt.o
-WIN_O = crt1.o crt1w.o wincrt1.o wincrt1w.o dllcrt1.o dllmain.o winex.o
+WIN_O = crt1.o crt1w.o wincrt1.o wincrt1w.o dllcrt1.o dllmain.o winex.o stdio99.o
 LIN_O = dsohandle.o
 OSX_O =
 
diff --git a/tcc.h b/tcc.h
index c73eed8..799e579 100644
--- a/tcc.h
+++ b/tcc.h
@@ -63,6 +63,8 @@ extern long double strtold (const char *__nptr, char **__endptr);
 #  include <stdint.h>
 # endif
 # define inline __inline
+# undef snprintf
+# undef vsnprintf
 # define snprintf _snprintf
 # define vsnprintf _vsnprintf
 # ifndef __GNUC__
diff --git a/win32/include/stdio.h b/win32/include/stdio.h
index da88793..1b4cc76 100644
--- a/win32/include/stdio.h
+++ b/win32/include/stdio.h
@@ -275,6 +275,35 @@ extern FILE (*_imp___iob)[];    /* A pointer to an array of FILE */
 # define snprintf __mingw_snprintf
 # endif
 # endif
+/* C99 formatting: msvcrt.dll doesn't know %lld, %hhd, %jd or %zu and its
+   _snprintf neither terminates nor counts a truncated result, the printf
+   family of libtcc1 does. Define __TCC_MSVCRT_PRINTF for msvcrt's own. */
+#ifndef __TCC_MSVCRT_PRINTF
+  int __cdecl __tcc_printf(const char *_Format,...);
+  int __cdecl __tcc_vprintf(const char *_Format,va_list _ArgList);
+  int __cdecl __tcc_fprintf(FILE *_File,const char *_Format,...);
+  int __cdecl __tcc_vfprintf(FILE *_File,const char *_Format,va_list _ArgList);
+  int __cdecl __tcc_sprintf(char *_Dest,const char *_Format,...);
+  int __cdecl __tcc_vsprintf(char *_Dest,const char *_Format,va_list _Args);
+  int __cdecl __tcc_snprintf(char *_Dest,size_t _Count,const char *_Format,...);
+  int __cdecl __tcc_vsnprintf(char *_Dest,size_t _Count,const char *_Format,va_list _Args);
+# undef printf
+# undef vprintf
+# undef fprintf
+# undef vfprintf
+# undef sprintf
+# undef vsprintf
+# undef snprintf
+# undef vsnprintf
+# define printf __tcc_printf
+# define vprintf __tcc_vprintf
+# define fprintf __tcc_fprintf
+# define vfprintf __tcc_vfprintf
+# define sprintf __tcc_sprintf
+# define vsprintf __tcc_vsprintf
+# define snprintf __tcc_snprintf
+# define vsnprintf __tcc_vsnprintf
+#endif
   _CRTIMP int __cdecl _vscprintf(const char *_Format,va_list _ArgList);
   _CRTIMP int __cdecl _set_printf_count_output(int _Value);
   _CRTIMP int __cdecl _get_printf_count_output(void);
diff --git a/win32/lib/stdio99.c b/win32/lib/stdio99.c
new file mode 100644
index 0000000..f80faef
--- /dev/null
+++ b/win32/lib/stdio99.c
@@ -0,0 +1,361 @@
+/* C99 formatted output for msvcrt.dll
+
+   The msvcrt.dll of Windows XP doesn't know the ll, hh, j, z and t length
+   modifiers, and its _snprintf neither terminates nor returns the full length
+   of a truncated result. stdio.h maps the printf family to these functions,
+   which format integers, characters and strings themselves and leave floating
+   point and wide characters to msvcrt one conversion at a time. */
+
+#include <stdarg.h>
+#include <stddef.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+int __cdecl _snprintf(char *buf, size_t size, const char *format, ...);
+
+typedef struct {
+    char *buf;
+    size_t size; /* room for characters, without the terminating NUL */
+    size_t len;  /* characters the whole result has */
+} Out;
+
+static void put(Out *out, const char *s, size_t n)
+{
+    if (out->len < out->size) {
+        size_t room = out->size - out->len;
+        memcpy(out->buf + out->len, s, n < room ? n : room);
+    }
+    out->len += n;
+}
+
+static void pad(Out *out, char c, int n)
+{
+    char block[16];
+    memset(block, c, sizeof block);
+    for (; n > 0; n -= sizeof block)
+        put(out, block, n < (int)sizeof block ? n : sizeof block);
+}
+
+/* A field of text, padded to its width */
+static void field(Out *out, const char *s, size_t n, int width, int left)
+{
+    if (!left)
+        pad(out, ' ', width - (int)n);
+    put(out, s, n);
+    if (left)
+        pad(out, ' ', width - (int)n);
+}
+
+enum { F_LEFT = 1, F_PLUS = 2, F_SPACE = 4, F_ALT = 8, F_ZERO = 16 };
+
+static void integer(Out *out, unsigned long long value, int negative, int base,
+                    int upper, int flags, int width, int precision)
+{
+    const char *digits = upper ? "0123456789ABCDEF" : "0123456789abcdef";
+    char text[24];
+    int n = 0, zeros, length;
+    const char *prefix = "";
+
+    while (value) {
+        text[sizeof text - 1 - n++] = digits[value % base];
+        value /= base;
+    }
+    zeros = precision > n ? precision - n : 0;
+    if (precision < 0 && n == 0)
+        zeros = 1;
+    if (negative)
+        prefix = "-";
+    else if (flags & F_PLUS)
+        prefix = "+";
+    else if (flags & F_SPACE)
+        prefix = " ";
+    if (flags & F_ALT) {
+        if (base == 8 && zeros == 0)
+            zeros = 1;
+        else if (base == 16 && n)
+            prefix = upper ? "0X" : "0x";
+    }
+    length = (int)strlen(prefix) + zeros + n;
+    if ((flags & F_ZERO) && !(flags & F_LEFT) && precision < 0 && width > length) {
+        zeros += width - length;
+        length = width;
+    }
+    if (!(flags & F_LEFT))
+        pad(out, ' ', width - length);
+    put(out, prefix, strlen(prefix));
+    pad(out, '0', zeros);
+    put(out, text + sizeof text - n, n);
+    if (flags & F_LEFT)
+        pad(out, ' ', width - length);
+}
+
+/* One conversion by msvcrt, for floating point and wide characters */
+static void delegate(Out *out, const char *spec, size_t spec_len, ...)
+{
+    char format[32], small[128], *text = small;
+    size_t size = sizeof small;
+    int n;
+    va_list ap;
+
+    if (spec_len >= sizeof format)
+        return;
+    memcpy(format, spec, spec_len);
+    format[spec_len] = 0;
+    for (;;) {
+        va_start(ap, spec_len);
+        n = _vsnprintf(text, size, format, ap);
+        va_end(ap);
+        if (n >= 0 && (size_t)n < size)
+            break;
+        if (text != small)
+            free(text);
+        size *= 4;
+        if (!(text = malloc(size)))
+            return;
+    }
+    put(out, text, n);
+    if (text != small)
+        free(text);
+}
+
+int __cdecl __tcc_vsnprintf(char *buf, size_t size, const char *format, va_list ap)
+{
+    Out out;
+    const char *p = format, *spec;
+    int flags, width, precision, length, base, upper;
+    long long svalue;
+    unsigned long long uvalue;
+
+    out.buf = buf;
+    out.size = size ? size - 1 : 0;
+    out.len = 0;
+    while (*p) {
+        if (*p != '%') {
+            const char *start = p;
+            while (*p && *p != '%')
+                p++;
+            put(&out, start, p - start);
+            continue;
+        }
+        spec = p++;
+        flags = 0;
+        for (;; p++) {
+            if (*p == '-') flags |= F_LEFT;
+            else if (*p == '+') flags |= F_PLUS;
+            else if (*p == ' ') flags |= F_SPACE;
+            else if (*p == '#') flags |= F_ALT;
+            else if (*p == '0') flags |= F_ZERO;
+            else break;
+        }
+        width = 0;
+        if (*p == '*') {
+            width = va_arg(ap, int), p++;
+            if (width < 0)
+                flags |= F_LEFT, width = -width;
+        } else {
+            while (*p >= '0' && *p <= '9')
+                width = width * 10 + *p++ - '0';
+        }
+        precision = -1;
+        if (*p == '.') {
+            p++;
+            precision = 0;
+            if (*p == '*') {
+                precision = va_arg(ap, int), p++;
+                if (precision < 0)
+                    precision = -1;
+            } else {
+                while (*p >= '0' && *p <= '9')
+                    precision = precision * 10 + *p++ - '0';
+            }
+        }
+        /* 'H' hh, 'h' h, 'l' l, 'q' ll, j and I64, 'L' long double,
+           z, t and I are 32 bits like int */
+        length = 0;
+        if (p[0] == 'h' && p[1] == 'h') length = 'H', p += 2;
+        else if (p[0] == 'l' && p[1] == 'l') length = 'q', p += 2;
+        else if (p[0] == 'I' && p[1] == '6' && p[2] == '4') length = 'q', p += 3;
+        else if (p[0] == 'I' && p[1] == '3' && p[2] == '2') p += 3;
+        else if (*p == 'j') length = 'q', p++;
+        else if (*p == 'z' || *p == 't' || *p == 'I') p++;
+        else if (*p == 'h' || *p == 'l' || *p == 'L') length = *p++;
+
+        base = 10, upper = 0;
+        switch (*p) {
+        case 'd':
+        case 'i':
+            if (length == 'q')
+                svalue = va_arg(ap, long long);
+            else
+                svalue = va_arg(ap, int);
+            if (length == 'H')
+                svalue = (signed char)svalue;
+            else if (length == 'h')
+                svalue = (short)svalue;
+            uvalue = svalue < 0 ? -(unsigned long long)svalue : (unsigned long long)svalue;
+            integer(&out, uvalue, svalue < 0, 10, 0, flags, width, precision);
+            break;
+        case 'X':
+            upper = 1;
+            /* fall through */
+        case 'x':
+            base = 16;
+            goto unsigned_value;
+        case 'o':
+            base = 8;
+            /* fall through */
+        case 'u':
+        unsigned_value:
+            if (length == 'q')
+                uvalue = va_arg(ap, unsigned long long);
+            else
+                uvalue = va_arg(ap, unsigned int);
+            if (length == 'H')
+                uvalue = (unsigned char)uvalue;
+            else if (length == 'h')
+                uvalue = (unsigned short)uvalue;
+            integer(&out, uvalue, 0, base, upper, flags & ~(F_PLUS | F_SPACE), width, precision);
+            break;
+        case 'p':
+            /* like msvcrt: eight uppercase hexadecimal digits */
+            integer(&out, (size_t)va_arg(ap, void *), 0, 16, 1, 0, width, 8);
+            break;
+        case 'c':
+            if (length == 'l') {
+                delegate(&out, spec, p + 1 - spec, va_arg(ap, int));
+            } else {
+                char c = (char)va_arg(ap, int);
+                field(&out, &c, 1, width, flags & F_LEFT);
+            }
+            break;
+        case 's':
+            if (length == 'l') {
+                delegate(&out, spec, p + 1 - spec, va_arg(ap, void *));
+            } else {
+                const char *s = va_arg(ap, const char *);
+                size_t n;
+                if (!s)
+                    s = "(null)";
+                if (precision >= 0) {
+                    const char *end = memchr(s, 0, precision);
+                    n = end ? (size_t)(end - s) : (size_t)precision;
+                } else {
+                    n = strlen(s);
+                }
+                field(&out, s, n, width, flags & F_LEFT);
+            }
+            break;
+        case 'n':
+            if (length == 'q')
+                *va_arg(ap, long long *) = out.len;
+            else if (length == 'H')
+                *va_arg(ap, signed char *) = out.len;
+            else if (length == 'h')
+                *va_arg(ap, short *) = out.len;
+            else
+                *va_arg(ap, int *) = out.len;
+            break;
+        case 'e': case 'E': case 'f': case 'F': case 'g': case 'G': case 'a': case 'A': {
+            /* msvcrt's long double is double; its format without the L */
+            char conversion[32];
+            size_t n = p + 1 - spec;
+            if (length == 'L') {
+                long double value = va_arg(ap, long double);
+                const char *l = memchr(spec, 'L', n);
+                memcpy(conversion, spec, l - spec);
+                memcpy(conversion + (l - spec), l + 1, p - l);
+                delegate(&out, conversion, n - 1, (double)value);
+            } else {
+                delegate(&out, spec, n, va_arg(ap, double));
+            }
+            break;
+        }
+        case '%':
+            put(&out, "%", 1);
+            break;
+        default:
+            /* unknown: the text as it is */
+            put(&out, spec, p + (*p != 0) - spec);
+            break;
+        }
+        if (*p)
+            p++;
+    }
+    if (size)
+        buf[out.len < out.size ? out.len : out.size] = 0;
+    return out.len > 0x7fffffff ? -1 : (int)out.len;
+}
+
+int __cdecl __tcc_snprintf(char *buf, size_t size, const char *format, ...)
+{
+    va_list ap;
+    int n;
+    va_start(ap, format);
+    n = __tcc_vsnprintf(buf, size, format, ap);
+    va_end(ap);
+    return n;
+}
+
+int __cdecl __tcc_vsprintf(char *buf, const char *format, va_list ap)
+{
+    return __tcc_vsnprintf(buf, 0x7fffffff, format, ap);
+}
+
+int __cdecl __tcc_sprintf(char *buf, const char *format, ...)
+{
+    va_list ap;
+    int n;
+    va_start(ap, format);
+    n = __tcc_vsprintf(buf, format, ap);
+    va_end(ap);
+    return n;
+}
+
+int __cdecl __tcc_vfprintf(FILE *file, const char *format, va_list ap)
+{
+    char small[512], *text = small;
+    va_list copy;
+    int n;
+
+    va_copy(copy, ap);
+    n = __tcc_vsnprintf(small, sizeof small, format, ap);
+    if (n >= (int)sizeof small) {
+        if (!(text = malloc(n + 1))) {
+            va_end(copy);
+            return -1;
+        }
+        __tcc_vsnprintf(text, n + 1, format, copy);
+    }
+    va_end(copy);
+    if (n > 0 && fwrite(text, 1, n, file) != (size_t)n)
+        n = -1;
+    if (text != small)
+        free(text);
+    return n;
+}
+
+int __cdecl __tcc_fprintf(FILE *file, const char *format, ...)
+{
+    va_list ap;
+    int n;
+    va_start(ap, format);
+    n = __tcc_vfprintf(file, format, ap);
+    va_end(ap);
+    return n;
+}
+
+int __cdecl __tcc_vprintf(const char *format, va_list ap)
+{
+    return __tcc_vfprintf(stdout, format, ap);
+}
+
+int __cdecl __tcc_printf(const char *format, ...)
+{
+    va_list ap;
+    int n;
+    va_start(ap, format);
+    n = __tcc_vfprintf(stdout, format, ap);
+    va_end(ap);
+    return n;
+}
